---
import Breadcrumb from '../../components/storefront/shared/Breadcrumb.astro';
import ProductsSection from '../../components/storefront/home/ProductsSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStorefrontProducts } from '../../lib/catalog';

// "Pasar Rapi" (2026-11-23): the whole catalogue in the same grid, chips and
// card as the home page (one component, one answer). The header's search
// submits `?q=` here and the grid filters in the browser, so the HTML is the
// same for every visitor and stays edge-cacheable.
const catalog = await getStorefrontProducts(Astro.locals);
const products = catalog.map((product) => ({
  slug: product.slug,
  name: product.productName,
  category: product.category,
  description: product.subheadline || product.description,
  href: `/produk/${product.slug}`,
  image: product.image,
  price: product.price,
  comparePrice: product.comparePrice,
  ratingValue: product.ratingValue,
  reviewCount: product.reviewCount,
  soldCount: product.soldCount,
  variants: product.variants.map((variant) => ({ label: variant.label, price: variant.price })),
}));
---

<BaseLayout
  title={`Produk - ${Astro.locals.tenant.name}`}
  description={`Pilih produk ${Astro.locals.tenant.name}, lihat varian dan harga sebelum memesan.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
  ]}
  wide
>
  <main id="konten-utama" class="min-h-screen bg-white text-[#111111]">
    <div class="sf-wrap"><Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Produk' }]} /></div>
    <ProductsSection
      products={products}
      heading={{
        eyebrow: '',
        title: 'Semua produk',
        description: products.length > 0 ? `${products.length} produk dari ${Astro.locals.tenant.name}.` : '',
      }}
      asPage
      eager
    />
  </main>
</BaseLayout>

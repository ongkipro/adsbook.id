---
import { tenantDatabase } from '../../../lib/tenant-database.ts';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { HomeBannerEditor } from '../../../components/admin/HomeBannerEditor';
import { resolveStorefrontTemplate } from '../../../lib/storefront-template';

export const prerender = false;

// R1b "Tampilan toko": the store's one template (read-only here) and the manual
// home banner. Same roles as /admin/content (owner, admin, advertiser).
const database = tenantDatabase(Astro.locals);
const template = await resolveStorefrontTemplate(
  database && typeof database === 'object' ? (database as D1Database) : undefined,
  Astro.locals.tenant.storefrontTemplate,
);
const templateName = template.state === 'ready' ? template.definition.name : Astro.locals.tenant.storefrontTemplate;
const role = Astro.locals.admin?.role;
const mayChangeTemplate = role === 'owner' || role === 'admin';
---

<AdminLayout title="Tampilan toko" activeMenu="products">
  <section class="space-y-5">
    <AdminPageHeader
      title="Tampilan toko"
      description="Tema toko dan banner beranda. Tanpa AI: unggah gambar, pratinjau, lalu terbitkan."
    />
    <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white p-4 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p><span class="text-slate-500">Tema:</span> <span class="font-semibold text-slate-900">{templateName}</span></p>
      {mayChangeTemplate && (
        <a href="/admin/settings/store" class="text-xs font-semibold text-blue-700 underline underline-offset-2">Ubah di Pengaturan › Toko &amp; CS</a>
      )}
    </div>
    <HomeBannerEditor client:load storeName={Astro.locals.tenant.name} />
  </section>
</AdminLayout>

---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SectionRailLayout from '../../components/admin/SectionRailLayout.astro';
import { CHECK_RAIL_GROUPS } from '../../components/admin/section-rails';
import RateCheckTools from '../../components/admin/RateCheckTools';

export const prerender = false;

const initialPhone = Astro.url.searchParams.get('search')?.trim() || '';
// Preserve legacy `?tab=ongkir` links by redirecting cleanly to the dedicated page.
if (!initialPhone && Astro.url.searchParams.get('tab') === 'ongkir') {
  return Astro.redirect('/admin/check/ongkir', 302);
}
---
<AdminLayout title="Cek WA (RTS)" activeMenu="scoring">
  <SectionRailLayout
    title="Cek WA (RTS)"
    description="Periksa riwayat paket terkirim vs retur calon pembeli berdasarkan nomor WhatsApp dari data Mengantar."
    groups={CHECK_RAIL_GROUPS}
    railLabel="Menu pengecekan"
    railId="check"
    maxWidth="full"
  >
    <RateCheckTools
      client:load
      mode="wa"
      defaultOrigin={null}
      warehouseName=""
      initialPhone={initialPhone}
    />
  </SectionRailLayout>
</AdminLayout>

---
import { CreditCard, KeyRound, ShieldCheck, Truck } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import TwoStepSettings from '../../components/admin/TwoStepSettings.astro';
import { getRuntimeEnv } from '../../lib/env.ts';
import { getAdminCredential } from '../../lib/admin-credentials.ts';
import { twoStepEnabled, twoStepEnrollmentOpen } from '../../lib/seller-two-step.ts';
import { tenantDatabase } from '../../lib/tenant-database.ts';
import { GET as getSettings } from '../api/admin/settings';

export const prerender = false;

type InitialCredential = {
  configured: boolean;
  api_key_masked: string;
  source: 'dashboard' | 'none';
};

type InitialIntegrations = {
  mengantar: InitialCredential & {
    webhook_issued_at: string | null;
    webhook_secret_configured: boolean;
    webhook_secret_masked: string;
    webhook_last_event_at: string | null;
    webhook_stale_warning: boolean;
  };
  autolaris: InitialCredential & {
    order_origin_id: string;
    order_destination_id: string;
    shipper_email: string;
    webhook_issued_at: string | null;
  };
};

const ROLE_LABELS: Record<string, string> = {
  owner: 'Owner',
  admin: 'Admin',
  customer_service: 'Operator CS',
  advertiser: 'Advertiser',
};

const admin = Astro.locals.admin;
const mustChangePassword = admin?.mustChangePassword ?? false;
const mayManageIntegrations = !mustChangePassword && (
  admin?.role === 'owner' || admin?.role === 'admin'
);
const enrollmentOpen = !mustChangePassword
  ? twoStepEnrollmentOpen(getRuntimeEnv(Astro.locals) as Record<string, unknown>)
  : false;

const database = tenantDatabase(Astro.locals);

const [credential, initialIntegrations] = await Promise.all([
  database && admin?.username
    ? getAdminCredential(database, admin.username).catch(() => null)
    : Promise.resolve(null),
  mayManageIntegrations
    ? (async (): Promise<InitialIntegrations | null> => {
        try {
          const response = await getSettings({
            url: Astro.url,
            request: Astro.request,
            locals: Astro.locals,
          } as Parameters<typeof getSettings>[0]);
          const payload = (await response.json().catch(() => ({}))) as {
            success?: boolean;
            data?: { credentials?: InitialIntegrations };
          };
          if (response.ok && payload.success && payload.data?.credentials) {
            return payload.data.credentials;
          }
        } catch (error) {
          console.error('admin-profile-ssr-settings', error instanceof Error ? error.message : 'unknown');
        }
        return null;
      })()
    : Promise.resolve(null),
]);

let twoStepIsEnabled = false;
if (!mustChangePassword && database && credential) {
  twoStepIsEnabled = await twoStepEnabled(database, credential.id).catch(() => false);
}
// T-57: the card shows while enrollment is open, or for a user who already has it on (so they can turn it off).
const showTwoStep = !mustChangePassword && (enrollmentOpen || twoStepIsEnabled);

const profileReady = Boolean(credential);
const initialUsername = credential?.username ?? admin?.username ?? '';
const displayName = credential?.displayName || initialUsername || 'Admin';
const roleLabel = ROLE_LABELS[credential?.role ?? admin?.role ?? ''] ?? 'Operator';
const avatarInitial = displayName.trim().slice(0, 1).toUpperCase() || 'A';

const mengantar = initialIntegrations?.mengantar ?? null;
const autolaris = initialIntegrations?.autolaris ?? null;
const integrationsReady = Boolean(initialIntegrations);

const formatWib = (iso: string) =>
  `${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(new Date(iso))} WIB`;

const webhookFormatted = autolaris?.webhook_issued_at
  ? `Aktif sejak ${formatWib(autolaris.webhook_issued_at)}.`
  : 'Belum dibuat.';

const mengantarWebhookFormatted = (() => {
  if (!mengantar) return 'Belum dipasang (sinkron otomatis per jam tetap berjalan).';
  if (mengantar.webhook_secret_configured && mengantar.webhook_issued_at) {
    return mengantar.webhook_last_event_at
      ? `Aktif · event terakhir ${formatWib(mengantar.webhook_last_event_at)}.`
      : `Aktif sejak ${formatWib(mengantar.webhook_issued_at)} · menunggu event pertama.`;
  }
  if (mengantar.webhook_issued_at && !mengantar.webhook_secret_configured) {
    return `URL dibuat ${formatWib(mengantar.webhook_issued_at)} · tempel Webhook Secret agar aktif.`;
  }
  if (mengantar.webhook_secret_configured && !mengantar.webhook_issued_at) {
    return 'Webhook Secret tersimpan · klik Buat URL webhook baru lalu tempel di Mengantar.';
  }
  return 'Belum dipasang (sinkron otomatis per jam tetap berjalan).';
})();

const pageTitle = mustChangePassword
  ? 'Amankan akun admin'
  : mayManageIntegrations ? 'Profil Admin & Integrasi API' : 'Profil Akun';
const pageDescription = mustChangePassword
  ? 'Ganti password bawaan untuk membuka workspace operasional. Semua sesi akan diakhiri setelah perubahan tersimpan.'
  : mayManageIntegrations
    ? 'Kelola kredensial masuk, keamanan dua langkah, serta API Mengantar dan AutoLaris untuk toko ini.'
    : 'Kelola username, password, dan keamanan akun Anda.';
---

<AdminLayout title={pageTitle} activeMenu="profile">
  <div class:list={[
    mustChangePassword
      ? 'mx-auto max-w-2xl space-y-5'
      : 'grid grid-cols-1 items-start gap-6 xl:grid-cols-[220px_minmax(0,1fr)]',
  ]}>
    {!mustChangePassword && (
      <aside class="hidden space-y-3 xl:sticky xl:top-0 xl:block xl:max-h-[calc(100dvh-7rem)] xl:overflow-y-auto">
        <div class="rounded-xl border border-slate-200 bg-white p-3.5">
          <div class="flex items-center gap-3">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-blue-600/10 text-sm font-semibold text-blue-700" aria-hidden="true">
              {avatarInitial}
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-slate-950">{displayName}</p>
              {displayName !== initialUsername && (
                <p class="truncate text-xs text-slate-500">{initialUsername}</p>
              )}
            </div>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-slate-100 pt-2.5">
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">{roleLabel}</span>
            <span class="truncate rounded-full bg-blue-50 px-2 py-0.5 font-mono text-xs font-medium text-blue-700">{Astro.locals.tenant.slug}</span>
          </div>
        </div>

        <nav aria-label="Menu profil" class="rounded-xl border border-slate-200 bg-white p-1.5">
          <div>
            <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-[0.06em] text-slate-500">Akun &amp; keamanan</p>
            <ul class="flex flex-col gap-0.5">
              <li>
                <a href="#kredensial-login" class="flex items-center gap-3 rounded-lg px-2.5 py-1.5 text-slate-900 outline-none transition-colors hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-blue-600/40">
                  <span class="grid size-8 shrink-0 place-items-center rounded-md bg-slate-100 text-slate-600" aria-hidden="true">
                    <KeyRound className="size-4" />
                  </span>
                  <span class="flex min-w-0 flex-1 flex-col">
                    <span class="truncate text-sm font-medium">Kredensial login</span>
                    <span class="truncate text-xs text-slate-500">Username &amp; password</span>
                  </span>
                </a>
              </li>
              {showTwoStep && (
                <li>
                  <a href="#twoStep" class="flex items-center gap-3 rounded-lg px-2.5 py-1.5 text-slate-900 outline-none transition-colors hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-blue-600/40">
                    <span class="grid size-8 shrink-0 place-items-center rounded-md bg-slate-100 text-slate-600" aria-hidden="true">
                      <ShieldCheck className="size-4" />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-sm font-medium">Verifikasi 2 langkah</span>
                      <span id="railTwoStepHint" class="truncate text-xs text-slate-500">{twoStepIsEnabled ? 'Aktif · 2FA menyala' : 'Disarankan'}</span>
                    </span>
                  </a>
                </li>
              )}
            </ul>
          </div>

          {mayManageIntegrations && (
            <div class="mt-1 border-t border-slate-100 pt-1">
              <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-[0.06em] text-slate-500">Integrasi API</p>
              <ul class="flex flex-col gap-0.5">
                <li>
                  <a href="#integrasi-mengantar" class="flex items-center gap-3 rounded-lg px-2.5 py-1.5 text-slate-900 outline-none transition-colors hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-blue-600/40">
                    <span class="grid size-8 shrink-0 place-items-center rounded-md bg-slate-100 text-slate-600" aria-hidden="true">
                      <Truck className="size-4" />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-sm font-medium">Mengantar API</span>
                      <span id="railMengantarHint" class="truncate text-xs text-slate-500">{mengantar?.source === 'dashboard' ? 'Aktif · Dashboard' : 'Belum aktif'}</span>
                    </span>
                  </a>
                </li>
                <li>
                  <a href="#integrasi-autolaris" class="flex items-center gap-3 rounded-lg px-2.5 py-1.5 text-slate-900 outline-none transition-colors hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-blue-600/40">
                    <span class="grid size-8 shrink-0 place-items-center rounded-md bg-slate-100 text-slate-600" aria-hidden="true">
                      <CreditCard className="size-4" />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-sm font-medium">AutoLaris API</span>
                      <span id="railAutolarisHint" class="truncate text-xs text-slate-500">{autolaris?.source === 'dashboard' ? 'Aktif · Dashboard' : 'Belum aktif'}</span>
                    </span>
                  </a>
                </li>
              </ul>
            </div>
          )}
        </nav>
      </aside>
    )}

    <div class="flex min-w-0 flex-col gap-5">
      <AdminPageHeader title={pageTitle} description={pageDescription} />

      {!mustChangePassword && (
        <nav aria-label="Lompat ke bagian profil" class="-mt-2 flex items-center gap-1.5 overflow-x-auto pb-1 xl:hidden">
          <a href="#kredensial-login" class="inline-flex min-h-9 shrink-0 items-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium whitespace-nowrap text-slate-700 hover:bg-slate-50">Kredensial login</a>
          {showTwoStep && (
            <a href="#twoStep" class="inline-flex min-h-9 shrink-0 items-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium whitespace-nowrap text-slate-700 hover:bg-slate-50">Verifikasi 2 langkah</a>
          )}
          {mayManageIntegrations && (
            <>
              <a href="#integrasi-mengantar" class="inline-flex min-h-9 shrink-0 items-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium whitespace-nowrap text-slate-700 hover:bg-slate-50">Mengantar API</a>
              <a href="#integrasi-autolaris" class="inline-flex min-h-9 shrink-0 items-center rounded-lg border border-slate-200 bg-white px-3 text-xs font-medium whitespace-nowrap text-slate-700 hover:bg-slate-50">AutoLaris API</a>
            </>
          )}
        </nav>
      )}

      <div id="profileLoading" class:list={['sr-only', profileReady && 'hidden']} role="status" aria-live="polite" aria-busy={profileReady ? 'false' : 'true'}>
        <span class="sr-only">Memuat profil admin.</span>
      </div>
      <div id="profileError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

      <form
        id="profileForm"
        inert={!profileReady}
        data-pending={!profileReady ? '' : undefined}
        data-ssr-ready={profileReady ? '1' : undefined}
        class="settings-card scroll-mt-4"
        novalidate
        aria-busy="false"
      >
        <div id="kredensial-login" class="settings-card-head flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="settings-card-title">Kredensial login</h2>
            <p class="settings-card-hint">Perubahan akan mengakhiri seluruh sesi admin. Login kembali memakai kredensial baru.</p>
          </div>
          <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{roleLabel}</span>
        </div>

        <div class="settings-card-body space-y-5">
          <div
            id="defaultCredentialNotice"
            class:list={[
              'rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold leading-6 text-amber-900',
              !mustChangePassword && 'hidden',
            ]}
            role="alert"
          >
            Akun ini wajib ganti password sebelum membuka menu admin lainnya.
          </div>

          <fieldset class="space-y-4">
            <legend class="sr-only">Kredensial login</legend>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <label class="block text-xs font-semibold text-slate-700" for="profileUsername">
                Email atau username untuk masuk
                <input
                  id="profileUsername"
                  name="username"
                  type="text"
                  value={initialUsername}
                  required
                  minlength="3"
                  maxlength="254"
                  autocomplete="username"
                  aria-describedby="profileUsernameHint"
                  class="admin-input-flat mt-2 sm:text-sm"
                />
                <span id="profileUsernameHint" class="mt-1.5 block text-xs font-normal leading-5 text-slate-500">
                  Anda masuk di /hello dengan ini. Email, atau huruf kecil, angka, titik, garis bawah, tanda hubung.
                </span>
              </label>

              <label class="block text-xs font-semibold text-slate-700" for="currentPassword">
                Password saat ini
                <input
                  id="currentPassword"
                  name="current_password"
                  type="password"
                  required
                  maxlength="1024"
                  autocomplete="current-password"
                  class="admin-input-flat mt-2 sm:text-sm"
                />
                <span class="mt-1.5 block text-xs font-normal leading-5 text-slate-500">
                  Diperlukan untuk mengonfirmasi perubahan kredensial.
                </span>
              </label>
            </div>

            <div class="grid grid-cols-1 gap-4 border-t border-slate-100 pt-4 md:grid-cols-2">
              <label class="block text-xs font-semibold text-slate-700" for="newPassword">
                Password baru
                <input
                  id="newPassword"
                  name="new_password"
                  type="password"
                  required
                  minlength="10"
                  maxlength="128"
                  autocomplete="new-password"
                  class="admin-input-flat mt-2 sm:text-sm"
                />
              </label>

              <label class="block text-xs font-semibold text-slate-700" for="confirmPassword">
                Konfirmasi password baru
                <input
                  id="confirmPassword"
                  name="confirm_password"
                  type="password"
                  required
                  minlength="10"
                  maxlength="128"
                  autocomplete="new-password"
                  class="admin-input-flat mt-2 sm:text-sm"
                />
              </label>
            </div>
          </fieldset>
        </div>

        <div class="settings-card-foot">
          <p id="profileStatus" class="min-h-5 text-xs font-medium text-slate-500" role="status" aria-live="polite" aria-atomic="true">
            Password baru minimal 10 karakter dan tidak boleh sama dengan username.
          </p>
          <button id="saveProfile" type="submit" class="btn-primary shrink-0">Simpan Profil</button>
        </div>
      </form>

      {showTwoStep && (
        <TwoStepSettings
          initialReady={profileReady}
          initialEnabled={twoStepIsEnabled}
          initialAvailable={enrollmentOpen}
        />
      )}

      {mayManageIntegrations && (
        <section id="integrasi-api" class="space-y-4 pt-1">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div class="min-w-0">
              <h2 class="text-base font-semibold text-slate-950">Kredensial Mengantar &amp; AutoLaris</h2>
              <p class="mt-1 max-w-2xl text-xs leading-5 text-slate-500">
                API key tersimpan terenkripsi khusus di database toko <span class="font-mono font-medium text-slate-700">{Astro.locals.tenant.slug}</span>. Provider yang belum diisi tidak dipakai.
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-3 text-xs font-medium text-slate-500">
              <a href="/admin/expeditions" class="whitespace-nowrap underline underline-offset-4 hover:text-slate-900">Atur ekspedisi</a>
              <a href="/admin/payments" class="whitespace-nowrap underline underline-offset-4 hover:text-slate-900">Atur pembayaran</a>
            </div>
          </div>

          <div id="integrationsLoading" class:list={['sr-only', integrationsReady && 'hidden']} role="status" aria-live="polite" aria-busy={integrationsReady ? 'false' : 'true'} aria-atomic="true">
            <span class="sr-only">Memuat konfigurasi integrasi API.</span>
          </div>
          <div id="integrationsError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

          <form
            id="integrationsForm"
            inert={!integrationsReady}
            data-pending={!integrationsReady ? '' : undefined}
            data-ssr-ready={integrationsReady ? '1' : undefined}
            class="space-y-4"
            novalidate
            aria-busy="false"
          >
            <fieldset id="integrasi-mengantar" class="settings-card scroll-mt-4">
              <legend class="sr-only">Mengantar API</legend>
              <div class="settings-card-head flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="settings-card-title">Mengantar API</h3>
                  <p class="settings-card-hint">Ongkir, pembuatan resi, penjadwalan pickup, pelacakan paket, dan riwayat RTS penerima.</p>
                </div>
                <span
                  id="mengantarSource"
                  class={mengantar?.source === 'dashboard'
                    ? 'shrink-0 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800'
                    : 'shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600'}
                >
                  {mengantar?.source === 'dashboard' ? 'Dashboard' : 'Belum aktif'}
                </span>
              </div>

              <div class="settings-card-body space-y-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700" for="mengantarKey">API key baru</label>
                  <div class="relative mt-2 max-w-xl">
                    <input
                      id="mengantarKey"
                      name="mengantar_api_key"
                      type="password"
                      autocomplete="new-password"
                      placeholder={mengantar?.api_key_masked || 'Masukkan API key Mengantar'}
                      class="admin-input-flat pr-24 font-mono sm:text-sm"
                    />
                    <button
                      id="toggleMengantarKey"
                      type="button"
                      class="absolute inset-y-1 right-1 min-w-20 rounded-lg bg-white px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-300"
                      aria-controls="mengantarKey"
                      aria-label="Tampilkan API key Mengantar"
                      aria-pressed="false"
                    >
                      Lihat
                    </button>
                  </div>
                  <p id="mengantarKeyHint" class="mt-1.5 text-xs text-slate-500">
                    Endpoint resmi Mengantar dipakai otomatis. Kosongkan untuk mempertahankan key saat ini.
                  </p>
                  <label class="mt-2.5 inline-flex items-center gap-2 text-xs font-medium text-slate-600">
                    <input type="checkbox" name="mengantar_clear_key" class="size-4 rounded border-slate-300" />
                    Hapus key tersimpan (Mengantar berhenti dipakai)
                  </label>
                </div>

                <div id="mengantarWebhookCard" class="space-y-3 rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-slate-900">Webhook Mengantar (sinkron status otomatis)</p>
                      <p id="mengantarWebhookState" class="mt-0.5 text-xs text-slate-600">{mengantarWebhookFormatted}</p>
                    </div>
                    <button id="issueMengantarWebhook" type="button" class="btn-secondary shrink-0">Buat URL webhook baru</button>
                  </div>

                  <div
                    id="mengantarWebhookWarning"
                    class:list={[
                      'rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-900',
                      !mengantar?.webhook_stale_warning && 'hidden',
                    ]}
                    role="status"
                  >
                    Tidak ada event webhook 48 jam terakhir padahal ada order aktif — cek apakah pengiriman webhook dijeda di dashboard Mengantar (klik <strong>Aktifkan kembali</strong>).
                  </div>

                  <div id="mengantarWebhookWrap" class="hidden flex-col gap-2 sm:flex-row sm:items-center">
                    <output id="mengantarWebhookUrl" class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-900"></output>
                    <button id="copyMengantarWebhookUrl" type="button" class="btn-secondary shrink-0">Salin URL</button>
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-700" for="mengantarWebhookSecret">Webhook Secret Mengantar</label>
                    <div class="relative mt-1.5 max-w-xl">
                      <input
                        id="mengantarWebhookSecret"
                        name="mengantar_webhook_secret"
                        type="password"
                        autocomplete="new-password"
                        placeholder={mengantar?.webhook_secret_masked || 'Tempel Webhook Secret dari Mengantar'}
                        class="admin-input-flat pr-24 font-mono sm:text-sm"
                      />
                      <button
                        id="toggleMengantarWebhookSecret"
                        type="button"
                        class="absolute inset-y-1 right-1 min-w-20 rounded-lg bg-white px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-300"
                        aria-controls="mengantarWebhookSecret"
                        aria-label="Tampilkan Webhook Secret Mengantar"
                        aria-pressed="false"
                      >
                        Lihat
                      </button>
                    </div>
                    <label class="mt-2 inline-flex items-center gap-2 text-xs font-medium text-slate-600">
                      <input type="checkbox" name="mengantar_clear_webhook_secret" class="size-4 rounded border-slate-300" />
                      Hapus Webhook Secret tersimpan
                    </label>
                  </div>

                  <div class="space-y-1 border-t border-slate-200/80 pt-2.5 text-xs leading-5 text-slate-500">
                    <p>
                      <strong class="font-semibold text-slate-700">Cara pasang:</strong> buka dashboard Mengantar → <strong>Settings → Account → Integrasi Public API</strong> → tempel URL webhook di atas → simpan, lalu salin <strong>Webhook Secret</strong> ke kolom ini dan klik <strong>Simpan Integrasi</strong>. Di production, menu Webhook muncul setelah akun diaktifkan oleh Mengantar (di sandbox langsung terbuka).
                    </p>
                    <p>
                      <strong class="font-semibold text-slate-700">Penting:</strong> membuat ulang API key Mengantar juga mengganti Webhook Secret (URL tetap) — tempel ulang Secret baru di sini bila API key dirotasi.
                    </p>
                  </div>
                </div>
              </div>
            </fieldset>

            <fieldset id="integrasi-autolaris" class="settings-card scroll-mt-4">
              <legend class="sr-only">AutoLaris API</legend>
              <div class="settings-card-head flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="settings-card-title">AutoLaris API</h3>
                  <p class="settings-card-hint">Pembayaran otomatis QRIS dan Virtual Account 24 jam tanpa cek mutasi manual (opsional).</p>
                </div>
                <span
                  id="autolarisSource"
                  class={autolaris?.source === 'dashboard'
                    ? 'shrink-0 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800'
                    : 'shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600'}
                >
                  {autolaris?.source === 'dashboard' ? 'Dashboard' : 'Belum aktif'}
                </span>
              </div>

              <div class="settings-card-body space-y-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700" for="autolarisKey">API key baru</label>
                  <div class="relative mt-2 max-w-xl">
                    <input
                      id="autolarisKey"
                      name="autolaris_api_key"
                      type="password"
                      autocomplete="new-password"
                      placeholder={autolaris?.api_key_masked || 'Masukkan API key AutoLaris'}
                      class="admin-input-flat pr-24 font-mono sm:text-sm"
                    />
                    <button
                      id="toggleAutolarisKey"
                      type="button"
                      class="absolute inset-y-1 right-1 min-w-20 rounded-lg bg-white px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-300"
                      aria-controls="autolarisKey"
                      aria-label="Tampilkan API key AutoLaris"
                      aria-pressed="false"
                    >
                      Lihat
                    </button>
                  </div>
                  <p id="autolarisKeyHint" class="mt-1.5 text-xs text-slate-500">
                    Cukup API key. QRIS dan Virtual Account langsung aktif di checkout; pengiriman tetap lewat Mengantar. Kosongkan untuk mempertahankan key saat ini.
                  </p>
                  <label class="mt-2.5 inline-flex items-center gap-2 text-xs font-medium text-slate-600">
                    <input type="checkbox" name="autolaris_clear_key" class="size-4 rounded border-slate-300" />
                    Hapus key tersimpan (AutoLaris berhenti dipakai)
                  </label>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="min-w-0">
                      <p class="text-xs font-semibold text-slate-900">URL webhook AutoLaris</p>
                      <p id="autolarisWebhookState" class="mt-0.5 text-xs text-slate-500">{webhookFormatted}</p>
                    </div>
                    <button id="issueWebhook" type="button" class="btn-secondary shrink-0">Buat URL webhook baru</button>
                  </div>
                  <div id="autolarisWebhookWrap" class="mt-3 hidden flex-col gap-2 sm:flex-row sm:items-center">
                    <output id="autolarisWebhookUrl" class="min-w-0 flex-1 break-all rounded-lg border border-slate-200 bg-white px-3 py-2 font-mono text-xs text-slate-900"></output>
                    <button id="copyWebhookUrl" type="button" class="btn-secondary shrink-0">Salin URL</button>
                  </div>
                  <p class="mt-2 text-xs text-slate-500">
                    URL hanya tampil sekali dan khusus subdomain toko ini. Membuat yang baru mematikan URL lama.
                  </p>
                </div>

                <details class="rounded-xl border border-slate-200 bg-slate-50/60 p-3.5" id="autolarisAdvanced">
                  <summary class="cursor-pointer text-xs font-semibold text-slate-700">
                    Lanjutan <span class="font-normal text-slate-500">(tidak perlu diisi)</span>
                  </summary>
                  <div class="mt-4 space-y-4">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                      <div class="min-w-0">
                        <label class="block text-xs font-semibold text-slate-700" for="autolarisOrigin">Area origin</label>
                        <input
                          id="autolarisOrigin"
                          name="autolaris_order_origin_id"
                          type="text"
                          value={autolaris?.order_origin_id ?? ''}
                          inputmode="numeric"
                          pattern="[0-9]*"
                          autocomplete="off"
                          placeholder="3517100"
                          aria-describedby="autolarisAreaHint"
                          class="admin-input-flat mt-2 font-mono sm:text-sm"
                        />
                      </div>
                      <div class="min-w-0">
                        <label class="block text-xs font-semibold text-slate-700" for="autolarisDestination">Area destination</label>
                        <input
                          id="autolarisDestination"
                          name="autolaris_order_destination_id"
                          type="text"
                          value={autolaris?.order_destination_id ?? ''}
                          inputmode="numeric"
                          pattern="[0-9]*"
                          autocomplete="off"
                          placeholder="3518010"
                          aria-describedby="autolarisAreaHint"
                          class="admin-input-flat mt-2 font-mono sm:text-sm"
                        />
                      </div>
                    </div>
                    <p id="autolarisAreaHint" class="text-xs text-slate-500">
                      Hanya bila AutoLaris meminta area tertentu untuk akun Anda. Kosongkan untuk memakai area bawaan (pembayaran saja, courir 1, tanpa pengiriman).
                    </p>
                    <div>
                      <label class="block text-xs font-semibold text-slate-700" for="autolarisShipperEmail">Email pengirim</label>
                      <input
                        id="autolarisShipperEmail"
                        name="autolaris_shipper_email"
                        type="email"
                        value={autolaris?.shipper_email ?? ''}
                        autocomplete="off"
                        aria-describedby="autolarisShipperHint"
                        class="admin-input-flat mt-2 sm:text-sm"
                      />
                      <p id="autolarisShipperHint" class="mt-1 text-xs text-slate-500">Kosongkan untuk memakai email CS toko.</p>
                    </div>
                  </div>
                </details>
              </div>
            </fieldset>

            <div class="settings-card">
              <div class="settings-card-foot border-t-0">
                <p id="saveStatus" class="min-h-5 text-xs font-medium text-slate-500" role="status" aria-live="polite" aria-atomic="true">
                  API key kosong tidak akan menghapus credential yang sudah aktif.
                </p>
                <button id="saveIntegrations" type="submit" class="btn-primary shrink-0">Simpan Integrasi</button>
              </div>
            </div>
          </form>
        </section>
      )}
    </div>
  </div>

  <script>
    type Credential = { configured: boolean; api_key_masked: string; source: 'dashboard' | 'none' };
    type Credentials = {
      mengantar: Credential & {
        webhook_issued_at: string | null;
        webhook_secret_configured: boolean;
        webhook_secret_masked: string;
        webhook_last_event_at: string | null;
        webhook_stale_warning: boolean;
      };
      autolaris: Credential & {
        order_origin_id: string;
        order_destination_id: string;
        shipper_email: string;
        webhook_issued_at: string | null;
      };
    };
    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const integrationsLoading = byId('integrationsLoading');
    let integrationsPending = false;
    let profilePending = false;

    const profileStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      const status = byId('profileStatus');
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-medium ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    const setProfilePending = (next: boolean) => {
      profilePending = next;
      const button = byId<HTMLButtonElement>('saveProfile');
      if (button) {
        button.disabled = next;
        button.textContent = next ? 'Menyimpan…' : 'Simpan Profil';
      }
      byId<HTMLFormElement>('profileForm')?.setAttribute('aria-busy', String(next));
    };

    const sourceLabel = (source: Credential['source']) => source === 'dashboard' ? 'Dashboard' : 'Belum aktif';
    const paintSource = (id: string, railId: string, source: Credential['source']) => {
      const node = byId<HTMLSpanElement>(id);
      if (node) {
        node.textContent = sourceLabel(source);
        node.className = source === 'dashboard'
          ? 'shrink-0 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800'
          : 'shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600';
      }
      const rail = byId(railId);
      if (rail) rail.textContent = source === 'dashboard' ? 'Aktif · Dashboard' : 'Belum aktif';
    };

    const showStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      const status = byId('saveStatus');
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-medium ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    const setPending = (next: boolean) => {
      integrationsPending = next;
      const button = byId<HTMLButtonElement>('saveIntegrations');
      if (button) {
        button.disabled = next;
        button.textContent = next ? 'Menyimpan…' : 'Simpan Integrasi';
      }
      byId<HTMLFormElement>('integrationsForm')?.setAttribute('aria-busy', String(next));
    };

    const setSecretVisibility = (input: HTMLInputElement | null, button: HTMLButtonElement | null, label: string, visible: boolean) => {
      if (!input || !button) return;
      input.type = visible ? 'text' : 'password';
      button.textContent = visible ? 'Sembunyikan' : 'Lihat';
      button.setAttribute('aria-label', `${visible ? 'Sembunyikan' : 'Tampilkan'} ${label}`);
      button.setAttribute('aria-pressed', String(visible));
    };

    const wireSecretToggle = (inputId: string, buttonId: string, label: string) => {
      const input = byId<HTMLInputElement>(inputId);
      const button = byId<HTMLButtonElement>(buttonId);
      button?.addEventListener('click', () => setSecretVisibility(input, button, label, input?.type === 'password'));
    };

    const formatWibClient = (iso: string) =>
      `${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(new Date(iso))} WIB`;

    const render = (credentials: Credentials) => {
      const mengantarKey = byId<HTMLInputElement>('mengantarKey');
      const mengantarWebhookSecret = byId<HTMLInputElement>('mengantarWebhookSecret');
      const autolarisKey = byId<HTMLInputElement>('autolarisKey');
      const mengantarToggle = byId<HTMLButtonElement>('toggleMengantarKey');
      const mengantarSecretToggle = byId<HTMLButtonElement>('toggleMengantarWebhookSecret');
      const autolarisToggle = byId<HTMLButtonElement>('toggleAutolarisKey');
      const setValue = (id: string, value: string) => { const input = byId<HTMLInputElement>(id); if (input) input.value = value; };
      setValue('autolarisOrigin', credentials.autolaris.order_origin_id);
      setValue('autolarisDestination', credentials.autolaris.order_destination_id);
      setValue('autolarisShipperEmail', credentials.autolaris.shipper_email);
      const webhookState = byId('autolarisWebhookState');
      if (webhookState) {
        const issued = credentials.autolaris.webhook_issued_at;
        webhookState.textContent = issued
          ? `Aktif sejak ${formatWibClient(issued)}.`
          : 'Belum dibuat.';
      }
      const mengantarWebhookState = byId('mengantarWebhookState');
      if (mengantarWebhookState) {
        const m = credentials.mengantar;
        if (m.webhook_secret_configured && m.webhook_issued_at) {
          mengantarWebhookState.textContent = m.webhook_last_event_at
            ? `Aktif · event terakhir ${formatWibClient(m.webhook_last_event_at)}.`
            : `Aktif sejak ${formatWibClient(m.webhook_issued_at)} · menunggu event pertama.`;
        } else if (m.webhook_issued_at && !m.webhook_secret_configured) {
          mengantarWebhookState.textContent = `URL dibuat ${formatWibClient(m.webhook_issued_at)} · tempel Webhook Secret agar aktif.`;
        } else if (m.webhook_secret_configured && !m.webhook_issued_at) {
          mengantarWebhookState.textContent = 'Webhook Secret tersimpan · klik Buat URL webhook baru lalu tempel di Mengantar.';
        } else {
          mengantarWebhookState.textContent = 'Belum dipasang (sinkron otomatis per jam tetap berjalan).';
        }
      }
      byId('mengantarWebhookWarning')?.classList.toggle('hidden', !credentials.mengantar.webhook_stale_warning);
      if (mengantarKey) { mengantarKey.value = ''; mengantarKey.placeholder = credentials.mengantar.api_key_masked || 'Masukkan API key Mengantar'; }
      if (mengantarWebhookSecret) { mengantarWebhookSecret.value = ''; mengantarWebhookSecret.placeholder = credentials.mengantar.webhook_secret_masked || 'Tempel Webhook Secret dari Mengantar'; }
      if (autolarisKey) { autolarisKey.value = ''; autolarisKey.placeholder = credentials.autolaris.api_key_masked || 'Masukkan API key AutoLaris'; }
      const clearCheckbox = (name: string) => {
        const box = document.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        if (box) box.checked = false;
      };
      clearCheckbox('mengantar_clear_key');
      clearCheckbox('mengantar_clear_webhook_secret');
      clearCheckbox('autolaris_clear_key');
      setSecretVisibility(mengantarKey, mengantarToggle, 'API key Mengantar', false);
      setSecretVisibility(mengantarWebhookSecret, mengantarSecretToggle, 'Webhook Secret Mengantar', false);
      setSecretVisibility(autolarisKey, autolarisToggle, 'API key AutoLaris', false);
      paintSource('mengantarSource', 'railMengantarHint', credentials.mengantar.source);
      paintSource('autolarisSource', 'railAutolarisHint', credentials.autolaris.source);
    };

    wireSecretToggle('mengantarKey', 'toggleMengantarKey', 'API key Mengantar');
    wireSecretToggle('mengantarWebhookSecret', 'toggleMengantarWebhookSecret', 'Webhook Secret Mengantar');
    wireSecretToggle('autolarisKey', 'toggleAutolarisKey', 'API key AutoLaris');

    const loadIntegrations = async () => {
      const response = await fetch('/api/admin/settings', { headers: { Accept: 'application/json' } });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat konfigurasi API.');
      render(payload.data.credentials);
      integrationsLoading?.setAttribute('aria-busy', 'false');
      integrationsLoading?.classList.add('hidden');
      byId('integrationsForm')?.removeAttribute('inert');
      byId('integrationsForm')?.removeAttribute('data-pending');
    };

    const showIntegrationsError = (error: unknown) => {
      integrationsLoading?.setAttribute('aria-busy', 'false');
      integrationsLoading?.classList.add('hidden');
      byId('integrationsForm')?.classList.add('hidden');
      const node = byId('integrationsError');
      if (node) {
        node.textContent = error instanceof Error ? error.message : 'Gagal memuat konfigurasi API.';
        node.classList.remove('hidden');
      }
    };

    const loadProfile = async () => {
      const response = await fetch('/api/admin/profile', { headers: { Accept: 'application/json' } });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat profil admin.');
      const username = byId<HTMLInputElement>('profileUsername');
      if (username) username.value = payload.data.username;
      byId('defaultCredentialNotice')?.classList.toggle('hidden', !payload.data.must_change_password);
      byId('profileLoading')?.setAttribute('aria-busy', 'false');
      byId('profileLoading')?.classList.add('hidden');
      byId('profileForm')?.removeAttribute('inert');
      byId('profileForm')?.removeAttribute('data-pending');
      return Boolean(payload.data.must_change_password);
    };

    // Hydrate from SSR without redundant network round-trips; only fetch if SSR fell back.
    const profileForm = byId<HTMLFormElement>('profileForm');
    const integrationsForm = byId<HTMLFormElement>('integrationsForm');
    if (profileForm && profileForm.dataset.ssrReady !== '1') {
      loadProfile().then((mustChangePassword) => {
        if (mustChangePassword) return;
        if (integrationsForm && integrationsForm.dataset.ssrReady !== '1') {
          loadIntegrations().catch(showIntegrationsError);
        }
      }).catch((error) => {
        byId('profileLoading')?.setAttribute('aria-busy', 'false');
        byId('profileLoading')?.classList.add('hidden');
        profileForm.classList.add('hidden');
        const node = byId('profileError');
        if (node) {
          node.textContent = error instanceof Error ? error.message : 'Gagal memuat profil admin.';
          node.classList.remove('hidden');
        }
        if (integrationsForm && integrationsForm.dataset.ssrReady !== '1') showIntegrationsError(error);
      });
    } else if (integrationsForm && integrationsForm.dataset.ssrReady !== '1') {
      loadIntegrations().catch(showIntegrationsError);
    }

    profileForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (profilePending || !form.reportValidity()) return;
      const values = new FormData(form);
      if (values.get('new_password') !== values.get('confirm_password')) {
        profileStatus('Konfirmasi password baru tidak sama.', 'error');
        byId<HTMLInputElement>('confirmPassword')?.focus();
        return;
      }
      setProfilePending(true);
      profileStatus('Menyimpan profil dan mengakhiri seluruh sesi…', 'idle');
      try {
        const response = await fetch('/api/admin/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: values.get('username'),
            current_password: values.get('current_password'),
            new_password: values.get('new_password'),
            confirm_password: values.get('confirm_password'),
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Profil admin gagal disimpan.');
        profileStatus(payload.message || 'Profil admin tersimpan. Silakan login kembali.', 'success');
        window.setTimeout(() => window.location.assign('/hello'), 900);
      } catch (error) {
        profileStatus(error instanceof Error ? error.message : 'Profil admin gagal disimpan.', 'error');
        setProfilePending(false);
      }
    });

    const wireWebhookIssuer = (
      buttonId: string,
      outputId: string,
      wrapId: string,
      copyButtonId: string,
      provider: 'autolaris' | 'mengantar',
    ) => {
      byId<HTMLButtonElement>(buttonId)?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        if (button.disabled) return;
        button.disabled = true;
        showStatus('Membuat URL webhook…', 'idle');
        try {
          const response = await fetch('/api/admin/settings', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'issue-webhook-token', provider }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || !payload.success) throw new Error(payload.error || 'URL webhook gagal dibuat.');
          render(payload.data.credentials);
          const output = byId(outputId);
          const wrap = byId(wrapId);
          if (output) output.textContent = payload.data.webhook_url;
          if (wrap) { wrap.classList.remove('hidden'); wrap.classList.add('flex'); }
          showStatus(payload.message || 'URL webhook dibuat.', 'success');
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'URL webhook gagal dibuat.', 'error');
        } finally {
          button.disabled = false;
        }
      });

      byId<HTMLButtonElement>(copyButtonId)?.addEventListener('click', async () => {
        const url = byId(outputId)?.textContent?.trim();
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          showStatus('URL webhook disalin.', 'success');
        } catch {
          showStatus('Browser menolak akses clipboard. Salin URL secara manual.', 'error');
        }
      });
    };

    wireWebhookIssuer('issueWebhook', 'autolarisWebhookUrl', 'autolarisWebhookWrap', 'copyWebhookUrl', 'autolaris');
    wireWebhookIssuer('issueMengantarWebhook', 'mengantarWebhookUrl', 'mengantarWebhookWrap', 'copyMengantarWebhookUrl', 'mengantar');

    integrationsForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (integrationsPending || !form.reportValidity()) return;
      setPending(true);
      showStatus('Menyimpan konfigurasi…', 'idle');
      const values = new FormData(form);
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-integrations',
            integrations: {
              mengantar_api_key: values.get('mengantar_clear_key') ? null : values.get('mengantar_api_key'),
              mengantar_webhook_secret: values.get('mengantar_clear_webhook_secret') ? null : values.get('mengantar_webhook_secret'),
              autolaris_api_key: values.get('autolaris_clear_key') ? null : values.get('autolaris_api_key'),
              autolaris_order_origin_id: values.get('autolaris_order_origin_id'),
              autolaris_order_destination_id: values.get('autolaris_order_destination_id'),
              autolaris_shipper_email: values.get('autolaris_shipper_email'),
            },
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Konfigurasi gagal disimpan.');
        render(payload.data.credentials);
        showStatus(payload.message || 'Konfigurasi integrasi tersimpan.', 'success');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Konfigurasi gagal disimpan.', 'error');
      } finally {
        setPending(false);
      }
    });

    // Scroll in-page section links strictly inside #admin-main so the browser
    // never scrolls outer layout containers or shifts the sticky rail under the topbar.
    const adminMain = byId('admin-main');
    const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Menu profil"] a[href^="#"]'));
    const setActiveRail = (hash: string) => {
      for (const link of railLinks) {
        const active = link.getAttribute('href') === hash;
        link.setAttribute('aria-current', active ? 'location' : 'false');
        link.classList.toggle('bg-blue-600/[0.07]', active);
        link.classList.toggle('text-blue-700', active);
        link.classList.toggle('text-slate-900', !active);
        const iconBox = link.firstElementChild;
        if (iconBox) {
          iconBox.classList.toggle('bg-blue-600/10', active);
          iconBox.classList.toggle('text-blue-700', active);
          iconBox.classList.toggle('bg-slate-100', !active);
          iconBox.classList.toggle('text-slate-600', !active);
        }
      }
    };
    const scrollToSection = (hash: string, smooth: boolean) => {
      const targetId = hash.replace(/^#/, '');
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target || !adminMain) return;
      const mainRect = adminMain.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const nextTop = Math.max(0, adminMain.scrollTop + (targetRect.top - mainRect.top) - 16);
      adminMain.scrollTo({ top: nextTop, behavior: smooth ? 'smooth' : 'auto' });
      setActiveRail(`#${targetId}`);
    };
    document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Menu profil"] a[href^="#"], nav[aria-label="Lompat ke bagian profil"] a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const hash = link.getAttribute('href') || '';
        if (!hash.startsWith('#')) return;
        event.preventDefault();
        window.history.replaceState(null, '', hash);
        scrollToSection(hash, true);
      });
    });
    if (adminMain && railLinks.length > 0) {
      let spyFrame = 0;
      const syncActiveRailFromScroll = () => {
        spyFrame = 0;
        const mainTop = adminMain.getBoundingClientRect().top;
        let currentHash = railLinks[0]?.getAttribute('href') || '#kredensial-login';
        for (const link of railLinks) {
          const hash = link.getAttribute('href') || '';
          const section = hash.startsWith('#') ? document.getElementById(hash.slice(1)) : null;
          if (!section) continue;
          if (section.getBoundingClientRect().top - mainTop <= 96) {
            currentHash = hash;
          }
        }
        setActiveRail(currentHash);
      };
      adminMain.addEventListener('scroll', () => {
        if (!spyFrame) spyFrame = window.requestAnimationFrame(syncActiveRailFromScroll);
      }, { passive: true });
    }
    if (window.location.hash) {
      window.requestAnimationFrame(() => scrollToSection(window.location.hash, false));
    } else if (railLinks[0]) {
      setActiveRail(railLinks[0].getAttribute('href') || '#kredensial-login');
    }
  </script>
</AdminLayout>

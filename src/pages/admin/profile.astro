---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
export const prerender = false;
const mustChangePassword = Astro.locals.admin?.mustChangePassword ?? false;
const mayManageIntegrations = !mustChangePassword && (
  Astro.locals.admin?.role === 'owner' || Astro.locals.admin?.role === 'admin'
);
const pageTitle = mustChangePassword
  ? 'Amankan akun admin'
  : mayManageIntegrations ? 'Profil Admin & Integrasi API' : 'Profil Akun';
---

<AdminLayout title={pageTitle} activeMenu="profile">
  <div class="space-y-5">
    <AdminPageHeader
      title={pageTitle}
      description={mustChangePassword
        ? "Ganti password bawaan untuk membuka workspace operasional. Semua sesi akan diakhiri setelah perubahan tersimpan."
        : mayManageIntegrations
        ? "Kelola kredensial admin, domain provider, serta API Mengantar dan AutoLaris."
        : "Kelola username dan password akun Anda."}
    />

    <div id="profileLoading" class="sr-only" role="status" aria-live="polite" aria-busy="true">
      <span class="sr-only">Memuat profil admin.</span>
    </div>
    <div id="profileError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

    <form id="profileForm" inert data-pending class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-7" novalidate aria-busy="false">
      <div id="defaultCredentialNotice" class="hidden mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold leading-6 text-amber-900" role="alert">
        Akun ini wajib ganti password sebelum membuka menu admin lainnya.
      </div>
      <fieldset>
        <legend class="font-semibold text-slate-950">Kredensial login</legend>
        <p class="mt-1 text-xs leading-5 text-slate-500">Perubahan akan mengakhiri seluruh sesi admin. Login kembali memakai kredensial baru.</p>
        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
          <label class="block text-xs font-semibold text-slate-700" for="profileUsername">
            Email atau username untuk masuk
            <input id="profileUsername" name="username" type="text" required minlength="3" maxlength="254" autocomplete="username" aria-describedby="profileUsernameHint" class="admin-input-flat mt-2 sm:text-sm" />
            <span id="profileUsernameHint" class="mt-1 block text-xs font-medium text-slate-500">Anda masuk di /hello dengan ini. Email, atau huruf kecil, angka, titik, garis bawah, tanda hubung.</span>
          </label>
          <label class="block text-xs font-semibold text-slate-700" for="currentPassword">
            Password saat ini
            <input id="currentPassword" name="current_password" type="password" required maxlength="1024" autocomplete="current-password" class="admin-input-flat mt-2 sm:text-sm" />
          </label>
          <label class="block text-xs font-semibold text-slate-700" for="newPassword">
            Password baru
            <input id="newPassword" name="new_password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" class="admin-input-flat mt-2 sm:text-sm" />
          </label>
          <label class="block text-xs font-semibold text-slate-700" for="confirmPassword">
            Konfirmasi password baru
            <input id="confirmPassword" name="confirm_password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" class="admin-input-flat mt-2 sm:text-sm" />
          </label>
        </div>
      </fieldset>
      <div class="mt-5 flex flex-col-reverse items-stretch gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
        <p id="profileStatus" class="min-h-5 text-xs font-semibold text-slate-500" role="status" aria-live="polite" aria-atomic="true">Password baru minimal 10 karakter dan tidak boleh sama dengan username.</p>
        <button id="saveProfile" type="submit" class="btn-primary">Simpan Profil</button>
      </div>
    </form>

    {mayManageIntegrations && <>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-7">
      <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">Kredensial provider</p>
      <h2 class="mt-1 text-base font-semibold text-slate-950">Mengantar & AutoLaris</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        Ganti API key dan base URL aktif untuk toko <strong>{Astro.locals.tenant.slug}</strong>. Nilai tersimpan hanya di database toko ini. Provider yang belum diisi tidak dipakai sama sekali.
      </p>
    </section>

    <div id="integrationsLoading" class="sr-only" role="status" aria-live="polite" aria-busy="true" aria-atomic="true">
      <span class="sr-only">Memuat konfigurasi integrasi API.</span>
    </div>
    <div id="integrationsError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

    <form id="integrationsForm" inert data-pending class="space-y-5" novalidate aria-busy="false">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <fieldset class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
          <div class="flex items-start justify-between gap-3">
            <div><legend class="font-semibold text-slate-950">Mengantar API</legend><p class="mt-1 text-xs text-slate-500">Ongkir, shipment, pickup, tracking, dan receiver history.</p></div>
            <span id="mengantarSource" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Belum aktif</span>
          </div>
          <label class="mt-6 block text-xs font-semibold text-slate-700" for="mengantarKey">API key baru</label>
          <div class="relative mt-2"><input id="mengantarKey" name="mengantar_api_key" type="password" autocomplete="new-password" class="admin-input-flat pr-24 font-mono sm:text-sm" /><button id="toggleMengantarKey" type="button" class="absolute inset-y-1 right-1 min-w-20 rounded-lg bg-white px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-300" aria-controls="mengantarKey" aria-label="Tampilkan API key Mengantar" aria-pressed="false">Lihat</button></div>
          <p id="mengantarKeyHint" class="mt-1 text-xs text-slate-500">Kosongkan untuk mempertahankan key saat ini.</p>
          <label class="mt-2 flex items-center gap-2 text-xs font-semibold text-slate-600"><input type="checkbox" name="mengantar_clear_key" class="size-4 rounded border-slate-300" />Hapus key tersimpan (Mengantar berhenti dipakai)</label>
          <label class="mt-4 block text-xs font-semibold text-slate-700" for="mengantarUrl">Base URL</label>
          <input id="mengantarUrl" name="mengantar_base_url" type="url" required class="admin-input-flat mt-2 font-mono sm:text-sm" />
        </fieldset>

        <fieldset class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
          <div class="flex items-start justify-between gap-3">
            <div><legend class="font-semibold text-slate-950">AutoLaris API</legend><p class="mt-1 text-xs text-slate-500">Invoice, virtual account, QRIS, DANA, dan status pembayaran.</p></div>
            <span id="autolarisSource" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Belum aktif</span>
          </div>
          <label class="mt-6 block text-xs font-semibold text-slate-700" for="autolarisKey">API key baru</label>
          <div class="relative mt-2"><input id="autolarisKey" name="autolaris_api_key" type="password" autocomplete="new-password" class="admin-input-flat pr-24 font-mono sm:text-sm" /><button id="toggleAutolarisKey" type="button" class="absolute inset-y-1 right-1 min-w-20 rounded-lg bg-white px-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-300" aria-controls="autolarisKey" aria-label="Tampilkan API key AutoLaris" aria-pressed="false">Lihat</button></div>
          <p id="autolarisKeyHint" class="mt-1 text-xs text-slate-500">Kosongkan untuk mempertahankan key saat ini.</p>
          <label class="mt-2 flex items-center gap-2 text-xs font-semibold text-slate-600"><input type="checkbox" name="autolaris_clear_key" class="size-4 rounded border-slate-300" />Hapus key tersimpan (AutoLaris berhenti dipakai)</label>
          <p class="mt-3 text-xs text-slate-600">Cukup API key. QRIS dan Virtual Account langsung aktif di checkout; pengiriman tetap lewat Mengantar.</p>
          <details class="mt-4 rounded-xl border border-slate-200 bg-slate-50/60 p-3" id="autolarisAdvanced">
            <summary class="cursor-pointer text-xs font-semibold text-slate-700">Lanjutan <span class="font-normal text-slate-500">(tidak perlu diisi)</span></summary>
            <label class="mt-3 block text-xs font-semibold text-slate-700" for="autolarisUrl">Base URL</label>
            <input id="autolarisUrl" name="autolaris_base_url" type="url" placeholder="https://api-h2h.autolaris.com" class="admin-input-flat mt-2 font-mono sm:text-sm" />
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="min-w-0">
                <label class="block text-xs font-semibold text-slate-700" for="autolarisOrigin">Area origin</label>
                <input id="autolarisOrigin" name="autolaris_order_origin_id" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="3517100" aria-describedby="autolarisAreaHint" class="admin-input-flat mt-2 font-mono sm:text-sm" />
              </div>
              <div class="min-w-0">
                <label class="block text-xs font-semibold text-slate-700" for="autolarisDestination">Area destination</label>
                <input id="autolarisDestination" name="autolaris_order_destination_id" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="3518010" aria-describedby="autolarisAreaHint" class="admin-input-flat mt-2 font-mono sm:text-sm" />
              </div>
            </div>
            <p id="autolarisAreaHint" class="mt-1 text-xs text-slate-500">Hanya bila AutoLaris meminta area tertentu untuk akun Anda. Kosongkan untuk memakai area bawaan (pembayaran saja, courir 1, tanpa pengiriman).</p>
            <label class="mt-4 block text-xs font-semibold text-slate-700" for="autolarisShipperEmail">Email pengirim</label>
            <input id="autolarisShipperEmail" name="autolaris_shipper_email" type="email" autocomplete="off" aria-describedby="autolarisShipperHint" class="admin-input-flat mt-2 sm:text-sm" />
            <p id="autolarisShipperHint" class="mt-1 text-xs text-slate-500">Kosongkan untuk memakai email CS toko.</p>
          </details>
          <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3">
            <p class="text-xs font-semibold text-slate-700">URL webhook AutoLaris</p>
            <p id="autolarisWebhookState" class="mt-1 text-xs text-slate-500">Belum dibuat.</p>
            <output id="autolarisWebhookUrl" class="mt-2 hidden break-all rounded-lg bg-white px-2 py-1.5 font-mono text-xs text-slate-900"></output>
            <button id="issueWebhook" type="button" class="btn-secondary mt-2">Buat URL webhook baru</button>
            <p class="mt-1 text-xs text-slate-500">URL hanya tampil sekali dan khusus subdomain toko ini. Membuat yang baru mematikan URL lama.</p>
          </div>
        </fieldset>
      </div>

      <div class="flex flex-col-reverse items-stretch gap-3 rounded-xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between">
        <p id="saveStatus" class="min-h-5 text-xs font-semibold text-slate-500" role="status" aria-live="polite" aria-atomic="true">API key kosong tidak akan menghapus credential yang sudah aktif.</p>
        <button id="saveIntegrations" type="submit" class="btn-primary">Simpan Integrasi</button>
      </div>
    </form>

    </>}
  </div>

  <script>
    type Credential = { configured: boolean; api_key_masked: string; base_url: string; source: 'dashboard' | 'none' };
    type Credentials = {
      mengantar: Credential;
      autolaris: Credential & {
        order_origin_id: string;
        order_destination_id: string;
        shipper_email: string;
        webhook_issued_at: string | null;
      };
    };
    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const integrationsLoading = byId('integrationsLoading');
    let integrationsPending = false;
    let profilePending = false;

    const profileStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      const status = byId('profileStatus');
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-semibold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    const setProfilePending = (next: boolean) => {
      profilePending = next;
      const button = byId<HTMLButtonElement>('saveProfile');
      if (button) {
        button.disabled = next;
        button.textContent = next ? 'Menyimpan…' : 'Simpan Profil';
      }
      byId<HTMLFormElement>('profileForm')?.setAttribute('aria-busy', String(next));
    };

    const sourceLabel = (source: Credential['source']) => source === 'dashboard' ? 'Dashboard' : 'Belum aktif';
    const paintSource = (id: string, source: Credential['source']) => {
      const node = byId<HTMLSpanElement>(id);
      if (!node) return;
      node.textContent = sourceLabel(source);
      node.className = source === 'dashboard'
        ? 'rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-800'
        : 'rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600';
    };

    const showStatus = (message: string, state: 'idle' | 'success' | 'error') => {
      const status = byId('saveStatus');
      if (!status) return;
      status.setAttribute('role', state === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
      status.textContent = message;
      status.className = `min-h-5 text-xs font-semibold ${state === 'success' ? 'text-blue-700' : state === 'error' ? 'text-rose-700' : 'text-slate-500'}`;
    };

    const setPending = (next: boolean) => {
      integrationsPending = next;
      const button = byId<HTMLButtonElement>('saveIntegrations');
      if (button) {
        button.disabled = next;
        button.textContent = next ? 'Menyimpan…' : 'Simpan Integrasi';
      }
      byId<HTMLFormElement>('integrationsForm')?.setAttribute('aria-busy', String(next));
    };

    const setSecretVisibility = (input: HTMLInputElement | null, button: HTMLButtonElement | null, label: string, visible: boolean) => {
      if (!input || !button) return;
      input.type = visible ? 'text' : 'password';
      button.textContent = visible ? 'Sembunyikan' : 'Lihat';
      button.setAttribute('aria-label', `${visible ? 'Sembunyikan' : 'Tampilkan'} ${label}`);
      button.setAttribute('aria-pressed', String(visible));
    };

    const wireSecretToggle = (inputId: string, buttonId: string, label: string) => {
      const input = byId<HTMLInputElement>(inputId);
      const button = byId<HTMLButtonElement>(buttonId);
      button?.addEventListener('click', () => setSecretVisibility(input, button, label, input?.type === 'password'));
    };

    const render = (credentials: Credentials) => {
      const mengantarUrl = byId<HTMLInputElement>('mengantarUrl');
      const autolarisUrl = byId<HTMLInputElement>('autolarisUrl');
      const mengantarKey = byId<HTMLInputElement>('mengantarKey');
      const autolarisKey = byId<HTMLInputElement>('autolarisKey');
      const mengantarToggle = byId<HTMLButtonElement>('toggleMengantarKey');
      const autolarisToggle = byId<HTMLButtonElement>('toggleAutolarisKey');
      if (mengantarUrl) mengantarUrl.value = credentials.mengantar.base_url;
      if (autolarisUrl) autolarisUrl.value = credentials.autolaris.base_url;
      const setValue = (id: string, value: string) => { const input = byId<HTMLInputElement>(id); if (input) input.value = value; };
      setValue('autolarisOrigin', credentials.autolaris.order_origin_id);
      setValue('autolarisDestination', credentials.autolaris.order_destination_id);
      setValue('autolarisShipperEmail', credentials.autolaris.shipper_email);
      const webhookState = byId('autolarisWebhookState');
      if (webhookState) {
        const issued = credentials.autolaris.webhook_issued_at;
        webhookState.textContent = issued
          ? `Aktif sejak ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(new Date(issued))} WIB.`
          : 'Belum dibuat.';
      }
      if (mengantarKey) { mengantarKey.value = ''; mengantarKey.placeholder = credentials.mengantar.api_key_masked || 'Masukkan API key Mengantar'; }
      if (autolarisKey) { autolarisKey.value = ''; autolarisKey.placeholder = credentials.autolaris.api_key_masked || 'Masukkan API key AutoLaris'; }
      setSecretVisibility(mengantarKey, mengantarToggle, 'API key Mengantar', false);
      setSecretVisibility(autolarisKey, autolarisToggle, 'API key AutoLaris', false);
      paintSource('mengantarSource', credentials.mengantar.source);
      paintSource('autolarisSource', credentials.autolaris.source);
    };


    wireSecretToggle('mengantarKey', 'toggleMengantarKey', 'API key Mengantar');
    wireSecretToggle('autolarisKey', 'toggleAutolarisKey', 'API key AutoLaris');

    const loadIntegrations = async () => {
      const response = await fetch('/api/admin/settings', { headers: { Accept: 'application/json' } });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat konfigurasi API.');
      render(payload.data.credentials);
      integrationsLoading?.setAttribute('aria-busy', 'false');
      integrationsLoading?.classList.add('hidden');
      byId('integrationsForm')?.removeAttribute('inert');
      byId('integrationsForm')?.removeAttribute('data-pending');
    };

    const showIntegrationsError = (error: unknown) => {
      integrationsLoading?.setAttribute('aria-busy', 'false');
      integrationsLoading?.classList.add('hidden');
      byId('integrationsForm')?.classList.add('hidden');
      const node = byId('integrationsError');
      if (node) {
        node.textContent = error instanceof Error ? error.message : 'Gagal memuat konfigurasi API.';
        node.classList.remove('hidden');
      }
    };

    const loadProfile = async () => {
      const response = await fetch('/api/admin/profile', { headers: { Accept: 'application/json' } });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat profil admin.');
      const username = byId<HTMLInputElement>('profileUsername');
      if (username) username.value = payload.data.username;
      byId('defaultCredentialNotice')?.classList.toggle('hidden', !payload.data.must_change_password);
      byId('profileLoading')?.setAttribute('aria-busy', 'false');
      byId('profileLoading')?.classList.add('hidden');
      byId('profileForm')?.removeAttribute('inert');
      byId('profileForm')?.removeAttribute('data-pending');
      return Boolean(payload.data.must_change_password);
    };

    loadProfile().then((mustChangePassword) => {
      if (mustChangePassword) return;
      if (byId('integrationsForm')) loadIntegrations().catch(showIntegrationsError);
    }).catch((error) => {
      byId('profileLoading')?.setAttribute('aria-busy', 'false');
      byId('profileLoading')?.classList.add('hidden');
      byId('profileForm')?.classList.add('hidden');
      const node = byId('profileError');
      if (node) {
        node.textContent = error instanceof Error ? error.message : 'Gagal memuat profil admin.';
        node.classList.remove('hidden');
      }
      if (byId('integrationsForm')) showIntegrationsError(error);
    });

    byId<HTMLFormElement>('profileForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (profilePending || !form.reportValidity()) return;
      const values = new FormData(form);
      if (values.get('new_password') !== values.get('confirm_password')) {
        profileStatus('Konfirmasi password baru tidak sama.', 'error');
        byId<HTMLInputElement>('confirmPassword')?.focus();
        return;
      }
      setProfilePending(true);
      profileStatus('Menyimpan profil dan mengakhiri seluruh sesi…', 'idle');
      try {
        const response = await fetch('/api/admin/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: values.get('username'),
            current_password: values.get('current_password'),
            new_password: values.get('new_password'),
            confirm_password: values.get('confirm_password'),
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Profil admin gagal disimpan.');
        profileStatus(payload.message || 'Profil admin tersimpan. Silakan login kembali.', 'success');
        window.setTimeout(() => window.location.assign('/hello'), 900);
      } catch (error) {
        profileStatus(error instanceof Error ? error.message : 'Profil admin gagal disimpan.', 'error');
        setProfilePending(false);
      }
    });

    byId<HTMLButtonElement>('issueWebhook')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (button.disabled) return;
      button.disabled = true;
      showStatus('Membuat URL webhook…', 'idle');
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'issue-webhook-token' }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'URL webhook gagal dibuat.');
        render(payload.data.credentials);
        const output = byId('autolarisWebhookUrl');
        if (output) { output.textContent = payload.data.webhook_url; output.classList.remove('hidden'); }
        showStatus(payload.message || 'URL webhook dibuat.', 'success');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'URL webhook gagal dibuat.', 'error');
      } finally {
        button.disabled = false;
      }
    });

    byId<HTMLFormElement>('integrationsForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (integrationsPending || !form.reportValidity()) return;
      setPending(true);
      showStatus('Menyimpan konfigurasi…', 'idle');
      const values = new FormData(form);
      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'save-integrations',
            integrations: {
              mengantar_api_key: values.get('mengantar_clear_key') ? null : values.get('mengantar_api_key'),
              mengantar_base_url: values.get('mengantar_base_url'),
              autolaris_api_key: values.get('autolaris_clear_key') ? null : values.get('autolaris_api_key'),
              autolaris_base_url: values.get('autolaris_base_url'),
              autolaris_order_origin_id: values.get('autolaris_order_origin_id'),
              autolaris_order_destination_id: values.get('autolaris_order_destination_id'),
              autolaris_shipper_email: values.get('autolaris_shipper_email'),
            },
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Konfigurasi gagal disimpan.');
        render(payload.data.credentials);
        showStatus(payload.message || 'Konfigurasi integrasi tersimpan.', 'success');
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Konfigurasi gagal disimpan.', 'error');
      } finally {
        setPending(false);
      }
    });
  </script>
</AdminLayout>

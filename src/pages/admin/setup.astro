---
import { tenantDatabase } from '../../lib/tenant-database.ts';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import SetupChecklist from '../../components/admin/SetupChecklist.astro';
import { buildSetupChecklist, readSetupFacts } from '../../lib/setup-checklist';

export const prerender = false;

// UX-2 (T-38): owner and admin (ADMIN_PAGE_ROUTES). Every step is read live
// from the store's data, so a step just saved shows as done on reload.
const facts = await readSetupFacts(tenantDatabase(Astro.locals), Astro.locals);
const steps = facts ? buildSetupChecklist(facts) : null;
const host = Astro.locals.tenantContext?.primaryHost ?? Astro.locals.tenantContext?.host ?? null;
const storeUrl = host ? `${Astro.url.protocol}//${host}${Astro.url.port && !host.includes(':') ? `:${Astro.url.port}` : ''}` : null;
---

<AdminLayout title="Checklist setup" activeMenu="settings">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader
      title="Checklist setup toko"
      description="Langkah wajib membuka toko untuk pembeli. Status tiap langkah dibaca dari data toko."
    />
    {steps
      ? <SetupChecklist steps={steps} storeUrl={storeUrl} />
      : <p class="rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600" role="status">Checklist belum bisa dibaca. Muat ulang halaman sebentar lagi.</p>}
  </div>
</AdminLayout>

---
import OrdersPage from '../../../components/admin/OrdersPage.astro';

export const prerender = false;

const legacyStatus = Astro.url.searchParams.get('status') ?? Astro.url.searchParams.get('shipping_status');
if (legacyStatus === 'abandoned') {
  const target = new URL('/admin/orders/abandoned', Astro.url.origin);
  const search = Astro.url.searchParams.get('search');
  if (search) target.searchParams.set('search', search);
  return Astro.redirect(`${target.pathname}${target.search}`, 302);
}

// A hybrid store lists its physical orders here and its digital ones under
// /admin/orders/digital; a single-mode store lists every order here.
const mode = Astro.locals.tenant?.catalogMode ?? 'hybrid';
const page = mode === 'hybrid'
  ? { kind: 'physical', view: 'physical', title: 'Pesanan produk fisik', description: 'Validasi pembayaran, alamat, risiko RTS, kurir, dan gudang. Konfirmasi order yang siap agar masuk ke antrean Pengiriman.' }
  : mode === 'digital'
    ? { kind: 'all', view: 'digital', title: 'Pesanan', description: 'Pesanan produk digital: akses terbuka otomatis saat pembayaran lunas. Pantau pembayaran, akses pembeli, dan follow up lewat WhatsApp.' }
    : { kind: 'all', view: 'physical', title: 'Pesanan', description: 'Validasi pembayaran, alamat, risiko RTS, kurir, dan gudang. Konfirmasi order yang siap agar masuk ke antrean Pengiriman.' };
---

<OrdersPage {...(page as { kind: 'all' | 'physical'; view: 'physical' | 'digital'; title: string; description: string })} />

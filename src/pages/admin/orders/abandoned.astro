---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { AbandonedOrders } from '../../../components/admin/AbandonedOrders';
import { LEAD_RETENTION_DAYS } from '../../../lib/lead-follow-up';

export const prerender = false;
---

<AdminLayout title="Pesanan tertinggal" activeMenu="orders">
  <div class="space-y-5">
    <AdminPageHeader
      title="Pesanan tertinggal"
      description={`Follow up calon pembeli yang sudah mengisi nama dan WhatsApp, lalu lengkapi datanya ketika siap menjadi order. Data lead disimpan ${LEAD_RETENTION_DAYS} hari sebelum dihapus otomatis.`}
    >
      <a slot="actions" href="/admin/orders" class="btn-secondary">
        Lihat order
      </a>
    </AdminPageHeader>
    <AbandonedOrders initialQuery={Astro.url.search} operator={Astro.locals.admin?.username ?? ''} client:load />
  </div>
</AdminLayout>

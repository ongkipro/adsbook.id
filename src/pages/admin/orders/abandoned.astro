---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { AbandonedOrders } from '../../../components/admin/AbandonedOrders';
import { LEAD_RETENTION_DAYS } from '../../../lib/lead-follow-up';

export const prerender = false;

// A hybrid store's leads become two kinds of order, listed on two pages; the sidebar links both.
const splitByKind = Astro.locals.tenant?.catalogMode === 'hybrid';
---

<AdminLayout title="Pesanan tertinggal" activeMenu="orders">
  <div class="space-y-5">
    {/* Two headers rather than a conditional slot: a slot passed as `false` still
        counts as filled and leaves an empty actions box on a hybrid store. */}
    {splitByKind ? (
      <AdminPageHeader
        title="Pesanan tertinggal"
        description={`Calon pembeli produk fisik dan digital yang sudah mengisi nama dan WhatsApp. Lead fisik menjadi order COD di Produk fisik; lead digital menjadi order bayar di muka di Produk digital. Data lead disimpan ${LEAD_RETENTION_DAYS} hari sebelum dihapus otomatis.`}
      />
    ) : (
      <AdminPageHeader
        title="Pesanan tertinggal"
        description={`Follow up calon pembeli yang sudah mengisi nama dan WhatsApp, lalu lengkapi datanya ketika siap menjadi order. Data lead disimpan ${LEAD_RETENTION_DAYS} hari sebelum dihapus otomatis.`}
      >
        <a slot="actions" href="/admin/orders" class="btn-secondary">
          Lihat order
        </a>
      </AdminPageHeader>
    )}
    <AbandonedOrders initialQuery={Astro.url.search} operator={Astro.locals.admin?.username ?? ''} splitByKind={splitByKind} client:load />
  </div>
</AdminLayout>

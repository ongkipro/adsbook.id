---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SectionRailLayout from '../../components/admin/SectionRailLayout.astro';
import { ADS_RAIL_GROUPS } from '../../components/admin/section-rails';
import { GET as getAds } from '../api/admin/ads';

export const prerender = false;

type AdsOverviewData = {
  meta_pixel_id?: string;
  meta_capi_configured?: boolean;
  google_tag_manager_id?: string;
  google_ads_conversion_id?: string;
  google_ads_conversion_label?: string;
  tiktok?: {
    pixel_id?: string;
    access_token_configured?: boolean;
  };
  tiktok_outbox?: {
    pending?: number;
    failed?: number;
  };
};

let initial: AdsOverviewData | null = null;
try {
  const response = await getAds({
    locals: Astro.locals,
    url: Astro.url,
    request: Astro.request,
  } as Parameters<typeof getAds>[0]);
  const payload = (await response.json().catch(() => ({}))) as { success?: boolean; data?: AdsOverviewData };
  if (response.ok && payload.success && payload.data) {
    initial = payload.data;
  }
} catch (error) {
  console.error('admin-ads-initial-load', error instanceof Error ? error.message : 'unknown');
}

const metaReady = initial ? Boolean(initial.meta_pixel_id && initial.meta_capi_configured) : false;
const googleReady = initial ? Boolean(initial.google_tag_manager_id || (initial.google_ads_conversion_id && initial.google_ads_conversion_label)) : false;
const tiktok = initial?.tiktok ?? {};
const tiktokReady = initial ? Boolean(tiktok.pixel_id && tiktok.access_token_configured) : false;
const outbox = initial?.tiktok_outbox;
const tiktokOutboxText = initial
  ? (outbox ? (outbox.failed ? `${outbox.failed} gagal` : outbox.pending ? `${outbox.pending} menunggu` : 'Lancar') : 'Tidak terbaca')
  : 'Belum diperiksa';

const badgeClass = (ready: boolean) =>
  `min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center px-2.5 py-1 text-xs font-semibold ${
    initial
      ? (ready ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800')
      : 'bg-slate-100 text-slate-600'
  }`;
const badgeLabel = (ready: boolean) => (initial ? (ready ? 'Aktif' : 'Belum lengkap') : 'Memuat');
---

<AdminLayout title="Iklan & tracking" activeMenu="ads">
  <SectionRailLayout
    title="Iklan & tracking"
    description="Kelola Meta, Google, dan TikTok secara terpisah dengan status konfigurasi yang mudah diaudit."
    groups={ADS_RAIL_GROUPS}
    railLabel="Menu iklan & tracking"
    railId="ads"
    maxWidth="5xl"
  >
    <div id="adsLoading" class:list={['sr-only', initial && 'hidden']} role="status" aria-live="polite" aria-busy={initial ? 'false' : 'true'} aria-atomic="true">
      <span class="sr-only">Memuat status channel tracking.</span>
    </div>
    <div id="adsError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

    <section
      id="adsChannels"
      inert={!initial}
      data-pending={!initial ? '' : undefined}
      data-ssr-ready={initial ? '1' : undefined}
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-3"
      aria-label="Channel tracking"
    >
      <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 text-slate-950">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Meta</p>
            <h3 class="mt-1 text-base font-semibold text-slate-950">Pixel & Conversions API</h3>
          </div>
          <span id="metaBadge" class={badgeClass(metaReady)}>{badgeLabel(metaReady)}</span>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola Pixel browser, token server-side, dan test event dari halaman khusus Meta.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs">
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Pixel</dt>
            <dd id="pixelState" class="min-w-0 truncate font-semibold text-slate-900">{initial ? (initial.meta_pixel_id ? 'Aktif' : 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">CAPI token</dt>
            <dd id="capiState" class="min-w-0 truncate font-semibold text-slate-900">{initial ? (initial.meta_capi_configured ? 'Tersimpan' : 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
        </dl>
        <div class="mt-auto pt-5">
          <a href="/admin/ads/meta" class="btn-blue w-full sm:w-auto">Kelola Meta</a>
        </div>
      </article>

      <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 text-slate-950">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-amber-700">Google</p>
            <h3 class="mt-1 text-base font-semibold text-slate-950">Tag Manager & Ads</h3>
          </div>
          <span id="googleBadge" class={badgeClass(googleReady)}>{badgeLabel(googleReady)}</span>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola GTM ecommerce dan conversion action Purchase tanpa membuka konfigurasi Meta.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs">
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">GTM</dt>
            <dd id="googleTagManagerState" class="min-w-0 truncate font-mono font-semibold text-slate-900">{initial ? (initial.google_tag_manager_id || 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Conversion ID</dt>
            <dd id="googleIdState" class="min-w-0 truncate font-mono font-semibold text-slate-900">{initial ? (initial.google_ads_conversion_id || 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Label</dt>
            <dd id="googleLabelState" class="min-w-0 truncate font-mono font-semibold text-slate-900">{initial ? (initial.google_ads_conversion_label || 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
        </dl>
        <div class="mt-auto pt-5">
          <a href="/admin/ads/google" class="btn-secondary w-full sm:w-auto">Kelola Google</a>
        </div>
      </article>

      <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 text-slate-950">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-700">TikTok</p>
            <h3 class="mt-1 text-base font-semibold text-slate-950">Pixel & Events API</h3>
          </div>
          <span id="tiktokBadge" class={badgeClass(tiktokReady)}>{badgeLabel(tiktokReady)}</span>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola TikTok Pixel, token Events API, dan waktu konversi COD dari halaman khusus TikTok.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs">
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Pixel</dt>
            <dd id="tiktokPixelState" class="min-w-0 truncate font-mono font-semibold text-slate-900">{initial ? (tiktok.pixel_id || 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Events API</dt>
            <dd id="tiktokTokenState" class="min-w-0 truncate font-semibold text-slate-900">{initial ? (tiktok.access_token_configured ? 'Tersimpan' : 'Belum diisi') : 'Belum diperiksa'}</dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2">
            <dt class="shrink-0 font-semibold text-slate-500">Antrean</dt>
            <dd id="tiktokOutboxState" class="min-w-0 truncate font-semibold text-slate-900">{tiktokOutboxText}</dd>
          </div>
        </dl>
        <div class="mt-auto pt-5">
          <a href="/admin/ads/tiktok" class="btn-secondary w-full sm:w-auto">Kelola TikTok</a>
        </div>
      </article>
    </section>
  </SectionRailLayout>

  <script>
    const channels = document.getElementById('adsChannels');
    if (channels && channels.dataset.ssrReady !== '1') {
      const loading = document.getElementById('adsLoading');
      const errorBox = document.getElementById('adsError');
      const badge = (id: string, ready: boolean) => { const node = document.getElementById(id); if (!node) return; node.textContent = ready ? 'Aktif' : 'Belum lengkap'; node.className = `min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center px-2.5 py-1 text-xs font-semibold ${ready ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'}`; };
      const text = (id: string, value: string) => { const node = document.getElementById(id); if (node) node.textContent = value; };
      fetch('/api/admin/ads', { headers: { Accept: 'application/json' } }).then(async (response) => { const payload = await response.json().catch(() => ({})); if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat status tracking.'); return payload.data; }).then((data) => {
        const metaReady = Boolean(data.meta_pixel_id && data.meta_capi_configured);
        const googleReady = Boolean(data.google_tag_manager_id || (data.google_ads_conversion_id && data.google_ads_conversion_label));
        const tiktok = data.tiktok || {};
        const tiktokReady = Boolean(tiktok.pixel_id && tiktok.access_token_configured);
        badge('metaBadge', metaReady); badge('googleBadge', googleReady); badge('tiktokBadge', tiktokReady);
        text('tiktokPixelState', tiktok.pixel_id || 'Belum diisi');
        text('tiktokTokenState', tiktok.access_token_configured ? 'Tersimpan' : 'Belum diisi');
        const outbox = data.tiktok_outbox;
        text('tiktokOutboxState', outbox ? (outbox.failed ? `${outbox.failed} gagal` : outbox.pending ? `${outbox.pending} menunggu` : 'Lancar') : 'Tidak terbaca');
        text('pixelState', data.meta_pixel_id ? 'Aktif' : 'Belum diisi');
        text('capiState', data.meta_capi_configured ? 'Tersimpan' : 'Belum diisi');
        text('googleTagManagerState', data.google_tag_manager_id || 'Belum diisi');
        text('googleIdState', data.google_ads_conversion_id || 'Belum diisi');
        text('googleLabelState', data.google_ads_conversion_label || 'Belum diisi');
        loading?.setAttribute('aria-busy', 'false');
        loading?.classList.add('hidden');
        channels.removeAttribute('inert');
        channels.removeAttribute('data-pending');
      }).catch((error) => { loading?.setAttribute('aria-busy', 'false'); loading?.classList.add('hidden'); document.querySelectorAll('[data-pending]').forEach((el) => el.classList.add('hidden')); if (errorBox) { errorBox.textContent = error instanceof Error ? error.message : 'Gagal memuat status tracking.'; errorBox.classList.remove('hidden'); } });
    }
  </script>
</AdminLayout>

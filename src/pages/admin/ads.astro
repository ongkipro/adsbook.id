---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';

export const prerender = false;
---

<AdminLayout title="Iklan & tracking" activeMenu="ads">
  <div class="space-y-6">
    <AdminPageHeader
      title="Iklan & tracking"
      description="Kelola Meta, Google, dan TikTok secara terpisah dengan status konfigurasi yang mudah diaudit."
    />

    <div id="adsLoading" class="sr-only" role="status" aria-live="polite" aria-busy="true" aria-atomic="true"><span class="sr-only">Memuat status channel tracking.</span><div class="h-56 animate-pulse rounded-xl bg-slate-100 text-slate-950 shadow-sm"></div><div class="h-56 animate-pulse rounded-xl bg-slate-100 text-slate-950 shadow-sm"></div><div class="h-56 animate-pulse rounded-xl bg-slate-100 text-slate-950 shadow-sm"></div></div>
    <div id="adsError" class="hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-800" role="alert" aria-live="assertive"></div>

    <section id="adsChannels" inert data-pending class="grid grid-cols-1 gap-4 lg:grid-cols-3" aria-label="Channel tracking">
      <article class="rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm p-6">
        <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-sky-700">Meta</p><h3 class="mt-1 text-base font-semibold text-slate-950">Pixel & Conversions API</h3></div><span id="metaBadge" class="min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Memuat</span></div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola Pixel browser, token server-side, dan test event dari halaman khusus Meta.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs"><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Pixel</dt><dd id="pixelState" class="min-w-0 truncate font-semibold text-slate-900">Belum diperiksa</dd></div><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">CAPI token</dt><dd id="capiState" class="min-w-0 truncate font-semibold text-slate-900">Belum diperiksa</dd></div></dl>
        <a href="/admin/ads/meta" class="btn-blue mt-5 w-full sm:w-auto">Kelola Meta</a>
      </article>

      <article class="rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm p-6">
        <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-amber-700">Google</p><h3 class="mt-1 text-base font-semibold text-slate-950">Tag Manager & Ads</h3></div><span id="googleBadge" class="min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Memuat</span></div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola GTM ecommerce dan conversion action Purchase tanpa membuka konfigurasi Meta.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs"><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">GTM</dt><dd id="googleTagManagerState" class="min-w-0 truncate font-mono font-semibold text-slate-900">Belum diperiksa</dd></div><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Conversion ID</dt><dd id="googleIdState" class="min-w-0 truncate font-mono font-semibold text-slate-900">Belum diperiksa</dd></div><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Label</dt><dd id="googleLabelState" class="min-w-0 truncate font-mono font-semibold text-slate-900">Belum diperiksa</dd></div></dl>
        <a href="/admin/ads/google" class="btn-secondary mt-5 w-full sm:w-auto">Kelola Google</a>
      </article>

      <article class="rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm p-6">
        <div class="flex items-start justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wider text-slate-700">TikTok</p><h3 class="mt-1 text-base font-semibold text-slate-950">Pixel & Events API</h3></div><span id="tiktokBadge" class="min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">Memuat</span></div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Kelola TikTok Pixel, token Events API, dan waktu konversi COD dari halaman khusus TikTok.</p>
        <dl class="mt-5 grid grid-cols-1 gap-2 text-xs"><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Pixel</dt><dd id="tiktokPixelState" class="min-w-0 truncate font-mono font-semibold text-slate-900">Belum diperiksa</dd></div><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Events API</dt><dd id="tiktokTokenState" class="min-w-0 truncate font-semibold text-slate-900">Belum diperiksa</dd></div><div class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2"><dt class="shrink-0 font-semibold text-slate-500">Antrean</dt><dd id="tiktokOutboxState" class="min-w-0 truncate font-semibold text-slate-900">Belum diperiksa</dd></div></dl>
        <a href="/admin/ads/tiktok" class="btn-secondary mt-5 w-full sm:w-auto">Kelola TikTok</a>
      </article>
    </section>
  </div>

  <script>
    const loading = document.getElementById('adsLoading');
    const channels = document.getElementById('adsChannels');
    const errorBox = document.getElementById('adsError');
    const badge = (id: string, ready: boolean) => { const node = document.getElementById(id); if (!node) return; node.textContent = ready ? 'Aktif' : 'Belum lengkap'; node.className = `min-w-[6.75rem] shrink-0 whitespace-nowrap rounded-full text-center px-2.5 py-1 text-xs font-semibold ${ready ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800'}`; };
    const text = (id: string, value: string) => { const node = document.getElementById(id); if (node) node.textContent = value; };
    fetch('/api/admin/ads', { headers: { Accept: 'application/json' } }).then(async (response) => { const payload = await response.json().catch(() => ({})); if (!response.ok || !payload.success) throw new Error(payload.error || 'Gagal memuat status tracking.'); return payload.data; }).then((data) => {
      const metaReady = Boolean(data.meta_pixel_id && data.meta_capi_configured);
      const googleReady = Boolean(data.google_tag_manager_id || (data.google_ads_conversion_id && data.google_ads_conversion_label));
      const tiktok = data.tiktok || {};
      const tiktokReady = Boolean(tiktok.pixel_id && tiktok.access_token_configured);
      badge('metaBadge', metaReady); badge('googleBadge', googleReady); badge('tiktokBadge', tiktokReady);
      text('tiktokPixelState', tiktok.pixel_id || 'Belum diisi');
      text('tiktokTokenState', tiktok.access_token_configured ? 'Tersimpan' : 'Belum diisi');
      const outbox = data.tiktok_outbox;
      text('tiktokOutboxState', outbox ? (outbox.failed ? `${outbox.failed} gagal` : outbox.pending ? `${outbox.pending} menunggu` : 'Lancar') : 'Tidak terbaca');
      text('pixelState', data.meta_pixel_id ? 'Aktif' : 'Belum diisi');
      text('capiState', data.meta_capi_configured ? 'Tersimpan' : 'Belum diisi');
      text('googleTagManagerState', data.google_tag_manager_id || 'Belum diisi');
      text('googleIdState', data.google_ads_conversion_id || 'Belum diisi');
      text('googleLabelState', data.google_ads_conversion_label || 'Belum diisi');
      loading?.setAttribute('aria-busy', 'false');
      loading?.classList.add('hidden');
      channels?.removeAttribute('inert');
      channels?.removeAttribute('data-pending');
    }).catch((error) => { loading?.setAttribute('aria-busy', 'false'); loading?.classList.add('hidden'); document.querySelectorAll('[data-pending]').forEach((el) => el.classList.add('hidden')); if (errorBox) { errorBox.textContent = error instanceof Error ? error.message : 'Gagal memuat status tracking.'; errorBox.classList.remove('hidden'); } });
  </script>
</AdminLayout>

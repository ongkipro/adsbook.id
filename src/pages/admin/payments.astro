---
import SectionRailLayout from '../../components/admin/SectionRailLayout.astro';
import { PAYMENTS_RAIL_GROUPS } from '../../components/admin/section-rails';
import PaymentSettings from '../../components/admin/PaymentSettings';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPaymentChannelsList, loadPaymentSettingsInitial } from '../../lib/payment-settings-initial';

export const prerender = false;

const channels = getPaymentChannelsList();
const initial = await loadPaymentSettingsInitial(Astro);
---

<AdminLayout title="Metode pembayaran" activeMenu="payments">
  <SectionRailLayout
    title="Metode pembayaran"
    description="Aktifkan metode pembayaran utama di checkout dan pantau kesiapan integrasi AutoLaris."
    groups={PAYMENTS_RAIL_GROUPS}
    railLabel="Menu pembayaran"
    railId="payments"
    maxWidth="4xl"
  >
    <PaymentSettings client:load channels={channels} initial={initial} view="methods" />
  </SectionRailLayout>
</AdminLayout>

---
import { ProductForm } from '../../../components/admin/ProductForm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { tenantDatabase } from '../../../lib/tenant-database.ts';
import { physicalProductGuide, readSetupFacts } from '../../../lib/setup-checklist';
export const prerender = false;

// ONBOARDING-BANK-WAREHOUSE-SPEC §3.1: what a physical product still waits on.
const setupGuide = Astro.locals.tenant.catalogMode === 'digital' ? null : physicalProductGuide(await readSetupFacts(tenantDatabase(Astro.locals), Astro.locals));
---

<AdminLayout title="Tambah produk" activeMenu="products">
  <div class="space-y-5">
    <AdminPageHeader
      title="Tambah produk"
      description="Simpan identitas produk, storefront, SKU, harga, berat, dan stok dalam satu operasi."
      backHref="/admin/products"
      backLabel="Katalog produk"
    />
    <ProductForm storeName={Astro.locals.tenant.name} catalogMode={Astro.locals.tenant.catalogMode} setupGuide={setupGuide} client:load />
  </div>
</AdminLayout>

---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../../components/admin/AdminPageHeader.astro';
import { ThemeHomeSettings } from '../../../../components/admin/ThemeHomeSettings';
import { BUILT_IN_STOREFRONT_TEMPLATES } from '../../../../lib/storefront-template';
export const prerender = false;

// Admin › Tema › Atur beranda (owner, 2026-11-24: simpler): one editor for
// the homepage sections, the hero picture and the accent. The draft/publish
// banner editor (R1b) stays only on the advanced /admin/content pages.
const themeName = BUILT_IN_STOREFRONT_TEMPLATES.find((theme) => theme.id === Astro.locals.tenant.storefrontTemplate)?.name ?? 'Tema toko';
---

<AdminLayout title={`Atur beranda · ${themeName}`} activeMenu="theme">
  <div class="space-y-6">
    <AdminPageHeader
      title="Atur beranda"
      description="Susun beranda toko Anda. Pembeli melihat perubahan setelah Anda menekan Simpan."
      backHref="/admin/settings/theme"
      backLabel="Tema"
    />
    <ThemeHomeSettings client:load />
  </div>
</AdminLayout>

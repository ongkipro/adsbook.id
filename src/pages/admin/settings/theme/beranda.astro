---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../../components/admin/AdminPageHeader.astro';
import { HomeBannerEditor } from '../../../../components/admin/HomeBannerEditor';
import { ThemeHomeSettings } from '../../../../components/admin/ThemeHomeSettings';
import { BUILT_IN_STOREFRONT_TEMPLATES } from '../../../../lib/storefront-template';
export const prerender = false;

// Admin › Tema › Atur beranda: the banner (R1b editor) and the active theme's
// homepage settings (sections, catalogue heading, accent).
const themeName = BUILT_IN_STOREFRONT_TEMPLATES.find((theme) => theme.id === Astro.locals.tenant.storefrontTemplate)?.name ?? 'Tema toko';
---

<AdminLayout title={`Atur beranda · ${themeName}`} activeMenu="theme">
  <div class="space-y-6">
    <AdminPageHeader
      title="Atur beranda"
      description={`Tema ${themeName}. Perubahan tampil di toko setelah disimpan.`}
      backHref="/admin/settings/theme"
      backLabel="Tema"
    />
    <HomeBannerEditor client:load storeName={Astro.locals.tenant.name} />
    <ThemeHomeSettings client:load />
  </div>
</AdminLayout>

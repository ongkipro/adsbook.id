---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SectionRailLayout from '../../../components/admin/SectionRailLayout.astro';
import { CHECK_RAIL_GROUPS } from '../../../components/admin/section-rails';
import RateCheckTools from '../../../components/admin/RateCheckTools';

export const prerender = false;

const initialResi = (Astro.url.searchParams.get('q') || Astro.url.searchParams.get('cnote') || '').trim();
---
<AdminLayout title="Cek resi" activeMenu="scoring">
  <SectionRailLayout
    title="Cek resi"
    description="Lacak status pengiriman terkini dan riwayat perjalanan paket memakai nomor resi atau nomor invoice pesanan."
    groups={CHECK_RAIL_GROUPS}
    railLabel="Menu pengecekan"
    railId="check"
    maxWidth="full"
  >
    <RateCheckTools
      client:load
      mode="resi"
      defaultOrigin={null}
      warehouseName=""
      initialResi={initialResi}
    />
  </SectionRailLayout>
</AdminLayout>

---
import LandingPageCatalog from '../../../components/admin/LandingPageCatalog';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminSubnavTabs from '../../../components/admin/AdminSubnavTabs.astro';
import { listLandingPages } from '../../../lib/landing-pages';

export const prerender = false;

// The list GET /api/admin/landing-pages answers, drawn on the server so the
// catalogue does not open on a spinner. JSON round trip: the island receives
// exactly what the API would send. A failure leaves the island to fetch it.
let initialPages: unknown[] | undefined;
try {
  initialPages = JSON.parse(JSON.stringify(await listLandingPages(Astro.locals)));
} catch (error) {
  console.error('admin-landing-pages-initial-load', error);
}
---

<AdminLayout title="Landing page" activeMenu="products">
  <div class="space-y-5">
    <AdminPageHeader
      title="Landing page"
      description="Builder native landing page untuk marketing dan promosi."
    />
    <AdminSubnavTabs
      label="Bagian katalog"
      items={[
        { href: '/admin/products', label: 'Produk & varian' },
        { href: '/admin/landing-pages', label: 'Landing page' },
      ]}
    />
    <LandingPageCatalog initialPages={initialPages as never} client:load />
  </div>
</AdminLayout>

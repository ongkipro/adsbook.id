---
import { tenantDatabase } from '../lib/tenant-database.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactMarketHome from '../components/storefront/templates/CompactMarketHome.astro';
import { getStorefrontProducts } from '../lib/catalog';
import { decideBannerPreview, getTenantHomeContent, seedHomeContent, type BannerPreview } from '../lib/tenant-content';
import { resolveAdminSession } from '../lib/admin-session';
import { resolveAuthSecret } from '../lib/auth-secret';
import { resolveStorefrontTemplate } from '../lib/storefront-template';
import { dailySeed, heroSummary, pickHeroProducts } from '../lib/daily-rotation';
import { homeDescription, homeTitle } from '../lib/home-seo';
import { storefrontImageSrc } from '../lib/image-derivative';
import { getStorePublicFacts, storefrontTrustSignals } from '../lib/public-store';
import { checkAccent, howToOrderSteps, liveAnnouncement, loadThemeSettings, parseThemeSettingsInput, pickProductsById, sortCatalog, type StoreThemeSettings } from '../lib/storefront-theme';
import { canAccessAdminRoute } from '../lib/auth';

const database = tenantDatabase(Astro.locals);
// R1b banner preview: only `?preview=banner` reads the session and the content
// row; every other request renders exactly as before.
let bannerPreview: BannerPreview = { granted: false };
if (Astro.url.searchParams.get('preview') === 'banner' && database && typeof database === 'object') {
  const db = database as D1Database;
  const session = await resolveAdminSession(db, Astro.request, await resolveAuthSecret(db, Astro.locals.tenantContext?.tenantId));
  const row = session
    ? await db
        .prepare("SELECT version, draft_json, published_json FROM storefront_content WHERE content_key = 'home' LIMIT 1")
        .first<{ version: number; draft_json: string | null; published_json: string | null }>()
    : null;
  bannerPreview = decideBannerPreview({
    session,
    op: Astro.url.searchParams.get('op'),
    version: Astro.url.searchParams.get('v'),
    row,
    seed: seedHomeContent(Astro.locals.tenant),
  });
}
// Admin › Tema › Atur beranda live preview: `?preview=home&s=<base64url JSON>`
// renders unsaved settings, for a signed-in owner or admin only, in the
// editor's same-origin frame (middleware allows `frame-ancestors 'self'` for
// this URL alone). Anyone else gets the ordinary page: the settings are read
// only behind the session check.
let homePreview: { settings: StoreThemeSettings; accent: string | null } | null = null;
if (Astro.url.searchParams.get('preview') === 'home' && database && typeof database === 'object') {
  const db = database as D1Database;
  const session = await resolveAdminSession(db, Astro.request, await resolveAuthSecret(db, Astro.locals.tenantContext?.tenantId));
  if (session && !session.mustChangePassword && canAccessAdminRoute(session.role, '/admin/settings/theme')) {
    try {
      const raw = Astro.url.searchParams.get('s') ?? '';
      const json = new TextDecoder().decode(Uint8Array.from(atob(raw.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0)));
      const parsed = parseThemeSettingsInput(JSON.parse(json));
      const accent = checkAccent(Astro.url.searchParams.get('accent') ?? '');
      if (parsed.ok) homePreview = { settings: parsed.settings, accent: accent.ok ? accent.accent : null };
    } catch {
      homePreview = null;
    }
  }
}
if (bannerPreview.granted || homePreview) {
  // For the signed-in operator alone: never stored by any cache, never indexed.
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
const [catalog, homeResolution, templateResolution, publicFacts, themeSettings] = await Promise.all([
  getStorefrontProducts(Astro.locals),
  getTenantHomeContent(Astro.locals, bannerPreview.granted ? bannerPreview.published ?? undefined : undefined),
  resolveStorefrontTemplate(
    database && typeof database === 'object' ? database as D1Database : undefined,
    Astro.locals.tenant.storefrontTemplate,
  ),
  getStorePublicFacts(Astro.locals),
  homePreview ? Promise.resolve(homePreview.settings) : loadThemeSettings(database && typeof database === 'object' ? (database as D1Database) : undefined),
]);
const home = themeSettings.sections;
// admin › Tema: the trust strip and the banner can be switched off; the
// catalogue heading is the store's own.
const trustSignals = home.trust.enabled ? storefrontTrustSignals(publicFacts) : [];
const toCard = (product: (typeof catalog)[number]) => ({
  slug: product.slug,
  name: product.productName,
  category: product.category,
  description: product.subheadline || product.description,
  href: `/produk/${product.slug}`,
  image: product.image,
  price: product.price,
  comparePrice: product.comparePrice,
  ratingValue: product.ratingValue,
  reviewCount: product.reviewCount,
  soldCount: product.soldCount,
  variants: product.variants.map((variant) => ({
    label: variant.label,
    price: variant.price,
  })),
});
const products = sortCatalog(catalog.map(toCard), home.catalog.sort);
const ready = homeResolution.state === 'ready' && templateResolution.state === 'ready';
const unavailable = homeResolution.state === 'unavailable' || templateResolution.state !== 'ready';
const content = homeResolution.state === 'ready' ? homeResolution.content : null;
const template = templateResolution.state === 'ready' ? templateResolution.definition : null;
if (unavailable) Astro.response.status = 503;
const homepageTitle = ready
  ? homeTitle(Astro.locals.tenant.name, Astro.locals.tenant.tagline || Astro.locals.tenant.description)
  : `Storefront ${Astro.locals.tenant.name}`;
const homepageDescription = homeDescription(
  Astro.locals.tenant.description,
  products.map((product) => product.category),
);
// The hero's slides, resolved HERE rather than inside CompactMarketHome, so
// the preload below names the image the hero will actually render. When the
// operator has no slides of their own the hero borrows a daily rotation from
// the catalogue — a fallback the old `content.heroSlides[0]` preload could
// not see, which left four of the six installs' LCP image unpreloaded. The
// pick rotates daily rather than per request so visitors reuse cached bytes.
// Owner, 2026-11-23: three to five catalogue products, each with a line of
// its own description, linking to its page.
// Admin › Tema › Hero: "auto" rotates 3–5 products daily (a banner published
// earlier through Konten & media still leads, so no store loses its picture);
// "products" is the seller's pick in their order; "banner" is the picture
// they uploaded on Atur beranda, falling back to the rotation without one.
const productSlide = (product: (typeof catalog)[number]) => ({
  image: product.image,
  alt: product.productName,
  badge: product.category,
  text: product.productName,
  summary: home.hero.summary ? heroSummary(product.catalogDescription || product.description) : '',
  href: `/produk/${product.slug}`,
});
const autoSlides = () => pickHeroProducts(catalog, dailySeed(new Date())).map(productSlide);
const legacyBanner = content && content.heroSlides.length > 0 ? content.heroSlides : null;
const ownBanner = home.hero.banner.image
  ? [{ image: home.hero.banner.image, alt: home.hero.banner.alt, badge: '', text: home.hero.banner.text, summary: '', href: home.hero.banner.href || undefined }]
  : null;
const pickedSlides = home.hero.source === 'products' ? pickProductsById(catalog, home.hero.productIds).map(productSlide) : [];
const heroSlides = !home.hero.enabled
  ? []
  : home.hero.source === 'banner' && ownBanner
    ? ownBanner
    : home.hero.source === 'products' && pickedSlides.length > 0
      ? pickedSlides
      : home.hero.source === 'auto' && legacyBanner
        ? legacyBanner
        : autoSlides();
const featuredProducts = home.featured.enabled ? pickProductsById(catalog, home.featured.productIds).map(toCard) : [];
const layout = {
  order: themeSettings.order,
  announcement: liveAnnouncement(themeSettings, new Date()),
  featured: featuredProducts.length > 1 ? { title: home.featured.title, products: featuredProducts } : null,
  howToOrder: home.howToOrder.enabled ? howToOrderSteps(publicFacts) : null,
  categories: home.catalog.categories,
};
const itemList = {
  name: `${Astro.locals.tenant.name} — Koleksi Produk pilihan`,
  items: products.map((p) => ({
    name: p.name,
    url: p.href,
    image: p.image,
    price: p.price,
    description: p.description,
  })),
};
---

<BaseLayout
  title={homepageTitle}
  description={homepageDescription}
  image={heroSlides[0]?.image || undefined}
  preloadImages={heroSlides[0]?.image
    ? storefrontImageSrc(heroSlides[0].image)
    : undefined}
  itemList={ready ? itemList : undefined}
  noindex={bannerPreview.granted || Boolean(homePreview)}
  buyerTracking={!bannerPreview.granted && !homePreview}
  accentOverride={homePreview?.accent ?? undefined}
>
  {bannerPreview.granted && (
    <div role="status" data-banner-preview class="sticky top-0 z-50 border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm text-amber-950">
      {bannerPreview.notice ?? 'Pratinjau banner: belum terlihat pembeli.'}{' '}
      <a href="/admin/settings/theme/beranda" class="font-semibold underline underline-offset-2">Kembali ke Atur beranda</a>
    </div>
  )}
  {
      unavailable || !content || !template ? (
      <section class="mx-auto flex min-h-[70vh] max-w-2xl items-center px-6 py-20 text-center">
        <div class="w-full rounded-sf-lg border border-slate-200 bg-white p-8 md:p-12" role="alert">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-600">Storefront tidak tersedia</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Halaman belum dapat ditampilkan</h1>
          <p class="mx-auto mt-4 max-w-lg text-sm leading-7 text-slate-600">
            Konfigurasi storefront sedang tidak dapat dibaca. Silakan coba lagi beberapa saat lagi.
          </p>
          <a href="/" class="mt-6 inline-flex min-h-11 items-center justify-center rounded-sf-lg border border-slate-300 bg-white px-5 text-sm font-bold text-slate-800 hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-950">
            Coba lagi
          </a>
        </div>
      </section>
    ) : (
      <CompactMarketHome content={content} products={products} heroSlides={heroSlides} sections={{ ...template.composition.sections, hero: template.composition.sections.hero && home.hero.enabled }} trustSignals={trustSignals} catalogHeading={{ ...content.catalog, title: home.catalog.title, description: home.catalog.description }} layout={layout} />
    )
  }
</BaseLayout>

---
import PlatformLayout from '../../../components/platform/PlatformLayout.astro';
import { getRuntimeEnv } from '../../../lib/env';
import { ACTION_ROLES, tenantDetail } from '../../../platform/admin/tenants';
import { billingState } from '../../../platform/billing';
export const prerender = false;

// UX-4: one tenant's hosts, events and health, and the actions its role allows.
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const detail = await tenantDetail(platformDb, String(Astro.params.id ?? ''));
if (!detail) return Astro.redirect('/platform');
const role = Astro.locals.platformUser?.role ?? 'platform_support';
const may = (action: keyof typeof ACTION_ROLES) => ACTION_ROLES[action].includes(role);
const tenant = detail.tenant as Record<string, string | number | null>;
const time = (iso: unknown) => (typeof iso === 'string' ? new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(new Date(iso)) : '—');
const BILLING_LABELS = { preview: 'Mode Preview', subscribed: 'Aktif', grace: 'Masa tenggang', expired: 'Berakhir' } as const;
const plans = (await platformDb.prepare('SELECT id FROM plans ORDER BY id').all<{ id: string }>()).results;
---
<PlatformLayout title={String(tenant.slug)} active="tenants">
  <a href="/platform" class="text-sm font-semibold text-blue-700 underline">← Semua tenant</a>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <h1 class="text-xl font-semibold text-slate-950">{tenant.slug}</h1>
    <span id="tenantStatus" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">{tenant.status}</span>
  </div>
  <dl class="mt-3 grid grid-cols-1 gap-2 text-sm sm:grid-cols-3">
    <div><dt class="text-xs text-slate-500">Owner</dt><dd class="break-all font-semibold">{tenant.owner_email}{tenant.owner_whatsapp ? ` · ${tenant.owner_whatsapp}` : ''}</dd></div>
    <div><dt class="text-xs text-slate-500">Owner</dt><dd class="break-all font-semibold">{tenant.owner_email}{tenant.owner_whatsapp ? ` · ${tenant.owner_whatsapp}` : ''}</dd></div>
    <div><dt class="text-xs text-slate-500">Owner</dt><dd class="break-all font-semibold">{tenant.owner_email}{tenant.owner_whatsapp ? ` · ${tenant.owner_whatsapp}` : ''}</dd></div>
    <div><dt class="text-xs text-slate-500">Paket</dt><dd class="font-semibold">{tenant.plan_id}</dd></div>
    <div><dt class="text-xs text-slate-500">Dibuat</dt><dd class="font-semibold">{time(tenant.created_at)}</dd></div>
    <div><dt class="text-xs text-slate-500">Dihapus setelah</dt><dd class="font-semibold">{time(tenant.purge_after)}</dd></div>
    <div><dt class="text-xs text-slate-500">Langganan</dt><dd class="font-semibold" id="subscriptionState">{Number(tenant.is_demo) === 1 ? 'toko contoh' : BILLING_LABELS[billingState({ subscriptionEndsAt: tenant.subscription_ends_at as string | null, graceEndsAt: tenant.grace_ends_at as string | null }, new Date())]}</dd></div>
    <div><dt class="text-xs text-slate-500">Aktif sampai</dt><dd class="font-semibold">{time(tenant.subscription_ends_at)}</dd></div>
  </dl>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="actionsTitle" data-tenant={String(tenant.id)} id="actions">
    <h2 id="actionsTitle" class="font-semibold text-slate-950">Aksi</h2>
    <p id="actionStatus" class="mt-2 min-h-5 text-sm font-semibold" role="status" aria-live="polite"></p>
    <div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {tenant.status === 'active' && may('suspend') && (
        <form data-action="suspend" class="space-y-2">
          <label for="suspendReason" class="block text-xs font-semibold text-slate-700">Alasan penangguhan</label>
          <input id="suspendReason" name="reason" required minlength="3" class="admin-input-flat" />
          <button type="submit" class="btn-secondary text-rose-700">Tangguhkan</button>
        </form>
      )}
      {tenant.status === 'suspended' && may('resume') && (
        <form data-action="resume" class="space-y-2">
          <label for="resumeReason" class="block text-xs font-semibold text-slate-700">Alasan mengaktifkan kembali</label>
          <input id="resumeReason" name="reason" required minlength="3" class="admin-input-flat" />
          <button type="submit" class="btn-primary">Aktifkan kembali</button>
        </form>
      )}
      {may('plan') && (
        <form data-action="plan" class="space-y-2">
          <label for="plan" class="block text-xs font-semibold text-slate-700">Paket</label>
          <select id="plan" name="plan" class="admin-input-flat">{plans.map((plan) => <option value={plan.id} selected={plan.id === tenant.plan_id}>{plan.id}</option>)}</select>
          <button type="submit" class="btn-secondary">Ubah paket</button>
        </form>
      )}
      {may('grant-subscription') && tenant.status === 'active' && (
        <form data-action="grant-subscription" class="space-y-2">
          <label for="grantDays" class="block text-xs font-semibold text-slate-700">Beri hari langganan (BILL-7, tercatat di riwayat)</label>
          <input id="grantDays" name="days" type="number" inputmode="numeric" required min="1" max="730" value="30" class="admin-input-flat" />
          <label for="grantReason" class="block text-xs font-semibold text-slate-700">Alasan</label>
          <input id="grantReason" name="reason" required minlength="5" maxlength="300" class="admin-input-flat" placeholder="Contoh: pilot Saraku" />
          <button type="submit" class="btn-secondary">Beri langganan</button>
        </form>
      )}
      {may('recover') && tenant.status === 'active' && (
        <form data-action="recover" class="space-y-2">
          <label for="evidence" class="block text-xs font-semibold text-slate-700">Ringkasan verifikasi pemilik (tanpa salinan dokumen)</label>
          <textarea id="evidence" name="evidence" required minlength="10" rows="2" class="admin-input-flat"></textarea>
          <button type="submit" class="btn-secondary">Buat kode pemulihan owner</button>
          <output id="recoveryToken" class="hidden block break-all rounded-lg bg-slate-50 p-2 font-mono text-xs"></output>
        </form>
      )}
      {may('purge-request') && !tenant.purge_after && tenant.status !== 'purged' && (
        <form data-action="purge-request" class="space-y-2">
          <label for="purgeSlug" class="block text-xs font-semibold text-slate-700">Ketik <strong>{tenant.slug}</strong> untuk menjadwalkan penghapusan (30 hari)</label>
          <input id="purgeSlug" name="slug" required class="admin-input-flat" autocomplete="off" />
          <button type="submit" class="btn-secondary text-rose-700">Jadwalkan penghapusan</button>
        </form>
      )}
    </div>
  </section>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="hostsTitle">
    <h2 id="hostsTitle" class="font-semibold text-slate-950">Host</h2>
    <ul class="mt-2 space-y-1 text-sm">
      {(detail.hosts as Array<Record<string, unknown>>).map((host) => (
        <li class="break-all"><span class="font-mono">{String(host.host)}</span> · {String(host.kind)} · {String(host.status)}{host.is_primary === 1 ? ' · utama' : ''}</li>
      ))}
    </ul>
    <h2 class="mt-5 font-semibold text-slate-950">Kesehatan</h2>
    <p class="mt-1 text-sm">Heartbeat: {time((detail.health as Record<string, unknown> | null)?.heartbeat_at)} · backlog {String((detail.health as Record<string, unknown> | null)?.outbox_backlog ?? 0)}{(detail.health as Record<string, unknown> | null)?.last_error ? ` · error terakhir: ${String((detail.health as Record<string, unknown>).last_error)}` : ''}</p>
  </section>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="eventsTitle">
    <h2 id="eventsTitle" class="font-semibold text-slate-950">Riwayat</h2>
    <ol class="mt-2 space-y-2 text-sm">
      {(detail.events as Array<Record<string, unknown>>).map((event) => (
        <li><span class="font-semibold">{String(event.kind)}</span> · {time(event.at)} · <span class="text-slate-500">{String(event.actor)}</span></li>
      ))}
    </ol>
  </section>

  <script>
    const section = document.getElementById('actions') as HTMLElement;
    const status = document.getElementById('actionStatus') as HTMLElement;
    for (const form of section.querySelectorAll<HTMLFormElement>('form[data-action]')) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector('button');
        if (button) button.disabled = true;
        const values = Object.fromEntries(new FormData(form));
        try {
          const response = await fetch(`/api/platform/tenants/${section.dataset.tenant}/${form.dataset.action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(values),
          });
          const payload = await response.json().catch(() => ({}));
          status.className = `mt-2 min-h-5 text-sm font-semibold ${payload.success ? 'text-blue-700' : 'text-rose-700'}`;
          status.textContent = payload.success ? payload.message : payload.error || 'Aksi gagal.';
          if (payload.success && payload.data?.recovery_token) {
            const output = document.getElementById('recoveryToken');
            if (output) { output.textContent = `Kode untuk owner (sekali tampil, 24 jam): ${payload.data.recovery_token}. Owner membukanya di /pemulihan pada subdomain tokonya.`; output.classList.remove('hidden'); }
          } else if (payload.success) {
            window.setTimeout(() => window.location.reload(), 600);
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    }
  </script>
</PlatformLayout>

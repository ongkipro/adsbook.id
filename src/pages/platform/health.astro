---
import PlatformLayout from '../../components/platform/PlatformLayout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { platformHealth } from '../../platform/admin/health';
export const prerender = false;

const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const health = await platformHealth(platformDb);
const time = (iso: string | null) => (iso ? new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(new Date(iso)) : 'belum ada');
---
<PlatformLayout title="Kesehatan" active="health">
  <h1 class="text-xl font-semibold text-slate-950">Kesehatan platform</h1>
  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold">Tenant per status</h2>
      <ul class="mt-2 text-sm">{health.statuses.map((row) => <li>{row.status}: <strong>{row.n}</strong></li>)}</ul></section>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold">Domain sendiri</h2>
      <ul class="mt-2 text-sm">{health.customHostnames.length ? health.customHostnames.map((row) => <li>{row.status}: <strong>{row.n}</strong></li>) : <li>Belum ada.</li>}</ul></section>
    <section id="staleHeartbeats" class="rounded-xl border border-rose-200 bg-white p-5 shadow-sm"><h2 class="font-semibold text-rose-800">Heartbeat lebih dari 2 jam</h2>
      <ul class="mt-2 text-sm">{health.staleHeartbeats.length ? health.staleHeartbeats.map((row) => <li><a class="font-semibold text-blue-700 underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a> · {time(row.heartbeat_at)}{row.last_error ? ` · ${row.last_error}` : ''}</li>) : <li>Semua tenant aktif sehat.</li>}</ul></section>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold">Recovery dan backlog</h2>
      <ul class="mt-2 text-sm">
        {health.recovery.map((row) => <li>recovery: <a class="font-semibold text-blue-700 underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
        {health.backlog.map((row) => <li>backlog {row.outbox_backlog}: <a class="font-semibold text-blue-700 underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
        {health.unresolvedRecoveries.map((row) => <li class="text-rose-800">pemulihan owner tanpa hasil: <a class="font-semibold text-blue-700 underline" href={`/platform/tenants/${row.tenant_id}`}>{row.slug ?? row.tenant_id}</a> · {time(row.at)}</li>)}
        {!health.recovery.length && !health.backlog.length && !health.unresolvedRecoveries.length && <li>Tidak ada.</li>}
      </ul></section>
  </div>
  <p class="mt-4 text-xs text-slate-500">Tingkat error Worker dan jumlah 404/503 gate: Workers Logs (baris <code>event: request</code> per permintaan) dan analitik dashboard Cloudflare. Diperiksa {time(health.checkedAt)}.</p>
</PlatformLayout>

---
import SiteLayout from '../../platform/site/SiteLayout.astro';
import AuthSplit from '../../platform/site/AuthSplit.astro';
import { RESET_PAGE } from '../../platform/site/site.ts';
import { getRuntimeEnv } from '../../lib/env';

export const prerender = false;

// "Lupa password" for a store owner (src/platform/owner-reset.ts): step 1 mails an
// 8-digit code to the owner email, step 2 takes the code and the new password. The
// challenge id lives in a script variable only (never the URL, storage or a cookie).
// Staff are pointed to their owner. The page is the same for every visitor.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const siteKey = typeof env.TURNSTILE_SITE_KEY === 'string' ? env.TURNSTILE_SITE_KEY : '';
const localStandIn = siteKey === 'local-stand-in';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<SiteLayout page={RESET_PAGE} authStage>
  <AuthSplit active="masuk">
    <div class="card-head">
      <h1 class="dot-end">Lupa password</h1>
      <p id="resetLead">Masukkan email pemilik toko. Kami kirim kode 8 digit untuk membuat password baru.</p>
    </div>

    <div id="resetError" class="error-banner" hidden role="alert" tabindex="-1"></div>

    <form
      id="resetForm"
      class="reset-form"
      method="post"
      novalidate
      aria-busy="false"
      data-step="1"
      data-standin={localStandIn ? '1' : ''}
      data-sitekey={localStandIn ? '' : siteKey}
    >
      <div class="field">
        <label for="resetEmail">Email pemilik toko</label>
        <input
          id="resetEmail"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          inputmode="email"
          placeholder="nama@email.com"
          aria-describedby="resetEmail-error"
          data-msg-missing="Masukkan email pemilik toko."
          data-msg-invalid="Masukkan email yang valid."
        />
        <p id="resetEmail-error" class="field-error" hidden></p>
      </div>

      <div id="codeStep" class="code-step" hidden>
        <p id="sentNote" class="sent-note" role="status" tabindex="-1"></p>
        <div class="field">
          <label for="resetCode">Kode dari email</label>
          <input
            id="resetCode"
            name="email_code"
            type="text"
            class="code-input"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{8}"
            maxlength="8"
            placeholder="8 digit"
            aria-describedby="resetCode-error"
          />
          <p id="resetCode-error" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="resetPassword">Password baru</label>
          <div class="password-box">
            <input
              id="resetPassword"
              name="password"
              type="password"
              maxlength="128"
              autocomplete="new-password"
              placeholder="Minimal 10 karakter"
              aria-describedby="resetPassword-hint resetPassword-error"
            />
            <button id="resetTogglePassword" type="button" class="toggle-pw" aria-controls="resetPassword" aria-pressed="false">Lihat</button>
          </div>
          <p id="resetPassword-hint" class="field-hint">10–128 karakter, tidak sama dengan email.</p>
          <p id="resetPassword-error" class="field-error" hidden></p>
        </div>
        <p class="code-links">
          <button id="resendCode" type="button" class="link-btn">Kirim ulang kode</button>
          <button id="changeEmail" type="button" class="link-btn">Ganti email</button>
        </p>
      </div>

      <button id="resetSubmit" type="submit" class="submit-btn">Kirim kode →</button>
      <p id="securityStatus" class="security-line" data-state={localStandIn || !siteKey ? 'ok' : 'pending'} aria-live="polite" hidden={!siteKey || localStandIn}></p>
    </form>

    {siteKey && !localStandIn && <div id="turnstileWidget" class="turnstile-slot"></div>}

    <div id="resetDone" class="done-card" hidden role="status" tabindex="-1">
      <strong>Password berhasil diganti</strong>
      <p>Semua sesi lama di toko Anda sudah dikeluarkan. Silakan masuk dengan password baru.</p>
      <a class="submit-btn as-link" href="/masuk">Masuk ke Dashboard →</a>
    </div>

    <p class="staff-help"><strong>Anda staf toko?</strong> Minta pemilik toko mengganti password Anda di <em>Pengaturan › Akses Pengguna</em>.</p>

    <p class="card-foot"><a href="/masuk">← Kembali ke halaman masuk</a></p>

    <Fragment slot="pitch">
      <h2 class="pitch-title dot-end">Password baru lewat email pemilik</h2>
      <p class="pitch-lead">Kode dikirim ke email pemilik toko, berlaku 10 menit dan hanya sekali pakai. Setelah password diganti, semua sesi lama di toko keluar otomatis.</p>
    </Fragment>
  </AuthSplit>
</SiteLayout>

<script>
  import { bindInlineValidation, validateInline, setFieldError } from '../../lib/form-validation-id.ts';

  const form = document.getElementById('resetForm') as HTMLFormElement;
  const email = document.getElementById('resetEmail') as HTMLInputElement;
  const codeStep = document.getElementById('codeStep') as HTMLElement;
  const code = document.getElementById('resetCode') as HTMLInputElement;
  const password = document.getElementById('resetPassword') as HTMLInputElement;
  const toggle = document.getElementById('resetTogglePassword') as HTMLButtonElement;
  const submit = document.getElementById('resetSubmit') as HTMLButtonElement;
  const banner = document.getElementById('resetError') as HTMLElement;
  const sentNote = document.getElementById('sentNote') as HTMLElement;
  const resend = document.getElementById('resendCode') as HTMLButtonElement;
  const changeEmail = document.getElementById('changeEmail') as HTMLButtonElement;
  const done = document.getElementById('resetDone') as HTMLElement;
  const lead = document.getElementById('resetLead') as HTMLElement;
  const security = document.getElementById('securityStatus') as HTMLElement;

  const SEND_LABEL = 'Kirim kode →';
  const RESET_LABEL = 'Simpan password baru →';
  const RESEND_GAP_MS = 60_000;
  let challenge: { id: string; email: string } | null = null;
  let resendAt = 0;
  let busy = false;

  const showError = (message: string) => {
    banner.textContent = message;
    banner.hidden = !message;
    if (message) banner.focus();
  };
  const normalized = () => email.value.trim().toLowerCase();

  toggle.addEventListener('click', () => {
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Sembunyikan' : 'Lihat';
    toggle.setAttribute('aria-pressed', String(show));
  });

  // ---- the bot check (the same invisible widget as signup) ------------------
  let turnstileToken = form.dataset.standin ? 'local-stand-in' : '';
  let turnstileFailed = false;
  const waiters: Array<() => void> = [];
  type Turnstile = { render(element: HTMLElement, options: Record<string, unknown>): string; reset(id?: string): void };
  let widgetId: string | undefined;
  const widget = document.getElementById('turnstileWidget');
  const setSecurity = (state: 'pending' | 'ok' | 'error', text: string) => {
    security.dataset.state = state;
    security.textContent = text;
  };
  if (widget && form.dataset.sitekey) {
    setSecurity('pending', 'Memverifikasi koneksi aman…');
    const failed = () => {
      turnstileFailed = true;
      setSecurity('error', 'Pemeriksaan keamanan gagal dimuat. Periksa koneksi, lalu muat ulang halaman.');
      waiters.splice(0).forEach((resolve) => resolve());
    };
    (window as unknown as Record<string, unknown>).__adsbookResetTurnstileReady = () => {
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      if (!turnstile) return failed();
      try {
        widgetId = turnstile.render(widget, {
          sitekey: form.dataset.sitekey,
          language: 'id',
          theme: 'light',
          size: 'flexible',
          appearance: 'interaction-only',
          callback: (token: string) => {
            turnstileToken = token;
            setSecurity('ok', 'Koneksi terverifikasi');
            waiters.splice(0).forEach((resolve) => resolve());
          },
          'error-callback': () => {
            turnstileToken = '';
            setSecurity('error', 'Verifikasi keamanan belum berhasil dan sedang diulang otomatis.');
          },
          'expired-callback': () => {
            turnstileToken = '';
            (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
          },
        });
      } catch {
        failed();
      }
    };
    const script = document.createElement('script');
    script.addEventListener('error', failed);
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__adsbookResetTurnstileReady';
    script.async = true;
    script.defer = true;
    document.head.append(script);
  }
  const awaitToken = () =>
    turnstileToken || turnstileFailed
      ? Promise.resolve()
      : Promise.race([new Promise<void>((resolve) => waiters.push(resolve)), new Promise<void>((resolve) => setTimeout(resolve, 4000))]);
  /** A token is single use: after any request that carried it, a fresh one is needed. */
  const spendToken = () => {
    if (form.dataset.standin) return;
    turnstileToken = '';
    (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
  };

  const post = async (body: Record<string, unknown>) => {
    await awaitToken();
    if (!turnstileToken) throw new Error('Verifikasi keamanan belum siap. Tunggu sebentar lalu coba lagi.');
    try {
      const response = await fetch('/api/platform/owner-reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...body, turnstile_token: turnstileToken }),
        signal: AbortSignal.timeout(20000),
      });
      const payload = (await response.json().catch(() => ({}))) as { success?: boolean; error?: string; errors?: Record<string, string>; challenge_id?: string };
      return { ok: response.ok && payload.success === true, payload };
    } finally {
      spendToken();
    }
  };

  const syncResend = () => {
    const left = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
    resend.disabled = left > 0 || busy;
    resend.textContent = left > 0 ? `Kirim ulang kode (${left} dtk)` : 'Kirim ulang kode';
  };
  setInterval(syncResend, 1000);

  const showStep = (step: 1 | 2) => {
    form.dataset.step = String(step);
    codeStep.hidden = step === 1;
    email.readOnly = step === 2;
    submit.textContent = step === 1 ? SEND_LABEL : RESET_LABEL;
    if (step === 2) {
      code.required = true;
      password.required = true;
      sentNote.textContent = `Jika ${email.value.trim()} adalah email pemilik toko, kode 8 digit sudah dikirim. Cek juga folder spam. Kode berlaku 10 menit.`;
      sentNote.focus();
    } else {
      code.required = false;
      password.required = false;
      code.value = '';
      password.value = '';
      challenge = null;
      email.focus();
    }
  };

  const requestCode = async () => {
    const result = await post({ action: 'request_code', email: email.value.trim() });
    if (!result.ok || !result.payload.challenge_id) {
      if (result.payload.errors?.email) setFieldError(email, result.payload.errors.email);
      throw new Error(result.payload.error || 'Kode belum bisa dikirim. Coba lagi.');
    }
    challenge = { id: result.payload.challenge_id, email: normalized() };
    resendAt = Date.now() + RESEND_GAP_MS;
    showStep(2);
  };

  const setBusy = (value: boolean, label: string) => {
    busy = value;
    submit.disabled = value;
    form.setAttribute('aria-busy', String(value));
    submit.textContent = label;
    syncResend();
  };

  bindInlineValidation(form);
  if (window.matchMedia('(min-width: 960px)').matches) email.focus();

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    showError('');
    if (!validateInline(form)) return;
    const step = form.dataset.step;
    if (step === '2') {
      if (!/^[0-9]{8}$/.test(code.value.trim())) return setFieldError(code, 'Masukkan 8 digit kode dari email.'), code.focus();
      const pw = password.value;
      if (pw.length < 10 || pw.length > 128) return setFieldError(password, 'Password 10–128 karakter.'), password.focus();
      if (pw.toLowerCase() === normalized()) return setFieldError(password, 'Password tidak boleh sama dengan email.'), password.focus();
    }
    setBusy(true, step === '1' ? 'Mengirim kode…' : 'Menyimpan password…');
    try {
      if (step === '1') {
        await requestCode();
      } else {
        if (!challenge || challenge.email !== normalized()) throw new Error('Minta kode baru untuk email ini.');
        const result = await post({
          action: 'reset',
          email: email.value.trim(),
          challenge_id: challenge.id,
          email_code: code.value.trim(),
          password: password.value,
        });
        if (!result.ok) {
          if (result.payload.errors?.emailCode) setFieldError(code, result.payload.errors.emailCode);
          if (result.payload.errors?.password) setFieldError(password, result.payload.errors.password);
          throw new Error(result.payload.error || 'Password belum berubah. Coba lagi.');
        }
        challenge = null;
        form.hidden = true;
        lead.hidden = true;
        done.hidden = false;
        done.focus();
        return;
      }
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Permintaan belum bisa diproses. Coba lagi.');
    }
    setBusy(false, form.dataset.step === '2' ? RESET_LABEL : SEND_LABEL);
  });

  resend.addEventListener('click', async () => {
    if (busy || Date.now() < resendAt) return;
    showError('');
    setBusy(true, 'Mengirim kode…');
    try {
      await requestCode();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Kode belum bisa dikirim. Coba lagi.');
    }
    setBusy(false, RESET_LABEL);
  });

  changeEmail.addEventListener('click', () => {
    if (busy) return;
    showError('');
    showStep(1);
  });
  syncResend();
</script>

<style>
  .card-head { display: grid; gap: 0.35rem; margin-bottom: 1.35rem; }
  .card-head h1 { font-size: clamp(1.45rem, 1.2rem + 1vw, 1.85rem); }
  .card-head p { color: var(--slate); font-size: 0.95rem; }
  .card-head p[hidden] { display: none; }
  .reset-form { display: grid; gap: 1.1rem; }
  .reset-form[hidden] { display: none; }
  .code-step { display: grid; gap: 1.1rem; }
  .code-step[hidden] { display: none; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-size: 0.875rem; font-weight: 700; color: var(--ink); }
  .field input {
    width: 100%;
    min-height: 48px;
    padding: 0 0.95rem;
    border-radius: 12px;
    border: 1px solid rgb(15 23 42 / 0.12);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  .field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgb(37 99 235 / 0.15); }
  .field input[aria-invalid="true"] { border-color: #e11d48; box-shadow: 0 0 0 3px rgb(225 29 72 / 0.12); }
  .field input[readonly] { background: var(--tile, #f8fafc); color: var(--slate); }
  .field input.code-input { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.32em; font-variant-numeric: tabular-nums; }
  .field input.code-input::placeholder { letter-spacing: normal; font-weight: 400; font-family: inherit; font-size: 1rem; }
  .field-hint { margin: 0; font-size: 0.8rem; color: var(--slate); }
  .password-box { position: relative; }
  .password-box input { padding-right: 7.5rem; }
  .toggle-pw {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    min-height: 40px;
    padding: 0 0.8rem;
    border: 0;
    border-radius: 9px;
    background: var(--tile);
    color: var(--ink);
    font: 600 0.82rem/1 var(--sans, inherit);
    cursor: pointer;
  }
  .sent-note { margin: 0; padding: 0.8rem 1rem; border-radius: 12px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e3a8a; font-size: 0.9rem; line-height: 1.5; }
  .code-links { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin: -0.35rem 0 0; }
  .link-btn { min-height: 44px; padding: 0 0.15rem; border: 0; background: none; color: var(--accent); font: 700 0.875rem/1 inherit; cursor: pointer; }
  .link-btn:disabled { color: var(--slate); font-weight: 600; cursor: default; }
  .field-error { display: flex; gap: 0.4rem; font-size: 0.82rem; font-weight: 500; color: #be123c; }
  .field-error::before { content: ""; width: 6px; height: 6px; margin-top: 0.4em; flex-shrink: 0; background: #e11d48; }
  .field-error[hidden] { display: none; }
  .error-banner { margin-bottom: 1rem; padding: 0.8rem 1rem; border-radius: 12px; background: #fff1f2; color: #9f1239; font-size: 0.9rem; font-weight: 600; }
  .error-banner[hidden] { display: none; }
  .submit-btn {
    min-height: 48px;
    margin-top: 0.25rem;
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font: 700 0.98rem/1.25 var(--display);
    word-spacing: 0.06em;
    cursor: pointer;
    box-shadow: 0 8px 20px -10px rgb(37 99 235 / 0.5);
  }
  .submit-btn:hover { background: var(--accent-hover); }
  .submit-btn:disabled { opacity: 0.7; cursor: progress; }
  .submit-btn.as-link { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
  .security-line { display: flex; align-items: center; justify-content: center; gap: 0.45rem; font-size: 0.76rem; color: var(--ink-muted); margin: 0; }
  .security-line[hidden] { display: none; }
  .security-line[data-state="error"] { color: #be123c; }
  .turnstile-slot { width: 100%; }
  .turnstile-slot:not(:empty) { margin-top: 0.75rem; }
  .done-card { display: grid; gap: 0.6rem; padding: 1rem 1.1rem; border-radius: 12px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #14532d; font-size: 0.95rem; line-height: 1.55; }
  .done-card[hidden] { display: none; }
  .done-card strong { color: var(--ink); font-size: 1.05rem; }
  .done-card p { margin: 0; }
  .staff-help { margin: 1rem 0 0; padding: 0.85rem 1rem; border-radius: 12px; background: #f1f5f9; color: #334155; font-size: 0.875rem; line-height: 1.5; }
  .staff-help strong { color: var(--ink); }
  .card-foot { margin-top: 1.25rem; padding-top: 1.1rem; border-top: var(--hairline); font-size: 0.9rem; }
  .card-foot a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font-weight: 700; text-decoration: none; }
</style>

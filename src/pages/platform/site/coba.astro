---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import ShotFrame from '../../../platform/site/ShotFrame.astro';
import SignalBand from '../../../platform/site/SignalBand.astro';
import HybridGeoSim from '../../../platform/site/HybridGeoSim.astro';
import CompetitorCompare from '../../../platform/site/CompetitorCompare.astro';
import PillarRows from '../../../platform/site/PillarRows.astro';
import StepFlow from '../../../platform/site/StepFlow.astro';
import SignalPipelineStrip from '../../../platform/site/SignalPipelineStrip.astro';
import CapabilityList from '../../../platform/site/CapabilityList.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { FAQ_SHORT, SHOTS } from '../../../platform/site/content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH, SITE_PAGES } from '../../../platform/site/site.ts';

export const prerender = false;
// The long-form page for ad traffic (/coba): everything on one page, built from
// the same components and words as the multi-page site.
---

<SiteLayout page={SITE_PAGES.coba}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="hero-kicker">Untuk seller COD yang beriklan di Meta, Google, TikTok, dan jaringan lain</p>
        <h1 id="hero-title" class="dot-end">Berhenti menebak hasil iklan COD Anda</h1>
        <p class="lead">Konversi yang terhitung ganda membuat iklan boncos tampak untung. Sinyal yang bocor membuat iklan laris tampak rugi. adsbook.id mencatat setiap pesanan ke kampanye asalnya, menyaring wilayah luar jangkauan otomatis, dan mengirim konversi 1:1 ke dashboard iklan Meta dan Google.</p>
        <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
        <p class="hero-note">Bebas rakit dan review toko dulu tanpa biaya · mulai Rp149.000/bulan saat siap beriklan · 0% potongan transaksi</p>
      </div>
      <div class="hero-shot"><ShotFrame shot={SHOTS.form} eager caption /></div>
    </div>
  </section>

  <HybridGeoSim id="coba-hybrid-title" />

  <SignalBand />

  <SignalPipelineStrip tone="canvas" />

  <section class="section section-white" aria-labelledby="pilar-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pilar-title">Satu kendali penuh dari klik iklan sampai dana cair</h2>
        <p class="lead">Semuanya sudah berjalan hari ini. Gambar adalah layar produk yang sebenarnya, dengan data dari toko contoh.</p>
      </div>
      <PillarRows headingLevel="h3" />
    </div>
  </section>

  <section class="section" aria-labelledby="alur-title">
    <div class="wrap">
      <div class="section-head"><h2 id="alur-title">Satu pesanan, dari klik sampai tercatat</h2></div>
      <StepFlow />
    </div>
  </section>

  <section class="section section-white" aria-labelledby="lengkap-title">
    <div class="wrap">
      <div class="section-head"><h2 id="lengkap-title">Dan yang Anda perlukan setiap hari</h2></div>
      <CapabilityList />
    </div>
  </section>

  <section class="section" aria-labelledby="harga-title">
    <div class="wrap">
      <div class="section-head"><h2 id="harga-title">Satu biaya flat per toko, 0% komisi transaksi</h2></div>
      <CompetitorCompare />
      <Pricing compact />
    </div>
  </section>

  <section class="section section-white" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-title">Yang paling sering ditanyakan pengiklan</h2></div>
      <FaqList items={FAQ_SHORT} />
      <p class="more"><a class="text-link" href="/faq">Semua pertanyaan</a></p>
    </div>
  </section>

  <ClosingCta />
</SiteLayout>

<style>
  .hero { padding: 2.5rem 0 5rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 3.5rem; align-items: center; }
  .hero-text { display: grid; gap: 1.35rem; justify-items: start; }
  .hero-kicker { font-weight: 700; color: var(--accent); font-size: 0.97rem; }
  .hero-note { font-size: 0.95rem; color: var(--ink-muted); }
  .hero-shot :global(.frame-phone) { max-width: 290px; }
  .more { margin-top: 1.75rem; }
  @media (max-width: 760px) {
    .hero { padding: 1rem 0 3rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-shot :global(.frame-phone) { max-height: 240px; max-width: 260px; }
    .hero-shot :global(figcaption) { display: none; }
  }
</style>

---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import PageHead from '../../../platform/site/PageHead.astro';
import PillarRows from '../../../platform/site/PillarRows.astro';
import CapabilityList from '../../../platform/site/CapabilityList.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { SITE_PAGES } from '../../../platform/site/site.ts';

export const prerender = false;
---

<SiteLayout page={SITE_PAGES.fitur}>
  <PageHead title="Fitur yang membuat setiap pesanan presisi" lead="Enam pilar, dari sinyal semua kanal iklan sampai infrastruktur, lalu semua yang Anda perlukan setiap hari. Gambar adalah layar produk yang sebenarnya, dengan data dari toko contoh." />
  <section class="section section-white" aria-label="Enam pilar">
    <div class="wrap"><PillarRows /></div>
  </section>
  <section class="section" aria-labelledby="lengkap-title">
    <div class="wrap">
      <div class="section-head"><h2 id="lengkap-title">Dan yang Anda perlukan setiap hari</h2></div>
      <CapabilityList />
    </div>
  </section>
  <ClosingCta tone="white" />
</SiteLayout>

---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import PageHead from '../../../platform/site/PageHead.astro';
import VisualBanner from '../../../platform/site/VisualBanner.astro';
import CompetitorCompare from '../../../platform/site/CompetitorCompare.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import { FAQ_GROUPS } from '../../../platform/site/content.ts';
import { SITE_PAGES, breadcrumbName } from '../../../platform/site/site.ts';

export const prerender = false;
const pricingFaq = FAQ_GROUPS[0].items;
---

<SiteLayout page={SITE_PAGES.harga}>
  <PageHead crumb={breadcrumbName(SITE_PAGES.harga)} eyebrow="Paket berlangganan" title="Gratis sampai siap beriklan" lead="Satu biaya flat per toko: 0% potongan QRIS/VA, tanpa kuota order, dengan Hybrid Form per provinsi dan konversi 1:1 ke Meta, Google, dan TikTok sudah termasuk." />
  <VisualBanner
    id="promo-harga-title"
    eager
    title="Mulai gratis, bayar saat siap beriklan"
    text="Tiga hal yang menjaga biaya Anda tetap masuk akal sejak hari pertama."
    points={[
      'Mode Preview gratis tanpa batas waktu persiapan',
      'Paket tahunan: bayar 10 bulan, gratis 2 bulan',
      'Masa tenggang 48 jam setelah jatuh tempo agar iklan aktif tidak terputus',
    ]}
    image={{ src: '/visual/harga.webp', width: 640, height: 440, alt: 'Ilustrasi 2.5D tiga plinth: Mode Preview tanpa batas waktu; hemat 2 bulan; masa tenggang 48 jam' }}
  />
  <section class="section section-white" aria-labelledby="paket-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="paket-title">Satu harga flat per toko, semua fitur terbuka</h2>
        <p class="lead">Pilih durasi. Semua paket berisi fitur yang sama; yang berbeda hanya lamanya.</p>
      </div>
      <Pricing />
      <div class="compare-head">
        <h2 class="compare-title">Dibanding form biasa dan aplikasi tracker terpisah</h2>
      </div>
      <CompetitorCompare />
    </div>
  </section>
  <section class="section" aria-labelledby="biaya-title">
    <div class="wrap">
      <div class="section-head"><h2 id="biaya-title">Soal biaya</h2></div>
      <FaqList items={pricingFaq} />
      <p class="more"><a class="text-link" href="/faq">Semua pertanyaan</a></p>
    </div>
  </section>
</SiteLayout>

<style>
  .more { margin-top: 1.75rem; }
  .compare-head { margin: 5rem 0 1.25rem; }
  .compare-title { font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.7rem); max-width: 30ch; }
  @media (max-width: 760px) { .compare-head { margin-top: 3.5rem; } }
</style>

---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import { FAQ_MORE, FAQ_SHORT } from '../../../platform/site/content.ts';
import { SITE_PAGES } from '../../../platform/site/site.ts';

export const prerender = false;
const pricingFaq = [...FAQ_SHORT, ...FAQ_MORE].filter((item) => /gratis|Uang pembeli|domain|langganan/i.test(item.q));
---

<SiteLayout page={SITE_PAGES.harga}>
  <section class="page-head">
    <div class="wrap"><div class="head">
      <h1>Coba gratis, bayar saat toko siap diiklankan</h1>
      <p class="lead">Satu harga untuk semua fitur, per toko. Sinyal iklan 1:1 ke Meta dan Google sudah termasuk, dan tidak ada potongan per transaksi.</p>
    </div></div>
  </section>
  <section class="section section-white">
    <div class="wrap">
      <h2 class="section-title">Paket per toko</h2>
      <Pricing />
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2 class="section-title">Soal biaya</h2>
      <FaqList items={pricingFaq} />
    </div>
  </section>
</SiteLayout>

---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import PageHead from '../../../platform/site/PageHead.astro';
import VisualBanner from '../../../platform/site/VisualBanner.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { getRuntimeEnv } from '../../../lib/env';
import { SITE_PAGES, breadcrumbName } from '../../../platform/site/site.ts';

export const prerender = false;
// The contact addresses are set by the operator (PLATFORM_SUPPORT_EMAIL,
// PLATFORM_SUPPORT_WHATSAPP); until then the page says so, never a made-up one.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const email = typeof env.PLATFORM_SUPPORT_EMAIL === 'string' && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(env.PLATFORM_SUPPORT_EMAIL) ? env.PLATFORM_SUPPORT_EMAIL : '';
const whatsapp = typeof env.PLATFORM_SUPPORT_WHATSAPP === 'string' && /^62\d{8,13}$/.test(env.PLATFORM_SUPPORT_WHATSAPP) ? env.PLATFORM_SUPPORT_WHATSAPP : '';
---

<SiteLayout page={SITE_PAGES.kontak}>
  <PageHead crumb={breadcrumbName(SITE_PAGES.kontak)} eyebrow="Hubungi kami" title="Kontak" lead="Untuk pertanyaan akun, toko, atau privasi. Pembeli di salah satu toko: lihat kolom berikutnya." />
  <VisualBanner
    id="kontak-visual-title"
    eager
    title="Dua jalur, satu tim"
    text="Seller dan calon seller dibantu langsung untuk akun, toko, dan langganan. Permintaan pembeli tentang data pesanan kami teruskan ke toko yang mengelolanya."
    image={{ src: '/visual/kontak.webp', width: 640, height: 440, alt: 'Ilustrasi 2.5D: jalur dukungan seller dan jalur perlindungan data pembeli' }}
  />
  <section class="section section-white">
    <div class="wrap contact">
      <section aria-labelledby="tim-title">
        <h2 id="tim-title">Seller dan calon seller</h2>
        {email || whatsapp ? (
          <dl class="channels">
            {email && <div><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>}
            {whatsapp && <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/${whatsapp}`} rel="noopener">+{whatsapp}</a></dd></div>}
          </dl>
        ) : (
          <p class="muted">Alamat kontak resmi sedang disiapkan dan diumumkan di halaman ini sebelum peluncuran.</p>
        )}
        <p class="muted">Sudah punya toko? <a href="/masuk">Masuk ke admin toko</a>; bantuan juga tersedia dari menu admin.</p>
      </section>
      <section aria-labelledby="pembeli-title">
        <h2 id="pembeli-title">Pembeli di salah satu toko</h2>
        <p class="muted">Toko tempat Anda berbelanja adalah pengelola data pesanan Anda. Hubungi toko itu lewat kontak di halaman Kebijakan Privasi toko tersebut. Permintaan yang sampai ke kami, kami teruskan ke toko tersebut dalam 3 hari kerja.</p>
      </section>
    </div>
  </section>
  <ClosingCta withShot={false} />
</SiteLayout>

<style>
  .contact { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  /* Two borderless porcelain panels (HOMEPAGE-DESIGN-SYSTEM v2 §5.2). */
  .contact { gap: 1.5rem; }
  .contact > section { display: grid; gap: 1rem; align-content: start; padding: 2.25rem; border-radius: 24px; background: var(--tile); }
  .contact h2 { font-size: 1.35rem; }
  .channels { margin: 0; display: grid; gap: 0.6rem; }
  .channels div { display: grid; grid-template-columns: 6rem 1fr; gap: 0.75rem; }
  .channels dt { font-weight: 700; }
  .channels dd { margin: 0; }
  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } .contact > section { padding: 1.5rem; border-radius: 20px; } }
</style>

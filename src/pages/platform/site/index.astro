---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import ShotFrame from '../../../platform/site/ShotFrame.astro';
import SignalBand from '../../../platform/site/SignalBand.astro';
import PillarGrid from '../../../platform/site/PillarGrid.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { FAQ_SHORT, SHOTS } from '../../../platform/site/content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH, SITE_PAGES } from '../../../platform/site/site.ts';

export const prerender = false;
// The home (2026-11-17 site pass): the promise, the proof in the logo, the six
// pillars short (full on /fitur), price, questions. One job per section.
---

<SiteLayout page={SITE_PAGES.home}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="hero-kicker">Toko COD untuk seller Meta dan Google Ads</p>
        <h1 id="hero-title" class="dot-end">Setiap pesanan dari iklan tercatat tepat satu kali</h1>
        <p class="lead">Form cepat di HP, pesanan Anda periksa sebelum dikirim, dan Purchase sampai ke Meta dari server, walau pembeli langsung menutup halaman.</p>
        <div class="hero-actions">
          <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
          <a class="text-link" href="/cara-kerja">Lihat cara kerjanya</a>
        </div>
        <ul class="hero-facts" aria-label="Ringkasan">
          <li>Gratis di Mode Preview</li>
          <li>Mulai Rp149.000/bulan</li>
          <li>0% potongan transaksi</li>
        </ul>
      </div>
      <div class="hero-shot"><ShotFrame shot={SHOTS.form} eager caption /></div>
    </div>
  </section>

  <SignalBand />

  <section class="section section-white" aria-labelledby="pilar-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pilar-title">Presisi di setiap langkah pesanan</h2>
        <p class="lead">Enam hal yang menentukan hasil iklan COD Anda, semuanya sudah berjalan hari ini.</p>
      </div>
      <PillarGrid />
    </div>
  </section>

  <section class="section" aria-labelledby="harga-title">
    <div class="wrap">
      <div class="section-head"><h2 id="harga-title">Satu harga, semua fitur, per toko</h2></div>
      <Pricing compact />
      <p class="more"><a class="text-link" href="/harga">Rincian paket</a></p>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-title">Pertanyaan yang sering muncul</h2></div>
      <FaqList items={FAQ_SHORT} />
      <p class="more"><a class="text-link" href="/faq">Semua pertanyaan</a></p>
    </div>
  </section>

  <ClosingCta />
</SiteLayout>

<style>
  .hero { padding: 2.5rem 0 5rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 3.5rem; align-items: center; }
  .hero-text { display: grid; gap: 1.35rem; justify-items: start; }
  .hero-kicker { font-weight: 700; color: var(--accent); font-size: 0.97rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .hero-facts { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; color: var(--ink-muted); font-size: 0.95rem; }
  .hero-facts li { display: flex; align-items: center; gap: 0.5rem; }
  .hero-facts li::before { content: ""; width: 6px; height: 6px; background: var(--accent); }
  .hero-shot :global(.frame-phone) { max-width: 290px; }
  .more { margin-top: 1.75rem; }
  @media (max-width: 760px) {
    .hero { padding: 1rem 0 3rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero-shot :global(.frame-phone) { max-height: 240px; max-width: 260px; }
    .hero-shot :global(figcaption) { display: none; }
  }
</style>

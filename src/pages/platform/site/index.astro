---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import KineticHero3D from '../../../platform/site/KineticHero3D.astro';
import HybridGeoSim from '../../../platform/site/HybridGeoSim.astro';
import TopCampaignsShowcase from '../../../platform/site/TopCampaignsShowcase.astro';
import SignalBand from '../../../platform/site/SignalBand.astro';
import HomeBentoGrid from '../../../platform/site/HomeBentoGrid.astro';
import CompetitorCompare from '../../../platform/site/CompetitorCompare.astro';
import ShotFrame from '../../../platform/site/ShotFrame.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { FAQ_SHORT, SHOTS } from '../../../platform/site/content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH, SITE_PAGES } from '../../../platform/site/site.ts';
import { getRuntimeEnv } from '../../../lib/env';
import { tenantHostSuffix } from '../../../platform/hostnames';

export const prerender = false;
// Homepage (Paduka, 2026-11-18, borderless gallery, HOMEPAGE-DESIGN-SYSTEM v2): the 100dvh 3D
// hero (unchanged) -> campaign analytics -> 1:1 tracking proof -> Hybrid Form by province ->
// six-pillar bento -> pricing, then the open comparison -> the real phone checkout -> FAQ ->
// one closing band without a second screenshot. Sections open on their H2: no eyebrow pills
// and no per-section "detail" links below the hero.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
---

<SiteLayout page={SITE_PAGES.home} heroHeader>
  <KineticHero3D suffix={tenantHostSuffix(env)}>
    <h1 slot="title" id="hero-title" class="dot-end">Dari klik iklan ke pesanan terkirim — <span class="accent">terkunci di satu titik</span></h1>
  </KineticHero3D>

  <TopCampaignsShowcase />

  <SignalBand />

  <HybridGeoSim />

  <section class="section" aria-labelledby="bento-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="bento-title">Dirancang untuk seller yang beriklan di semua platform iklan</h2>
        <p class="lead">Ringan di HP pembeli, ketat terhadap paket berisiko retur, dan rapi mengirim konversi ke Ads Manager Anda.</p>
      </div>
      <HomeBentoGrid />
    </div>
  </section>

  <section class="section section-white" aria-labelledby="harga-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="harga-title">Satu harga flat per toko, semua fitur terbuka</h2>
        <p class="lead">Siapkan katalog dan review tampilan toko gratis tanpa batas waktu di Mode Preview. Aktifkan langganan via QRIS atau Virtual Account saat siap menjalankan iklan.</p>
      </div>
      <Pricing compact />
      <div class="compare-head">
        <h3>Dibanding form biasa dan aplikasi tracker terpisah</h3>
        <p class="muted">Tidak ada persentase yang ikut naik saat penjualan naik, dan tidak perlu menyewa aplikasi kedua.</p>
      </div>
      <CompetitorCompare />
    </div>
  </section>

  <section class="section" aria-labelledby="bukti-produk-title">
    <div class="wrap proof-grid">
      <div class="proof-text">
        <h2 id="bukti-produk-title">Form checkout yang bersih dan cepat dibuka</h2>
        <p class="lead">Pilih varian, ketik kecamatan dan hasilnya langsung muncul, lalu pesanan masuk ke antrean verifikasi tim CS Anda.</p>
        <ul class="proof-facts" aria-label="Ringkasan">
          <li>Setup tanpa coding</li>
          <li>Review toko dulu tanpa biaya</li>
          <li>0% potongan per transaksi</li>
        </ul>
        <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
      </div>
      <div class="proof-shot"><ShotFrame shot={SHOTS.form} caption /></div>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-title">Pertanyaan yang sering diajukan pengiklan</h2></div>
      <FaqList items={FAQ_SHORT} />
      <p class="more"><a class="text-link" href="/faq">Semua pertanyaan</a></p>
    </div>
  </section>

  <ClosingCta withShot={false} visual />
</SiteLayout>

<style>
  .proof-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 3.5rem; align-items: center; }
  .proof-text { display: grid; gap: 1.2rem; justify-items: start; }
  .proof-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; color: var(--ink-muted); font-size: 0.94rem; font-weight: 600; }
  .proof-facts li { display: flex; align-items: center; gap: 0.5rem; }
  .proof-facts li::before { content: ""; width: 6px; height: 6px; background: var(--accent); }
  .compare-head { display: grid; gap: 0.5rem; margin: 5rem 0 1.25rem; max-width: 60ch; }
  .compare-head h3 { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); font-weight: 800; }
  .more { margin-top: 1.75rem; }
  @media (max-width: 760px) {
    .proof-grid { grid-template-columns: 1fr; gap: 2.25rem; }
    .compare-head { margin-top: 3.5rem; }
  }
</style>

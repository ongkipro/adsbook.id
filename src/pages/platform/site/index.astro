---
import SiteLayout from '../../../platform/site/SiteLayout.astro';
import KineticHero3D from '../../../platform/site/KineticHero3D.astro';
import ShotFrame from '../../../platform/site/ShotFrame.astro';
import SignalBand from '../../../platform/site/SignalBand.astro';
import PillarGrid from '../../../platform/site/PillarGrid.astro';
import Pricing from '../../../platform/site/Pricing.astro';
import FaqList from '../../../platform/site/FaqList.astro';
import ClosingCta from '../../../platform/site/ClosingCta.astro';
import { FAQ_SHORT, SHOTS } from '../../../platform/site/content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH, SITE_PAGES } from '../../../platform/site/site.ts';
import { getRuntimeEnv } from '../../../lib/env';
import { tenantHostSuffix } from '../../../platform/hostnames';

export const prerender = false;
// The home (Paduka, 2026-11-18): a 100dvh 3D hero where three ad channels lock
// into one order, then the former hero as the product proof (the real form on
// a phone), then the promise in the logo, the six pillars short, price,
// questions. One job per section.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
---

<SiteLayout page={SITE_PAGES.home} heroHeader>
  <KineticHero3D suffix={tenantHostSuffix(env)}>
    <h1 slot="title" id="hero-title" class="dot-end">Dari klik iklan ke pesanan terkirim — <span class="accent">terkunci di satu titik</span></h1>
  </KineticHero3D>

  <section class="section section-white proof" aria-labelledby="bukti-produk-title">
    <div class="wrap proof-grid">
      <div class="proof-text">
        <p class="proof-kicker">Toko COD untuk seller iklan di semua kanal</p>
        <h2 id="bukti-produk-title">Setiap pesanan dari iklan tercatat tepat satu kali</h2>
        <p class="lead">Meta, Google, TikTok, atau jaringan lain: setiap pesanan tercatat ke kanal iklannya. Form cepat di HP, pesanan Anda periksa sebelum dikirim, dan konversi sampai ke Meta dan Google dari server, walau pembeli langsung menutup halaman.</p>
        <ul class="proof-facts" aria-label="Ringkasan">
          <li>Gratis di Mode Preview</li>
          <li>Mulai Rp149.000/bulan</li>
          <li>0% potongan transaksi</li>
        </ul>
        <div class="proof-actions">
          <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
          <a class="text-link" href="/cara-kerja">Lihat cara kerjanya</a>
        </div>
      </div>
      <div class="proof-shot"><ShotFrame shot={SHOTS.form} caption /></div>
    </div>
  </section>

  <SignalBand />

  <section class="section section-white" aria-labelledby="pilar-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pilar-title">Presisi di setiap langkah pesanan</h2>
        <p class="lead">Enam hal yang menentukan hasil iklan COD Anda, semuanya sudah berjalan hari ini.</p>
      </div>
      <PillarGrid />
    </div>
  </section>

  <section class="section" aria-labelledby="harga-title">
    <div class="wrap">
      <div class="section-head"><h2 id="harga-title">Satu harga, semua fitur, per toko</h2></div>
      <Pricing compact />
      <p class="more"><a class="text-link" href="/harga">Rincian paket</a></p>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-title">Pertanyaan yang sering muncul</h2></div>
      <FaqList items={FAQ_SHORT} />
      <p class="more"><a class="text-link" href="/faq">Semua pertanyaan</a></p>
    </div>
  </section>

  <ClosingCta />
</SiteLayout>

<style>
  /* The hero ends on the canvas; the proof section opens on white with one hairline between them. */
  .proof { border-top: 1px solid var(--line); }
  .proof-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 3.5rem; align-items: center; }
  .proof-text { display: grid; gap: 1.35rem; justify-items: start; }
  .proof-kicker { font-weight: 700; color: var(--accent); font-size: 0.97rem; }
  .proof-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .proof-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; color: var(--ink-muted); font-size: 0.95rem; }
  .proof-facts li { display: flex; align-items: center; gap: 0.5rem; }
  .proof-facts li::before { content: ""; width: 6px; height: 6px; background: var(--accent); }
  .proof-shot :global(.frame-phone) { max-width: 290px; }
  .more { margin-top: 1.75rem; }
  @media (max-width: 760px) {
    .proof-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .proof-shot :global(.frame-phone) { max-width: 260px; }
  }
</style>

---
import SiteLayout from '../../platform/site/SiteLayout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { tenantHostSuffix } from '../../platform/hostnames';
import { PLANS, PLAN_POINTS } from '../../platform/site/content.ts';
import { SIGNUP_PAGE } from '../../platform/site/site.ts';

export const prerender = false;

// UX-1: signup on the platform host, sharing the warm editorial SiteLayout
// (#F8FAFC canvas, Plus Jakarta Sans headings, #2563EB accent).
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const siteKey = typeof env.TURNSTILE_SITE_KEY === 'string' ? env.TURNSTILE_SITE_KEY : '';
const localStandIn = siteKey === 'local-stand-in';
const suffix = tenantHostSuffix(env);

const rawPaket = Astro.url.searchParams.get('paket') ?? '';
const chosenPlan = PLANS.find((plan) => plan.code === rawPaket) ?? null;
const modeMasuk = Astro.url.searchParams.get('masuk') === '1';
---

<SiteLayout page={SIGNUP_PAGE} quietHeader>
  {siteKey && !localStandIn && (
    <script slot="head" is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <section class="signup-band">
    <div class="wrap signup-grid">
      <!-- Left column (desktop) / Secondary context: value summary & journey -->
      <aside class="signup-pitch" aria-label="Yang Anda dapatkan">
        <p class="eyebrow">Mode Preview Gratis · Tanpa Kartu</p>
        <h1>Siapkan toko sekarang, bayar saat siap beriklan</h1>
        <p class="lead-copy">
          Toko langsung aktif di alamat <code>nama-toko.{suffix}</code> milik Anda sendiri. Susun produk, landing page, gudang, dan pixel lebih dulu sebelum berlangganan.
        </p>

        {chosenPlan && (
          <div class="picked-plan" role="note">
            <div>
              <p class="picked-label">Paket pilihan setelah toko siap</p>
              <p class="picked-title">{chosenPlan.label} · <strong>{chosenPlan.price}</strong> <span class="muted">({chosenPlan.note})</span></p>
            </div>
            <p class="picked-sub">Tidak ditagih sekarang. Anda baru membayar di menu Langganan setelah mencoba admin toko.</p>
          </div>
        )}

        <ol class="journey-steps" aria-label="Alur mulai berjualan">
          <li>
            <span class="step-num" aria-hidden="true">1</span>
            <div>
              <strong>Daftar &amp; masuk otomatis (&lt; 30 detik)</strong>
              <p>Database terisolasi dibuat khusus untuk toko Anda dan langsung membuka dashboard admin.</p>
            </div>
          </li>
          <li>
            <span class="step-num" aria-hidden="true">2</span>
            <div>
              <strong>Lengkapi produk, LP &amp; lihat preview di HP</strong>
              <p>Cek tampilan form COD dan halaman produk Anda secara nyata tanpa batas waktu.</p>
            </div>
          </li>
          <li>
            <span class="step-num" aria-hidden="true">3</span>
            <div>
              <strong>Aktifkan langganan &amp; jalankan iklan 1:1</strong>
              <p>Bayar via QRIS/VA mulai Rp149.000/bulan untuk membuka pesanan, sinyal Meta CAPI 1:1, dan 1 domain sendiri.</p>
            </div>
          </li>
        </ol>

        <ul class="pitch-points">
          {PLAN_POINTS.slice(0, 4).map((point) => <li>{point}</li>)}
        </ul>
      </aside>

      <!-- Right column: the signup card -->
      <div class="signup-card-col">
        <div class="signup-card">
          <div class="card-head">
            <h2>Buat akun toko</h2>
            <p class="muted">1 akun = 1 toko terisolasi + 1 domain sendiri.</p>
          </div>

          <div id="errorSummary" class="error-banner" hidden role="alert" tabindex="-1"></div>

          <form
            id="signupForm"
            class="signup-form"
            novalidate
            aria-busy="false"
            data-suffix={suffix}
            data-standin={localStandIn ? '1' : ''}
            data-paket={chosenPlan?.code ?? ''}
          >
            <div class="field">
              <label for="storeName">Nama toko</label>
              <input
                id="storeName"
                name="store_name"
                type="text"
                required
                maxlength="80"
                autocomplete="organization"
                placeholder="Contoh: Herbal Nusantara"
                aria-describedby="storeNameError"
              />
              <p id="storeNameError" class="field-error" hidden></p>
            </div>

            <div class="field">
              <label for="slug">Alamat toko</label>
              <div class="slug-box" id="slugBox">
                <input
                  id="slug"
                  name="slug"
                  type="text"
                  required
                  maxlength="32"
                  autocomplete="off"
                  spellcheck="false"
                  inputmode="url"
                  placeholder="herbal-nusantara"
                  aria-describedby="slugPreview slugHint slugError"
                />
                <span class="slug-suffix">.{suffix}</span>
              </div>
              <p id="slugPreview" class="slug-preview">
                URL preview: <code id="slugPreviewUrl">https://nama-toko.{suffix}</code>
              </p>
              <p id="slugHint" class="field-hint" aria-live="polite">Huruf kecil, angka, dan tanda hubung (3–32 karakter).</p>
              <div id="slugSuggestions" class="slug-suggestions" hidden aria-label="Saran alamat toko yang tersedia"></div>
              <p id="slugError" class="field-error" hidden></p>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="254"
                autocomplete="email"
                inputmode="email"
                placeholder="anda@email.com"
                aria-describedby="emailHint emailError"
              />
              <p id="emailHint" class="field-hint">Email ini dipakai untuk masuk ke toko.</p>
              <p id="emailError" class="field-error" hidden></p>
            </div>

            <div class="field">
              <div class="label-row">
                <label for="whatsapp">Nomor WhatsApp aktif</label>
                <span class="optional-tag">Opsional</span>
              </div>
              <input
                id="whatsapp"
                name="whatsapp"
                type="tel"
                maxlength="20"
                autocomplete="tel"
                inputmode="tel"
                placeholder="0812-3456-7890"
                aria-describedby="whatsappHint whatsappError"
              />
              <p id="whatsappHint" class="field-hint">Otomatis dipasang sebagai CS WhatsApp toko &amp; kontak tagihan.</p>
              <p id="whatsappError" class="field-error" hidden></p>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <div class="pw-box">
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="10"
                  maxlength="128"
                  autocomplete="new-password"
                  placeholder="Minimal 10 karakter"
                  aria-describedby="passwordRules passwordError"
                />
                <button
                  id="togglePassword"
                  type="button"
                  class="pw-toggle"
                  aria-controls="password"
                  aria-pressed="false"
                  aria-label="Tampilkan password"
                >Lihat</button>
              </div>
              <ul id="passwordRules" class="pw-rules" aria-live="polite">
                <li id="ruleLength" data-ok="false">Minimal 10 karakter <span id="pwCount">(0/10)</span></li>
                <li id="ruleDiff" data-ok="true">Tidak sama dengan email</li>
              </ul>
              <p id="passwordError" class="field-error" hidden></p>
            </div>

            <div class="field">
              <label class="terms-row">
                <input id="terms" name="terms" type="checkbox" required aria-describedby="termsError" />
                <span>
                  Saya setuju dengan <a href="/syarat" target="_blank" rel="noopener">Syarat Layanan Seller</a> dan telah membaca <a href="/privasi" target="_blank" rel="noopener">Kebijakan Privasi</a> adsbook.id.
                </span>
              </label>
              <p id="termsError" class="field-error" hidden></p>
            </div>

            {siteKey && !localStandIn && (
              <div class="turnstile-wrap">
                <div class="cf-turnstile" data-sitekey={siteKey} data-language="id"></div>
              </div>
            )}
            <p id="turnstileError" class="field-error" hidden role="alert"></p>

            <button id="submitSignup" type="submit" class="btn submit-btn">
              Buat toko
            </button>
            <p id="progressNote" class="progress-note" hidden aria-live="polite"></p>
          </form>

          <!-- Provisioning / Handoff Transition State -->
          <section id="signupDone" class="done-panel" hidden aria-live="polite">
            <div class="done-badge">✓ Toko berhasil dibuat</div>
            <h3 id="doneStoreTitle">Toko Anda sudah aktif. Membuka admin…</h3>
            <p class="done-url" id="doneStoreUrl"></p>
            <div class="done-creds">
              <p>Masuk dengan email <strong id="doneEmail"></strong> dan password yang baru Anda buat.</p>
              <dl>
                <dt>Alamat Admin</dt>
                <dd><code id="doneAdminHref"></code></dd>
              </dl>
            </div>
            <div class="done-actions">
              <a id="doneLogin" href="#" class="btn">Masuk ke toko</a>
              <p class="muted small">Jika halaman tidak berpindah otomatis dalam beberapa detik, klik tombol di atas.</p>
            </div>
          </section>

          <!-- Returning Seller Store Finder -->
          <div class="login-finder">
            <details id="finderDetails" open={modeMasuk ? true : undefined}>
              <summary>Sudah punya toko? Masuk ke admin toko Anda</summary>
              <form id="finderForm" class="finder-form" novalidate>
                <label for="finderSlug">Masukkan alamat / slug toko Anda</label>
                <div class="finder-row">
                  <div class="slug-box finder-box">
                    <input
                      id="finderSlug"
                      type="text"
                      required
                      placeholder="nama-toko atau domainanda.com"
                      autocomplete="off"
                      spellcheck="false"
                    />
                  </div>
                  <button type="submit" class="btn btn-small">Buka Login</button>
                </div>
                <p id="finderError" class="field-error" hidden></p>
              </form>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { HERO_EMAIL_KEY, storeLoginUrl, toSlug } from '../../platform/store-finder.ts';

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const summary = document.getElementById('errorSummary') as HTMLElement;
  const submit = document.getElementById('submitSignup') as HTMLButtonElement;
  const progressNote = document.getElementById('progressNote') as HTMLElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const slugBox = document.getElementById('slugBox') as HTMLElement;
  const slugPreviewUrl = document.getElementById('slugPreviewUrl') as HTMLElement;
  const slugHint = document.getElementById('slugHint') as HTMLElement;
  const slugSuggestions = document.getElementById('slugSuggestions') as HTMLElement;
  const nameInput = document.getElementById('storeName') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const whatsappInput = document.getElementById('whatsapp') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const toggle = document.getElementById('togglePassword') as HTMLButtonElement;
  const ruleLength = document.getElementById('ruleLength') as HTMLElement;
  const ruleDiff = document.getElementById('ruleDiff') as HTMLElement;
  const pwCount = document.getElementById('pwCount') as HTMLElement;

  const suffix = form.dataset.suffix || 'adsbook.my.id';
  const paket = form.dataset.paket || '';
  let slugTouched = false;
  let pending = false;

  // The home hero's account dialog hands its email over in this tab's session, never in the URL
  // (a page URL reaches the platform Pixel); read once, then forgotten.
  try {
    const handed = sessionStorage.getItem(HERO_EMAIL_KEY);
    sessionStorage.removeItem(HERO_EMAIL_KEY);
    if (handed && !emailInput.value) emailInput.value = handed.slice(0, 254);
  } catch {
    // Storage blocked: the seller types it again.
  }

  const cleanSlugTyping = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/--+/g, '-')
      .replace(/^-+/, '')
      .slice(0, 32);

  const updatePreviewUrl = () => {
    const val = slugInput.value.trim() || 'nama-toko';
    slugPreviewUrl.textContent = `https://${val}.${suffix}`;
  };

  const renderSuggestions = (items: string[]) => {
    slugSuggestions.innerHTML = '';
    if (!items || !items.length) {
      slugSuggestions.hidden = true;
      return;
    }
    const label = document.createElement('span');
    label.className = 'sug-label';
    label.textContent = 'Tersedia:';
    slugSuggestions.append(label);
    for (const item of items) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sug-chip';
      btn.textContent = `${item}.${suffix}`;
      btn.addEventListener('click', () => {
        slugTouched = true;
        slugInput.value = item;
        clearFieldError('slug');
        slugSuggestions.hidden = true;
        updatePreviewUrl();
        checkAvailability();
        slugInput.focus();
      });
      slugSuggestions.append(btn);
    }
    slugSuggestions.hidden = false;
  };

  let availabilityTimer = 0;
  let availabilitySeq = 0;
  const checkAvailability = () => {
    window.clearTimeout(availabilityTimer);
    const slug = slugInput.value.trim();
    updatePreviewUrl();
    if (!slug) {
      slugHint.textContent = 'Huruf kecil, angka, dan tanda hubung (3–32 karakter).';
      slugHint.dataset.state = 'neutral';
      slugBox.dataset.state = 'neutral';
      renderSuggestions([]);
      return;
    }
    if (slug.length < 3) {
      slugHint.textContent = 'Minimal 3 karakter.';
      slugHint.dataset.state = 'warn';
      slugBox.dataset.state = 'neutral';
      renderSuggestions([]);
      return;
    }
    slugHint.textContent = 'Memeriksa ketersediaan alamat…';
    slugHint.dataset.state = 'checking';
    const seq = ++availabilitySeq;
    availabilityTimer = window.setTimeout(async () => {
      const response = await fetch(`/api/platform/slug?slug=${encodeURIComponent(slug)}`).catch(() => null);
      const payload = await response?.json().catch(() => null);
      if (seq !== availabilitySeq || !payload?.success || slugInput.value.trim() !== slug) return;
      if (payload.data.available) {
        slugHint.textContent = `✓ ${slug}.${suffix} tersedia.`;
        slugHint.dataset.state = 'ok';
        slugBox.dataset.state = 'ok';
        renderSuggestions([]);
      } else {
        slugHint.textContent = payload.data.reason || 'Alamat toko ini tidak tersedia.';
        slugHint.dataset.state = 'err';
        slugBox.dataset.state = 'err';
        renderSuggestions(Array.isArray(payload.data.suggestions) ? payload.data.suggestions : []);
      }
    }, 240);
  };

  const updatePasswordChecklist = () => {
    const pw = password.value;
    const em = emailInput.value.trim().toLowerCase();
    const lenOk = pw.length >= 10 && pw.length <= 128;
    const diffOk = !pw || !em || pw.toLowerCase() !== em;
    pwCount.textContent = `(${Math.min(pw.length, 10)}/10)`;
    ruleLength.dataset.ok = String(lenOk);
    ruleDiff.dataset.ok = String(diffOk);
  };

  const fields: Record<string, { input: HTMLElement; error: HTMLElement }> = {
    storeName: { input: nameInput, error: document.getElementById('storeNameError') as HTMLElement },
    slug: { input: slugInput, error: document.getElementById('slugError') as HTMLElement },
    email: { input: emailInput, error: document.getElementById('emailError') as HTMLElement },
    whatsapp: { input: whatsappInput, error: document.getElementById('whatsappError') as HTMLElement },
    password: { input: password, error: document.getElementById('passwordError') as HTMLElement },
    terms: { input: document.getElementById('terms') as HTMLElement, error: document.getElementById('termsError') as HTMLElement },
    turnstile: { input: submit, error: document.getElementById('turnstileError') as HTMLElement },
  };

  const clearFieldError = (key: string) => {
    const entry = fields[key];
    if (!entry) return;
    entry.error.textContent = '';
    entry.error.hidden = true;
    if (entry.input !== submit) entry.input.removeAttribute('aria-invalid');
  };

  nameInput.addEventListener('input', () => {
    clearFieldError('storeName');
    if (!slugTouched) {
      slugInput.value = toSlug(nameInput.value);
      checkAvailability();
    }
  });

  slugInput.addEventListener('input', () => {
    slugTouched = slugInput.value.trim().length > 0;
    const cleaned = cleanSlugTyping(slugInput.value);
    if (slugInput.value !== cleaned) slugInput.value = cleaned;
    clearFieldError('slug');
    checkAvailability();
  });

  slugInput.addEventListener('blur', () => {
    const trimmed = slugInput.value.replace(/-+$/g, '');
    if (trimmed !== slugInput.value) {
      slugInput.value = trimmed;
      checkAvailability();
    }
  });

  emailInput.addEventListener('input', () => {
    clearFieldError('email');
    updatePasswordChecklist();
  });
  whatsappInput.addEventListener('input', () => clearFieldError('whatsapp'));
  password.addEventListener('input', () => {
    clearFieldError('password');
    updatePasswordChecklist();
  });
  document.getElementById('terms')?.addEventListener('change', () => clearFieldError('terms'));

  toggle.addEventListener('click', () => {
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Sembunyikan' : 'Lihat';
    toggle.setAttribute('aria-pressed', String(show));
    toggle.setAttribute('aria-label', `${show ? 'Sembunyikan' : 'Tampilkan'} password`);
  });

  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    pending = false;
    submit.disabled = false;
    submit.textContent = 'Buat toko';
    form.setAttribute('aria-busy', 'false');
    progressNote.hidden = true;
  });

  const showErrors = (message: string, errors: Record<string, string>, suggestions: string[] = []) => {
    let firstInvalid: HTMLElement | null = null;
    for (const [name, field] of Object.entries(fields)) {
      const text = errors[name] || '';
      field.error.textContent = text;
      field.error.hidden = !text;
      if (field.input !== submit) {
        if (text) {
          field.input.setAttribute('aria-invalid', 'true');
          if (!firstInvalid) firstInvalid = field.input;
        } else {
          field.input.removeAttribute('aria-invalid');
        }
      }
    }
    if (suggestions.length) renderSuggestions(suggestions);
    const listed = Object.values(errors).filter(Boolean);
    summary.textContent = listed.length ? `${message} ${listed.join(' ')}` : message;
    summary.hidden = false;
    (firstInvalid ?? summary).focus();
  };

  const PROVISION_STAGES = [
    'Memeriksa ketersediaan & mengamankan alamat toko…',
    'Menyiapkan database terisolasi khusus toko Anda…',
    'Mengatur kredensial pemilik & membuka dashboard admin…',
  ];

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (pending) return;
    pending = true;
    submit.disabled = true;
    submit.textContent = 'Membuat toko…';
    form.setAttribute('aria-busy', 'true');
    summary.hidden = true;

    let stageIdx = 0;
    progressNote.textContent = PROVISION_STAGES[0];
    progressNote.hidden = false;
    const stageTimer = window.setInterval(() => {
      stageIdx = Math.min(PROVISION_STAGES.length - 1, stageIdx + 1);
      progressNote.textContent = PROVISION_STAGES[stageIdx];
    }, 1100);

    const values = new FormData(form);
    const eventId = crypto.randomUUID();
    const turnstileToken = form.dataset.standin
      ? 'local-stand-in'
      : String(values.get('cf-turnstile-response') || '');

    let succeeded = false;
    try {
      const response = await fetch('/api/platform/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          store_name: values.get('store_name'),
          slug: values.get('slug'),
          email: values.get('email'),
          whatsapp: values.get('whatsapp'),
          password: values.get('password'),
          terms: values.get('terms') === 'on',
          turnstile_token: turnstileToken,
          event_id: eventId,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) {
        showErrors(
          payload.error || 'Pendaftaran gagal.',
          payload.errors || {},
          Array.isArray(payload.suggestions) ? payload.suggestions : [],
        );
        (window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
        return;
      }

      succeeded = true;
      const data = payload.data as {
        store_url: string;
        login_url: string;
        handoff_url: string | null;
        handoff_token: string | null;
        email: string;
      };
      const fbq = (window as unknown as { fbq?: (...args: unknown[]) => void }).fbq;
      try {
        fbq?.('track', 'CompleteRegistration', { content_name: 'signup', status: 'registered' }, { eventID: eventId });
      } catch {
        /* server CAPI still carries the event */
      }

      form.hidden = true;
      const finderWrap = document.querySelector('.login-finder') as HTMLElement | null;
      if (finderWrap) finderWrap.hidden = true;
      (document.getElementById('doneEmail') as HTMLElement).textContent = data.email;
      (document.getElementById('doneStoreUrl') as HTMLElement).textContent = data.store_url;
      (document.getElementById('doneAdminHref') as HTMLElement).textContent = `${data.store_url}/admin`;
      (document.getElementById('doneLogin') as HTMLAnchorElement).href = data.login_url;
      (document.getElementById('signupDone') as HTMLElement).hidden = false;

      if (data.handoff_url && data.handoff_token) {
        const handoff = document.createElement('form');
        handoff.method = 'POST';
        handoff.action = data.handoff_url;
        handoff.hidden = true;

        const tokenField = document.createElement('input');
        tokenField.type = 'hidden';
        tokenField.name = 'token';
        tokenField.value = data.handoff_token;
        handoff.append(tokenField);

        const nextField = document.createElement('input');
        nextField.type = 'hidden';
        nextField.name = 'next';
        nextField.value = paket ? `/admin/billing?cycle=${encodeURIComponent(paket)}` : '/admin/setup?welcome=1';
        handoff.append(nextField);

        document.body.append(handoff);
        if (fbq) await new Promise((resolve) => setTimeout(resolve, 280));
        handoff.submit();
      }
    } catch {
      showErrors('Koneksi terputus. Coba lagi.', {});
    } finally {
      window.clearInterval(stageTimer);
      if (!succeeded) {
        pending = false;
        submit.disabled = false;
        submit.textContent = 'Buat toko';
        form.setAttribute('aria-busy', 'false');
        progressNote.hidden = true;
      }
    }
  });

  // Store-finder for returning sellers ("Sudah punya toko?")
  const finderForm = document.getElementById('finderForm') as HTMLFormElement | null;
  const finderInput = document.getElementById('finderSlug') as HTMLInputElement | null;
  const finderError = document.getElementById('finderError') as HTMLElement | null;
  finderForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!finderInput || !finderError) return;
    const login = storeLoginUrl(finderInput.value, suffix, window.location);
    if ('error' in login) {
      finderError.textContent = login.error;
      finderError.hidden = false;
      return;
    }
    finderError.hidden = true;
    window.location.assign(login.url);
  });
</script>

<style>
  .signup-band { padding: 2rem 0 4.5rem; }
  .signup-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 3.5rem;
    align-items: start;
  }

  .signup-pitch { display: grid; gap: 1.25rem; padding-top: 0.5rem; }
  .eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-tint);
    display: inline-block;
    justify-self: start;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }
  .signup-pitch h1 { font-size: clamp(1.85rem, 1.35rem + 2vw, 2.65rem); }
  .lead-copy { color: var(--ink-muted); font-size: 1.05rem; }

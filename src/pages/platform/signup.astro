  .step-bar { grid-column: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .step-bar span { height: 3px; border-radius: 3px; background: #e2e8f0; transition: background-color 240ms cubic-bezier(0.22, 1, 0.36, 1); }
  .step-bar span[data-on="true"] { background: var(--accent); }
  .step-count { grid-column: 3; font: 600 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--slate); white-space: nowrap; }

  .picked-plan { margin: 0 0 0.75rem; padding: 0.45rem 0.75rem; border-radius: 10px; background: var(--accent-tint); color: var(--ink); font-size: 0.82rem; }
  .picked-plan span { color: var(--ink-muted); }

  .card-head { display: grid; gap: 0.15rem; margin-bottom: 1rem; }

  .slug-suggestions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .sug-label { font-size: 0.78rem; color: var(--ink-muted); font-weight: 600; }
  :global(.sug-chip) { appearance: none; border: 0; background: var(--accent-tint); color: var(--accent-hover); border-radius: 999px; padding: 0.25rem 0.7rem; min-height: 32px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; font-weight: 700; cursor: pointer; }
  :global(.sug-chip:hover) { background: #bfdbfe; }

  .field-hint { font-size: 0.8rem; color: var(--ink-muted); }
  .field-error { font-size: 0.8rem; font-weight: 600; color: #be123c; }

  .ctx-chip { justify-self: start; max-width: 100%; padding: 0.4rem 0.8rem; border-radius: 999px; background: var(--tile); font-size: 0.8rem; color: var(--ink-muted); overflow-wrap: anywhere; }
  .ctx-chip span:first-child { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700; color: var(--ink); }

  .pw-box { position: relative; display: flex; align-items: center; }
  .pw-box input { padding-right: 6.2rem !important; }
  .pw-toggle { position: absolute; right: 0.35rem; min-height: 38px; min-width: 4.5rem; padding: 0 0.65rem; border: 0; border-radius: 8px; background: var(--tile); color: var(--ink); font-size: 0.8rem; font-weight: 700; cursor: pointer; }
  .pw-rules { list-style: none; margin: 0.1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .pw-rules li { padding: 0.2rem 0.6rem; border-radius: 999px; background: var(--tile); font-size: 0.76rem; font-weight: 600; color: var(--ink-muted); transition: background-color 200ms ease-out, color 200ms ease-out; }
  .pw-rules li[data-ok="true"] { background: #dcfce7; color: #15803d; }
  .pw-rules li[data-ok="true"]::before { content: "✓ "; }

  .terms-row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.6rem; align-items: start; font-size: 0.85rem; font-weight: 500 !important; color: var(--ink-muted) !important; cursor: pointer; }
  .terms-row input[type="checkbox"] { width: 1.1rem; height: 1.1rem; margin-top: 0.15rem; accent-color: var(--accent); cursor: pointer; }
  .terms-row a { font-weight: 700; }

  /* The label may wrap under enlarged text; the button only grows. */
  .submit-btn { width: 100%; min-height: 48px; padding: 0.7rem 1rem; border: 0; border-radius: 999px; background: var(--accent); color: #fff; font: 700 0.98rem/1.25 var(--display); word-spacing: 0.06em; cursor: pointer; box-shadow: 0 8px 20px -10px rgb(37 99 235 / 0.5); }
  .submit-btn:hover { background: var(--accent-hover); }
  .submit-btn:disabled { opacity: 0.75; cursor: progress; }

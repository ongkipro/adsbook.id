---
import SiteLayout from '../../platform/site/SiteLayout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { tenantHostSuffix } from '../../platform/hostnames';
import { PLANS } from '../../platform/site/content.ts';
import { SIGNUP_PAGE } from '../../platform/site/site.ts';
import AuthSplit from '../../platform/site/AuthSplit.astro';

export const prerender = false;

// AUTH-MINIMALIST-STEP-UX-SPEC §4: signup as a three-step wizard inside one
// form (store, owner, security), so every step fits one screen and a password
// manager still sees the email and the new password together.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const siteKey = typeof env.TURNSTILE_SITE_KEY === 'string' ? env.TURNSTILE_SITE_KEY : '';
const localStandIn = siteKey === 'local-stand-in';
const suffix = tenantHostSuffix(env);

const rawPaket = Astro.url.searchParams.get('paket') ?? '';
const chosenPlan = PLANS.find((plan) => plan.code === rawPaket) ?? null;
// The returning seller's door moved to its own page (AUTH-LOGIN-REGISTER-UX-SPEC §2.3);
// an old "/daftar?masuk=1" link or bookmark lands there.
if (Astro.url.searchParams.get('masuk') === '1') return Astro.redirect('/masuk', 302);
---

<SiteLayout page={SIGNUP_PAGE} authStage>
  <AuthSplit active="daftar">
    <div class="wizard-head">
      <button id="stepBack" type="button" class="step-back" hidden>← Kembali</button>
      <div class="step-bar" aria-hidden="true"><span data-bar="1"></span><span data-bar="2"></span><span data-bar="3"></span></div>
      <p class="step-count" aria-live="polite">Langkah <span id="stepNow">1</span> / 3</p>
    </div>

    {chosenPlan && (
      <p class="picked-plan" role="note">Paket pilihan nanti: <strong>{chosenPlan.label} · {chosenPlan.price}</strong> <span>(belum ditagih)</span></p>
    )}

    <div class="card-head">
      <h1 class="dot-end">Buat toko gratis</h1>
      <p id="stepLead" class="step-lead">Jenis dan identitas toko</p>
    </div>

    <div id="errorSummary" class="error-banner" hidden role="alert" tabindex="-1"></div>

    <form
      method="post"
      id="signupForm"
      class="signup-form"
      novalidate
      aria-busy="false"
      data-step="1"
      data-suffix={suffix}
      data-standin={localStandIn ? '1' : ''}
      data-sitekey={localStandIn ? '' : siteKey}
      data-paket={chosenPlan?.code ?? ''}
    >
      <!-- Step 1 — the store: what it sells, its name, its address. -->
      <section class="step" data-step-panel="1" aria-label="Langkah 1 dari 3: jenis dan identitas toko">
        <fieldset class="catalog-choice">
          <legend>Fokus katalog awal</legend>
          <div class="catalog-options">
            <label class="catalog-option">
              <input type="radio" name="catalog_mode" value="physical" checked />
              <span class="catalog-title">Produk Fisik</span>
              <span class="catalog-sub">COD · ongkir · kontrol RTS</span>
            </label>
            <label class="catalog-option">
              <input type="radio" name="catalog_mode" value="digital" />
              <span class="catalog-title">Produk Digital</span>
              <span class="catalog-sub">Akses otomatis saat lunas</span>
            </label>
          </div>
          <p class="field-hint catalog-hint"><strong>Satu toko bisa keduanya.</strong> Mode Hybrid dapat diaktifkan kapan saja di Pengaturan › Toko.</p>
        </fieldset>

        <div class="field">
          <label for="storeName">Nama toko</label>
          <input id="storeName" name="store_name" type="text" required maxlength="80" autocomplete="organization" placeholder="Contoh: Herbal Nusantara" aria-describedby="storeNameError" />
          <p id="storeNameError" class="field-error" hidden></p>
        </div>

        <div class="field domain-field">
          <div class="domain-pill" id="slugPill" data-state="neutral">
            <span class="dp-url"><span id="slugPillHost">nama-toko</span>.{suffix}</span>
            <span id="slugHint" class="dp-status" aria-live="polite">Diisi dari nama toko</span>
            <button id="slugEdit" type="button" class="dp-edit" aria-expanded="false" aria-controls="slugEditor">Ubah</button>
          </div>
          <div id="slugEditor" class="slug-editor" hidden>
            <label for="slug">Alamat toko</label>
            <div class="slug-box" id="slugBox">
              <input id="slug" name="slug" type="text" required maxlength="32" autocomplete="off" spellcheck="false" inputmode="url" placeholder="herbal-nusantara" aria-describedby="slugHint slugError" />
              <span class="slug-suffix">.{suffix}</span>
            </div>
          </div>
          <div id="slugSuggestions" class="slug-suggestions" hidden aria-label="Saran alamat toko yang tersedia"></div>
          <p id="slugError" class="field-error" hidden></p>
        </div>

        <button id="toStep2" type="submit" class="submit-btn">Lanjut ke Akun Pemilik →</button>
      </section>

      <!-- Step 2 — the owner: the sign-in email and an optional WhatsApp. -->
      <section class="step" data-step-panel="2" aria-label="Langkah 2 dari 3: kontak pemilik" hidden>
        <p class="ctx-chip"><span id="ctxHost">nama-toko.{suffix}</span> · <span id="ctxMode">Produk Fisik</span></p>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="anda@email.com" aria-describedby="emailHint emailError" />
          <p id="emailHint" class="field-hint">1 email = 1 toko mandiri, dipakai masuk di adsbook.id/masuk.</p>
          <p id="emailError" class="field-error" hidden></p>
        </div>
        <div class="field">
          <div class="label-row">
            <label for="whatsapp">Nomor WhatsApp aktif</label>
            <span class="optional-tag">Opsional</span>
          </div>
          <input id="whatsapp" name="whatsapp" type="tel" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="0812-3456-7890" aria-describedby="whatsappHint whatsappError" />
          <p id="whatsappHint" class="field-hint">Menjadi kontak CS awal dan pengingat masa aktif.</p>
          <p id="whatsappError" class="field-error" hidden></p>
        </div>
        <button id="toStep3" type="submit" class="submit-btn">Lanjut ke Keamanan →</button>
      </section>

      <!-- Step 3 — security and launch. -->
      <section class="step" data-step-panel="3" aria-label="Langkah 3 dari 3: keamanan dan peluncuran" hidden>
        <div class="field">
          <label for="password">Password</label>
          <div class="pw-box">
            <input id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Minimal 10 karakter" aria-describedby="passwordRules passwordError" />
            <button id="togglePassword" type="button" class="pw-toggle" aria-controls="password" aria-pressed="false" aria-label="Tampilkan password">Lihat</button>
          </div>
          <ul id="passwordRules" class="pw-rules" aria-live="polite">
            <li id="ruleLength" data-ok="false">10+ karakter <span id="pwCount">(0/10)</span></li>
            <li id="ruleDiff" data-ok="true">Berbeda dari email</li>
          </ul>
          <p id="passwordError" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label class="terms-row">
            <input id="terms" name="terms" type="checkbox" required aria-describedby="termsError" />
            <span>Saya menyetujui <a href="/syarat" target="_blank" rel="noopener">Syarat Layanan Seller</a> dan <a href="/privasi" target="_blank" rel="noopener">Kebijakan Privasi</a> adsbook.id.</span>
          </label>
          <p id="termsError" class="field-error" hidden></p>
        </div>
        <p id="turnstileError" class="field-error" hidden role="alert"></p>
        <button id="submitSignup" type="submit" class="submit-btn">Buat Toko Gratis →</button>
        <p id="securityStatus" class="security-line" data-state={localStandIn || !siteKey ? 'ok' : 'pending'} aria-live="polite" hidden={!siteKey}>
          {localStandIn ? 'Koneksi terverifikasi · proteksi keamanan aktif' : 'Memverifikasi koneksi aman…'}
        </p>
        <p id="progressNote" class="progress-note" hidden aria-live="polite"></p>
      </section>

      <!-- The bot check runs from the first second, invisibly for almost every visitor;
           only a visitor it cannot clear sees a full-width check here, on any step. -->
      {siteKey && !localStandIn && <div id="turnstileWidget" class="turnstile-slot"></div>}
    </form>

    <!-- The launch, on the same card, before the handoff to the new store. -->
    <section id="signupDone" class="launch" hidden aria-live="polite">
      <h2 class="launch-title">Meluncurkan toko Anda</h2>
      <ol class="launch-steps">
        <li data-launch="1">Alamat toko dikunci · <code id="doneStoreUrl"></code></li>
        <li data-launch="2">Database mandiri diaktifkan</li>
        <li data-launch="3">Membuka dashboard toko Anda…</li>
      </ol>
      <p class="launch-note">Masuk dengan email <strong id="doneEmail"></strong>. Jika halaman tidak berpindah, <a id="doneLogin" href="#">masuk ke toko</a>.</p>
    </section>

    <Fragment slot="pitch">
      <h2 class="pitch-title dot-end">Satu ruang kendali presisi untuk pengiklan</h2>
      <p class="store-preview"><span class="sp-dot" aria-hidden="true"></span><span id="panelStoreUrl">nama-toko.{suffix}</span></p>
      <ul class="panel-checks">
        <li>Tracking 1:1 Meta, Google, dan TikTok dari server</li>
        <li data-mode="physical">COD, ongkir per kecamatan, dan kontrol RTS</li>
        <li data-mode="digital" hidden>Akses digital terbuka otomatis saat lunas</li>
        <li>0% komisi · Mode Preview gratis tanpa batas waktu</li>
      </ul>
      <!-- What the first minutes after signup ask, for the focus chosen in the form. -->
      <p class="next-steps" data-next-steps="physical">Setelah daftar: 4 langkah setup dipandu (produk, gudang, API key Mengantar, rekening bank).</p>
      <p class="next-steps" data-next-steps="digital" hidden>Setelah daftar: 2 langkah tanpa gudang (produk digital, pembayaran).</p>
    </Fragment>
  </AuthSplit>
</SiteLayout>

<script>
  import { toSlug } from '../../platform/store-finder.ts';

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const summary = document.getElementById('errorSummary') as HTMLElement;
  const submit = document.getElementById('submitSignup') as HTMLButtonElement;
  const progressNote = document.getElementById('progressNote') as HTMLElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const slugBox = document.getElementById('slugBox') as HTMLElement;
  const slugPill = document.getElementById('slugPill') as HTMLElement;
  const slugPillHost = document.getElementById('slugPillHost') as HTMLElement;
  const slugHint = document.getElementById('slugHint') as HTMLElement;
  const slugEdit = document.getElementById('slugEdit') as HTMLButtonElement;
  const slugEditor = document.getElementById('slugEditor') as HTMLElement;
  const slugSuggestions = document.getElementById('slugSuggestions') as HTMLElement;
  const nameInput = document.getElementById('storeName') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const whatsappInput = document.getElementById('whatsapp') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const toggle = document.getElementById('togglePassword') as HTMLButtonElement;
  const ruleLength = document.getElementById('ruleLength') as HTMLElement;
  const ruleDiff = document.getElementById('ruleDiff') as HTMLElement;
  const pwCount = document.getElementById('pwCount') as HTMLElement;
  const stepBack = document.getElementById('stepBack') as HTMLButtonElement;
  const stepNow = document.getElementById('stepNow') as HTMLElement;
  const stepLead = document.getElementById('stepLead') as HTMLElement;
  const security = document.getElementById('securityStatus') as HTMLElement;

  const suffix = form.dataset.suffix || 'adsbook.my.id';
  const paket = form.dataset.paket || '';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let slugTouched = false;
  let pending = false;
  // The button's resting label, restored after every refused attempt.
  const SUBMIT_LABEL = 'Buat Toko Gratis →';
  const STEP_LEADS = ['Jenis dan identitas toko', 'Kontak pemilik toko', 'Keamanan dan peluncuran'];

  // ---- steps -----------------------------------------------------------------
  let step = 1;
  const panels = [...form.querySelectorAll<HTMLElement>('[data-step-panel]')];
  const showStep = (next: number, focus?: HTMLElement | null, moveFocus = true) => {
    step = next;
    form.dataset.step = String(next);
    for (const panel of panels) panel.hidden = panel.dataset.stepPanel !== String(next);
    for (const bar of document.querySelectorAll<HTMLElement>('[data-bar]')) bar.dataset.on = String(Number(bar.dataset.bar) <= next);
    stepNow.textContent = String(next);
    stepLead.textContent = STEP_LEADS[next - 1];
    stepBack.hidden = next === 1;
    if (!moveFocus) return;
    const target = focus ?? panels[next - 1].querySelector<HTMLElement>('input:not([type="radio"])');
    // A focused field outside the viewport (zoomed text, a short screen) is scrolled into view.
    target?.focus();
  };
  stepBack.addEventListener('click', () => {
    summary.hidden = true;
    showStep(Math.max(1, step - 1));
  });

  const cleanSlugTyping = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/--+/g, '-')
      .replace(/^-+/, '')
      .slice(0, 32);

  const catalogMode = () => ((form.querySelector('input[name="catalog_mode"]:checked') as HTMLInputElement | null)?.value === 'digital' ? 'digital' : 'physical');
  const host = () => `${slugInput.value.trim() || 'nama-toko'}.${suffix}`;
  // The store's address, everywhere it is shown: the pill, step 2's chip, the panel's preview.
  const syncStoreContext = () => {
    slugPillHost.textContent = slugInput.value.trim() || 'nama-toko';
    for (const id of ['ctxHost', 'panelStoreUrl']) {
      const element = document.getElementById(id);
      if (element) element.textContent = host();
    }
    const mode = catalogMode();
    (document.getElementById('ctxMode') as HTMLElement).textContent = mode === 'digital' ? 'Produk Digital' : 'Produk Fisik';
    for (const item of document.querySelectorAll<HTMLElement>('[data-mode]')) item.hidden = item.dataset.mode !== mode;
    for (const note of document.querySelectorAll<HTMLElement>('[data-next-steps]')) note.hidden = note.dataset.nextSteps !== mode;
  };

  const openEditor = (focus = false) => {
    slugEditor.hidden = false;
    slugEdit.setAttribute('aria-expanded', 'true');
    if (focus) slugInput.focus();
  };
  slugEdit.addEventListener('click', () => {
    if (slugEditor.hidden) openEditor(true);
    else {
      slugEditor.hidden = true;
      slugEdit.setAttribute('aria-expanded', 'false');
    }
  });

  const renderSuggestions = (items: string[]) => {
    slugSuggestions.innerHTML = '';
    if (!items || !items.length) {
      slugSuggestions.hidden = true;
      return;
    }
    const label = document.createElement('span');
    label.className = 'sug-label';
    label.textContent = 'Tersedia:';
    slugSuggestions.append(label);
    for (const item of items) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sug-chip';
      btn.textContent = item;
      btn.addEventListener('click', () => {
        slugTouched = true;
        slugInput.value = item;
        clearFieldError('slug');
        slugSuggestions.hidden = true;
        checkAvailability();
        // The chip just clicked is gone: keyboard focus lands on the address it filled.
        slugInput.focus();
      });
      slugSuggestions.append(btn);
    }
    slugSuggestions.hidden = false;
  };

  const setSlugState = (state: 'neutral' | 'checking' | 'ok' | 'err' | 'warn', text: string) => {
    slugHint.textContent = text;
    slugHint.dataset.state = state;
    slugPill.dataset.state = state;
    slugBox.dataset.state = state === 'ok' || state === 'err' ? state : 'neutral';
  };

  let availabilityTimer = 0;
  let availabilitySeq = 0;
  let availability: Promise<void> = Promise.resolve();
  let settleAvailability: (() => void) | null = null;
  // Addresses the server refused at signup stay unavailable until the seller picks another.
  const rejectedSlugs = new Map<string, string>();
  const checkAvailability = () => {
    window.clearTimeout(availabilityTimer);
    // A superseded check settles at once (a waiting Continue re-reads the current inputs),
    // and its late answer is ignored.
    availabilitySeq += 1;
    settleAvailability?.();
    settleAvailability = null;
    const slug = slugInput.value.trim();
    syncStoreContext();
    if (!slug) {
      setSlugState('neutral', 'Diisi dari nama toko');
      renderSuggestions([]);
      return;
    }
    if (slug.length < 3) {
      setSlugState('warn', 'Minimal 3 karakter');
      renderSuggestions([]);
      return;
    }
    if (rejectedSlugs.has(slug)) {
      setSlugState('err', rejectedSlugs.get(slug)!);
      openEditor();
      return;
    }
    setSlugState('checking', 'Memeriksa…');
    const seq = availabilitySeq;
    availability = new Promise((resolve) => {
      settleAvailability = resolve;
      availabilityTimer = window.setTimeout(async () => {
        const response = await fetch(`/api/platform/slug?slug=${encodeURIComponent(slug)}`).catch(() => null);
        const payload = await response?.json().catch(() => null);
        if (seq === availabilitySeq && payload?.success && slugInput.value.trim() === slug) {
          if (payload.data.available) {
            setSlugState('ok', '✓ Tersedia');
            renderSuggestions([]);
          } else {
            setSlugState('err', payload.data.reason || 'Alamat toko ini tidak tersedia.');
            // A taken address opens the editor with free alternatives at once.
            openEditor();
            renderSuggestions(Array.isArray(payload.data.suggestions) ? payload.data.suggestions : []);
          }
        } else if (seq === availabilitySeq && slugHint.dataset.state === 'checking') {
          // No answer: the server decides on submit.
          setSlugState('neutral', 'Diperiksa saat membuat toko');
        }
        if (seq === availabilitySeq) settleAvailability = null;
        resolve();
      }, 240);
    });
  };

  const updatePasswordChecklist = () => {
    const pw = password.value;
    const em = emailInput.value.trim().toLowerCase();
    const lenOk = pw.length >= 10 && pw.length <= 128;
    const diffOk = !pw || !em || pw.toLowerCase() !== em;
    pwCount.textContent = lenOk ? '' : `(${Math.min(pw.length, 10)}/10)`;
    ruleLength.dataset.ok = String(lenOk);
    ruleDiff.dataset.ok = String(diffOk);
  };

  const fields: Record<string, { input: HTMLElement; error: HTMLElement; step: number }> = {
    storeName: { input: nameInput, error: document.getElementById('storeNameError') as HTMLElement, step: 1 },
    slug: { input: slugInput, error: document.getElementById('slugError') as HTMLElement, step: 1 },
    email: { input: emailInput, error: document.getElementById('emailError') as HTMLElement, step: 2 },
    whatsapp: { input: whatsappInput, error: document.getElementById('whatsappError') as HTMLElement, step: 2 },
    password: { input: password, error: document.getElementById('passwordError') as HTMLElement, step: 3 },
    terms: { input: document.getElementById('terms') as HTMLElement, error: document.getElementById('termsError') as HTMLElement, step: 3 },
    turnstile: { input: submit, error: document.getElementById('turnstileError') as HTMLElement, step: 3 },
  };

  const clearFieldError = (key: string) => {
    const entry = fields[key];
    if (!entry) return;
    entry.error.textContent = '';
    entry.error.hidden = true;
    if (entry.input !== submit) entry.input.removeAttribute('aria-invalid');
  };

  nameInput.addEventListener('input', () => {
    clearFieldError('storeName');
    if (!slugTouched) {
      slugInput.value = toSlug(nameInput.value);
      checkAvailability();
    }
  });
  slugInput.addEventListener('input', () => {
    slugTouched = slugInput.value.trim().length > 0;
    const cleaned = cleanSlugTyping(slugInput.value);
    if (slugInput.value !== cleaned) slugInput.value = cleaned;
    clearFieldError('slug');
    checkAvailability();
  });
  slugInput.addEventListener('blur', () => {
    const trimmed = slugInput.value.replace(/-+$/g, '');
    if (trimmed !== slugInput.value) {
      slugInput.value = trimmed;
      checkAvailability();
    }
  });
  form.addEventListener('change', (event) => {
    if ((event.target as HTMLElement).matches('input[name="catalog_mode"]')) syncStoreContext();
  });
  emailInput.addEventListener('input', () => {
    clearFieldError('email');
    updatePasswordChecklist();
  });
  whatsappInput.addEventListener('input', () => clearFieldError('whatsapp'));
  password.addEventListener('input', () => {
    clearFieldError('password');
    updatePasswordChecklist();
  });
  document.getElementById('terms')?.addEventListener('change', () => clearFieldError('terms'));

  toggle.addEventListener('click', () => {
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Sembunyikan' : 'Lihat';
    toggle.setAttribute('aria-pressed', String(show));
    toggle.setAttribute('aria-label', `${show ? 'Sembunyikan' : 'Tampilkan'} password`);
  });

  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    pending = false;
    submit.disabled = false;
    submit.textContent = SUBMIT_LABEL;
    form.setAttribute('aria-busy', 'false');
    progressNote.hidden = true;
  });

  /** Field errors on their steps: the wizard returns to the earliest step with one and focuses it. */
  const showErrors = (message: string, errors: Record<string, string>, suggestions: string[] = []) => {
    let first: { input: HTMLElement; step: number } | null = null;
    for (const [name, field] of Object.entries(fields)) {
      const text = errors[name] || '';
      field.error.textContent = text;
      field.error.hidden = !text;
      if (field.input !== submit) {
        if (text) field.input.setAttribute('aria-invalid', 'true');
        else field.input.removeAttribute('aria-invalid');
      }
      if (text && (!first || field.step < first.step)) first = { input: field.input, step: field.step };
    }
    if (errors.slug) {
      rejectedSlugs.set(slugInput.value.trim(), errors.slug);
      setSlugState('err', errors.slug);
      openEditor();
    }
    if (suggestions.length) {
      openEditor();
      renderSuggestions(suggestions);
    }
    const listed = Object.values(errors).filter(Boolean);
    summary.textContent = listed.length ? `${message} ${listed.join(' ')}` : message;
    summary.hidden = false;
    if (first) showStep(first.step, first.input === submit ? null : first.input);
    else summary.focus();
  };
  const stepError = (key: string, text: string) => {
    summary.hidden = true;
    const field = fields[key];
    field.error.textContent = text;
    field.error.hidden = false;
    field.input.setAttribute('aria-invalid', 'true');
    field.input.focus();
  };

  /** Step 1 and 2 checks before moving on; the server checks everything again. */
  const stepReady = async (current: number): Promise<boolean> => {
    if (current === 1) {
      const problem = (): [key: string, text: string] | null => {
        if (!nameInput.value.trim()) return ['storeName', 'Isi nama toko.'];
        if (slugInput.value.trim().length < 3) return ['slug', 'Alamat toko minimal 3 karakter.'];
        if (slugHint.dataset.state === 'err') return ['slug', 'Pilih alamat toko yang tersedia.'];
        return null;
      };
      // Wait for the check of the address as it is now; edits made while waiting start a new
      // check, so the wait follows them, and the inputs are judged again once it settles.
      for (let round = 0; round < 3 && !problem() && slugHint.dataset.state === 'checking'; round += 1) {
        await Promise.race([availability, new Promise((resolve) => setTimeout(resolve, 3000))]);
      }
      const found = problem();
      if (found) {
        if (found[0] === 'slug') openEditor();
        stepError(found[0], found[1]);
        return false;
      }
      return true;
    }
    if (current === 2) {
      if (!emailInput.value.trim() || !emailInput.checkValidity()) return stepError('email', 'Masukkan email yang valid, contoh: nama@email.com.'), false;
      return true;
    }
    return true;
  };

  // ---- the bot check: invisible unless a visitor needs it ---------------------
  let turnstileToken = form.dataset.standin ? 'local-stand-in' : '';
  let turnstileFailed = false;
  const tokenWaiters: Array<() => void> = [];
  const LOAD_FAILED = 'Pemeriksaan keamanan gagal dimuat. Periksa koneksi, lalu muat ulang halaman.';
  const setSecurity = (state: 'pending' | 'ok' | 'error', text: string) => {
    security.dataset.state = state;
    security.textContent = text;
  };
  type Turnstile = { render(element: HTMLElement, options: Record<string, unknown>): string; reset(id?: string): void };
  let widgetId: string | undefined;
  const widget = document.getElementById('turnstileWidget');
  if (widget && form.dataset.sitekey) {
    setSecurity('pending', 'Memverifikasi koneksi aman…');
    const failed = () => {
      turnstileFailed = true;
      setSecurity('error', LOAD_FAILED);
      tokenWaiters.splice(0).forEach((resolve) => resolve());
    };
    (window as unknown as Record<string, unknown>).__adsbookTurnstileReady = () => {
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      if (!turnstile) return failed();
      try {
        widgetId = turnstile.render(widget, {
          sitekey: form.dataset.sitekey,
          language: 'id',
          theme: 'light',
          size: 'flexible',
          appearance: 'interaction-only',
          callback: (token: string) => {
            turnstileToken = token;
            clearFieldError('turnstile');
            setSecurity('ok', 'Koneksi terverifikasi · proteksi keamanan aktif');
            tokenWaiters.splice(0).forEach((resolve) => resolve());
          },
          'error-callback': () => {
            turnstileToken = '';
            setSecurity('error', 'Verifikasi keamanan belum berhasil. Muat ulang halaman bila tidak pulih.');
          },
          'expired-callback': () => {
            turnstileToken = '';
            setSecurity('pending', 'Memperbarui verifikasi keamanan…');
            (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
          },
        });
      } catch {
        failed();
      }
    };
    const script = document.createElement('script');
    script.addEventListener('error', failed);
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__adsbookTurnstileReady';
    script.async = true;
    script.defer = true;
    document.head.append(script);
  }
  /** A token still in flight when the seller is faster: wait up to 4 seconds. Without one, nothing is sent. */
  const awaitToken = () =>
    turnstileToken || turnstileFailed
      ? Promise.resolve()
      : Promise.race([new Promise<void>((resolve) => tokenWaiters.push(resolve)), new Promise<void>((resolve) => setTimeout(resolve, 4000))]);

  const PROVISION_STAGES = [
    'Mengamankan alamat toko…',
    'Menyiapkan database terisolasi khusus toko Anda…',
    'Mengatur kredensial pemilik…',
  ];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, reduceMotion ? 0 : ms));
  /** While a signup is in flight nothing it sends can change: Back, the address editor and every step are locked. */
  const lockForm = (locked: boolean) => {
    stepBack.disabled = locked;
    slugEdit.disabled = locked;
    for (const panel of panels) panel.inert = locked;
  };
  /**
   * A token is single use: once a request carrying it may have reached the server,
   * it is spent, whether the answer was a refusal or never arrived. The real widget
   * is reset for a fresh one; the local stand-in token needs none.
   */
  const spendToken = () => {
    if (form.dataset.standin) return;
    turnstileToken = '';
    setSecurity('pending', 'Memverifikasi koneksi aman…');
    (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
  };
  const restoreSubmit = () => {
    lockForm(false);
    pending = false;
    submit.disabled = false;
    submit.textContent = SUBMIT_LABEL;
    form.setAttribute('aria-busy', 'false');
    progressNote.hidden = true;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (pending) return;
    if (step < 3) {
      const current = step;
      pending = true;
      const ready = await stepReady(current).finally(() => (pending = false));
      if (ready) {
        summary.hidden = true;
        showStep(current + 1);
      }
      return;
    }
    pending = true;
    // What is sent is what the seller confirmed with this click, read before any wait.
    const values = new FormData(form);
    const mode = catalogMode();
    lockForm(true);
    submit.disabled = true;
    form.setAttribute('aria-busy', 'true');
    summary.hidden = true;
    clearFieldError('turnstile');

    if (!turnstileToken) {
      submit.textContent = 'Menyelesaikan verifikasi keamanan…';
      await awaitToken();
      if (!turnstileToken) {
        // No request without a token: it would only spend one of the hour's attempts. The
        // check stays as it is (never reset here), so a visitor solving it keeps their progress.
        restoreSubmit();
        const error = fields.turnstile.error;
        error.textContent = turnstileFailed
          ? LOAD_FAILED
          : 'Verifikasi keamanan belum selesai. Selesaikan pemeriksaan di bawah formulir bila muncul, lalu tekan Buat Toko Gratis lagi.';
        error.hidden = false;
        return;
      }
    }
    submit.textContent = 'Membuat toko…';
    let stageIdx = 0;
    progressNote.textContent = PROVISION_STAGES[0];
    progressNote.hidden = false;
    const stageTimer = window.setInterval(() => {
      stageIdx = Math.min(PROVISION_STAGES.length - 1, stageIdx + 1);
      progressNote.textContent = PROVISION_STAGES[stageIdx];
    }, 1100);

    const eventId = crypto.randomUUID();

    let succeeded = false;
    let postAttempted = false;
    try {
      postAttempted = true;
      const response = await fetch('/api/platform/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          store_name: values.get('store_name'),
          slug: values.get('slug'),
          email: values.get('email'),
          whatsapp: values.get('whatsapp'),
          password: values.get('password'),
          terms: values.get('terms') === 'on',
          catalog_mode: mode,
          turnstile_token: turnstileToken,
          event_id: eventId,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) {
        // Unlocked first: the error moves focus into a step that must be usable.
        restoreSubmit();
        showErrors(
          payload.error || 'Pendaftaran gagal.',
          payload.errors || {},
          Array.isArray(payload.suggestions) ? payload.suggestions : [],
        );
        spendToken();
        return;
      }

      succeeded = true;
      const data = payload.data as { store_url: string; login_url: string; handoff_url: string | null; handoff_token: string | null; email: string };
      const fbq = (window as unknown as { fbq?: (...args: unknown[]) => void }).fbq;
      try {
        fbq?.('track', 'CompleteRegistration', { content_name: 'signup', status: 'registered' }, { eventID: eventId });
      } catch {
        /* server CAPI still carries the event */
      }

      // The launch sequence on the same card, then the handoff.
      form.hidden = true;
      for (const element of document.querySelectorAll<HTMLElement>('.wizard-head, .card-head, .picked-plan')) element.hidden = true;
      (document.getElementById('doneEmail') as HTMLElement).textContent = data.email;
      (document.getElementById('doneStoreUrl') as HTMLElement).textContent = data.store_url.replace(/^https?:\/\//, '');
      (document.getElementById('doneLogin') as HTMLAnchorElement).href = data.login_url;
      const done = document.getElementById('signupDone') as HTMLElement;
      done.hidden = false;
      for (const line of done.querySelectorAll<HTMLElement>('[data-launch]')) {
        line.dataset.on = 'true';
        await wait(380);
      }

      if (data.handoff_url && data.handoff_token) {
        const handoff = document.createElement('form');
        handoff.method = 'POST';
        handoff.action = data.handoff_url;
        handoff.hidden = true;
        for (const [name, value] of [['token', data.handoff_token], ['next', paket ? `/admin/billing?cycle=${encodeURIComponent(paket)}` : '/admin/setup?welcome=1']]) {
          const field = document.createElement('input');
          field.type = 'hidden';
          field.name = name;
          field.value = value;
          handoff.append(field);
        }
        document.body.append(handoff);
        handoff.submit();
      }
    } catch {
      // A lost answer after a successful signup leaves the page as it is (the launch and its
      // manual sign-in link stay); before that, the request may have spent the token.
      if (!succeeded) {
        restoreSubmit();
        if (postAttempted) spendToken();
        showErrors('Koneksi terputus. Coba lagi.', {});
      }
    } finally {
      window.clearInterval(stageTimer);
      if (!succeeded) restoreSubmit();
    }
  });

  showStep(1, null, false);
  syncStoreContext();
  form.dataset.ready = '1';
  if (window.matchMedia('(min-width: 960px)').matches) nameInput.focus({ preventScroll: true });
</script>

<style>
  /* ---- wizard head: back, a three-segment bar, the count ---- */

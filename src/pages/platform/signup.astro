  .optional-tag { font-size: 0.78rem; color: var(--ink-muted); font-weight: 500; }
  .field input[type="text"], .field input[type="email"], .field input[type="tel"], .field input[type="password"] {
    width: 100%;
    min-height: 46px;
    padding: 0.6rem 0.85rem;

---
import SiteLayout from '../../platform/site/SiteLayout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { tenantHostSuffix } from '../../platform/hostnames';
import { PLANS } from '../../platform/site/content.ts';
import { SIGNUP_PAGE } from '../../platform/site/site.ts';
import AuthSplit from '../../platform/site/AuthSplit.astro';

export const prerender = false;

// AUTH-MINIMALIST-STEP-UX-SPEC §4 and T-58 (PR-11): signup as a four-step wizard
// inside one form (store, owner, security, mailbox code), so every step fits one
// screen and a password manager still sees the email and the new password
// together. Nothing is created until the owner types the code mailed to the exact
// address: step 3 asks the server to send it, step 4 sends it back with the rest.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const siteKey = typeof env.TURNSTILE_SITE_KEY === 'string' ? env.TURNSTILE_SITE_KEY : '';
const localStandIn = siteKey === 'local-stand-in';
const suffix = tenantHostSuffix(env);

const rawPaket = Astro.url.searchParams.get('paket') ?? '';
const chosenPlan = PLANS.find((plan) => plan.code === rawPaket) ?? null;
// The returning seller's door moved to its own page (AUTH-LOGIN-REGISTER-UX-SPEC §2.3);
// an old "/daftar?masuk=1" link or bookmark lands there.
if (Astro.url.searchParams.get('masuk') === '1') return Astro.redirect('/masuk', 302);
---

<SiteLayout page={SIGNUP_PAGE} authStage>
  <AuthSplit active="daftar">
    <div class="wizard-head">
      <button id="stepBack" type="button" class="step-back" hidden>← Kembali</button>
      <div class="step-bar" aria-hidden="true"><span data-bar="1"></span><span data-bar="2"></span><span data-bar="3"></span><span data-bar="4"></span></div>
      <p class="step-count" aria-live="polite">Langkah <span id="stepNow">1</span> / 4</p>
    </div>

    {chosenPlan && (
      <p class="picked-plan" role="note">Paket pilihan nanti: <strong>{chosenPlan.label} · {chosenPlan.price}</strong> <span>(belum ditagih)</span></p>
    )}

    <div class="card-head">
      <h1 class="dot-end">Buat toko gratis</h1>
      <p id="stepLead" class="step-lead">Jenis dan alamat toko</p>
    </div>

    <div id="errorSummary" class="error-banner" hidden role="alert" tabindex="-1"></div>
    <!-- After step 1 only: the address is not confirmed yet (or turned out unavailable). -->
    <p id="slugNote" class="slug-note" role="status" hidden></p>

    <form
      method="post"
      id="signupForm"
      class="signup-form"
      novalidate
      aria-busy="false"
      data-step="1"
      data-suffix={suffix}
      data-standin={localStandIn ? '1' : ''}
      data-sitekey={localStandIn ? '' : siteKey}
      data-paket={chosenPlan?.code ?? ''}
    >
      <!-- Step 1 — the store: what it sells and its address. -->
      <section class="step" data-step-panel="1" aria-label="Langkah 1 dari 4: jenis dan alamat toko">
        <fieldset class="catalog-choice">
          <legend>Fokus katalog awal</legend>
          <div class="catalog-options">
            <label class="catalog-option">
              <input type="radio" name="catalog_mode" value="physical" checked />
              <span class="catalog-title">Produk Fisik</span>
              <span class="catalog-sub">COD · ongkir · kontrol RTS</span>
            </label>
            <label class="catalog-option">
              <input type="radio" name="catalog_mode" value="digital" />
              <span class="catalog-title">Produk Digital</span>
              <span class="catalog-sub">Akses otomatis saat lunas</span>
            </label>
          </div>
          <p class="field-hint catalog-hint"><strong>Satu toko bisa keduanya.</strong> Mode Hybrid dapat diaktifkan kapan saja di Pengaturan › Toko.</p>
        </fieldset>

        <!-- The store's address: the seller types only the prefix; the suffix is fixed. -->
        <div class="field">
          <label for="slug">Alamat toko</label>
          <div class="slug-box" id="slugBox">
            <input id="slug" name="slug" type="text" required maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" inputmode="url" placeholder="herbal-nusantara" aria-describedby="slugHint slugError" />
            <span class="slug-suffix">.{suffix}</span>
          </div>
          <p id="slugHint" class="field-hint slug-hint" aria-live="polite"></p>
          <div id="slugSuggestions" class="slug-suggestions" hidden aria-label="Saran alamat toko yang tersedia"></div>
          <p id="slugError" class="field-error" hidden></p>
        </div>

        <button id="toStep2" type="submit" class="submit-btn">Lanjut ke Nama &amp; Kontak →</button>
      </section>

      <!-- Step 2 — the store's name and the owner: the sign-in email and an optional WhatsApp. -->
      <section class="step" data-step-panel="2" aria-label="Langkah 2 dari 4: identitas dan kontak pemilik" hidden>
        <div class="field">
          <label for="storeName">Nama toko</label>
          <input id="storeName" name="store_name" type="text" required maxlength="80" autocomplete="organization" placeholder="Contoh: Herbal Nusantara" aria-describedby="storeNameError" />
          <p id="storeNameError" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="anda@email.com" aria-describedby="emailHint emailError" />
          <p id="emailHint" class="field-hint">1 email = 1 toko mandiri, dipakai masuk di adsbook.id/masuk.</p>
          <p id="emailError" class="field-error" hidden></p>
        </div>
        <div class="field">
          <div class="label-row">
            <label for="whatsapp">Nomor WhatsApp aktif</label>
            <span class="optional-tag">Opsional</span>
          </div>
          <input id="whatsapp" name="whatsapp" type="tel" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="0812-3456-7890" aria-describedby="whatsappHint whatsappError" />
          <p id="whatsappHint" class="field-hint">Menjadi kontak CS awal dan pengingat masa aktif.</p>
          <p id="whatsappError" class="field-error" hidden></p>
        </div>
        <button id="toStep3" type="submit" class="submit-btn">Lanjut ke Keamanan →</button>
      </section>

      <!-- Step 3 — security. The mailbox code is requested from here; nothing is created yet. -->
      <section class="step" data-step-panel="3" aria-label="Langkah 3 dari 4: keamanan akun" hidden>
        <div class="field">
          <label for="password">Password</label>
          <div class="pw-box">
            <input id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Minimal 10 karakter" aria-describedby="passwordRules passwordError" />
            <button id="togglePassword" type="button" class="pw-toggle" aria-controls="password" aria-pressed="false" aria-label="Tampilkan password">Lihat</button>
          </div>
          <ul id="passwordRules" class="pw-rules" aria-live="polite">
            <li id="ruleLength" data-ok="false">10+ karakter <span id="pwCount">(0/10)</span></li>
            <li id="ruleDiff" data-ok="true">Berbeda dari email</li>
          </ul>
          <p id="passwordError" class="field-error" hidden></p>
        </div>
        <div class="field">
          <label class="terms-row">
            <input id="terms" name="terms" type="checkbox" required aria-describedby="termsError" />
            <span>Saya menyetujui <a href="/syarat" target="_blank" rel="noopener">Syarat Layanan Seller</a> dan <a href="/privasi" target="_blank" rel="noopener">Kebijakan Privasi</a> adsbook.id.</span>
          </label>
          <p id="termsError" class="field-error" hidden></p>
        </div>
        <p id="sendTurnstileError" class="field-error" hidden role="alert"></p>
        <button id="sendCode" type="submit" class="submit-btn">Kirim kode ke email →</button>
      </section>

      <!-- Step 4 — the mailbox: the 8-digit code sent to the owner's email. It lives in memory only. -->
      <section class="step" data-step-panel="4" aria-label="Langkah 4 dari 4: verifikasi email" hidden>
        <div class="field">
          <label for="emailCode">Kode verifikasi</label>
          <input id="emailCode" class="code-input" name="email_code" type="text" required inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" placeholder="8 angka" aria-describedby="codeHint emailCodeError codeNote" />
          <p id="codeHint" class="field-hint code-hint"></p>
          <p id="emailCodeError" class="field-error" hidden></p>
          <!-- A live region without a status role: the page's one role=status is the progress note. -->
          <p id="codeNote" class="field-hint code-note" aria-live="polite"></p>
        </div>
        <div class="code-actions">
          <button id="resendCode" type="button" class="link-btn" disabled>Kirim ulang kode</button>
          <span id="resendWait" class="code-wait"></span>
          <button id="changeEmail" type="button" class="link-btn">Ganti email</button>
        </div>
        <p id="turnstileError" class="field-error" hidden role="alert"></p>
        <button id="submitSignup" type="submit" class="submit-btn">Buat Toko Gratis →</button>
      </section>

      <!-- Shared by steps 3 and 4: both calls carry a bot-check token. -->
      <div id="stepFoot" class="step-foot" hidden>
        <p id="securityStatus" class="security-line" data-state={localStandIn || !siteKey ? 'ok' : 'pending'} aria-live="polite" hidden={!siteKey}>
          {localStandIn ? 'Koneksi terverifikasi · proteksi keamanan aktif' : 'Memverifikasi koneksi aman…'}
        </p>
      </div>
    </form>

    <!-- Outside the form: while a signup waits, the steps are inert and the form is busy,
         but the wait is still announced and the check stays usable. -->
    <p id="progressNote" class="progress-note" role="status" aria-live="polite" hidden></p>
    <!-- The bot check runs from the first second, invisibly for almost every visitor;
         only a visitor it cannot clear sees a full-width check here, on any step. -->
    {siteKey && !localStandIn && <div id="turnstileWidget" class="turnstile-slot"></div>}

    <!-- The launch, on the same card, before the handoff to the new store. -->
    <section id="signupDone" class="launch" hidden aria-live="polite">
      <h2 class="launch-title">Meluncurkan toko Anda</h2>
      <ol class="launch-steps">
        <li data-launch="1">Alamat toko dikunci · <code id="doneStoreUrl"></code></li>
        <li data-launch="2">Database mandiri diaktifkan</li>
        <li data-launch="3">Membuka dashboard toko Anda…</li>
      </ol>
      <p class="launch-note">Masuk dengan email <strong id="doneEmail"></strong>. Jika halaman tidak berpindah, <a id="doneLogin" href="#">masuk ke toko</a>.</p>
    </section>

    <Fragment slot="pitch">
      <h2 class="pitch-title dot-end">Satu ruang kendali presisi untuk pengiklan</h2>
      <p class="store-preview"><span class="sp-dot" aria-hidden="true"></span><span id="panelStoreUrl">nama-toko.{suffix}</span></p>
      <ul class="panel-checks">
        <li>Tracking 1:1 Meta, Google, dan TikTok dari server</li>
        <li data-mode="physical">COD, ongkir per kecamatan, dan kontrol RTS</li>
        <li data-mode="digital" hidden>Akses digital terbuka otomatis saat lunas</li>
        <li>0% komisi · Mode Preview gratis tanpa batas waktu</li>
      </ul>
      <!-- What the first minutes after signup ask, for the focus chosen in the form. -->
      <p class="next-steps" data-next-steps="physical">Setelah daftar: 4 langkah setup dipandu (produk, gudang, API key Mengantar, rekening bank).</p>
      <p class="next-steps" data-next-steps="digital" hidden>Setelah daftar: 2 langkah tanpa gudang (produk digital, pembayaran).</p>
    </Fragment>
  </AuthSplit>
</SiteLayout>

<script>

  const form = document.getElementById('signupForm') as HTMLFormElement;
  const summary = document.getElementById('errorSummary') as HTMLElement;
  const submit = document.getElementById('submitSignup') as HTMLButtonElement;
  const progressNote = document.getElementById('progressNote') as HTMLElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const slugBox = document.getElementById('slugBox') as HTMLElement;
  const slugHint = document.getElementById('slugHint') as HTMLElement;
  const slugSuggestions = document.getElementById('slugSuggestions') as HTMLElement;
  const nameInput = document.getElementById('storeName') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const whatsappInput = document.getElementById('whatsapp') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const toggle = document.getElementById('togglePassword') as HTMLButtonElement;
  const ruleLength = document.getElementById('ruleLength') as HTMLElement;
  const ruleDiff = document.getElementById('ruleDiff') as HTMLElement;
  const pwCount = document.getElementById('pwCount') as HTMLElement;
  const stepBack = document.getElementById('stepBack') as HTMLButtonElement;
  const stepNow = document.getElementById('stepNow') as HTMLElement;
  const stepLead = document.getElementById('stepLead') as HTMLElement;
  const security = document.getElementById('securityStatus') as HTMLElement;
  const sendCode = document.getElementById('sendCode') as HTMLButtonElement;
  const emailCodeInput = document.getElementById('emailCode') as HTMLInputElement;
  const codeHint = document.getElementById('codeHint') as HTMLElement;
  const codeNote = document.getElementById('codeNote') as HTMLElement;
  const resendCode = document.getElementById('resendCode') as HTMLButtonElement;
  const resendWait = document.getElementById('resendWait') as HTMLElement;
  const changeEmail = document.getElementById('changeEmail') as HTMLButtonElement;
  const stepFoot = document.getElementById('stepFoot') as HTMLElement;

  const suffix = form.dataset.suffix || 'adsbook.my.id';
  const paket = form.dataset.paket || '';
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let pending = false;
  // The buttons' resting labels, restored after every refused attempt.
  const SUBMIT_LABEL = 'Buat Toko Gratis →';
  const SEND_LABEL = 'Kirim kode ke email →';
  const RESEND_LABEL = 'Kirim ulang kode';
  // T-58, the mailbox code. The server owns the real limits; these only shape the screen.
  const CODE_TTL_MINUTES = 10;
  // A held code is reused for a step back and forth, never close to its expiry.
  const CODE_REUSE_MS = (CODE_TTL_MINUTES - 1) * 60_000;
  const RESEND_COOLDOWN_MS = 60_000;
  const CODE_FORMAT_ERROR = 'Masukkan 8 angka kode dari email.';
  const CODE_MISSING = 'Kode belum dikirim untuk email ini. Kirim kode dulu.';
  const CODE_SEND_FAILED = 'Kode belum bisa dikirim. Coba lagi.';
  // How long Continue waits for an address check before moving on (the server checks again at signup).
  const SLUG_DECISION_MS = 1200;
  const SLUG_NOT_CONFIRMED = 'Belum sempat dicek; diperiksa lagi saat toko dibuat.';
  const SLUG_NOTE_PENDING = 'Alamat toko belum sempat dicek; diperiksa lagi saat toko dibuat.';
  const SLUG_NOTE_TAKEN = 'Alamat toko ternyata tidak tersedia; kembali ke langkah 1 untuk menggantinya.';
  const STEP_LEADS = ['Jenis dan alamat toko', 'Nama toko dan kontak pemilik', 'Keamanan akun', 'Verifikasi email'];

  // ---- steps -----------------------------------------------------------------
  let step = 1;
  const panels = [...form.querySelectorAll<HTMLElement>('[data-step-panel]')];
  const showStep = (next: number, focus?: HTMLElement | null, moveFocus = true) => {
    step = next;
    form.dataset.step = String(next);
    for (const panel of panels) panel.hidden = panel.dataset.stepPanel !== String(next);
    for (const bar of document.querySelectorAll<HTMLElement>('[data-bar]')) bar.dataset.on = String(Number(bar.dataset.bar) <= next);
    stepNow.textContent = String(next);
    stepLead.textContent = STEP_LEADS[next - 1];
    stepBack.hidden = next === 1;
    // Both calls that carry a bot-check token (steps 3 and 4) show its status and its errors.
    stepFoot.hidden = next < 3;
    syncSlugNote();
    if (!moveFocus) return;
    const target = focus ?? panels[next - 1].querySelector<HTMLElement>('input:not([type="radio"])');
    // A focused field outside the viewport (zoomed text, a short screen) is scrolled into view.
    target?.focus();
  };
  stepBack.addEventListener('click', () => {
    summary.hidden = true;
    showStep(Math.max(1, step - 1));
  });

  const cleanSlugTyping = (value: string) =>
    value
      .normalize('NFKD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/--+/g, '-')
      .replace(/^-+/, '')
      .slice(0, 32);

  const catalogMode = () => ((form.querySelector('input[name="catalog_mode"]:checked') as HTMLInputElement | null)?.value === 'digital' ? 'digital' : 'physical');
  const host = () => `${slugInput.value.trim() || 'nama-toko'}.${suffix}`;
  // The store's address in the studio panel's preview; the panel's points follow the catalog.
  const syncStoreContext = () => {
    const preview = document.getElementById('panelStoreUrl');
    if (preview) preview.textContent = host();
    const mode = catalogMode();
    for (const item of document.querySelectorAll<HTMLElement>('[data-mode]')) item.hidden = item.dataset.mode !== mode;
    for (const note of document.querySelectorAll<HTMLElement>('[data-next-steps]')) note.hidden = note.dataset.nextSteps !== mode;
  };

  // Suggestions belong to the address they were offered for, and go the moment it changes.
  let suggestionsFor = '';
  const renderSuggestions = (items: string[], forSlug = slugInput.value.trim()) => {
    suggestionsFor = items && items.length ? forSlug : '';
    slugSuggestions.innerHTML = '';
    if (!items || !items.length) {
      slugSuggestions.hidden = true;
      return;
    }
    const label = document.createElement('span');
    label.className = 'sug-label';
    label.textContent = 'Tersedia:';
    slugSuggestions.append(label);
    for (const item of items) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sug-chip';
      btn.textContent = item;
      btn.addEventListener('click', () => {
        slugInput.value = item;
        clearFieldError('slug');
        slugSuggestions.hidden = true;
        checkAvailability();
        // The chip just clicked is gone: keyboard focus lands on the address it filled.
        slugInput.focus();
      });
      slugSuggestions.append(btn);
    }
    slugSuggestions.hidden = false;
  };

  const setSlugState = (state: 'neutral' | 'checking' | 'ok' | 'err' | 'warn', text: string) => {
    slugHint.textContent = text;
    // No filler text, and no jump: the line keeps its height and is empty until there is something to say.
    slugHint.dataset.state = state;
    slugBox.dataset.state = state === 'ok' || state === 'err' ? state : 'neutral';
    syncSlugNote();
  };
  /**
   * Past step 1 the address's own status line is out of sight: one short note says it is not
   * confirmed yet (no answer in time, or a failed check), or that a late answer found it
   * unavailable; a late "available" removes it. The server still decides at signup.
   */
  function syncSlugNote() {
    const note = document.getElementById('slugNote');
    if (!note) return;
    const state = slugHint.dataset.state;
    const text = step === 1 ? '' : state === 'err' ? SLUG_NOTE_TAKEN : state === 'neutral' && slugHint.textContent === SLUG_NOT_CONFIRMED ? SLUG_NOTE_PENDING : '';
    note.textContent = text;
    note.dataset.state = state === 'err' ? 'err' : 'pending';
    note.hidden = !text;
  }

  let availabilityTimer = 0;
  let availabilitySeq = 0;
  let availability: Promise<void> = Promise.resolve();
  let settleAvailability: (() => void) | null = null;
  // The check still waiting for the typing pause (Continue runs it at once), and the request in flight.
  let scheduledCheck: (() => void) | null = null;
  let checkRequest: AbortController | null = null;
  // Addresses the server refused at signup stay unavailable until the seller picks another.
  const rejectedSlugs = new Map<string, string>();
  /** Voids the current check: its timer, its request (aborted) and anyone waiting on it (settled). */
  const voidCheck = () => {
    window.clearTimeout(availabilityTimer);
    scheduledCheck = null;
    availabilitySeq += 1;
    checkRequest?.abort();
    checkRequest = null;
    settleAvailability?.();
    settleAvailability = null;
  };
  const checkAvailability = () => {
    // A superseded check is cancelled and settles at once (a waiting Continue re-reads the
    // current inputs); an answer that still arrives is ignored.
    voidCheck();
    const slug = slugInput.value.trim();
    syncStoreContext();
    // Alternatives offered for another address never outlive it, even if this check is slow or fails;
    // the server's alternatives for this same (refused) address stay.
    if (suggestionsFor && suggestionsFor !== slug) renderSuggestions([]);
    if (!slug) {
      setSlugState('neutral', '');
      renderSuggestions([]);
      return;
    }
    if (slug.length < 3) {
      setSlugState('warn', 'Minimal 3 karakter');
      renderSuggestions([]);
      return;
    }
    if (rejectedSlugs.has(slug)) {
      setSlugState('err', rejectedSlugs.get(slug)!);
      return;
    }
    setSlugState('checking', 'Memeriksa…');
    const seq = availabilitySeq;
    availability = new Promise((resolve) => {
      settleAvailability = resolve;
      const run = async () => {
        scheduledCheck = null;
        const request = new AbortController();
        checkRequest = request;
        const response = await fetch(`/api/platform/slug?slug=${encodeURIComponent(slug)}`, { signal: request.signal }).catch(() => null);
        const payload = await response?.json().catch(() => null);
        if (seq === availabilitySeq && payload?.success && slugInput.value.trim() === slug) {
          if (payload.data.available) {
            setSlugState('ok', '✓ Tersedia');
            renderSuggestions([]);
          } else {
            setSlugState('err', payload.data.reason || 'Alamat toko ini tidak tersedia.');
            // A taken address shows free alternatives at once.
            renderSuggestions(Array.isArray(payload.data.suggestions) ? payload.data.suggestions : []);
          }
        } else if (seq === availabilitySeq && slugHint.dataset.state === 'checking') {
          // No answer: the server decides on submit.
          setSlugState('neutral', SLUG_NOT_CONFIRMED);
        }
        if (seq === availabilitySeq) {
          settleAvailability = null;
          checkRequest = null;
        }
        resolve();
      };
      // Typing: the trailing pause. Continue or Enter runs it at once (flushCheck).
      scheduledCheck = run;
      availabilityTimer = window.setTimeout(run, 240);
    });
  };
  /** Runs a check still waiting for the typing pause now; one already in flight is reused, not repeated. */
  const flushCheck = () => {
    const run = scheduledCheck;
    if (!run) return;
    window.clearTimeout(availabilityTimer);
    run();
  };

  const updatePasswordChecklist = () => {
    const pw = password.value;
    const em = emailInput.value.trim().toLowerCase();
    const lenOk = pw.length >= 10 && pw.length <= 128;
    const diffOk = !pw || !em || pw.toLowerCase() !== em;
    pwCount.textContent = lenOk ? '' : `(${Math.min(pw.length, 10)}/10)`;
    ruleLength.dataset.ok = String(lenOk);
    ruleDiff.dataset.ok = String(diffOk);
  };

  const isButton = (element: HTMLElement) => element instanceof HTMLButtonElement;
  const turnstileErrorStep3 = document.getElementById('sendTurnstileError') as HTMLElement;
  const turnstileErrorStep4 = document.getElementById('turnstileError') as HTMLElement;
  /** Both steps' bot-check errors: a fresh token, or a new call, answers whichever was showing. */
  const clearTurnstileErrors = () => {
    for (const error of [turnstileErrorStep3, turnstileErrorStep4]) {
      error.textContent = '';
      error.hidden = true;
    }
  };
  const fields: Record<string, { input: HTMLElement; error: HTMLElement; step: number }> = {
    storeName: { input: nameInput, error: document.getElementById('storeNameError') as HTMLElement, step: 2 },
    slug: { input: slugInput, error: document.getElementById('slugError') as HTMLElement, step: 1 },
    email: { input: emailInput, error: document.getElementById('emailError') as HTMLElement, step: 2 },
    whatsapp: { input: whatsappInput, error: document.getElementById('whatsappError') as HTMLElement, step: 2 },
    password: { input: password, error: document.getElementById('passwordError') as HTMLElement, step: 3 },
    terms: { input: document.getElementById('terms') as HTMLElement, error: document.getElementById('termsError') as HTMLElement, step: 3 },
    emailCode: { input: emailCodeInput, error: document.getElementById('emailCodeError') as HTMLElement, step: 4 },
    // The bot check answers for whichever call is open: the code request (step 3) or, on step 4,
    // the resend and the signup itself. Each step keeps its error above its own button.
    turnstile: {
      get input(): HTMLElement {
        return step >= 4 ? submit : sendCode;
      },
      get error(): HTMLElement {
        return step >= 4 ? turnstileErrorStep4 : turnstileErrorStep3;
      },
      get step(): number {
        return step >= 4 ? 4 : 3;
      },
    },
  };

  const clearFieldError = (key: string) => {
    const entry = fields[key];
    if (!entry) return;
    entry.error.textContent = '';
    entry.error.hidden = true;
    if (!isButton(entry.input)) entry.input.removeAttribute('aria-invalid');
  };

  // The store's name never rewrites its address: the address is chosen on step 1.
  nameInput.addEventListener('input', () => clearFieldError('storeName'));
  slugInput.addEventListener('input', () => {
    const cleaned = cleanSlugTyping(slugInput.value);
    if (slugInput.value !== cleaned) slugInput.value = cleaned;
    clearFieldError('slug');
    checkAvailability();
  });
  slugInput.addEventListener('blur', () => {
    const trimmed = slugInput.value.replace(/-+$/g, '');
    if (trimmed !== slugInput.value) {
      slugInput.value = trimmed;
      checkAvailability();
    }
  });
  form.addEventListener('change', (event) => {
    if ((event.target as HTMLElement).matches('input[name="catalog_mode"]')) syncStoreContext();
  });
  emailInput.addEventListener('input', () => {
    clearFieldError('email');
    updatePasswordChecklist();
    dropStaleChallenge();
  });
  whatsappInput.addEventListener('input', () => clearFieldError('whatsapp'));
  emailCodeInput.addEventListener('input', () => {
    // Digits only (a pasted "1234 5678" or "123-456-78" still fits), at most eight.
    const digits = emailCodeInput.value.replace(/\D+/g, '').slice(0, 8);
    if (emailCodeInput.value !== digits) emailCodeInput.value = digits;
    clearFieldError('emailCode');
    codeNote.textContent = '';
  });
  password.addEventListener('input', () => {
    clearFieldError('password');
    updatePasswordChecklist();
  });
  document.getElementById('terms')?.addEventListener('change', () => clearFieldError('terms'));

  toggle.addEventListener('click', () => {
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Sembunyikan' : 'Lihat';
    toggle.setAttribute('aria-pressed', String(show));
    toggle.setAttribute('aria-label', `${show ? 'Sembunyikan' : 'Tampilkan'} password`);
  });

  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    pending = false;
    submit.disabled = false;
    submit.textContent = SUBMIT_LABEL;
    sendCode.disabled = false;
    sendCode.textContent = SEND_LABEL;
    syncResend();
    form.setAttribute('aria-busy', 'false');
    progressNote.hidden = true;
  });

  // The button the open call came from, named in the bot-check copy: the code request, its resend, or the signup.
  let callLabel = 'Buat Toko Gratis';
  // The bot check failing at the server is recoverable here: a fresh token replaces the spent one.
  const tokenRetry = () => `Verifikasi keamanan perlu diulang. Tunggu tanda koneksi terverifikasi, lalu tekan ${callLabel} lagi.`;
  let shownErrors: { message: string; errors: Record<string, string> } | null = null;
  const renderSummary = () => {
    if (!shownErrors) return void (summary.hidden = true);
    const listed = Object.values(shownErrors.errors).filter(Boolean);
    if (!listed.length && !shownErrors.message) return void (summary.hidden = true);
    summary.textContent = listed.length ? `${shownErrors.message} ${listed.join(' ')}`.trim() : shownErrors.message;
    summary.hidden = false;
  };
  /** A fresh token answers the bot-check error alone; other errors stay as they are. */
  const clearTokenError = () => {
    clearTurnstileErrors();
    if (!shownErrors?.errors.turnstile) return;
    const { turnstile: _spent, ...rest } = shownErrors.errors;
    shownErrors = Object.values(rest).some(Boolean) ? { message: 'Pendaftaran belum selesai.', errors: rest } : null;
    renderSummary();
  };

  /** Field errors on their steps: the wizard returns to the earliest step with one and focuses it. */
  const showErrors = (message: string, rawErrors: Record<string, string>, suggestions: string[] = []) => {
    const errors = { ...rawErrors };
    if (errors.turnstile) {
      errors.turnstile = tokenRetry();
      // The server's own words ask for a reload; here a fresh token is all it takes.
      if (Object.keys(errors).filter((key) => errors[key]).length === 1) message = '';
    }
    let first: { input: HTMLElement; step: number } | null = null;
    for (const [name, field] of Object.entries(fields)) {
      const text = errors[name] || '';
      field.error.textContent = text;
      field.error.hidden = !text;
      if (!isButton(field.input)) {
        if (text) field.input.setAttribute('aria-invalid', 'true');
        else field.input.removeAttribute('aria-invalid');
      }
      if (text && (!first || field.step < first.step)) first = { input: field.input, step: field.step };
    }
    if (errors.slug) {
      // The server's word is final for this address: any check still running is void.
      voidCheck();
      rejectedSlugs.set(slugInput.value.trim(), errors.slug);
      setSlugState('err', errors.slug);
    }
    if (suggestions.length) renderSuggestions(suggestions);
    shownErrors = { message, errors };
    renderSummary();
    if (first) showStep(first.step, isButton(first.input) ? null : first.input);
    else summary.focus();
  };
  const stepError = (key: string, text: string) => {
    summary.hidden = true;
    const field = fields[key];
    field.error.textContent = text;
    field.error.hidden = false;
    field.input.setAttribute('aria-invalid', 'true');
    field.input.focus();
  };

  /** Step 1 and 2 checks before moving on; the server checks everything again. */
  const stepReady = async (current: number): Promise<boolean> => {
    if (current === 1) {
      const problem = (): [key: string, text: string] | null => {
        if (slugInput.value.trim().length < 3) return ['slug', 'Alamat toko minimal 3 karakter.'];
        if (rejectedSlugs.has(slugInput.value.trim()) || slugHint.dataset.state === 'err') return ['slug', 'Pilih alamat toko yang tersedia.'];
        return null;
      };
      // Known problems (too short, taken, reserved, refused by the server) block at once.
      // Otherwise the check of the address as it is now runs immediately, and Continue waits for
      // it within one deadline counted from this press: an edit while waiting starts (and runs)
      // a new check but never extends the wait, and the inputs are judged again at the end.
      const deadline = performance.now() + SLUG_DECISION_MS;
      // An address left unconfirmed earlier (no answer in time, or a failed check) is checked
      // afresh: a request that already missed one deadline is cancelled, not waited for again.
      if (!problem() && slugHint.dataset.state === 'neutral' && slugInput.value.trim().length >= 3) checkAvailability();
      while (!problem() && slugHint.dataset.state === 'checking') {
        const left = deadline - performance.now();
        if (left <= 0) break;
        flushCheck();
        await Promise.race([availability, new Promise((resolve) => setTimeout(resolve, left))]);
      }
      const found = problem();
      if (found) {
        stepError(found[0], found[1]);
        return false;
      }
      // No answer in time: say so (never "available" without an answer); the server checks it at signup.
      if (slugHint.dataset.state === 'checking') setSlugState('neutral', SLUG_NOT_CONFIRMED);
      return true;
    }
    if (current === 2) {
      if (!nameInput.value.trim()) return stepError('storeName', 'Isi nama toko.'), false;
      if (!emailInput.value.trim() || !emailInput.checkValidity()) return stepError('email', 'Masukkan email yang valid, contoh: nama@email.com.'), false;
      return true;
    }
    if (current === 3) {
      // Mirrors planSignup (src/platform/signup.ts; the server stays the authority). Asked here, before
      // the code is mailed, so a password or terms refusal can never cost the owner a code.
      const pw = password.value;
      if (pw.length < 10 || pw.length > 128) return stepError('password', 'Password 10–128 karakter.'), false;
      if (pw.toLowerCase() === normalizedEmail()) return stepError('password', 'Password tidak boleh sama dengan email.'), false;
      if (!(document.getElementById('terms') as HTMLInputElement).checked) return stepError('terms', 'Setujui syarat & ketentuan untuk melanjutkan.'), false;
      return true;
    }
    return true;
  };

  // ---- the bot check: invisible unless a visitor needs it ---------------------
  let turnstileToken = form.dataset.standin ? 'local-stand-in' : '';
  let turnstileFailed = false;
  const tokenWaiters: Array<() => void> = [];
  const LOAD_FAILED = 'Pemeriksaan keamanan gagal dimuat. Periksa koneksi, lalu muat ulang halaman.';
  const setSecurity = (state: 'pending' | 'ok' | 'error', text: string) => {
    security.dataset.state = state;
    security.textContent = text;
  };
  type Turnstile = { render(element: HTMLElement, options: Record<string, unknown>): string; reset(id?: string): void };
  let widgetId: string | undefined;
  const widget = document.getElementById('turnstileWidget');
  if (widget && form.dataset.sitekey) {
    setSecurity('pending', 'Memverifikasi koneksi aman…');
    const failed = () => {
      turnstileFailed = true;
      setSecurity('error', LOAD_FAILED);
      tokenWaiters.splice(0).forEach((resolve) => resolve());
    };
    (window as unknown as Record<string, unknown>).__adsbookTurnstileReady = () => {
      const turnstile = (window as unknown as { turnstile?: Turnstile }).turnstile;
      if (!turnstile) return failed();
      try {
        widgetId = turnstile.render(widget, {
          sitekey: form.dataset.sitekey,
          language: 'id',
          theme: 'light',
          size: 'flexible',
          appearance: 'interaction-only',
          callback: (token: string) => {
            turnstileToken = token;
            clearTokenError();
            setSecurity('ok', 'Koneksi terverifikasi · proteksi keamanan aktif');
            tokenWaiters.splice(0).forEach((resolve) => resolve());
          },
          'error-callback': () => {
            turnstileToken = '';
            setSecurity('error', 'Verifikasi keamanan belum berhasil dan sedang diulang otomatis.');
          },
          'expired-callback': () => {
            turnstileToken = '';
            setSecurity('pending', 'Memperbarui verifikasi keamanan…');
            (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
          },
        });
      } catch {
        failed();
      }
    };
    const script = document.createElement('script');
    script.addEventListener('error', failed);
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__adsbookTurnstileReady';
    script.async = true;
    script.defer = true;
    document.head.append(script);
  }
  /** A token still in flight when the seller is faster: wait up to 4 seconds. Without one, nothing is sent. */
  const awaitToken = () =>
    turnstileToken || turnstileFailed
      ? Promise.resolve()
      : Promise.race([new Promise<void>((resolve) => tokenWaiters.push(resolve)), new Promise<void>((resolve) => setTimeout(resolve, 4000))]);

  const PROVISION_STAGES = [
    'Mengamankan alamat toko…',
    'Menyiapkan database terisolasi khusus toko Anda…',
    'Mengatur kredensial pemilik…',
  ];
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, reduceMotion ? 0 : ms));
  /** While a signup is in flight nothing it sends can change: Back, the address editor and every step are locked. */
  const lockForm = (locked: boolean) => {
    stepBack.disabled = locked;
    for (const panel of panels) panel.inert = locked;
  };
  /**
   * A token is single use: once a request carrying it may have reached the server,
   * it is spent, whether the answer was a refusal or never arrived. The real widget
   * is reset for a fresh one; the local stand-in token needs none.
   */
  const spendToken = () => {
    if (form.dataset.standin) return;
    turnstileToken = '';
    setSecurity('pending', 'Memverifikasi koneksi aman…');
    (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(widgetId);
  };
  const restoreSubmit = () => {
    lockForm(false);
    pending = false;
    submit.disabled = false;
    submit.textContent = SUBMIT_LABEL;
    sendCode.disabled = false;
    sendCode.textContent = SEND_LABEL;
    resendCode.textContent = RESEND_LABEL;
    syncResend();
    form.setAttribute('aria-busy', 'false');
    progressNote.hidden = true;
  };

  // ---- the mailbox code (T-58, PR-11) -------------------------------------------------------
  // The challenge handle lives in this variable alone: never in storage, a cookie, the URL or the
  // DOM, so a reload starts the wizard over and nothing of it can be resumed from the page.
  // `email` is the normalised address the code is bound to (compared on every use); `shown` is it as typed.
  let challenge: { id: string; email: string; shown: string; at: number } | null = null;
  const normalizedEmail = () => emailInput.value.trim().toLowerCase();
  /** Once the address is edited, a code held for the old one is dropped with its typed digits; nothing re-binds it. */
  function dropStaleChallenge() {
    if (challenge && challenge.email !== normalizedEmail()) dropChallenge();
  }
  /** The code is gone (spent, or bound to an address that is no longer the one typed): nothing of it is reused. */
  function dropChallenge() {
    challenge = null;
    emailCodeInput.value = '';
    clearFieldError('emailCode');
    codeNote.textContent = '';
  }
  /** A code already sent to this address (same normalised address, not near its expiry) is used again, not re-sent. */
  const heldChallenge = () =>
    challenge && challenge.email === normalizedEmail() && Date.now() - challenge.at < CODE_REUSE_MS ? challenge : null;

  // The resend button waits out a short cooldown. Read from the clock on every tick, so a throttled
  // tab or a sleeping laptop still shows the true remainder. The server's own caps are the limit.
  let resendAt = 0;
  let resendTimer = 0;
  function syncResend() {
    const left = Math.ceil((resendAt - Date.now()) / 1000);
    if (left > 0) {
      resendWait.textContent = `Bisa kirim ulang dalam ${left} detik`;
      if (!resendTimer) resendTimer = window.setInterval(syncResend, 1000);
    } else {
      window.clearInterval(resendTimer);
      resendTimer = 0;
      resendWait.textContent = '';
    }
    resendCode.disabled = pending || left > 0;
  }

  const showCodeStep = (note: string) => {
    codeHint.textContent = `Kami mengirim kode 8 angka ke ${challenge?.shown ?? ''}. Berlaku ${CODE_TTL_MINUTES} menit; cek juga folder spam.`;
    codeNote.textContent = note;
    showStep(4, emailCodeInput);
  };

  /**
   * Every call that reaches the server carries a bot-check token, and a token is single use.
   * One still in flight is waited for (4 seconds at most); without one nothing is sent and
   * the call's button is restored. `label` is that button's resting text, named in the retry copy.
   */
  const ensureToken = async (button: HTMLButtonElement, label: string): Promise<boolean> => {
    callLabel = label.replace(/ →$/, '');
    if (turnstileToken) return true;
    button.textContent = 'Menyelesaikan verifikasi keamanan…';
    progressNote.textContent = 'Menyelesaikan verifikasi keamanan…';
    progressNote.hidden = false;
    await awaitToken();
    if (turnstileToken) return true;
    // No request without a token: it would only spend one of the hour's attempts. The
    // check stays as it is (never reset here), so a visitor solving it keeps their progress.
    restoreSubmit();
    const error = fields.turnstile.error;
    error.textContent = turnstileFailed
      ? LOAD_FAILED
      : `Verifikasi keamanan belum selesai. Selesaikan pemeriksaan di bawah formulir bila muncul, lalu tekan ${callLabel} lagi.`;
    error.hidden = false;
    // Focus went with the inert step; it returns to the button, unless the seller is
    // working in the check itself.
    if (!widget?.contains(document.activeElement)) button.focus();
    return false;
  };

  /** Step 3 and the resend: ask the server to mail a code to this address. Nothing is created by it. */
  const requestCode = async (resend: boolean) => {
    pending = true;
    // What is mailed is what the seller confirmed with this click, read before any wait.
    const email = emailInput.value.trim();
    const button = resend ? resendCode : sendCode;
    lockForm(true);
    button.disabled = true;
    syncResend();
    form.setAttribute('aria-busy', 'true');
    summary.hidden = true;
    clearTurnstileErrors();
    if (!(await ensureToken(button, resend ? RESEND_LABEL : SEND_LABEL))) return;
    // The request is on its way: the cooldown starts now, whatever comes back (the server's caps count attempts, not successes).
    resendAt = Date.now() + RESEND_COOLDOWN_MS;
    button.textContent = resend ? 'Mengirim ulang…' : 'Mengirim kode…';
    progressNote.textContent = `Mengirim kode ke ${email}…`;
    progressNote.hidden = false;
    try {
      const response = await fetch('/api/platform/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'request_email_code', email, turnstile_token: turnstileToken }),
      });
      const payload = await response.json().catch(() => ({}));
      if (response.ok && payload.success && typeof payload.challenge_id === 'string' && payload.challenge_id) {
        challenge = { id: payload.challenge_id, email: email.toLowerCase(), shown: email, at: Date.now() };
        emailCodeInput.value = '';
        clearFieldError('emailCode');
        restoreSubmit();
        showCodeStep(resend ? `Kode baru sudah dikirim ke ${email}. Pakai kode terbaru.` : '');
        return;
      }
      // A refusal or a malformed answer: the code held before (if any) is untouched.
      restoreSubmit();
      showErrors(payload.error || CODE_SEND_FAILED, payload.errors || {});
    } catch {
      restoreSubmit();
      showErrors('Koneksi terputus. Coba lagi.', {});
    } finally {
      // The request went out: its token is spent whatever came back, and the check is reset for the next call.
      spendToken();
    }
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (pending) return;
    if (step < 3) {
      const current = step;
      pending = true;
      const ready = await stepReady(current).finally(() => (pending = false));
      if (ready) {
        summary.hidden = true;
        showStep(current + 1);
      }
      return;
    }
    if (step === 3) {
      pending = true;
      const ready = await stepReady(3).finally(() => (pending = false));
      if (!ready) return;
      summary.hidden = true;
      // Back from step 4 and forward again with the same address: the code already sent is still the one.
      if (heldChallenge()) return void showCodeStep('');
      await requestCode(false);
      return;
    }
    // Step 4: the code is checked on the screen before a request is spent on it.
    const code = emailCodeInput.value.trim();
    const held = challenge && challenge.email === normalizedEmail() ? challenge : null;
    if (!held) {
      resendAt = 0;
      syncResend();
      return void stepError('emailCode', CODE_MISSING);
    }
    if (!/^\d{8}$/.test(code)) return void stepError('emailCode', CODE_FORMAT_ERROR);
    pending = true;
    // What is sent is what the seller confirmed with this click, read before any wait.
    const values = new FormData(form);
    const mode = catalogMode();
    lockForm(true);
    submit.disabled = true;
    syncResend();
    form.setAttribute('aria-busy', 'true');
    summary.hidden = true;
    clearTurnstileErrors();

    if (!(await ensureToken(submit, SUBMIT_LABEL))) return;
    submit.textContent = 'Membuat toko…';
    let stageIdx = 0;
    progressNote.textContent = PROVISION_STAGES[0];
    progressNote.hidden = false;
    const stageTimer = window.setInterval(() => {
      stageIdx = Math.min(PROVISION_STAGES.length - 1, stageIdx + 1);
      progressNote.textContent = PROVISION_STAGES[stageIdx];
    }, 1100);

    const eventId = crypto.randomUUID();

    let succeeded = false;
    let postAttempted = false;
    try {
      postAttempted = true;
      const response = await fetch('/api/platform/signup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          store_name: values.get('store_name'),
          slug: values.get('slug'),
          email: values.get('email'),
          whatsapp: values.get('whatsapp'),
          password: values.get('password'),
          terms: values.get('terms') === 'on',
          catalog_mode: mode,
          turnstile_token: turnstileToken,
          event_id: eventId,
          challenge_id: held.id,
          email_code: code,
        }),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.success) {
        // Unlocked first: the error moves focus into a step that must be usable.
        restoreSubmit();
        // A refusal about the store, the owner or the password sends the seller back to an earlier
        // step. The server may already have spent the code by then (it is claimed before the store
        // is reserved), so the page does not offer it again: the next step 3 mails a new one. A
        // wrong or expired code, a bot-check refusal or a general failure keeps the seller on this
        // step with the same challenge.
        const refused = (payload.errors || {}) as Record<string, string>;
        if (Object.entries(refused).some(([key, text]) => text && key !== 'emailCode' && key !== 'turnstile')) dropChallenge();
        showErrors(
          payload.error || 'Pendaftaran gagal.',
          payload.errors || {},
          Array.isArray(payload.suggestions) ? payload.suggestions : [],
        );
        spendToken();
        return;
      }

      succeeded = true;
      // The code is spent and the handle is not kept: nothing of the verification outlives the signup.
      challenge = null;
      emailCodeInput.value = '';
      const data = payload.data as { store_url: string; login_url: string; handoff_url: string | null; handoff_token: string | null; email: string };
      const fbq = (window as unknown as { fbq?: (...args: unknown[]) => void }).fbq;
      try {
        fbq?.('track', 'CompleteRegistration', { content_name: 'signup', status: 'registered' }, { eventID: eventId });
      } catch {
        /* server CAPI still carries the event */
      }

      // The launch sequence on the same card, then the handoff.
      form.hidden = true;
      progressNote.hidden = true;
      for (const element of document.querySelectorAll<HTMLElement>('.wizard-head, .card-head, .picked-plan, #slugNote')) element.hidden = true;
      (document.getElementById('doneEmail') as HTMLElement).textContent = data.email;
      (document.getElementById('doneStoreUrl') as HTMLElement).textContent = data.store_url.replace(/^https?:\/\//, '');
      (document.getElementById('doneLogin') as HTMLAnchorElement).href = data.login_url;
      const done = document.getElementById('signupDone') as HTMLElement;
      done.hidden = false;
      for (const line of done.querySelectorAll<HTMLElement>('[data-launch]')) {
        line.dataset.on = 'true';
        await wait(380);
      }

      if (data.handoff_url && data.handoff_token) {
        const handoff = document.createElement('form');
        handoff.method = 'POST';
        handoff.action = data.handoff_url;
        handoff.hidden = true;
        for (const [name, value] of [['token', data.handoff_token], ['next', paket ? `/admin/billing?cycle=${encodeURIComponent(paket)}` : '/admin/setup?welcome=1']]) {
          const field = document.createElement('input');
          field.type = 'hidden';
          field.name = name;
          field.value = value;
          handoff.append(field);
        }
        document.body.append(handoff);
        handoff.submit();
      }
    } catch {
      // A lost answer after a successful signup leaves the page as it is (the launch and its
      // manual sign-in link stay); before that, the request may have spent the token.
      if (!succeeded) {
        restoreSubmit();
        if (postAttempted) spendToken();
        showErrors('Koneksi terputus. Coba lagi.', {});
      }
    } finally {
      window.clearInterval(stageTimer);
      if (!succeeded) restoreSubmit();
    }
  });

  resendCode.addEventListener('click', () => {
    if (!pending) void requestCode(true);
  });
  // A wrong address is corrected on step 2; the code held for the old one is never used for the new one.
  changeEmail.addEventListener('click', () => {
    summary.hidden = true;
    showStep(2, emailInput);
  });

  showStep(1, null, false);
  syncStoreContext();
  form.dataset.ready = '1';
  if (window.matchMedia('(min-width: 960px)').matches) slugInput.focus({ preventScroll: true });
</script>

<style>
  /* ---- wizard head: back, a three-segment bar, the count ---- */
  .wizard-head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.75rem; margin-bottom: 1rem; min-height: 28px; }
  .step-back { grid-column: 1; border: 0; background: none; padding: 0.25rem 0; min-height: 28px; color: var(--slate); font-size: 0.85rem; font-weight: 700; cursor: pointer; }
  .step-back:hover { color: var(--accent); }
  .step-back[hidden] + .step-bar { grid-column: 1 / 3; }

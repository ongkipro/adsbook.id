---
import PlatformLayout from '../../components/platform/PlatformLayout.astro';
import { getRuntimeEnv } from '../../lib/env';
import { listTenants, STALE_HEARTBEAT_MS } from '../../platform/admin/tenants';
export const prerender = false;

// UX-4: the tenant list — control-plane fields only (TEN-6).
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const status = Astro.url.searchParams.get('status') || '';
const q = Astro.url.searchParams.get('q') || '';
const tenants = await listTenants(platformDb, { status: status || null, search: q || null });
const now = Date.now();
const age = (iso: string | null) => {
  if (!iso) return { text: 'belum ada', stale: true };
  const minutes = Math.round((now - Date.parse(iso)) / 60000);
  return { text: minutes < 60 ? `${minutes} mnt` : `${Math.round(minutes / 60)} jam`, stale: now - Date.parse(iso) > STALE_HEARTBEAT_MS };
};
const date = (iso: string | null) => (iso ? new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeZone: 'Asia/Jakarta' }).format(new Date(iso)) : '—');
const statuses = ['', 'active', 'suspended', 'provisioning', 'recovery', 'purging', 'purged'];
const tone: Record<string, string> = {
  active: 'bg-emerald-100 text-emerald-800', suspended: 'bg-amber-100 text-amber-900', recovery: 'bg-rose-100 text-rose-800',
  purging: 'bg-slate-200 text-slate-700', purged: 'bg-slate-100 text-slate-500', provisioning: 'bg-blue-100 text-blue-800',
};
---
<PlatformLayout title="Tenant" active="tenants">
  <h1 class="text-xl font-semibold text-slate-950">Tenant</h1>
  <form method="get" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end" role="search">
    <div class="sm:w-48">
      <label for="status" class="block text-xs font-semibold text-slate-700">Status</label>
      <select id="status" name="status" class="admin-input-flat mt-1">
        {statuses.map((value) => <option value={value} selected={value === status}>{value || 'Semua'}</option>)}
      </select>
    </div>
    <div class="flex-1">
      <label for="q" class="block text-xs font-semibold text-slate-700">Cari slug atau host</label>
      <input id="q" name="q" value={q} class="admin-input-flat mt-1" placeholder="toko-a atau tokosaya.com" />
    </div>
    <button type="submit" class="btn-primary">Terapkan</button>
  </form>

  <p class="mt-4 text-xs text-slate-500">{tenants.length} tenant</p>
  <ul class="mt-2 divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm md:hidden">
    {tenants.map((tenant) => {
      const beat = age(tenant.heartbeat_at);
      return (
        <li class="p-4">
          <a href={`/platform/tenants/${tenant.id}`} class="font-semibold text-blue-700 underline">{tenant.slug}</a>
          <span class={`ml-2 rounded-full px-2 py-0.5 text-xs font-semibold ${tone[tenant.status] ?? 'bg-slate-100'}`}>{tenant.status}</span>
          <p class="mt-1 break-all text-xs text-slate-600">{tenant.primary_host ?? '—'}</p>
          <p class="mt-1 text-xs text-slate-500">Paket {tenant.plan_id} · dibuat {date(tenant.created_at)} · heartbeat <span class={beat.stale && tenant.status === 'active' ? 'font-semibold text-rose-700' : ''}>{beat.text}</span> · backlog {tenant.outbox_backlog ?? 0}</p>
        </li>
      );
    })}
  </ul>
  <div class="mt-2 hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm md:block">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr><th class="px-4 py-3">Slug</th><th class="px-4 py-3">Host utama</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Paket</th><th class="px-4 py-3">Dibuat</th><th class="px-4 py-3">Aktivitas</th><th class="px-4 py-3">Heartbeat</th><th class="px-4 py-3 text-right">Backlog</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {tenants.map((tenant) => {
          const beat = age(tenant.heartbeat_at);
          return (
            <tr>
              <td class="px-4 py-3"><a href={`/platform/tenants/${tenant.id}`} class="font-semibold text-blue-700 underline">{tenant.slug}</a></td>
              <td class="px-4 py-3 font-mono text-xs">{tenant.primary_host ?? '—'}</td>
              <td class="px-4 py-3"><span class={`rounded-full px-2 py-0.5 text-xs font-semibold ${tone[tenant.status] ?? 'bg-slate-100'}`}>{tenant.status}</span></td>
              <td class="px-4 py-3">{tenant.plan_id}</td>
              <td class="px-4 py-3">{date(tenant.created_at)}</td>
              <td class="px-4 py-3">{date(tenant.last_activity)}</td>
              <td class={`px-4 py-3 ${beat.stale && tenant.status === 'active' ? 'font-semibold text-rose-700' : ''}`}>{beat.text}</td>
              <td class="px-4 py-3 text-right">{tenant.outbox_backlog ?? 0}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</PlatformLayout>

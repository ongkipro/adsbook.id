---
import SiteLayout from '../../platform/site/SiteLayout.astro';
import AuthSplit from '../../platform/site/AuthSplit.astro';
import { LOGIN_PAGE } from '../../platform/site/site.ts';
import { getRuntimeEnv } from '../../lib/env';
import { tenantHostSuffix } from '../../platform/hostnames';

export const prerender = false;

// AUTH-LOGIN-REGISTER-UX-SPEC §2.3: one sign-in door for every store. An email or
// username and a password; the store is found from the identifier, and the
// session opens on the store's own subdomain (POST /api/platform/masuk → /api/handoff).
const suffix = tenantHostSuffix((getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>);
---

<SiteLayout page={LOGIN_PAGE} authStage>
  <AuthSplit active="masuk">
    <div class="card-head">
      <h1 class="dot-end">Masuk ke dashboard toko</h1>
      <p>Email pemilik toko atau username tim Anda.</p>
    </div>

    <div id="loginError" class="error-banner" hidden role="alert" tabindex="-1"></div>

    <form id="loginForm" class="login-form" method="post" novalidate aria-busy="false">
      <div class="field">
        <label for="loginIdentifier">Email atau username</label>
        <input
          id="loginIdentifier"
          name="identifier"
          type="text"
          required
          maxlength="254"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          inputmode="email"
          placeholder="nama@email.com atau username"
          aria-describedby="loginIdentifier-error"
          data-msg-missing="Masukkan email atau username Anda."
        />
        <p id="loginIdentifier-error" class="field-error" hidden></p>
      </div>
      <div class="field">
        <label for="loginPassword">Password</label>
        <div class="password-box">
          <input
            id="loginPassword"
            name="password"
            type="password"
            required
            maxlength="1024"
            autocomplete="current-password"
            placeholder="Masukkan password"
            aria-describedby="loginPassword-error"
            data-msg-missing="Masukkan password Anda."
          />
          <button id="loginTogglePassword" type="button" class="toggle-pw" aria-controls="loginPassword" aria-pressed="false">Lihat</button>
        </div>
        <p id="loginPassword-error" class="field-error" hidden></p>
      </div>
      <button id="loginSubmit" type="submit" class="submit-btn">Masuk ke Dashboard →</button>
    </form>

    <!-- T-57 / PR-35: the second step, shown only after the password was accepted
         for a seller with two-step verification on. Never a field under the password. -->
    <form id="codeForm" class="login-form" method="post" novalidate aria-busy="false" hidden>
      <div class="step-note">
        <p class="step-title">Verifikasi dua langkah</p>
        <p>Masukkan 6 digit kode dari aplikasi autentikator Anda. Tidak bisa membuka aplikasinya? Pakai salah satu kode cadangan.</p>
      </div>
      <div class="field">
        <label for="loginCode">Kode verifikasi</label>
        <input
          id="loginCode"
          name="code"
          type="text"
          required
          maxlength="9"
          autocomplete="one-time-code"
          autocapitalize="none"
          spellcheck="false"
          inputmode="text"
          placeholder="123456"
          aria-describedby="loginCode-error"
          data-msg-missing="Masukkan kode verifikasi."
        />
        <p id="loginCode-error" class="field-error" hidden></p>
      </div>
      <button id="codeSubmit" type="submit" class="submit-btn">Verifikasi &amp; Masuk →</button>
      <button id="codeBack" type="button" class="link-btn">← Masuk dengan akun lain</button>
    </form>

    <p class="card-foot">Lupa password? <a href="/lupa-password">Buat password baru →</a></p>

    <Fragment slot="pitch">
      <h2 class="pitch-title dot-end">Satu pintu ke ruang kendali Anda</h2>
      <p class="pitch-lead">Sistem mengenali toko Anda dari email pemilik atau username tim, lalu membuka admin di alamat toko Anda sendiri.</p>
      <ul class="panel-checks">
        <li>Sesi terisolasi per toko</li>
        <li>Kredensial tersimpan terenkripsi</li>
        <li><span>Tetap bisa masuk lewat <code>nama-toko.{suffix}/hello</code></span></li>
      </ul>
    </Fragment>
  </AuthSplit>
</SiteLayout>

<script>
  import { bindInlineValidation, validateInline, setFieldError } from '../../lib/form-validation-id.ts';

  const form = document.getElementById('loginForm') as HTMLFormElement | null;
  const identifier = document.getElementById('loginIdentifier') as HTMLInputElement | null;
  const password = document.getElementById('loginPassword') as HTMLInputElement | null;
  const toggle = document.getElementById('loginTogglePassword') as HTMLButtonElement | null;
  const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
  const banner = document.getElementById('loginError') as HTMLElement | null;

  toggle?.addEventListener('click', () => {
    if (!password) return;
    const show = password.type === 'password';
    password.type = show ? 'text' : 'password';
    toggle.textContent = show ? 'Sembunyikan' : 'Lihat';
    toggle.setAttribute('aria-pressed', String(show));
  });

  const showError = (message: string) => {
    if (!banner) return;
    banner.textContent = message;
    banner.hidden = !message;
    if (message) banner.focus();
  };

  // The first field takes focus on a desktop only: a phone's keyboard never jumps up unasked.
  if (identifier && window.matchMedia('(min-width: 960px)').matches && !identifier.value) identifier.focus();

  // The handoff travels in a POST body to the store's own subdomain, never a URL.
  const redeemHandoff = (data: { handoff_url: string; handoff_token: string; next: string }) => {
    const handoff = document.createElement('form');
    handoff.method = 'POST';
    handoff.action = data.handoff_url;
    handoff.hidden = true;
    for (const [name, value] of [['token', data.handoff_token], ['next', data.next]]) {
      const field = document.createElement('input');
      field.type = 'hidden';
      field.name = name;
      field.value = String(value ?? '');
      handoff.append(field);
    }
    document.body.append(handoff);
    handoff.submit();
  };

  // T-57: the second step. The challenge lives in this page's memory only.
  const codeForm = document.getElementById('codeForm') as HTMLFormElement | null;
  const code = document.getElementById('loginCode') as HTMLInputElement | null;
  const codeSubmit = document.getElementById('codeSubmit') as HTMLButtonElement | null;
  const codeBack = document.getElementById('codeBack') as HTMLButtonElement | null;
  let pendingStep: { identifier: string; challenge: string } | null = null;

  const backToPassword = (message = '') => {
    pendingStep = null;
    if (codeForm) codeForm.hidden = true;
    if (form) form.hidden = false;
    if (code) code.value = '';
    if (password) { password.value = ''; }
    if (submit) { submit.disabled = false; submit.textContent = 'Masuk ke Dashboard →'; }
    form?.setAttribute('aria-busy', 'false');
    showError(message);
    if (!message) password?.focus();
  };

  const showCodeStep = (who: string, challenge: string) => {
    pendingStep = { identifier: who, challenge };
    if (password) password.value = '';
    if (form) form.hidden = true;
    if (codeForm) codeForm.hidden = false;
    code?.focus();
  };

  codeBack?.addEventListener('click', () => backToPassword());

  if (codeForm && code && codeSubmit) {
    bindInlineValidation(codeForm);
    codeForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      showError('');
      if (!validateInline(codeForm) || !pendingStep) return;
      codeSubmit.disabled = true;
      codeForm.setAttribute('aria-busy', 'true');
      codeSubmit.textContent = 'Memeriksa kode…';
      try {
        const response = await fetch('/api/platform/masuk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier: pendingStep.identifier, challenge: pendingStep.challenge, code: code.value }),
        });
        const payload = await response.json().catch(() => ({}));
        if (response.ok && payload.success) {
          codeSubmit.textContent = 'Membuka ruang kendali…';
          redeemHandoff(payload.data);
          return;
        }
        const message = payload.error || 'Kode belum bisa diperiksa. Coba lagi.';
        // A wrong code keeps the step; an ended challenge goes back to the password.
        if (response.status === 401 && !/^Kode verifikasi salah/.test(message)) return backToPassword(message);
        showError(message);
        code.value = '';
        code.focus();
      } catch {
        showError('Koneksi terputus. Coba lagi.');
      }
      codeSubmit.disabled = false;
      codeForm.setAttribute('aria-busy', 'false');
      codeSubmit.textContent = 'Verifikasi & Masuk →';
    });
  }

  if (form && identifier && password && submit) {
    bindInlineValidation(form);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      showError('');
      if (!validateInline(form)) return;
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      submit.textContent = 'Memeriksa kredensial…';
      try {
        const response = await fetch('/api/platform/masuk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identifier: identifier.value, password: password.value }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) throw new Error(payload.error || 'Masuk belum berhasil. Coba lagi.');
        if (payload.data?.two_step) {
          showCodeStep(identifier.value, String(payload.data.challenge));
          return;
        }
        submit.textContent = 'Membuka ruang kendali…';
        redeemHandoff(payload.data);
      } catch (error) {
        showError(error instanceof Error ? error.message : 'Masuk belum berhasil. Coba lagi.');
        setFieldError(password, '');
        password.value = '';
        password.focus();
        submit.disabled = false;
        form.setAttribute('aria-busy', 'false');
        submit.textContent = 'Masuk ke Dashboard →';
      }
    });
  }
</script>

<style>
  .card-head { display: grid; gap: 0.35rem; margin-bottom: 1.35rem; }
  .card-head h1 { font-size: clamp(1.45rem, 1.2rem + 1vw, 1.85rem); }
  .card-head p { color: var(--slate); font-size: 0.95rem; }
  .login-form { display: grid; gap: 1.1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-size: 0.875rem; font-weight: 700; color: var(--ink); }
  .field input {
    width: 100%;
    min-height: 48px;
    padding: 0 0.95rem;
    border-radius: 12px;
    border: 1px solid rgb(15 23 42 / 0.12);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }
  .field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgb(37 99 235 / 0.15); }
  .field input[aria-invalid="true"] { border-color: #e11d48; box-shadow: 0 0 0 3px rgb(225 29 72 / 0.12); }
  .password-box { position: relative; }
  .password-box input { padding-right: 7.5rem; }
  .toggle-pw {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    min-height: 40px;
    padding: 0 0.8rem;
    border: 0;
    border-radius: 9px;
    background: var(--tile);
    color: var(--ink);
    font: 600 0.82rem/1 var(--sans, inherit);
    cursor: pointer;
  }
  .field-error { display: flex; gap: 0.4rem; font-size: 0.82rem; font-weight: 500; color: #be123c; }
  .field-error::before { content: ""; width: 6px; height: 6px; margin-top: 0.4em; flex-shrink: 0; background: #e11d48; }
  .field-error[hidden] { display: none; }
  .error-banner { margin-bottom: 1rem; padding: 0.8rem 1rem; border-radius: 12px; background: #fff1f2; color: #9f1239; font-size: 0.9rem; font-weight: 600; }
  .error-banner[hidden] { display: none; }
  .submit-btn {
    min-height: 48px;
    margin-top: 0.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font: 700 0.98rem/1 var(--display);
    word-spacing: 0.06em;
    cursor: pointer;
    box-shadow: 0 8px 20px -10px rgb(37 99 235 / 0.5);
  }
  .submit-btn:hover { background: var(--accent-hover); }
  .submit-btn:disabled { opacity: 0.7; cursor: progress; }
  .login-form[hidden] { display: none; }
  .step-note { display: grid; gap: 0.3rem; padding: 0.85rem 1rem; border-radius: 12px; background: #eff6ff; color: #1e3a8a; font-size: 0.9rem; line-height: 1.5; }
  .step-title { font-weight: 700; color: var(--ink); }
  .link-btn { justify-self: center; min-height: 44px; padding: 0 0.75rem; border: 0; background: none; color: var(--accent); font: 600 0.9rem/1 var(--sans, inherit); cursor: pointer; }
  .card-foot { margin-top: 1.25rem; padding-top: 1.1rem; border-top: var(--hairline); font-size: 0.9rem; color: var(--slate); }
  .card-foot a { color: var(--accent); font-weight: 700; text-decoration: none; }
  .card-foot code, :global(.panel-checks code) { font-size: 0.85em; overflow-wrap: anywhere; }
  /* The label may wrap under enlarged text; the minimum height keeps one-line labels steady. */
  .submit-btn { padding: 0.7rem 1rem; line-height: 1.25; }
</style>

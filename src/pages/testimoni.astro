---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/storefront/shared/PageIntro.astro';
---

<BaseLayout
  shell="storefront"
  title={`Ulasan Pembeli - ${Astro.locals.tenant.name}`}
  description={`Halaman ulasan pembeli saat ini belum tersedia.`}
  noindex={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Ulasan Pembeli', url: '/testimoni' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-sf-ink">
    <PageIntro
      badge="Informasi"
      title="Ulasan Belum Tersedia"
      description="Sistem ulasan pembeli saat ini sedang dalam pengembangan dan belum dapat ditampilkan."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Ulasan' }]}
    />

    <div class="mx-auto max-w-[480px] px-5 py-12 text-center">
      <div class="rounded-sf-lg border border-sf-line bg-sf-surface p-8">
        <h2 class="text-[15px] font-semibold text-sf-ink">Belum ada ulasan</h2>
        <p class="mt-2 text-[13px] text-sf-text">
          Kami sedang mempersiapkan sistem baru untuk menampilkan ulasan pembeli yang terverifikasi.
        </p>
        <div class="mt-6">
          <a href="/" class="inline-flex min-h-12 w-full items-center justify-center rounded-sf bg-sf-accent px-5 text-sm font-semibold text-white transition-colors hover:bg-sf-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink">
            Kembali ke beranda
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

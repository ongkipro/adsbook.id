---
import { storefrontImageSrc } from '../lib/image-derivative';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProducts } from '../lib/catalog';

const relatedProducts = (await getStorefrontProducts(Astro.locals)).slice(0, 4).map((product) => ({
  name: product.productName,
  category: product.category,
  image: product.image,
  href: `/produk/${product.slug}`,
}));

// Reached through Astro.rewrite from the landing catch-all, which matches every
// unknown single-segment path. Without an explicit status a rewrite renders
// this page with 200, and a soft 404 is worse than the plain text it replaced.
Astro.response.status = 404;
---

<BaseLayout
  title={`Halaman Tidak Ditemukan - ${Astro.locals.tenant.name}`}
  description={`Maaf, halaman ${Astro.locals.tenant.name} yang Anda cari tidak ditemukan. Kembali ke beranda atau katalog produk.`}
  noindex={true}
>
  <main id="konten-utama" class="min-h-screen bg-white px-4 py-12 text-sf-ink">
    <section class="mx-auto max-w-[480px] py-6">
      <div class="text-center">
        <div
          class="relative mx-auto flex h-[92px] w-[92px] items-center justify-center rounded-full bg-white shadow-[inset_0_0_0_1px_var(--sf-line)]"
        >
          <span class="text-[34px] font-semibold tracking-[-0.06em] text-sf-ink">404</span>
        </div>

        <h1 class="mt-5 text-2xl font-bold leading-tight tracking-[-0.02em] text-sf-ink">
          Halaman tidak ditemukan
        </h1>

        <p class="mx-auto mt-2 max-w-[340px] text-sm leading-6 text-sf-text">
          Link yang Anda buka mungkin sudah dipindahkan atau produknya tidak dijual lagi.
        </p>
      </div>

      <div class="mt-7 grid gap-3">
        <a
          href="/"
          title={`Kembali ke beranda ${Astro.locals.tenant.name}`}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-sf bg-sf-accent px-5 text-[15px] font-semibold text-white transition-colors hover:bg-sf-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink"
        >
          <Icon name="lucide:home" class="h-4 w-4" aria-hidden="true" />
          <span>Kembali ke beranda</span>
        </a>
      </div>

      <section class="mt-10 border-t border-sf-line pt-6" aria-labelledby="produk-terkait-title">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 id="produk-terkait-title" class="text-lg font-bold tracking-[-0.01em] text-sf-ink">
              Mungkin ini yang Anda cari
            </h2>
          </div>
          <a
            href="/produk"
            title={`Lihat semua produk ${Astro.locals.tenant.name}`}
            class="inline-flex min-h-11 shrink-0 items-center text-sm font-semibold text-sf-accent underline-offset-4 hover:underline"
          >
            Lihat semua
          </a>
        </div>

        <div class="mt-4 divide-y divide-sf-line">
          {
            relatedProducts.map((product, index) => (
              <a
                href={product.href}
                title={`Lihat detail produk ${product.name}`}
                class="group grid grid-cols-[58px_1fr_auto] items-center gap-3 py-3 first:pt-0 last:pb-0"
                style={`animation-delay: ${index * 70}ms`}
              >
                <img
                  src={storefrontImageSrc(product.image)}
                  alt={`Foto produk ${product.name}`}
                  title={`Produk ${product.name}`}
                  class="h-[58px] w-[58px] rounded-sf border border-sf-line bg-sf-surface object-cover"
                  width="58"
                  height="58"
                  loading="lazy"
                  decoding="async"
                />
                <div class="min-w-0">
                  <p class="truncate text-[14px] font-semibold text-sf-ink">{product.name}</p>
                  <p class="mt-1 line-clamp-1 text-[12px] leading-5 text-sf-text">{product.category}</p>
                </div>
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 text-sf-ink transition-transform duration-200 group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>
      </section>
    </section>
  </main>

</BaseLayout>

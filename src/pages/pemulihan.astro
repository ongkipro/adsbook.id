---
import { BRAND_MARK, BRAND_WORDMARK, FAVICON_PNG } from '../lib/brand-assets';
import '../styles/admin.css';
export const prerender = false;
// IAM-9: the owner pastes the recovery code the platform gave them and sets a
// new password. The code stays in the form body, never in a URL.
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pulihkan akses - {Astro.locals.tenant.name}</title>
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK} />
    <link rel="icon" type="image/png" sizes="32x32" href={FAVICON_PNG} />
  </head>
  <body class="min-h-dvh bg-[#f6f7f9] text-slate-900 antialiased">
    <main class="mx-auto w-full max-w-md px-4 py-12">
      <img src={BRAND_WORDMARK} alt="adsbook.id" width="119" height="19" loading="eager" class="mb-5 h-[19px] w-auto" />
      <h1 class="text-xl font-semibold text-slate-950">Pulihkan akses owner</h1>
      <p class="mt-2 text-sm text-slate-600">Masukkan kode pemulihan dari tim adsbook.id, lalu buat password baru. Semua sesi lama akan keluar.</p>
      <form id="recoveryForm" class="mt-6 space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" novalidate>
        <div>
          <label for="token" class="block text-sm font-semibold">Kode pemulihan</label>
          <input id="token" name="token" required autocomplete="one-time-code" spellcheck="false" class="admin-input-flat mt-2 font-mono" />
        </div>
        <div>
          <label for="password" class="block text-sm font-semibold">Password baru</label>
          <input id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password" class="admin-input-flat mt-2" />
          <p class="mt-1 text-xs text-slate-500">Minimal 10 karakter.</p>
        </div>
        <p id="recoveryStatus" class="min-h-5 text-sm font-semibold" role="status" aria-live="polite"></p>
        <button id="recoverySubmit" type="submit" class="btn-primary w-full">Simpan password baru</button>
      </form>
      <p class="mt-4 text-sm"><a href="/hello" class="font-semibold text-blue-700 underline">Kembali ke halaman masuk</a></p>
    </main>
    <script>
      const form = document.getElementById('recoveryForm') as HTMLFormElement;
      const status = document.getElementById('recoveryStatus') as HTMLElement;
      const button = document.getElementById('recoverySubmit') as HTMLButtonElement;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity() || button.disabled) return;
        button.disabled = true;
        const values = new FormData(form);
        try {
          const response = await fetch('/api/owner-recovery', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: String(values.get('token') || '').trim(), password: values.get('password') }),
          });
          const payload = await response.json().catch(() => ({}));
          status.className = `min-h-5 text-sm font-semibold ${payload.success ? 'text-blue-700' : 'text-rose-700'}`;
          status.setAttribute('role', payload.success ? 'status' : 'alert');
          status.textContent = payload.success ? payload.message : payload.error || 'Gagal memulihkan akses.';
          if (payload.success) form.reset();
        } finally {
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>

---
import PageIntro from '../components/storefront/shared/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { footerLegal, footerNavigation } from '../data/site';
import { getStorefrontProducts } from '../lib/catalog';
import { listPublicLandingPages } from '../lib/landing-pages';

const mainLinks = [{ label: 'Beranda (Halaman Depan)', href: '/' }, ...footerNavigation];

// Read from D1 like /sitemap.xml does. This page used to render from compiled
// arrays that are now empty, so it listed no products at all.
const products = await getStorefrontProducts(Astro.locals);
const landingPages = (await listPublicLandingPages(Astro.locals).catch(() => []))
  // A claimed page's own slug only redirects to the product URL, which the
  // product list on this page already carries; listing it here would badge a
  // bouncing link as "Live".
  .filter((page) => !page.isProductPage);
---

<BaseLayout
  shell="storefront"
  title={`Sitemap Halaman - ${Astro.locals.tenant.name}`}
  description={`Daftar lengkap halaman penting website ${Astro.locals.tenant.name} untuk memudahkan penelusuran navigasi.`}
  noindex={true}
  follow
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Sitemap', url: '/sitemap' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-sf-ink">
    <PageIntro
      badge="Peta Situs"
      title="Sitemap Halaman"
      description={`Daftar lengkap halaman penting website ${Astro.locals.tenant.name} dalam satu tempat agar mudah ditelusuri.`}
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Sitemap' }]}
    />

    <div class="mx-auto max-w-[480px] space-y-6 px-4 py-6">
      <!-- Section 1: Halaman Utama & Navigasi -->
      <div class="rounded-sf-lg border border-sf-line bg-white p-5">
        <h2 class="flex items-center gap-2 text-base font-bold tracking-[-0.01em] text-sf-ink">
          <span class="h-2 w-2 rounded-full bg-sf-accent"></span>
          Navigasi Utama
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-2.5">
          {
            mainLinks.map((link) => (
              <a
                href={link.href}
                class="flex min-h-11 items-center justify-between rounded-sf border border-sf-line bg-sf-surface-soft px-4 py-2.5 text-sm font-semibold text-sf-text transition-colors hover:border-sf-line-strong hover:bg-sf-accent-soft hover:text-sf-ink"
              >
                <span>{link.label}</span>
                <span class="text-xs text-sf-muted" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Section 2: Produk & Landing Page -->
      <div class="rounded-sf-lg border border-sf-line bg-white p-5">
        <h2 class="flex items-center gap-2 text-base font-bold tracking-[-0.01em] text-sf-ink">
          <span class="h-2 w-2 rounded-full bg-sf-accent"></span>
          Produk & Halaman Promo
        </h2>

        <div class="mt-4 space-y-4">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-sf-text">Katalog Produk</h3>
            <div class="mt-2 grid grid-cols-2 gap-2">
              {
                products.map((product) => (
                  <a
                    href={`/produk/${product.slug}`}
                    class="block rounded-sf border border-sf-line bg-sf-surface-soft p-3 text-center transition-colors hover:border-sf-line-strong hover:bg-sf-accent-soft"
                  >
                    <p class="text-sm font-semibold text-sf-ink">{product.productName}</p>
                    <p class="mt-0.5 text-xs font-normal text-sf-text">{product.variants[0]?.label || ''}</p>
                  </a>
                ))
              }
            </div>
          </div>

          <div class="border-t border-sf-line pt-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-sf-text">Halaman Promo</h3>
            <div class="mt-2 space-y-2">
              {
                landingPages.map((item) => (
                  <a
                    href={item.href}
                    class="flex min-h-11 items-center justify-between gap-2 rounded-sf border border-sf-line bg-sf-surface-soft px-4 py-2.5 text-sm font-semibold text-sf-text transition-colors hover:border-sf-line-strong hover:bg-sf-accent-soft hover:text-sf-ink"
                  >
                    <span class="truncate">{item.title}</span>
                    <span class="shrink-0 rounded-sf-sm border border-sf-line bg-sf-accent-soft px-2 py-0.5 text-xs font-semibold text-sf-accent-strong">
                      Aktif
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4: Halaman Legal & Informasi -->
      <div class="rounded-sf-lg border border-sf-line bg-white p-5">
        <h2 class="flex items-center gap-2 text-base font-bold tracking-[-0.01em] text-sf-ink">
          <span class="h-2 w-2 rounded-full bg-sf-muted"></span>
          Legal & Informasi Tambahan
        </h2>
        <div class="mt-3 grid grid-cols-1 gap-1 text-sm">
          {
            footerLegal.map((link) => (
              <a
                href={link.href}
                class="flex min-h-10 items-center justify-between py-1.5 font-semibold text-sf-text transition-colors hover:text-sf-ink"
              >
                <span>{link.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- XML sitemap button -->
      <div class="pt-2 text-center">
        <a
          href="/sitemap.xml"
          target="_blank"
          class="inline-flex min-h-11 items-center gap-2 rounded-sf border border-sf-line bg-white px-4 py-2 text-xs font-semibold text-sf-text transition-colors hover:border-sf-ink hover:text-sf-ink"
        >
          <svg class="h-4 w-4 text-sf-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M4 11.189v-1.189c0-.552.448-1 1-1h6c.552 0 1 .448 1 1v1.189c0 .552-.448 1-1 1H5c-.552 0-1-.448-1-1zm0 4.811c0-.552.448-1 1-1h6c.552 0 1 .448 1 1v1.189c0 .552-.448 1-1 1H5c-.552 0-1-.448-1-1v-1.189zm8.583-12h2.417c.552 0 1 .448 1 1v1.189c0 .552-.448 1-1 1h-2.417c-.552 0-1-.448-1-1v-1.189c0-.552.448-1 1-1zm2.417 6c.552 0 1 .448 1 1v1.189c0 .552-.448 1-1 1h-2.417c-.552 0-1-.448-1-1v-1.189c0-.552.448-1 1-1h2.417zm-1.417 6v1.189c0 .552-.448 1 1 1h-2.583c-.552 0-1-.448-1-1v-1.189c0-.552.448-1 1-1h2.583c.552 0 1 .448 1 1zm5.417-12c.552 0 1 .448 1 1v1.189c0 .552-.448 1-1 1h-2.417c-.552 0-1-.448-1-1v-1.189c0-.552.448-1 1-1h2.417z"
            ></path>
          </svg>
          Lihat XML Sitemap (Mesin Pencari)
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

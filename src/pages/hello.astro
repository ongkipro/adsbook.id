---
import { BRAND_MARK, BRAND_WORDMARK, BRAND_WORDMARK_ON_DARK, FAVICON_PNG, FAVICON_192 } from '../lib/brand-assets';
import { tenantDatabase } from '../lib/tenant-database.ts';
import '../styles/admin.css';
import {
  DEFAULT_ADMIN_PASSWORD_HASH,
  getAdminCredential,
  getAdminCredentialById,
  isDefaultAdminCredential,
  normalizeAdminUsername,
  verifyAdminLoginPassword,
  type AdminCredential,
} from '../lib/admin-credentials';
import {
  SESSION_COOKIE_NAME,
  SESSION_COOKIE_OPTIONS,
  secureEqual,
  signJwt,
  verifyPasswordHash,
} from '../lib/auth';
import { storeAdminSession } from '../lib/admin-session';
import { resolveAuthSecret } from '../lib/auth-secret';
import {
  checkAdminLoginRateLimit,
  spendAdminLoginAttempt,
  clearAdminLoginFailures,
  getClientIp,
  recordAdminLoginFailure,
} from '../lib/rate-limit';

import { CMS_VERSION } from '../lib/version';
import {
  CHALLENGE_TTL_MS,
  TWO_STEP_COOKIE_NAME,
  TWO_STEP_COOKIE_OPTIONS,
  challengeRefusal,
  createLoginChallenge,
  forgotPasswordUrl,
  redeemLoginChallenge,
  twoStepEnabled,
} from '../lib/seller-two-step';

export const prerender = false;

let errorMessage = '';
let submittedUsername = '';
let focusPassword = false;
// T-57 / PR-35: the second step, rendered only after a correct password for an enrolled seller.
let codeStep = false;
const lupaPasswordUrl = forgotPasswordUrl(Astro.url);

const database = tenantDatabase(Astro.locals);

// The middleware's cross-site guard only covers /api/admin/*, and this form
// posts to itself — so the login POST needs its own origin check. Without it a
// third-party page can silently log an admin into an attacker's session.
const loginOrigin = Astro.request.headers.get('origin');
const loginFetchSite = Astro.request.headers.get('sec-fetch-site');
// `same-site` too: another seller's host shares the parent domain, and a login
// posted from there would fix the victim into the attacker's session (T-22).
const crossSiteLogin =
  (loginOrigin !== null && loginOrigin !== Astro.url.origin) ||
  loginFetchSite === 'cross-site' ||
  loginFetchSite === 'same-site';

if (Astro.request.method === 'POST' && crossSiteLogin) {
  Astro.response.status = 403;
  errorMessage = 'Permintaan login ditolak karena berasal dari domain lain.';
} else if (Astro.request.method === 'POST') {
  const authSecret = await resolveAuthSecret(database, Astro.locals.tenantContext?.tenantId);
  const clientIp = getClientIp(Astro.request.headers);

  // The one place a session opens on this page: after the password alone, or after the code.
  const openSession = async (credential: AdminCredential) => {
    const { token, session } = await signJwt({ username: credential.username, role: credential.role }, authSecret);
    await Promise.all([
      storeAdminSession(database!, session, credential),
      clearAdminLoginFailures(database!, credential.username, clientIp),
    ]);
    Astro.cookies.set(SESSION_COOKIE_NAME, token, { ...SESSION_COOKIE_OPTIONS, maxAge: 60 * 60 * 24 });
    return Astro.redirect(credential.mustChangePassword ? '/admin/profile' : '/admin/dashboard');
  };

  try {
    if (!database || authSecret.length < 32) {
      Astro.response.status = 503;
      errorMessage = 'Login admin belum dikonfigurasi di server.';
    } else {
      const data = await Astro.request.formData();
      if (data.get('step') === 'code') {
        // T-57: the challenge the password step set. No session exists until this succeeds,
        // and only for the credential revision the password was checked against.
        const outcome = await redeemLoginChallenge(database, Astro.cookies.get(TWO_STEP_COOKIE_NAME)?.value, String(data.get('code') || '').slice(0, 32));
        const credential = outcome.ok ? await getAdminCredentialById(database, outcome.credentialId) : null;
        if (outcome.ok && credential && credential.updatedAt === outcome.credentialUpdatedAt && !isDefaultAdminCredential(credential)) {
          Astro.cookies.delete(TWO_STEP_COOKIE_NAME, TWO_STEP_COOKIE_OPTIONS);
          return await openSession(credential);
        }
        const reason = outcome.ok ? 'invalid' : outcome.reason;
        Astro.response.status = 401;
        errorMessage = challengeRefusal(reason);
        codeStep = reason === 'wrong_code';
        if (!codeStep) Astro.cookies.delete(TWO_STEP_COOKIE_NAME, TWO_STEP_COOKIE_OPTIONS);
      } else {
        const username = normalizeAdminUsername(data.get('username'));
        submittedUsername = username;
        const password = String(data.get('password') || '').slice(0, 1024);

        // LOGIN-19. Checked before the credential is even looked up, so the limit
        // behaves identically for a username that exists and one that does not —
        // otherwise the rate limiter itself answers the question the error message
        // refuses to. Nothing is spent here; only a failure is recorded, below.
        // The wave brake first: spent atomically by every attempt, so parallel
        // guesses cannot all slip past the peek below (see spendAdminLoginAttempt).
        const wave = await spendAdminLoginAttempt(database, username, clientIp);
        const attempts = wave.allowed
          ? await checkAdminLoginRateLimit(database, username, clientIp)
          : wave;
        if (!attempts.allowed) {
          Astro.response.status = 429;
          Astro.response.headers.set(
            'retry-after',
            String(Math.max(1, Math.ceil((attempts.resetAt - Date.now()) / 1000))),
          );
          errorMessage = 'Terlalu banyak percobaan login. Coba lagi dalam beberapa menit.';
        } else {
          const credential = await getAdminCredential(database, username);

          // LOGIN-13. Every branch here must cost the same. Verifying a rotated
          // password is one PBKDF2 pass at 100k iterations; the seeded credential
          // is a digest compare, and an unknown username used to cost nothing at
          // all — so those two run a discarded verification against the seeded
          // hash. Without it a fast 401 means "no such operator" and a slow one
          // means "that one exists", which is the fact the message withholds.
          const needsWorkFloor = credential === null || isDefaultAdminCredential(credential);
          const [usernameMatches, passwordMatches] = await Promise.all([
            credential ? secureEqual(username, credential.username) : Promise.resolve(false),
            credential
              ? verifyAdminLoginPassword(password, credential)
              : Promise.resolve(false),
            needsWorkFloor
              ? verifyPasswordHash(password, DEFAULT_ADMIN_PASSWORD_HASH)
              : Promise.resolve(false),
          ]);

          if (credential && usernameMatches && passwordMatches) {
            if (!(await twoStepEnabled(database, credential.id))) return await openSession(credential);
            // PR-35: the password was right; the session waits for the code, on its own step.
            const challenge = await createLoginChallenge(database, { id: credential.id, updatedAt: credential.updatedAt });
            await clearAdminLoginFailures(database, username, clientIp);
            Astro.cookies.set(TWO_STEP_COOKIE_NAME, challenge, { ...TWO_STEP_COOKIE_OPTIONS, maxAge: CHALLENGE_TTL_MS / 1000 });
            codeStep = true;
          } else {
            await recordAdminLoginFailure(database, username, clientIp);
            Astro.response.status = 401;
            focusPassword = true;
            errorMessage = 'Username atau password salah.';
          }
        }
      }
    }
  } catch (error) {
    console.error('admin-login', error);
    Astro.response.status = 500;
    errorMessage = 'Terjadi kesalahan sistem login.';
  }
}

---

<!DOCTYPE html>
<html lang={Astro.locals.tenant.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Masuk - {Astro.locals.tenant.adminName}</title>
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK} />
    <link rel="icon" type="image/png" sizes="32x32" href={FAVICON_PNG} />
    <link rel="apple-touch-icon" href={FAVICON_192} />
    <!-- LOGIN-18: no third-party asset. This page loaded a Google Fonts
         stylesheet for a family it never applied, which told Google the address
         of every operator opening the admin and bought nothing back. -->
  </head>
  <body class="admin-login-page bg-slate-50 text-slate-900 antialiased selection:bg-blue-200 selection:text-blue-900">
    <main class="admin-login-stage" aria-labelledby="loginTitle">
      <!-- Left Brand Panel (Desktop) -->
      <div class="admin-login-brand relative isolate hidden overflow-hidden lg:flex flex-col justify-center bg-slate-950 p-10 text-white xl:p-14">
        <!-- Ornament: a dot grid that fades toward the edges. Decorative only. -->
        <div class="login-brand-grid" aria-hidden="true"></div>
        <!-- T-29: the platform's name and one line about the admin; the
             inherited tip-jar panel is gone (PR-18). -->
        <section class="relative max-w-md" aria-labelledby="loginBrandTitle">
          <img src={BRAND_WORDMARK_ON_DARK} alt="adsbook.id" width="126" height="20" loading="eager" class="h-5 w-auto opacity-90" />
          <h2 id="loginBrandTitle" class="mt-4 text-3xl font-semibold leading-tight">Pesanan, pengiriman, dan iklan {Astro.locals.tenant.name} di satu admin.</h2>
        </section>
      </div>

      <!-- Right Form Panel -->
      <!-- One screen, no scroll, on a phone and on a desktop: the form centred,
           a short footer pinned to the bottom of the same column. -->
      <div class="admin-login-form-wrapper">
        <div class="admin-login-card">
          <div class="admin-login-header text-center lg:text-left">
            <!-- The wordmark: "adsbook.id" as one name, ".id" in the brand blue. -->
            <!-- The wordmark leads back to the store's homepage, on a phone and
                 on a desktop alike: an operator who reached the login by mistake,
                 or who wants to see the shop, has one obvious way out. -->
            <h1 id="loginTitle" class="login-wordmark">
              <a href="/" class="login-wordmark-link" aria-label={`adsbook.id, kembali ke beranda ${Astro.locals.tenant.name}`} title={`Ke beranda ${Astro.locals.tenant.name}`}>
                <img src={BRAND_WORDMARK} alt="" width="138" height="22" loading="eager" class="h-[22px] w-auto shrink-0" />
              </a>
            </h1>
          </div>
          <div class="admin-login-form-content">
        {errorMessage && (
          <div id="loginError" class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4" role="alert" aria-live="assertive">
            <div class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 flex-shrink-0 text-rose-600" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
              </svg>
              <p class="text-sm font-normal leading-relaxed text-rose-800">{errorMessage}</p>
            </div>
          </div>
        )}


        {codeStep ? (
        <form id="codeForm" method="POST" class="space-y-4" novalidate aria-busy="false" aria-describedby={[errorMessage && 'loginError'].filter(Boolean).join(' ') || undefined}>
          <input type="hidden" name="step" value="code" />
          <div class="rounded-xl border border-blue-100 bg-blue-50 p-4 text-sm leading-relaxed text-blue-900">
            <p class="font-semibold text-slate-900">Verifikasi dua langkah</p>
            <p class="mt-1">Masukkan 6 digit kode dari aplikasi autentikator Anda. Tidak bisa membuka aplikasinya? Pakai salah satu kode cadangan.</p>
          </div>
          <div class="space-y-2">
            <label for="code" class="text-sm font-semibold text-slate-900">Kode verifikasi</label>
            <input id="code" type="text" name="code" required maxlength="9" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" autofocus placeholder="123456" class="admin-input-flat" aria-describedby="code-error" data-msg-missing="Masukkan kode verifikasi." />
            <p id="code-error" class="admin-field-error" hidden></p>
          </div>
          <button id="loginSubmit" type="submit" class="mt-1 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-[#2563EB] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#1D4ED8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2563EB] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:bg-[#1D4ED8] disabled:text-white/80">
            Verifikasi &amp; Masuk
          </button>
          <p class="text-center text-sm"><a href="/hello" class="font-semibold text-[#2563EB] hover:underline">← Masuk dengan akun lain</a></p>
          <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
        ) : (
        <form id="loginForm" method="POST" class="space-y-4" novalidate aria-busy="false" aria-describedby={[errorMessage && 'loginError'].filter(Boolean).join(' ') || undefined}>
          <div class="space-y-2">
            <label for="username" class="text-sm font-semibold text-slate-900">Email atau username</label>
            <input id="username" type="text" name="username" required maxlength="254" autocomplete="username" autofocus={!focusPassword} value={submittedUsername} placeholder="nama@email.com" class="admin-input-flat" spellcheck="false" aria-describedby="username-error" data-msg-missing="Masukkan email atau username Anda." />
            <p id="username-error" class="admin-field-error" hidden></p>
          </div>

          <div class="space-y-2">
            <label for="password" class="text-sm font-semibold text-slate-900">Password</label>
            <div class="relative flex items-center">
              <input id="password" type="password" name="password" required autocomplete="current-password" autofocus={focusPassword} placeholder="Masukkan password" class="admin-input-flat pr-20" aria-describedby="password-error" data-msg-missing="Masukkan password Anda." />
              <button id="togglePassword" type="button" class="absolute right-1 flex items-center justify-center rounded px-3 text-sm font-normal text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-1" aria-controls="password" aria-label="Tampilkan password" aria-pressed="false">Lihat</button>
            </div>
            <p id="password-error" class="admin-field-error" hidden></p>
          </div>

          <button id="loginSubmit" type="submit" class="mt-1 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-[#2563EB] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#1D4ED8] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#2563EB] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:bg-[#1D4ED8] disabled:text-white/80">
            Masuk
          </button>
          <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
          <p class="text-center text-sm text-slate-500">Lupa password? <a id="forgotPassword" href={lupaPasswordUrl} class="font-semibold text-[#2563EB] hover:underline">Buat password baru</a></p>
        </form>
        )}
      </div>
        </div>
        <footer class="admin-login-foot">
          <p class="font-mono text-slate-400">adsbook.id v{CMS_VERSION.version}</p>
        </footer>
      <script>
        import { bindInlineValidation, validateInline } from '../lib/form-validation-id.ts';

        const form = (document.getElementById('loginForm') ?? document.getElementById('codeForm')) as HTMLFormElement | null;
        const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
        const password = document.getElementById('password') as HTMLInputElement | null;
        const toggle = document.getElementById('togglePassword') as HTMLButtonElement | null;
        const status = document.getElementById('loginStatus');
        const submitLabel = submit?.textContent?.trim() || 'Masuk Dashboard';
        let pending = false;

        // A page restored from the back/forward cache keeps the DOM it was
        // unloaded with. Without this the operator comes back to a permanently
        // disabled button still reading "Memverifikasi…" and cannot log in.
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted || !submit) return;
          pending = false;
          form?.setAttribute('aria-busy', 'false');
          submit.disabled = false;
          submit.textContent = submitLabel;
          if (status) status.textContent = '';
        });

        form?.addEventListener('submit', (event) => {
          if (pending) {
            event.preventDefault();
            return;
          }
          // novalidate: the messages are ours, in Indonesian, under each field.
          if (!validateInline(form)) {
            event.preventDefault();
            return;
          }
          if (!submit) return;
          pending = true;
          form.setAttribute('aria-busy', 'true');
          submit.disabled = true;
          submit.innerHTML = '<svg class="mr-2 h-4 w-4 animate-spin text-white/80 motion-reduce:animate-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memverifikasi&hellip;';
          if (status) status.textContent = 'Memverifikasi kredensial admin.';
        });

        if (form) bindInlineValidation(form);

        toggle?.addEventListener('click', () => {
          if (!password) return;
          const visible = password.type === 'text';
          password.type = visible ? 'password' : 'text';
          toggle.textContent = visible ? 'Lihat' : 'Sembunyikan';
          toggle.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
          toggle.setAttribute('aria-pressed', String(!visible));
        });
      </script>
      </div>
    </main>
    <script>
      // Constraint validation speaks Indonesian on every page, whatever the browser's language.
      import { installIndonesianValidation } from '../lib/form-validation-id.ts';
      installIndonesianValidation();
    </script>
  </body>
</html>

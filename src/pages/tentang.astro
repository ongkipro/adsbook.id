---
import PageIntro from '../components/storefront/shared/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  shell="storefront"
  title={`Tentang ${Astro.locals.tenant.name}`}
  description={`Profil dan informasi tentang ${Astro.locals.tenant.name}.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Tentang Kami', url: '/tentang' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-white text-sf-ink">
    <PageIntro
      badge="Tentang Kami"
      title={`Tentang ${Astro.locals.tenant.name}`}
      description={Astro.locals.tenant.description}
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Tentang Kami' }]}
    />

    <section class="mx-auto max-w-[480px] px-4 py-6">
      <div class="rounded-sf-lg border border-sf-line bg-sf-surface-soft p-5">
        <h2 class="text-base font-bold tracking-[-0.01em] text-sf-ink">
          Selamat datang di {Astro.locals.tenant.name}
        </h2>
        <p class="mt-2 text-sm leading-6 text-sf-text">
          Jelajahi katalog kami untuk melihat pilihan produk, detail varian, dan harga terbaru sebelum memesan.
        </p>
        <div class="mt-5">
          <a
            href="/produk"
            class="inline-flex min-h-12 w-full items-center justify-center rounded-sf bg-sf-accent px-5 text-sm font-semibold text-white transition-colors hover:bg-sf-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink"
          >
            Lihat semua produk
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

---
import { BRAND_MARK, FAVICON_PNG, FAVICON_192 } from '../lib/brand-assets';
import '../styles/admin.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500 from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import { AdminShell } from '../components/admin/AdminShell.tsx';
import { ADMIN_ACCENT } from '../components/admin/admin-navigation';
import { BROWSER_UNSUPPORTED_MESSAGE, lacksFetchMetadata } from '../lib/auth';

interface Props {
  title: string;
  activeMenu: 'dashboard' | 'analytics' | 'content' | 'products' | 'orders' | 'shipping' | 'expeditions' | 'scoring' | 'ads' | 'settings' | 'plugins' | 'payments' | 'profile' | 'status' | 'docs';
}

const { title, activeMenu } = Astro.props;
const currentPath = (Astro.url.pathname + Astro.url.search).replace(/\/$/, '') || '/';
const adminRole = Astro.locals.admin?.role ?? 'customer_service';
const mustChangePassword = Astro.locals.admin?.mustChangePassword ?? false;
// ADR-041 (T-50): Preview, grace and expired say so on every admin page; the
// owner and admin get the way to pay. Subscribed stores show nothing.
// PR-26: the demo store never pays, so it never carries a subscription notice.
const isDemo = Boolean(Astro.locals.tenantContext?.isDemo);
const billingState = isDemo ? undefined : Astro.locals.billing?.state;
const canPay = adminRole === 'owner' || adminRole === 'admin';
const billingNotice =
  billingState === 'preview'
    ? { urgent: false, title: 'Mode Preview.', body: 'Siapkan toko sepuasnya. Pembeli belum bisa memesan dan iklan belum aktif sampai langganan diaktifkan (mulai Rp149.000/bulan).', cta: 'Aktifkan langganan' }
    : billingState === 'grace'
      ? { urgent: true, title: 'Langganan sudah jatuh tempo.', body: 'Toko masih menerima pesanan dan iklan tetap jalan selama masa tenggang 48 jam. Perpanjang sekarang agar tidak terhenti.', cta: 'Perpanjang sekarang' }
      : billingState === 'expired'
        ? { urgent: true, title: 'Langganan berakhir.', body: 'Pesanan, iklan, dan AI dijeda. Semua data toko tetap aman dan kembali aktif begitu langganan diperpanjang.', cta: 'Perpanjang langganan' }
        : null;
const sidebarDefaultOpen = Astro.cookies.get('sidebar_state')?.value !== 'false';
// IAM-5: a browser that sends no Fetch Metadata cannot save anything here; say
// so before the operator fills a form, not after.
const browserUnsupported = lacksFetchMetadata(Astro.request.headers);

---

<!DOCTYPE html>
<html lang={Astro.locals.tenant.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={ADMIN_ACCENT} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} - ${Astro.locals.tenant.adminName}`} />
    <meta property="twitter:card" content="summary_large_image" />
    <title>{title} - {Astro.locals.tenant.adminName}</title>
    <link rel="icon" type="image/svg+xml" href={BRAND_MARK} />
    <link rel="icon" type="image/png" sizes="32x32" href={FAVICON_PNG} />
    <link rel="apple-touch-icon" href={FAVICON_192} />
    {/* The faces admin.css declares `optional`: preloaded so the first paint has them. */}
    {[inter400, inter500, inter600, inter700].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
  </head>
  <body
    class="admin-shell flex h-dvh overflow-hidden bg-[#f6f7f9] text-slate-900 antialiased"
    style={`--admin-accent:${ADMIN_ACCENT}`}
  >
    <a href="#admin-main" class="btn-secondary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50">Lewati ke konten utama</a>

    <AdminShell
      client:load
      title={title}
      adminName={Astro.locals.tenant.adminName}
      siteName={Astro.locals.tenant.name}
      siteLogo={Astro.locals.tenant.logo}
      activeMenu={activeMenu}
      currentPath={currentPath}
      siteUrl={Astro.locals.tenant.siteUrl}
      adminRole={adminRole}
      adminUsername={Astro.locals.admin?.username ?? ''}
      mustChangePassword={mustChangePassword}
      sidebarDefaultOpen={sidebarDefaultOpen}
      catalogMode={Astro.locals.tenant.catalogMode}
    >
      {browserUnsupported && (
        <div id="browserUnsupportedNotice" role="alert" class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900">
          {BROWSER_UNSUPPORTED_MESSAGE}
        </div>
      )}
      {isDemo && (
        <div id="demoNotice" role="note" class="mb-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
          <strong class="text-slate-900">Toko contoh adsbook.id.</strong> Hanya untuk dilihat: perubahan, pesanan, dan pembayaran tidak aktif, dan tidak perlu berlangganan.
        </div>
      )}
      {billingNotice && Astro.url.pathname !== '/admin/billing' && (
        <div id="billingNotice" role={billingNotice.urgent ? 'alert' : 'status'} class={`mb-4 flex flex-col gap-3 rounded-xl border px-4 py-3 text-sm sm:flex-row sm:items-center sm:justify-between ${billingNotice.urgent ? 'border-amber-300 bg-amber-50 text-amber-950' : 'border-blue-200 bg-blue-50 text-blue-950'}`}>
          <p class="leading-5"><strong>{billingNotice.title}</strong> {billingNotice.body}</p>
          {canPay && (
            <a href="/admin/billing" class="btn-primary shrink-0 text-center">{billingNotice.cta}</a>
          )}
        </div>
      )}
      <slot />
    </AdminShell>
    <!-- Vanilla JS for the admin drawer, global search, and logout enhancement. -->
    <script>
      // Delegate submit for dynamically rendered logout forms
      document.addEventListener('submit', async (event) => {
        const target = event.target as HTMLFormElement;
        if (target.hasAttribute('data-logout-form')) {
          event.preventDefault();
          const button = target.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (button) {
            button.disabled = true;
            button.textContent = 'Keluar…';
          }
          try {
            const response = await fetch('/api/admin/logout', { method: 'POST', headers: { Accept: 'application/json' } });
            if (!response.ok) throw new Error('Logout gagal');
            window.location.assign('/hello');
          } catch {
            if (button) {
              button.disabled = false;
              button.textContent = 'Coba keluar lagi';
            }
          }
        }
      });
    </script>
    <script>
      // Constraint validation speaks Indonesian on every page, whatever the browser's language.
      import { installIndonesianValidation } from '../lib/form-validation-id.ts';
      installIndonesianValidation();
    </script>
  </body>
</html>

---
import AdminPageHeader from './AdminPageHeader.astro';
import { visibleRailGroups, type RailGroup } from './section-rails';

interface Props {
  title: string;
  description: string;
  groups: RailGroup[];
  railLabel: string;
  railId: string;
  maxWidth?: '4xl' | '5xl' | 'full';
}

const {
  title,
  description,
  groups: rawGroups,
  railLabel,
  railId,
  maxWidth = '4xl',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const role = Astro.locals.admin?.role ?? 'customer_service';
const groups = visibleRailGroups(rawGroups, role);
const flatItems = groups.flatMap((group) => group.items);
const hasActions = Astro.slots.has('actions');
const widthClass =
  maxWidth === 'full'
    ? 'max-w-none'
    : maxWidth === '5xl'
      ? 'max-w-5xl'
      : 'max-w-4xl';
---

<div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[240px_minmax(0,1fr)]">
  <aside
    data-section-rail={railId}
    class="hidden xl:sticky xl:top-0 xl:block xl:max-h-[calc(100dvh-8rem)] xl:overflow-y-auto"
  >
    <nav aria-label={railLabel} class="rounded-xl border border-slate-200 bg-white p-1.5">
      {groups.map((group, groupIndex) => (
        <div class:list={[groupIndex > 0 && 'mt-1 border-t border-slate-100 pt-1']}>
          {group.label && (
            <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-[0.06em] text-slate-400">
              {group.label}
            </p>
          )}
          <ul class="flex flex-col gap-0.5">
            {group.items.map((item) => {
              const active = path === item.href;
              const Icon = item.icon;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-3 rounded-lg px-2.5 py-1.5 outline-none transition-colors focus-visible:ring-2 focus-visible:ring-blue-600/40',
                      active ? 'bg-blue-600/[0.07] text-blue-700' : 'text-slate-900 hover:bg-slate-50',
                    ]}
                  >
                    <span
                      class:list={[
                        'grid size-8 shrink-0 place-items-center rounded-md',
                        active ? 'bg-blue-600/10 text-blue-700' : 'bg-slate-100 text-slate-600',
                      ]}
                      aria-hidden="true"
                    >
                      <Icon className="size-4" />
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-sm font-medium">{item.label}</span>
                      <span class:list={['truncate text-xs', active ? 'text-blue-700/80' : 'text-slate-500']}>
                        {item.hint}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </aside>

  <script is:inline>
    (() => {
      const rail = document.querySelector('[data-section-rail]');
      if (!rail) return;
      const id = rail.getAttribute('data-section-rail') || 'default';
      const storageKey = `adsbook:section-rail:${id}`;
      let top = 0;
      try { top = Number(sessionStorage.getItem(storageKey)) || 0; } catch {}
      if (top > 0) rail.scrollTop = top;
      const current = rail.querySelector('[aria-current="page"]');
      if (current) {
        const box = rail.getBoundingClientRect();
        const item = current.getBoundingClientRect();
        if (item.top < box.top) rail.scrollTop -= box.top - item.top + 8;
        else if (item.bottom > box.bottom) rail.scrollTop += item.bottom - box.bottom + 8;
      }
      rail.addEventListener('click', () => {
        try { sessionStorage.setItem(storageKey, String(Math.round(rail.scrollTop))); } catch {}
      });
    })();
  </script>

  <div class:list={['flex min-w-0 flex-col gap-5', widthClass]}>
    <AdminPageHeader title={title} description={description}>
      {hasActions && <slot name="actions" slot="actions" />}
    </AdminPageHeader>

    {flatItems.length > 1 && (
      <nav
        aria-label={railLabel}
        class="-mt-2 flex items-center gap-1.5 overflow-x-auto pb-1 xl:hidden"
      >
        {flatItems.map((item) => {
          const active = path === item.href;
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-10 shrink-0 items-center gap-1.5 rounded-lg border px-3 text-xs font-medium whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40',
                active
                  ? 'border-blue-200 bg-blue-50 text-blue-700'
                  : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-950',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    )}

    <slot />
  </div>
</div>

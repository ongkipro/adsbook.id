---
import { ChevronRight } from 'lucide-react';
import AdminPageHeader from './AdminPageHeader.astro';
import { SETTINGS_INDEX, visibleSettingsGroups } from './settings-sections';

// Every Pengaturan page: at 1280px and up a rail of sections beside the page,
// pinned while the page scrolls; on a phone `/admin/settings` is the directory
// and each section links back to it. `index` marks that directory page.
interface Props {
  title: string;
  description: string;
  index?: boolean;
}

const { title, description, index = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const groups = visibleSettingsGroups(Astro.locals.admin?.role ?? 'customer_service', Astro.locals.tenant.catalogMode);
---

<div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[220px_minmax(0,1fr)]">
  {/* `top-0`, not the main area's padding: a sticky offset is measured inside the scroll area's padding already, so any more pushed the rail 24px below the page header on every page long enough to scroll. */}
  <aside data-settings-rail class="hidden xl:sticky xl:top-0 xl:block xl:max-h-[calc(100dvh-8rem)] xl:overflow-y-auto">
    <nav aria-label="Menu pengaturan" class="rounded-xl border border-slate-200 bg-white p-1.5">
      {groups.map((group, groupIndex) => (
        <div class:list={[groupIndex > 0 && 'mt-1 border-t border-slate-100 pt-1']}>
          <p class="px-2.5 pb-1 pt-2 text-xs font-semibold uppercase tracking-[0.06em] text-slate-500">{group.label}</p>
          <ul class="flex flex-col gap-0.5">
            {group.items.map((item) => {
              const active = path === item.href;
              const Icon = item.icon;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-start gap-2.5 rounded-lg px-2.5 py-2 outline-none transition-colors focus-visible:ring-2 focus-visible:ring-blue-600/40',
                      active ? 'bg-blue-600/[0.07] text-blue-700' : 'text-slate-900 hover:bg-slate-50',
                    ]}
                  >
                    <Icon
                      className={`mt-0.5 size-4 shrink-0 ${active ? 'text-blue-600' : 'text-slate-500'}`}
                      aria-hidden="true"
                    />
                    <span class="flex min-w-0 flex-1 flex-col">
                      <span class="truncate text-sm font-medium leading-tight">{item.label}</span>
                      <span class:list={['mt-0.5 truncate text-xs', active ? 'text-blue-700/80' : 'text-slate-500']}>{item.hint}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </aside>
  {/* Every section is a full page load: on a window too short for the whole rail, put it back where it was
      before the first paint, and never leave the current section out of view. No store or account data. */}
  <script is:inline>
    (() => {
      const rail = document.querySelector('[data-settings-rail]');
      if (!rail) return;
      const key = 'adsbook:settings-rail';
      let top = 0;
      try { top = Number(sessionStorage.getItem(key)) || 0; } catch {}
      if (top > 0) rail.scrollTop = top;
      const current = rail.querySelector('[aria-current="page"]');
      if (current) {
        const box = rail.getBoundingClientRect();
        const item = current.getBoundingClientRect();
        if (item.top < box.top) rail.scrollTop -= box.top - item.top + 8;
        else if (item.bottom > box.bottom) rail.scrollTop += item.bottom - box.bottom + 8;
      }
      rail.addEventListener('click', () => { try { sessionStorage.setItem(key, String(Math.round(rail.scrollTop))); } catch {} });
    })();
  </script>

  <div class="flex min-w-0 flex-col gap-5">
    {!index && (
      <a href={SETTINGS_INDEX} class="-mb-3 -ml-1 inline-flex min-h-11 w-fit items-center px-1 text-xs font-semibold text-slate-500 transition-colors hover:text-slate-950 xl:hidden">
        <span aria-hidden="true">←</span><span class="ml-1.5">Semua pengaturan</span>
      </a>
    )}
    <AdminPageHeader title={title} description={description} />

    {index && (
      <nav aria-label="Halaman pengaturan" data-settings-directory class="flex flex-col gap-4 xl:hidden">
        {groups.map((group) => {
          const items = group.items.filter((item) => item.href !== SETTINGS_INDEX);
          return items.length > 0 && (
            <section class="flex flex-col gap-2">
              <h3 class="px-1 text-xs font-semibold uppercase tracking-[0.06em] text-slate-500">{group.label}</h3>
              <ul class="divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white">
                {items.map((item) => {
                  const Icon = item.icon;
                  return (
                    <li>
                      <a href={item.href} class="flex min-h-14 items-center gap-3 px-3 py-2 active:bg-slate-50">
                        <span class="grid size-8 shrink-0 place-items-center rounded-md bg-slate-100 text-slate-600" aria-hidden="true"><Icon className="size-4" /></span>
                        <span class="flex min-w-0 flex-1 flex-col">
                          <span class="truncate text-sm font-medium text-slate-900">{item.label}</span>
                          <span class="truncate text-xs text-slate-500">{item.hint}</span>
                        </span>
                        <ChevronRight className="size-4 shrink-0 text-slate-300" aria-hidden="true" />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })}
      </nav>
    )}

    <slot />
  </div>
</div>

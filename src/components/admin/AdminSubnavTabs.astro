---
interface TabItem {
  href: string;
  label: string;
}

interface Props {
  label: string;
  items: TabItem[];
}

const { label, items } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav aria-label={label} class="-mt-2 flex items-center gap-1.5 overflow-x-auto pb-0.5">
  {items.map((item) => {
    const active = path === item.href;
    return (
      <a
        href={item.href}
        aria-current={active ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-10 shrink-0 items-center rounded-lg border px-3.5 text-sm font-medium whitespace-nowrap transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600/40',
          active
            ? 'border-blue-200 bg-blue-50 text-blue-700'
            : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-slate-950',
        ]}
      >
        {item.label}
      </a>
    );
  })}
</nav>

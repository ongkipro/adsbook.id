---
import '../../styles/admin.css';
import { ADMIN_ACCENT } from '../admin/admin-navigation';
import { PlatformShell } from './PlatformShell.tsx';
import type { PlatformMenu } from './platform-navigation';

/**
 * The platform console page frame (T-52): the seller admin's AdminLayout —
 * same stylesheet, same `.admin-shell` body, same accent — around the
 * console's PlatformShell island. Signed-out pages (the login) render plain.
 */
interface Props { title: string; description?: string; active?: PlatformMenu }
const { title, description, active = 'overview' } = Astro.props;
const user = Astro.locals.platformUser;
const sidebarDefaultOpen = Astro.cookies.get('sidebar_state')?.value !== 'false';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={ADMIN_ACCENT} />
    <title>{title} - adsbook.id platform</title>
    <link rel="icon" type="image/svg+xml" href="/images/adsbook-icon.svg" />
  </head>
  {user ? (
    <body class="admin-shell flex h-dvh overflow-hidden bg-[#f6f7f9] text-slate-900 antialiased" style={`--admin-accent:${ADMIN_ACCENT}`}>
      <a href="#platform-main" class="btn-secondary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50">Lewati ke konten utama</a>
      <PlatformShell client:load title={title} description={description} active={active} email={user.email} role={user.role} sidebarDefaultOpen={sidebarDefaultOpen}>
        <slot />
      </PlatformShell>
    </body>
  ) : (
    <body class="admin-login-page bg-slate-50 text-slate-900 antialiased selection:bg-blue-200 selection:text-blue-900">
      <slot />
    </body>
  )}
</html>

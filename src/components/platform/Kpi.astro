---
import { Card, CardContent } from '../ui/card';
/** One KPI as the seller dashboard draws it: label, value, the basis it was computed on. */
interface Props { label: string; value: string; basis: string; id?: string; tone?: string }
const { label, value, basis, id, tone = 'text-slate-950' } = Astro.props;
---
<Card id={id} className="overflow-hidden border-slate-200 shadow-none">
  <CardContent className="p-3.5 sm:p-4">
    <p class="text-xs font-medium text-slate-500">{label}</p>
    <p class={`mt-1.5 whitespace-nowrap text-xl font-semibold tabular-nums tracking-tight ${tone}`}>{value}</p>
    <p class="mt-1 line-clamp-2 text-xs leading-4 text-slate-500">{basis}</p>
  </CardContent>
</Card>

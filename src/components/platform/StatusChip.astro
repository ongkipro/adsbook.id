---
/** A status as text plus colour, never colour alone. */
interface Props { value: string; label?: string }
const { value, label } = Astro.props;
const tone: Record<string, string> = {
  active: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  subscribed: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  paid: 'bg-emerald-50 text-emerald-800 ring-emerald-200',
  preview: 'bg-blue-50 text-blue-800 ring-blue-200',
  pending: 'bg-amber-50 text-amber-900 ring-amber-200',
  grace: 'bg-amber-50 text-amber-900 ring-amber-200',
  provisioning: 'bg-blue-50 text-blue-800 ring-blue-200',
  suspended: 'bg-rose-50 text-rose-800 ring-rose-200',
  expired: 'bg-rose-50 text-rose-800 ring-rose-200',
  recovery: 'bg-rose-50 text-rose-800 ring-rose-200',
  disabled: 'bg-slate-100 text-slate-600 ring-slate-200',
  revoked: 'bg-slate-100 text-slate-600 ring-slate-200',
  cancelled: 'bg-slate-100 text-slate-600 ring-slate-200',
  purging: 'bg-slate-100 text-slate-700 ring-slate-200',
  purged: 'bg-slate-100 text-slate-500 ring-slate-200',
  demo: 'bg-violet-50 text-violet-800 ring-violet-200',
};
---
<span class={`inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tone[value] ?? 'bg-slate-100 text-slate-700 ring-slate-200'}`}>{label ?? value}</span>

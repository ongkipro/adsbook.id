---
/**
 * A status as text plus colour (never colour alone), in the seller admin's
 * status-pill look (ShippingOperations, HeadlessApiManagement).
 */
interface Props { value: string; label?: string }
const { value, label } = Astro.props;
const tone: Record<string, string> = {
  active: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
  subscribed: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
  paid: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
  preview: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  provisioning: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  pending: 'bg-amber-50 text-amber-800 ring-amber-600/20',
  grace: 'bg-amber-50 text-amber-800 ring-amber-600/20',
  suspended: 'bg-rose-50 text-rose-700 ring-rose-600/20',
  expired: 'bg-rose-50 text-rose-700 ring-rose-600/20',
  recovery: 'bg-rose-50 text-rose-700 ring-rose-600/20',
  demo: 'bg-violet-50 text-violet-700 ring-violet-600/20',
};
---
<span class={`inline-flex items-center whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset ${tone[value] ?? 'bg-slate-100 text-slate-600 ring-slate-500/20'}`}>{label ?? value}</span>

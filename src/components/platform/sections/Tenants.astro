---
import PlatformLayout from '../PlatformLayout.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import StatusChip from '../StatusChip.astro';
import { ConsoleFilters } from '../ConsoleFilters';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../ui/table';
import { getRuntimeEnv } from '../../../lib/env';
import { billingState } from '../../../platform/billing';
import { listTenants, STALE_HEARTBEAT_MS, TENANT_LIST_LIMIT } from '../../../platform/admin/tenants';
import { ageText, BILLING_FILTERS, BILLING_LABELS, formatWibDate } from '../../../platform/admin/metrics';

// UX-4 (amended by T-52): both status axes, owner, and filters kept in the URL.
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const status = Astro.url.searchParams.get('status') || '';
const billing = Astro.url.searchParams.get('billing') || '';
const q = Astro.url.searchParams.get('q') || '';
const now = new Date();
const tenants = await listTenants(platformDb, { status: status || null, search: q || null, billing: billing || null }, now);
const STATUS_LABELS: Record<string, string> = { active: 'Aktif', suspended: 'Ditangguhkan', provisioning: 'Dibuat', recovery: 'Pemulihan', purging: 'Dihapus', purged: 'Terhapus' };
const filtered = Boolean(status || billing || q);
const rows = tenants.map((tenant) => {
  const state = billingState({ subscriptionEndsAt: tenant.subscription_ends_at, graceEndsAt: tenant.grace_ends_at }, now);
  const stale = tenant.status === 'active' && (!tenant.heartbeat_at || now.getTime() - Date.parse(tenant.heartbeat_at) > STALE_HEARTBEAT_MS);
  return { ...tenant, state, stale };
});
---
<PlatformLayout title="Toko" description="Semua toko, status, dan langganannya" active="tenants">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title="Toko" description="Status toko dan status langganan adalah dua hal berbeda; keduanya ditampilkan." />
    <ConsoleFilters
      client:load
      path="/platform/tenants"
      values={{ q, status, billing }}
      search={{ name: 'q', label: 'Cari toko', placeholder: 'Slug, domain, atau email owner' }}
      selects={[
        { name: 'status', label: 'Status toko', options: [{ value: '', label: 'Semua status' }, ...Object.entries(STATUS_LABELS).map(([value, label]) => ({ value, label }))] },
        { name: 'billing', label: 'Langganan', options: [{ value: '', label: 'Semua langganan' }, ...BILLING_FILTERS.map((value) => ({ value, label: BILLING_LABELS[value] }))] },
      ]}
    />

    <p class="text-xs text-slate-500" id="tenantCount">{rows.length} toko{rows.length >= TENANT_LIST_LIMIT ? ` (dibatasi ${TENANT_LIST_LIMIT}; persempit filter)` : ''}</p>

    {rows.length === 0 ? (
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-600 shadow-sm">
        {filtered ? <>Tidak ada toko yang cocok dengan filter ini. <a href="/platform/tenants" class="font-semibold text-blue-700 underline">Hapus filter</a></> : 'Belum ada toko.'}
      </div>
    ) : (
      <>
        <ul class="divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm md:hidden">
          {rows.map((tenant) => (
            <li>
              <a href={`/platform/tenants/${tenant.id}`} class="block p-4 active:bg-slate-50">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-semibold text-blue-700">{tenant.slug}</span>
                  <StatusChip value={tenant.status} label={STATUS_LABELS[tenant.status]} />
                  {tenant.is_demo === 1 ? <StatusChip value="demo" label="Toko contoh" /> : <StatusChip value={tenant.state} label={BILLING_LABELS[tenant.state]} />}
                </div>
                <p class="mt-1 truncate text-xs text-slate-600">{tenant.owner_email}</p>
                <p class="mt-0.5 truncate text-xs text-slate-500">{tenant.primary_host ?? '—'} · dibuat {formatWibDate(tenant.created_at)}</p>
              </a>
            </li>
          ))}
        </ul>
        <div class="hidden overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm md:block">
          <Table>
            <TableHeader className="bg-slate-50">
              <TableRow>
                <TableHead className="px-4 text-xs text-slate-500">Toko</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Host utama</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Status</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Langganan</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Dibuat</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Heartbeat</TableHead>
                <TableHead className="px-4 text-right text-xs text-slate-500">Backlog</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {rows.map((tenant) => (
                <TableRow>
                  <TableCell className="px-4 py-3">
                    <a href={`/platform/tenants/${tenant.id}`} class="font-semibold text-blue-700 hover:underline">{tenant.slug}</a>
                    <p class="max-w-64 truncate text-xs text-slate-500">{tenant.owner_email}</p>
                  </TableCell>
                  <TableCell className="px-4 py-3 font-mono text-xs text-slate-700">{tenant.primary_host ?? '—'}</TableCell>
                  <TableCell className="px-4 py-3"><StatusChip value={tenant.status} label={STATUS_LABELS[tenant.status]} /></TableCell>
                  <TableCell className="px-4 py-3">
                    {tenant.is_demo === 1 ? <StatusChip value="demo" label="Toko contoh" /> : <StatusChip value={tenant.state} label={BILLING_LABELS[tenant.state]} />}
                    {tenant.subscription_ends_at && <p class="mt-1 text-xs text-slate-500">s.d. {formatWibDate(tenant.subscription_ends_at)}</p>}
                  </TableCell>
                  <TableCell className="px-4 py-3 text-slate-700">{formatWibDate(tenant.created_at)}</TableCell>
                  <TableCell className={`px-4 py-3 ${tenant.stale ? 'font-semibold text-rose-700' : 'text-slate-700'}`}>{ageText(tenant.heartbeat_at, now)}</TableCell>
                  <TableCell className="px-4 py-3 text-right tabular-nums">{tenant.outbox_backlog ?? 0}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </>
    )}
  </div>
</PlatformLayout>

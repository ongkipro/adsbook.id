---
import PlatformLayout from '../PlatformLayout.astro';
import StatusChip from '../StatusChip.astro';
import { getRuntimeEnv } from '../../../lib/env';
import { formatWibDateTime } from '../../../platform/admin/metrics';
import { listTeam } from '../../../platform/admin/team';

// UX-10: platform_owner only; support gets a 403 page naming who can grant access.
const user = Astro.locals.platformUser;
const isOwner = user?.role === 'platform_owner';
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const team = isOwner ? await listTeam(platformDb) : [];
---
<PlatformLayout title="Tim" active="team">
  <h1 class="text-xl font-semibold text-slate-950">Tim platform</h1>
  {!isOwner ? (
    <p class="mt-4 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-700" role="alert">Halaman ini hanya untuk owner platform. Minta owner platform jika Anda perlu mengubah akses tim.</p>
  ) : (
    <>
      <p class="mt-1 text-sm text-slate-600">Orang yang bisa masuk ke console ini. Setiap akun wajib memakai kode authenticator (TOTP).</p>
      <p id="teamStatus" class="mt-3 min-h-5 text-sm font-semibold" role="status" aria-live="polite"></p>

      <div class="mt-2 relative overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="w-full min-w-[640px] text-left text-sm" id="teamTable">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold text-slate-500">
            <tr><th scope="col" class="px-4 py-3">Email</th><th scope="col" class="px-4 py-3">Peran</th><th scope="col" class="px-4 py-3">MFA</th><th scope="col" class="px-4 py-3">Status</th><th scope="col" class="px-4 py-3">Masuk terakhir</th><th scope="col" class="px-4 py-3"><span class="sr-only">Aksi</span></th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {team.map((member) => (
              <tr>
                <td class="px-4 py-3 break-all">{member.email}{member.id === user?.id && <span class="ml-2 text-xs text-slate-500">(Anda)</span>}</td>
                <td class="px-4 py-3">{member.role === 'platform_owner' ? 'Owner' : 'Support'}</td>
                <td class="px-4 py-3">{member.mfa ? 'Aktif' : 'Belum'}</td>
                <td class="px-4 py-3">{member.disabled_at ? <StatusChip value="disabled" label="Nonaktif" /> : <StatusChip value="active" label="Aktif" />}</td>
                <td class="px-4 py-3 whitespace-nowrap">{formatWibDateTime(member.last_sign_in)}</td>
                <td class="px-4 py-3 text-right">
                  {member.id !== user?.id && (member.disabled_at
                    ? <button type="button" class="btn-secondary" data-member={member.id} data-op="enable">Aktifkan</button>
                    : <button type="button" class="btn-secondary text-rose-700" data-member={member.id} data-op="disable" data-email={member.email}>Nonaktifkan</button>)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="addTitle">
        <h2 id="addTitle" class="text-base font-semibold text-slate-950">Tambah anggota</h2>
        <form id="addMember" class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-[1fr_10rem_1fr_auto] md:items-end">
          <div>
            <label for="memberEmail" class="block text-xs font-semibold text-slate-700">Email</label>
            <input id="memberEmail" name="email" type="email" required autocomplete="off" class="admin-input-flat mt-1" />
          </div>
          <div>
            <label for="memberRole" class="block text-xs font-semibold text-slate-700">Peran</label>
            <select id="memberRole" name="role" class="admin-input-flat mt-1">
              <option value="platform_support">Support</option>
              <option value="platform_owner">Owner</option>
            </select>
          </div>
          <div>
            <label for="memberPassword" class="block text-xs font-semibold text-slate-700">Password awal (min. 12)</label>
            <input id="memberPassword" name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" class="admin-input-flat mt-1" />
          </div>
          <button type="submit" class="btn-primary">Tambah</button>
        </form>
        <p class="mt-2 text-xs text-slate-500">Support bisa melihat semua toko, tagihan, dan kesehatan, serta menangguhkan toko. Owner juga bisa memberi hari langganan, memulihkan owner toko, menghapus toko, dan mengelola tim.</p>
        <div id="enrolment" class="mt-4 hidden rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" role="status">
          <p class="font-semibold">Simpan sekarang — hanya tampil sekali.</p>
          <p class="mt-1">Berikan ke anggota baru lewat jalur aman. Masukkan secret ke aplikasi authenticator (Google Authenticator, 1Password, Authy).</p>
          <p class="mt-2 text-xs text-amber-900">TOTP secret</p>
          <code id="enrolSecret" class="block break-all font-mono text-sm"></code>
          <p class="mt-2 text-xs text-amber-900">otpauth URI</p>
          <code id="enrolUri" class="block break-all font-mono text-xs"></code>
        </div>
      </section>
    </>
  )}
  <script>
    const status = document.getElementById('teamStatus');
    const say = (ok: boolean, text: string) => {
      if (!status) return;
      status.className = `mt-3 min-h-5 text-sm font-semibold ${ok ? 'text-blue-700' : 'text-rose-700'}`;
      status.textContent = text;
    };
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-member]')) {
      button.addEventListener('click', async () => {
        const op = button.dataset.op;
        if (op === 'disable' && !window.confirm(`Nonaktifkan ${button.dataset.email}? Sesinya langsung ditutup.`)) return;
        button.disabled = true;
        const response = await fetch(`/api/platform/team/${button.dataset.member}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ op }),
        }).catch(() => null);
        const payload = await response?.json().catch(() => ({})) ?? {};
        say(Boolean(payload.success), payload.message || payload.error || 'Gagal.');
        if (payload.success) window.setTimeout(() => window.location.reload(), 700);
        else button.disabled = false;
      });
    }
    const form = document.getElementById('addMember') as HTMLFormElement | null;
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector('button');
      if (button) button.disabled = true;
      const values = Object.fromEntries(new FormData(form));
      const response = await fetch('/api/platform/team', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(values),
      }).catch(() => null);
      const payload = await response?.json().catch(() => ({})) ?? {};
      say(Boolean(payload.success), payload.message || payload.error || 'Gagal.');
      if (button) button.disabled = false;
      if (payload.success && payload.data) {
        (document.getElementById('enrolSecret') as HTMLElement).textContent = payload.data.totp_secret;
        (document.getElementById('enrolUri') as HTMLElement).textContent = payload.data.otpauth_uri;
        document.getElementById('enrolment')?.classList.remove('hidden');
        form.reset();
      }
    });
  </script>
</PlatformLayout>

---
import PlatformLayout from '../PlatformLayout.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import { TeamManager } from '../TeamManager';
import { getRuntimeEnv } from '../../../lib/env';
import { listTeam } from '../../../platform/admin/team';

// UX-10: platform_owner only; support gets a 403 page naming who can grant access.
const user = Astro.locals.platformUser;
const isOwner = user?.role === 'platform_owner';
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const team = isOwner ? await listTeam(platformDb) : [];
---
<PlatformLayout title="Tim" description="Siapa yang bisa masuk ke console ini" active="team">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title="Tim platform" description="Setiap akun wajib memakai kode authenticator (TOTP). Selalu tersisa minimal satu owner aktif." />
    {isOwner
      ? <TeamManager client:load members={team.map(({ id, email, role, mfa, disabled_at, last_sign_in }) => ({ id, email, role, mfa, disabled_at, last_sign_in }))} selfId={user!.id} />
      : <p class="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-700 shadow-sm" role="alert">Halaman ini hanya untuk owner platform. Minta owner platform jika Anda perlu mengubah akses tim.</p>}
  </div>
</PlatformLayout>

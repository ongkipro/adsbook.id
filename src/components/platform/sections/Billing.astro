---
import PlatformLayout from '../PlatformLayout.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import Kpi from '../Kpi.astro';
import StatusChip from '../StatusChip.astro';
import { ConsoleFilters } from '../ConsoleFilters';
import { InvoiceCheckButton } from '../InvoiceCheckButton';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../ui/card';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../ui/table';
import { getRuntimeEnv } from '../../../lib/env';
import { formatIdr } from '../../../lib/format-idr';
import { BILLING_CYCLES } from '../../../platform/billing';
import { formatWibDate, formatWibDateTime, INVOICE_LIMIT, INVOICE_STATUSES, invoiceTotals, listPlatformInvoices, subscriptionWindows } from '../../../platform/admin/metrics';

// UX-8: money in, the subscription calendar, every invoice across stores.
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const status = Astro.url.searchParams.get('status') || '';
const q = Astro.url.searchParams.get('q') || '';
const now = new Date();
const [totals, windows, invoices] = await Promise.all([
  invoiceTotals(platformDb, now),
  subscriptionWindows(platformDb, now),
  listPlatformInvoices(platformDb, { status: status || null, search: q || null }),
]);
const STATUS_LABELS: Record<string, string> = { pending: 'Menunggu', paid: 'Lunas', expired: 'Kedaluwarsa', cancelled: 'Dibatalkan' };
const cycleLabel = (code: string) => (BILLING_CYCLES as Record<string, { label: string }>)[code]?.label ?? code;
const monthName = new Intl.DateTimeFormat('id-ID', { month: 'long', timeZone: 'Asia/Jakarta' }).format(now);
const filtered = Boolean(status || q);
const calendar = [
  { id: 'calEnding', title: 'Berakhir ≤ 14 hari', rows: windows.ending.map((row) => ({ ...row, note: `berakhir ${formatWibDate(row.subscription_ends_at)}` })) },
  { id: 'calGrace', title: 'Masa tenggang', rows: windows.grace.map((row) => ({ ...row, note: `dijeda ${formatWibDateTime(row.grace_ends_at)}` })) },
  { id: 'calExpired', title: 'Berakhir 30 hari terakhir', rows: windows.expired.map((row) => ({ ...row, note: `sejak ${formatWibDate(row.grace_ends_at)}` })) },
];
---
<PlatformLayout title="Tagihan" description="Invoice langganan dan kalender perpanjangan" active="billing">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title="Tagihan" description="Langganan dibayar lewat AutoLaris platform (QRIS/VA). Hari ditambahkan sekali, saat pembayaran terkonfirmasi." />

    <section aria-label="Angka tagihan" class="grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-3">
      <Kpi label={`Diterima ${monthName}`} value={formatIdr(totals.thisMonth)} basis="tagihan lunas, bulan WIB berjalan" />
      <Kpi label="Bulan lalu" value={formatIdr(totals.lastMonth)} basis="tagihan lunas" />
      <Kpi label="Menunggu bayar" value={String(totals.pending)} basis="tagihan belum kedaluwarsa" tone={totals.pending ? 'text-amber-700' : 'text-slate-950'} />
    </section>

    <div class="grid grid-cols-1 gap-3 lg:grid-cols-3">
      {calendar.map((column) => (
        <Card id={column.id} className="border-slate-200 shadow-none">
          <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">{column.title}</CardTitle>
          <CardDescription>{column.rows.length} toko</CardDescription>
        </CardHeader>
          <CardContent className="px-0">
            {column.rows.length ? (
              <ul class="divide-y divide-slate-100 text-sm">
                {column.rows.slice(0, 20).map((row) => (
                  <li class="flex items-center justify-between gap-3 px-4 py-2">
                    <a href={`/platform/tenants/${row.id}`} class="font-semibold text-blue-700 hover:underline">{row.slug}</a>
                    <span class="text-xs text-slate-500">{row.note}</span>
                  </li>
                ))}
              </ul>
            ) : <p class="px-4 py-2 text-sm text-slate-500">Tidak ada.</p>}
          </CardContent>
        </Card>
      ))}
    </div>

    <ConsoleFilters
      client:load
      path="/platform/billing"
      values={{ q, status }}
      search={{ name: 'q', label: 'Cari tagihan', placeholder: 'Nomor tagihan atau slug toko' }}
      selects={[{ name: 'status', label: 'Status', options: [{ value: '', label: 'Semua status' }, ...INVOICE_STATUSES.map((value) => ({ value, label: STATUS_LABELS[value] }))] }]}
    />
    <p class="text-xs text-slate-500" id="invoiceCount">{invoices.length} tagihan{invoices.length >= INVOICE_LIMIT ? ` (dibatasi ${INVOICE_LIMIT})` : ''}</p>
    {invoices.length === 0 ? (
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-600 shadow-sm">
        {filtered ? <>Tidak ada tagihan yang cocok. <a href="/platform/billing" class="font-semibold text-blue-700 underline">Hapus filter</a></> : 'Belum ada tagihan.'}
      </div>
    ) : (
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <Table>
          <TableHeader className="bg-slate-50">
            <TableRow>
              <TableHead className="px-4 text-xs text-slate-500">Nomor</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Toko</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Paket</TableHead>
              <TableHead className="px-4 text-right text-xs text-slate-500">Total</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Metode</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Status</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Dibuat</TableHead>
              <TableHead className="px-4 text-xs text-slate-500">Dibayar</TableHead>
              <TableHead className="px-4"><span class="sr-only">Aksi</span></TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {invoices.map((invoice) => (
              <TableRow>
                <TableCell className="px-4 font-mono text-xs">{invoice.invoice_number}</TableCell>
                <TableCell className="px-4">{invoice.slug ? <a href={`/platform/tenants/${invoice.tenant_id}`} class="font-semibold text-blue-700 hover:underline">{invoice.slug}</a> : '—'}</TableCell>
                <TableCell className="px-4">{cycleLabel(invoice.cycle_code)}</TableCell>
                <TableCell className="px-4 text-right tabular-nums">{formatIdr(invoice.total_idr)}</TableCell>
                <TableCell className="px-4">{invoice.channel_code}</TableCell>
                <TableCell className="px-4"><StatusChip value={invoice.status} label={STATUS_LABELS[invoice.status]} /></TableCell>
                <TableCell className="px-4 text-slate-700">{formatWibDateTime(invoice.created_at)}</TableCell>
                <TableCell className="px-4 text-slate-700">{formatWibDateTime(invoice.paid_at)}</TableCell>
                <TableCell className="px-4 text-right">{invoice.status === 'pending' && <InvoiceCheckButton client:visible invoiceId={invoice.id} />}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
    )}
  </div>
</PlatformLayout>

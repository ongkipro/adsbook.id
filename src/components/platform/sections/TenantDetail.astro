---
/** UX-4 tenant detail; the dispatcher has already confirmed the tenant exists. */
interface Props { tenantId: string }
import PlatformLayout from '../PlatformLayout.astro';
import StatusChip from '../StatusChip.astro';
import { getRuntimeEnv } from '../../../lib/env';
import { formatIdr } from '../../../lib/format-idr';
import { ACTION_ROLES, tenantDetail } from '../../../platform/admin/tenants';
import { billingState, BILLING_CYCLES, listInvoices } from '../../../platform/billing';
import { actorNames, BILLING_LABELS, describeEvent, EVENT_LABELS, formatWibDate, formatWibDateTime, ownerWhatsAppLink, tenantUsage30d } from '../../../platform/admin/metrics';

// UX-4 (amended by T-52): one store's two status axes, contact, invoices,
// usage, hosts, health, events, and the actions its role allows.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const platformDb = env.PLATFORM_DB as D1Database;
const detail = (await tenantDetail(platformDb, Astro.props.tenantId))!;
const role = Astro.locals.platformUser?.role ?? 'platform_support';
const may = (action: keyof typeof ACTION_ROLES) => ACTION_ROLES[action].includes(role);
const tenant = detail.tenant as Record<string, string | number | null>;
const tenantId = String(tenant.id);
const slug = String(tenant.slug);
const now = new Date();
const [plans, invoices, usage, actors] = await Promise.all([
  platformDb.prepare('SELECT id, name FROM plans ORDER BY id').all<{ id: string; name: string }>().then((result) => result.results),
  listInvoices(platformDb, tenantId, 20),
  tenantUsage30d(platformDb, tenantId, now),
  actorNames(platformDb),
]);
const isDemo = Number(tenant.is_demo) === 1;
const state = billingState({ subscriptionEndsAt: tenant.subscription_ends_at as string | null, graceEndsAt: tenant.grace_ends_at as string | null }, now);
const hosts = detail.hosts as Array<{ host: string; kind: string; status: string; ssl_status: string | null; is_primary: number; created_at: string }>;
const primary = hosts.find((host) => host.is_primary === 1 && host.status === 'active') ?? hosts.find((host) => host.kind === 'subdomain');
const subdomain = hosts.find((host) => host.kind === 'subdomain');
const proto = Astro.url.protocol;
const port = Astro.url.port && Astro.url.hostname.endsWith('localhost') ? `:${Astro.url.port}` : '';
const storeUrl = primary ? `${proto}//${primary.host}${port}` : null;
const helloUrl = subdomain ? `${proto}//${subdomain.host}${port}/hello` : null;
const wa = ownerWhatsAppLink(tenant.owner_whatsapp as string | null, slug);
const health = detail.health as { heartbeat_at?: string | null; outbox_backlog?: number | null; last_error?: string | null } | null;
const events = detail.events as Array<{ kind: string; actor: string; at: string; detail_json: string | null }>;
const actorLabel = (actor: string) => actors.get(actor) ?? (actor.includes('@') ? `${actor} (owner)` : actor);
const mb = (bytes: number) => `${(bytes / 1_048_576).toLocaleString('id-ID', { maximumFractionDigits: 1 })} MB`;
const cycleLabel = (code: string) => (BILLING_CYCLES as Record<string, { label: string }>)[code]?.label ?? code;
---
<PlatformLayout title={slug} active="tenants">
  <a href="/platform/tenants" class="text-sm font-semibold text-blue-700 hover:underline">← Semua toko</a>
  <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-xl font-semibold text-slate-950">{slug}</h1>
        <span id="tenantStatus"><StatusChip value={String(tenant.status)} /></span>
        <span id="subscriptionState">{isDemo ? <StatusChip value="demo" label="toko contoh" /> : <StatusChip value={state} label={BILLING_LABELS[state]} />}</span>
      </div>
      <p class="mt-1 break-all text-sm text-slate-600">{primary?.host ?? 'belum ada host aktif'}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      {storeUrl && <a href={storeUrl} target="_blank" rel="noopener" class="btn-secondary">Buka toko ↗</a>}
      {helloUrl && <a href={helloUrl} target="_blank" rel="noopener" class="btn-secondary">Login admin toko ↗</a>}
    </div>
  </div>

  <section class="mt-5 rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="summaryTitle">
    <h2 id="summaryTitle" class="text-base font-semibold text-slate-950">Ringkasan</h2>
    <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <dt class="text-xs text-slate-500">Owner</dt>
        <dd class="break-all font-medium">{tenant.owner_email}</dd>
        <dd class="mt-1 flex flex-wrap gap-3 text-xs">
          <a href={`mailto:${tenant.owner_email}`} class="font-semibold text-blue-700 hover:underline">Email</a>
          {wa && <a href={wa} target="_blank" rel="noopener" class="font-semibold text-blue-700 hover:underline">WhatsApp {tenant.owner_whatsapp}</a>}
        </dd>
      </div>
      <div><dt class="text-xs text-slate-500">Paket</dt><dd class="font-medium">{plans.find((plan) => plan.id === tenant.plan_id)?.name ?? tenant.plan_id}</dd></div>
      <div><dt class="text-xs text-slate-500">Dibuat</dt><dd class="font-medium">{formatWibDateTime(tenant.created_at)}</dd></div>
      <div><dt class="text-xs text-slate-500">Langganan aktif sampai</dt><dd class="font-medium">{formatWibDateTime(tenant.subscription_ends_at)}</dd></div>
      <div><dt class="text-xs text-slate-500">Masa tenggang sampai</dt><dd class="font-medium">{formatWibDateTime(tenant.grace_ends_at)}</dd></div>
      <div><dt class="text-xs text-slate-500">Dihapus setelah</dt><dd class="font-medium">{formatWibDate(tenant.purge_after)}</dd></div>
    </dl>
  </section>

  <section class="mt-5 rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="actionsTitle" data-tenant={tenantId} id="actions">
    <h2 id="actionsTitle" class="text-base font-semibold text-slate-950">Aksi</h2>
    <p id="actionStatus" class="mt-2 min-h-5 text-sm font-semibold" role="status" aria-live="polite"></p>
    <div class="mt-3 grid grid-cols-1 gap-5 lg:grid-cols-2">
      {may('grant-subscription') && tenant.status === 'active' && (
        <form data-action="grant-subscription" class="space-y-2">
          <label for="grantDays" class="block text-xs font-semibold text-slate-700">Beri hari langganan (tercatat di riwayat)</label>
          <input id="grantDays" name="days" type="number" inputmode="numeric" required min="1" max="730" value="30" class="admin-input-flat" />
          <label for="grantReason" class="block text-xs font-semibold text-slate-700">Alasan</label>
          <input id="grantReason" name="reason" required minlength="5" maxlength="300" class="admin-input-flat" placeholder="Contoh: pilot Saraku" />
          <button type="submit" class="btn-secondary">Beri langganan</button>
        </form>
      )}
      {tenant.status === 'active' && may('suspend') && (
        <form data-action="suspend" class="space-y-2">
          <label for="suspendReason" class="block text-xs font-semibold text-slate-700">Alasan penangguhan</label>
          <input id="suspendReason" name="reason" required minlength="3" class="admin-input-flat" />
          <button type="submit" class="btn-secondary text-rose-700">Tangguhkan</button>
        </form>
      )}
      {tenant.status === 'suspended' && may('resume') && (
        <form data-action="resume" class="space-y-2">
          <label for="resumeReason" class="block text-xs font-semibold text-slate-700">Alasan mengaktifkan kembali</label>
          <input id="resumeReason" name="reason" required minlength="3" class="admin-input-flat" />
          <button type="submit" class="btn-primary">Aktifkan kembali</button>
        </form>
      )}
      {may('plan') && plans.length > 1 && (
        <form data-action="plan" class="space-y-2">
          <label for="plan" class="block text-xs font-semibold text-slate-700">Paket</label>
          <select id="plan" name="plan" class="admin-input-flat">{plans.map((plan) => <option value={plan.id} selected={plan.id === tenant.plan_id}>{plan.name}</option>)}</select>
          <button type="submit" class="btn-secondary">Ubah paket</button>
        </form>
      )}
      {may('recover') && tenant.status === 'active' && (
        <form data-action="recover" class="space-y-2">
          <label for="evidence" class="block text-xs font-semibold text-slate-700">Ringkasan verifikasi pemilik (tanpa salinan dokumen)</label>
          <textarea id="evidence" name="evidence" required minlength="10" rows="2" class="admin-input-flat"></textarea>
          <button type="submit" class="btn-secondary">Buat kode pemulihan owner</button>
          <output id="recoveryToken" class="hidden block break-all rounded-lg bg-slate-50 p-2 font-mono text-xs"></output>
        </form>
      )}
      {may('purge-request') && !tenant.purge_after && tenant.status !== 'purged' && (
        <form data-action="purge-request" class="space-y-2">
          <label for="purgeSlug" class="block text-xs font-semibold text-slate-700">Ketik <strong>{slug}</strong> untuk menjadwalkan penghapusan permanen (30 hari)</label>
          <input id="purgeSlug" name="slug" required class="admin-input-flat" autocomplete="off" />
          <button type="submit" class="btn-secondary text-rose-700">Jadwalkan penghapusan</button>
        </form>
      )}
    </div>
  </section>

  <section class="mt-5 rounded-xl border border-slate-200 bg-white" aria-labelledby="invoicesTitle">
    <div class="flex items-center justify-between px-5 py-4">
      <h2 id="invoicesTitle" class="text-base font-semibold text-slate-950">Tagihan langganan</h2>
      <a href={`/platform/billing?q=${encodeURIComponent(slug)}`} class="text-xs font-semibold text-blue-700 hover:underline">Lihat di Tagihan</a>
    </div>
    {invoices.length ? (
      <div class="relative overflow-x-auto border-t border-slate-100">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-slate-50 text-xs font-semibold text-slate-500">
            <tr><th scope="col" class="px-5 py-2">Nomor</th><th scope="col" class="px-5 py-2">Paket</th><th scope="col" class="px-5 py-2 text-right">Total</th><th scope="col" class="px-5 py-2">Metode</th><th scope="col" class="px-5 py-2">Status</th><th scope="col" class="px-5 py-2">Dibuat</th><th scope="col" class="px-5 py-2"><span class="sr-only">Aksi</span></th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {invoices.map((invoice) => (
              <tr>
                <td class="px-5 py-2 whitespace-nowrap font-mono text-xs">{invoice.invoice_number}</td>
                <td class="px-5 py-2 whitespace-nowrap">{cycleLabel(invoice.cycle_code)}</td>
                <td class="px-5 py-2 text-right tabular-nums">{formatIdr(invoice.total_idr)}</td>
                <td class="px-5 py-2">{invoice.channel_code}</td>
                <td class="px-5 py-2"><StatusChip value={invoice.status} /></td>
                <td class="px-5 py-2 whitespace-nowrap">{formatWibDateTime(invoice.created_at)}</td>
                <td class="px-5 py-2 text-right">{invoice.status === 'pending' && <button type="button" class="btn-secondary" data-check-invoice={invoice.id}>Cek status</button>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="border-t border-slate-100 px-5 py-4 text-sm text-slate-600">Belum ada tagihan.</p>
    )}
  </section>

  <div class="mt-5 grid grid-cols-1 gap-5 lg:grid-cols-2">
    <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="usageTitle">
      <h2 id="usageTitle" class="text-base font-semibold text-slate-950">Pemakaian 30 hari</h2>
      <dl class="mt-3 grid grid-cols-3 gap-3 text-sm">
        <div><dt class="text-xs text-slate-500">Pesanan</dt><dd class="text-xl font-semibold tabular-nums">{usage.orders.toLocaleString('id-ID')}</dd></div>
        <div><dt class="text-xs text-slate-500">Request</dt><dd class="text-xl font-semibold tabular-nums">{usage.requests.toLocaleString('id-ID')}</dd></div>
        <div><dt class="text-xs text-slate-500">Media</dt><dd class="text-xl font-semibold tabular-nums">{mb(usage.mediaBytes)}</dd></div>
      </dl>
      <p class="mt-2 text-xs text-slate-500">Dari catatan harian platform ({usage.days} hari tercatat).</p>
    </section>

    <section class="rounded-xl border border-slate-200 bg-white p-5" aria-labelledby="healthTitle">
      <h2 id="healthTitle" class="text-base font-semibold text-slate-950">Kesehatan</h2>
      <dl class="mt-3 space-y-1 text-sm">
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Heartbeat</dt><dd>{formatWibDateTime(health?.heartbeat_at)}</dd></div>
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Backlog CAPI</dt><dd class="tabular-nums">{health?.outbox_backlog ?? 0}</dd></div>
        <div class="flex justify-between gap-3"><dt class="text-slate-500">Error terakhir</dt><dd class="break-all text-right">{health?.last_error ?? '—'}</dd></div>
      </dl>
    </section>
  </div>

  <section class="mt-5 rounded-xl border border-slate-200 bg-white" aria-labelledby="hostsTitle">
    <h2 id="hostsTitle" class="px-5 py-4 text-base font-semibold text-slate-950">Host</h2>
    <ul class="divide-y divide-slate-100 border-t border-slate-100 text-sm">
      {hosts.map((host) => (
        <li class="flex flex-wrap items-center gap-2 px-5 py-2">
          <span class="break-all font-mono text-xs">{host.host}</span>
          <StatusChip value={host.status} />
          <span class="text-xs text-slate-500">{host.kind === 'custom' ? 'domain sendiri' : 'subdomain'}{host.is_primary === 1 ? ' · utama' : ''}{host.ssl_status ? ` · SSL ${host.ssl_status}` : ''}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-5 rounded-xl border border-slate-200 bg-white" aria-labelledby="eventsTitle">
    <div class="flex items-center justify-between px-5 py-4">
      <h2 id="eventsTitle" class="text-base font-semibold text-slate-950">Riwayat</h2>
      <a href={`/platform/activity?slug=${encodeURIComponent(slug)}`} class="text-xs font-semibold text-blue-700 hover:underline">Semua aktivitas toko ini</a>
    </div>
    <ol class="divide-y divide-slate-100 border-t border-slate-100 text-sm">
      {events.map((event) => (
        <li class="px-5 py-2">
          <span class="font-medium">{EVENT_LABELS[event.kind] ?? event.kind}</span>
          <span class="text-slate-500"> · {formatWibDateTime(event.at)} · {actorLabel(event.actor)}</span>
          {describeEvent(event.detail_json) && <p class="text-xs text-slate-600">{describeEvent(event.detail_json)}</p>}
        </li>
      ))}
    </ol>
  </section>

  <script>
    import { checkInvoiceButtons } from '../invoice-check';
    checkInvoiceButtons();
    const section = document.getElementById('actions') as HTMLElement;
    const status = document.getElementById('actionStatus') as HTMLElement;
    for (const form of section.querySelectorAll<HTMLFormElement>('form[data-action]')) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector('button');
        if (button) button.disabled = true;
        const values = Object.fromEntries(new FormData(form));
        try {
          const response = await fetch(`/api/platform/tenants/${section.dataset.tenant}/${form.dataset.action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(values),
          });
          const payload = await response.json().catch(() => ({}));
          status.className = `mt-2 min-h-5 text-sm font-semibold ${payload.success ? 'text-blue-700' : 'text-rose-700'}`;
          status.textContent = payload.success ? payload.message : payload.error || 'Aksi gagal.';
          if (payload.success && payload.data?.recovery_token) {
            const output = document.getElementById('recoveryToken');
            if (output) { output.textContent = `Kode untuk owner (sekali tampil, 24 jam): ${payload.data.recovery_token}. Owner membukanya di /pemulihan pada subdomain tokonya.`; output.classList.remove('hidden'); }
          } else if (payload.success) {
            window.setTimeout(() => window.location.reload(), 600);
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    }
  </script>
</PlatformLayout>

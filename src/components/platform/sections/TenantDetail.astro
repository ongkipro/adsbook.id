---
/** UX-4 tenant detail; the dispatcher has already confirmed the tenant exists. */
interface Props { tenantId: string }
import PlatformLayout from '../PlatformLayout.astro';
import StatusChip from '../StatusChip.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import { TenantActions } from '../TenantActions';
import { InvoiceCheckButton } from '../InvoiceCheckButton';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../ui/card';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../ui/table';
import { buttonVariants } from '../../ui/button';
import { getRuntimeEnv } from '../../../lib/env';
import { formatIdr } from '../../../lib/format-idr';
import { ACTION_ROLES, tenantDetail } from '../../../platform/admin/tenants';
import { billingState, BILLING_CYCLES, listInvoices } from '../../../platform/billing';
import { actorNames, BILLING_LABELS, describeEvent, EVENT_LABELS, formatWibDate, formatWibDateTime, ownerWhatsAppLink, tenantUsage30d } from '../../../platform/admin/metrics';

// UX-4 (amended by T-52): one store's two status axes, contact, invoices,
// usage, hosts, health, events, and the actions its role allows.
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const platformDb = env.PLATFORM_DB as D1Database;
const detail = (await tenantDetail(platformDb, Astro.props.tenantId))!;
const role = Astro.locals.platformUser?.role ?? 'platform_support';
const may = (action: keyof typeof ACTION_ROLES) => ACTION_ROLES[action].includes(role);
const tenant = detail.tenant as Record<string, string | number | null>;
const tenantId = String(tenant.id);
const slug = String(tenant.slug);
const now = new Date();
const [plans, invoices, usage, actors] = await Promise.all([
  platformDb.prepare('SELECT id, name FROM plans ORDER BY id').all<{ id: string; name: string }>().then((result) => result.results),
  listInvoices(platformDb, tenantId, 20),
  tenantUsage30d(platformDb, tenantId, now),
  actorNames(platformDb),
]);
const isDemo = Number(tenant.is_demo) === 1;
const state = billingState({ subscriptionEndsAt: tenant.subscription_ends_at as string | null, graceEndsAt: tenant.grace_ends_at as string | null }, now);
const hosts = detail.hosts as Array<{ host: string; kind: string; status: string; ssl_status: string | null; is_primary: number; created_at: string }>;
const primary = hosts.find((host) => host.is_primary === 1 && host.status === 'active') ?? hosts.find((host) => host.kind === 'subdomain');
const subdomain = hosts.find((host) => host.kind === 'subdomain');
const proto = Astro.url.protocol;
const port = Astro.url.port && Astro.url.hostname.endsWith('localhost') ? `:${Astro.url.port}` : '';
const storeUrl = primary ? `${proto}//${primary.host}${port}` : null;
const helloUrl = subdomain ? `${proto}//${subdomain.host}${port}/hello` : null;
const wa = ownerWhatsAppLink(tenant.owner_whatsapp as string | null, slug);
const health = detail.health as { heartbeat_at?: string | null; outbox_backlog?: number | null; last_error?: string | null } | null;
const events = detail.events as Array<{ kind: string; actor: string; at: string; detail_json: string | null }>;
const actorLabel = (actor: string) => actors.get(actor) ?? (actor.includes('@') ? `${actor} (owner)` : actor);
const mb = (bytes: number) => `${(bytes / 1_048_576).toLocaleString('id-ID', { maximumFractionDigits: 1 })} MB`;
const outline = buttonVariants({ variant: 'outline' });
const allowed = (Object.keys(ACTION_ROLES) as Array<keyof typeof ACTION_ROLES>).filter((action) => may(action) && action !== 'plan');
const STATUS_LABELS: Record<string, string> = { active: 'Aktif', suspended: 'Ditangguhkan', provisioning: 'Dibuat', recovery: 'Pemulihan', purging: 'Dihapus', purged: 'Terhapus' };
const INVOICE_LABELS: Record<string, string> = { pending: 'Menunggu', paid: 'Lunas', expired: 'Kedaluwarsa', cancelled: 'Dibatalkan' };
const HOST_LABELS: Record<string, string> = { pending: 'Menunggu DNS', active: 'Aktif', revoked: 'Dicabut' };
const cycleLabel = (code: string) => (BILLING_CYCLES as Record<string, { label: string }>)[code]?.label ?? code;
---
<PlatformLayout title={slug} description="Detail toko" active="tenants">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title={slug} description={primary?.host ?? 'Belum ada host aktif'} backHref="/platform/tenants" backLabel="Semua toko">
      <Fragment slot="actions">
        {storeUrl && <a href={storeUrl} target="_blank" rel="noopener" class={outline}>Buka toko ↗</a>}
        {helloUrl && <a href={helloUrl} target="_blank" rel="noopener" class={outline}>Login admin toko ↗</a>}
      </Fragment>
    </AdminPageHeader>

    <div class="flex flex-wrap items-center gap-2">
      <span id="tenantStatus"><StatusChip value={String(tenant.status)} label={STATUS_LABELS[String(tenant.status)]} /></span>
      <span id="subscriptionState">{isDemo ? <StatusChip value="demo" label="Toko contoh" /> : <StatusChip value={state} label={BILLING_LABELS[state]} />}</span>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Ringkasan</CardTitle>
        </CardHeader>
        <CardContent>
          <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div>
              <dt class="text-xs text-slate-500">Owner</dt>
              <dd class="break-all font-medium text-slate-900">{tenant.owner_email}</dd>
              <dd class="mt-1 flex flex-wrap gap-3 text-xs">
                <a href={`mailto:${tenant.owner_email}`} class="font-semibold text-blue-700 hover:underline">Email</a>
                {wa && <a href={wa} target="_blank" rel="noopener" class="font-semibold text-blue-700 hover:underline">WhatsApp {tenant.owner_whatsapp}</a>}
              </dd>
            </div>
            <div><dt class="text-xs text-slate-500">Paket</dt><dd class="font-medium text-slate-900">{plans.find((plan) => plan.id === tenant.plan_id)?.name ?? tenant.plan_id}</dd></div>
            <div><dt class="text-xs text-slate-500">Dibuat</dt><dd class="font-medium text-slate-900">{formatWibDateTime(tenant.created_at)}</dd></div>
            <div><dt class="text-xs text-slate-500">Langganan aktif sampai</dt><dd class="font-medium text-slate-900">{formatWibDateTime(tenant.subscription_ends_at)}</dd></div>
            <div><dt class="text-xs text-slate-500">Masa tenggang sampai</dt><dd class="font-medium text-slate-900">{formatWibDateTime(tenant.grace_ends_at)}</dd></div>
            <div><dt class="text-xs text-slate-500">Dihapus setelah</dt><dd class="font-medium text-slate-900">{formatWibDate(tenant.purge_after)}</dd></div>
          </dl>
        </CardContent>
      </Card>
      <TenantActions client:load tenantId={tenantId} slug={slug} status={String(tenant.status)} allowed={allowed} purgeScheduled={Boolean(tenant.purge_after)} />
    </div>

    <Card className="border-slate-200 shadow-none">
      <CardHeader className="border-b border-slate-100 pb-3">
        <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Tagihan langganan</CardTitle>
        <CardDescription><a href={`/platform/billing?q=${encodeURIComponent(slug)}`} class="font-semibold text-blue-700 hover:underline">Lihat di menu Tagihan</a></CardDescription>
      </CardHeader>
      <CardContent className="px-0">
        {invoices.length ? (
          <Table>
            <TableHeader className="bg-slate-50">
              <TableRow>
                <TableHead className="px-4 text-xs text-slate-500">Nomor</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Paket</TableHead>
                <TableHead className="px-4 text-right text-xs text-slate-500">Total</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Metode</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Status</TableHead>
                <TableHead className="px-4 text-xs text-slate-500">Dibuat</TableHead>
                <TableHead className="px-4"><span class="sr-only">Aksi</span></TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {invoices.map((invoice) => (
                <TableRow>
                  <TableCell className="px-4 font-mono text-xs">{invoice.invoice_number}</TableCell>
                  <TableCell className="px-4">{cycleLabel(invoice.cycle_code)}</TableCell>
                  <TableCell className="px-4 text-right tabular-nums">{formatIdr(invoice.total_idr)}</TableCell>
                  <TableCell className="px-4">{invoice.channel_code}</TableCell>
                  <TableCell className="px-4"><StatusChip value={invoice.status} label={INVOICE_LABELS[invoice.status]} /></TableCell>
                  <TableCell className="px-4 text-slate-700">{formatWibDateTime(invoice.created_at)}</TableCell>
                  <TableCell className="px-4 text-right">{invoice.status === 'pending' && <InvoiceCheckButton client:visible invoiceId={invoice.id} />}</TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        ) : (
          <p class="px-4 py-4 text-sm text-slate-500">Belum ada tagihan.</p>
        )}
      </CardContent>
    </Card>

    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Pemakaian 30 hari</CardTitle>
          <CardDescription>Dari catatan harian platform ({usage.days} hari tercatat).</CardDescription>
        </CardHeader>
        <CardContent>
          <dl class="grid grid-cols-3 gap-3 text-sm">
            <div><dt class="text-xs text-slate-500">Pesanan</dt><dd class="text-xl font-semibold tabular-nums text-slate-950">{usage.orders.toLocaleString('id-ID')}</dd></div>
            <div><dt class="text-xs text-slate-500">Request</dt><dd class="text-xl font-semibold tabular-nums text-slate-950">{usage.requests.toLocaleString('id-ID')}</dd></div>
            <div><dt class="text-xs text-slate-500">Media</dt><dd class="text-xl font-semibold tabular-nums text-slate-950">{mb(usage.mediaBytes)}</dd></div>
          </dl>
        </CardContent>
      </Card>
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Kesehatan</CardTitle>
        </CardHeader>
        <CardContent>
          <dl class="space-y-1.5 text-sm">
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Heartbeat</dt><dd class="text-slate-900">{formatWibDateTime(health?.heartbeat_at)}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Backlog CAPI</dt><dd class="tabular-nums text-slate-900">{health?.outbox_backlog ?? 0}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-slate-500">Error terakhir</dt><dd class="break-all text-right text-slate-900">{health?.last_error ?? '—'}</dd></div>
          </dl>
        </CardContent>
      </Card>
    </div>

    <Card className="border-slate-200 shadow-none">
      <CardHeader className="border-b border-slate-100 pb-3">
        <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Host</CardTitle>
        <CardDescription>Subdomain adsbook.my.id dan domain sendiri milik seller.</CardDescription>
      </CardHeader>
      <CardContent className="px-0">
        <ul class="divide-y divide-slate-100 text-sm">
          {hosts.map((host) => (
            <li class="flex flex-wrap items-center gap-2 px-4 py-2.5">
              <span class="break-all font-mono text-xs text-slate-800">{host.host}</span>
              <StatusChip value={host.status} label={HOST_LABELS[host.status] ?? host.status} />
              <span class="text-xs text-slate-500">{host.kind === 'custom' ? 'domain sendiri' : 'subdomain'}{host.is_primary === 1 ? ' · utama' : ''}{host.ssl_status ? ` · SSL ${host.ssl_status}` : ''}</span>
            </li>
          ))}
        </ul>
      </CardContent>
    </Card>

    <Card className="border-slate-200 shadow-none">
      <CardHeader className="border-b border-slate-100 pb-3">
        <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Riwayat</CardTitle>
        <CardDescription><a href={`/platform/activity?slug=${encodeURIComponent(slug)}`} class="font-semibold text-blue-700 hover:underline">Semua aktivitas toko ini</a></CardDescription>
      </CardHeader>
      <CardContent className="px-0">
        <ol class="divide-y divide-slate-100 text-sm">
          {events.map((event) => (
            <li class="px-4 py-2.5">
              <span class="font-medium text-slate-900">{EVENT_LABELS[event.kind] ?? event.kind}</span>
              <span class="text-slate-500"> · {formatWibDateTime(event.at)} · {actorLabel(event.actor)}</span>
              {describeEvent(event.detail_json) && <p class="text-xs text-slate-600">{describeEvent(event.detail_json)}</p>}
            </li>
          ))}
        </ol>
      </CardContent>
    </Card>
  </div>
</PlatformLayout>

---
import PlatformLayout from '../PlatformLayout.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import Kpi from '../Kpi.astro';
import DailyChart from '../DailyChart';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../ui/card';
import { buttonVariants } from '../../ui/button';
import { getRuntimeEnv } from '../../../lib/env';
import { formatIdr } from '../../../lib/format-idr';
import { actionItems, ageText, dailySeries, overviewKpis, ownerWhatsAppLink, previewLeads } from '../../../platform/admin/metrics';

// UX-7: what needs the operator today, and how the business is doing.
const platformDb = (getRuntimeEnv(Astro.locals) as Record<string, unknown> | undefined)?.PLATFORM_DB as D1Database;
const now = new Date();
const [kpis, actions, leads, series] = await Promise.all([
  overviewKpis(platformDb, now),
  actionItems(platformDb, now),
  previewLeads(platformDb, 15),
  dailySeries(platformDb, now, 30),
]);
const conversion = kpis.activated ? `${Math.round((kpis.everSubscribed / kpis.activated) * 100)}%` : '—';
const monthName = new Intl.DateTimeFormat('id-ID', { month: 'long', timeZone: 'Asia/Jakarta' }).format(now);
const loadedAt = new Intl.DateTimeFormat('id-ID', { timeStyle: 'short', timeZone: 'Asia/Jakarta' }).format(now);
const totalSignups = series.reduce((sum, point) => sum + point.signups, 0);
const totalPaid = series.reduce((sum, point) => sum + point.paid, 0);
const tone: Record<string, string> = {
  grace: 'bg-amber-500', ending: 'bg-amber-500', invoice: 'bg-blue-500', domain: 'bg-blue-500',
  heartbeat: 'bg-rose-500', recovery: 'bg-rose-500', purge: 'bg-slate-400',
};
const outline = buttonVariants({ variant: 'outline' });
---
<PlatformLayout title="Ringkasan" description="Pendapatan, toko berbayar, dan yang perlu ditindak" active="overview">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title="Ringkasan platform" description={`Semua angka dalam WIB · dimuat ${loadedAt}.`} />

    <section aria-label="Angka utama" class="grid grid-cols-2 gap-2.5 sm:gap-3 xl:grid-cols-4">
      <Kpi id="kpiPaying" label="Toko berbayar" value={String(kpis.payingStores)} basis={kpis.inGrace ? `${kpis.inGrace} dalam masa tenggang` : 'aktif atau dalam masa tenggang'} />
      <Kpi id="kpiCollected" label={`Pendapatan ${monthName}`} value={formatIdr(kpis.collectedThisMonth)} basis={`bulan lalu ${formatIdr(kpis.collectedLastMonth)}`} />
      <Kpi id="kpiMrr" label="Perkiraan MRR" value={formatIdr(kpis.estimatedMrr)} basis="paket terakhir yang dibayar, per 30 hari" />
      <Kpi id="kpiConversion" label="Preview → bayar" value={conversion} basis={`${kpis.everSubscribed} dari ${kpis.activated} toko · ${kpis.signupsLast7Days} daftar 7 hari terakhir`} />
    </section>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(320px,1fr)]">
      <Card className="min-w-0 border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">30 hari terakhir</CardTitle>
          <CardDescription>{totalSignups} toko baru · {totalPaid} pembayaran langganan · per hari WIB</CardDescription>
        </CardHeader>
        <CardContent>
          <figure>
            <DailyChart client:visible points={series} />
            <figcaption class="sr-only">{totalSignups} toko baru dan {totalPaid} pembayaran dalam 30 hari terakhir.</figcaption>
            <table class="sr-only">
              <caption>Toko baru dan tagihan dibayar per hari (WIB)</caption>
              <thead><tr><th scope="col">Tanggal</th><th scope="col">Toko baru</th><th scope="col">Dibayar</th></tr></thead>
              <tbody>{series.map((point) => <tr><td>{point.day}</td><td>{point.signups}</td><td>{point.paid}</td></tr>)}</tbody>
            </table>
          </figure>
        </CardContent>
      </Card>

      <Card className="min-w-0 border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Perlu tindakan</CardTitle>
          <CardDescription>{actions.length ? `${actions.length} item` : 'Semua beres'}</CardDescription>
        </CardHeader>
        <CardContent className="px-0">
          {actions.length ? (
            <ul class="divide-y divide-slate-100" id="actionList">
              {actions.map((item) => (
                <li>
                  <a href={item.href} class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-slate-50">
                    <span class={`mt-1.5 size-2 shrink-0 rounded-full ${tone[item.kind] ?? 'bg-slate-400'}`} aria-hidden="true" />
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-medium text-slate-900">{item.label} · <span class="font-normal text-slate-700">{item.slug}</span></span>
                      <span class="block truncate text-xs text-slate-500">{item.detail}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="px-4 py-6 text-sm text-slate-500" id="actionList">Tidak ada yang perlu ditindak.</p>
          )}
        </CardContent>
      </Card>
    </div>

    <Card className="border-slate-200 shadow-none">
      <CardHeader className="border-b border-slate-100 pb-3">
        <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Follow-up Mode Preview</CardTitle>
        <CardDescription>Toko yang belum pernah berlangganan, terbaru di atas.</CardDescription>
      </CardHeader>
      <CardContent className="px-0">
        {leads.length ? (
          <ul class="divide-y divide-slate-100" id="leadList">
            {leads.map((lead) => {
              const wa = ownerWhatsAppLink(lead.owner_whatsapp, lead.slug);
              return (
                <li class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                  <div class="min-w-0">
                    <a href={`/platform/tenants/${lead.id}`} class="text-sm font-semibold text-blue-700 hover:underline">{lead.slug}</a>
                    <p class="truncate text-xs text-slate-500">{lead.owner_email} · daftar {ageText(lead.created_at, now)} lalu</p>
                  </div>
                  <div class="flex shrink-0 gap-2">
                    {wa && <a href={wa} target="_blank" rel="noopener" class={outline}>WhatsApp</a>}
                    <a href={`mailto:${lead.owner_email}`} class={outline}>Email</a>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="px-4 py-6 text-sm text-slate-500" id="leadList">Belum ada toko di Mode Preview.</p>
        )}
      </CardContent>
    </Card>
  </div>
</PlatformLayout>

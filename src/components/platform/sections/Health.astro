---
import PlatformLayout from '../PlatformLayout.astro';
import { getRuntimeEnv } from '../../../lib/env';
import { platformHealth } from '../../../platform/admin/health';
import { formatWibDateTime } from '../../../platform/admin/metrics';

// OBS-3/OBS-4: what the control plane knows, plus which platform settings are configured (never a value).
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const platformDb = env.PLATFORM_DB as D1Database;
const health = await platformHealth(platformDb);
// Configured or not — never a value. Platform-host code only (the platform tag stays off seller hosts).
const set = (name: string) => typeof env[name] === 'string' && String(env[name]).trim().length > 0;
const config = [
  { label: 'Pembayaran langganan (AutoLaris platform)', ok: set('PLATFORM_AUTOLARIS_API_KEY') },
  { label: 'Webhook AutoLaris platform', ok: set('PLATFORM_AUTOLARIS_WEBHOOK_TOKEN') },
  { label: 'Notifikasi operator (alert webhook)', ok: set('PLATFORM_ALERT_WEBHOOK_URL') },
  { label: 'Turnstile pendaftaran', ok: set('TURNSTILE_SITE_KEY') && set('TURNSTILE_SECRET_KEY') },
  { label: 'Meta Pixel + CAPI platform', ok: set('PLATFORM_META_PIXEL_ID') && set('PLATFORM_META_CAPI_TOKEN') },
  { label: 'Cloudflare for SaaS (domain sendiri)', ok: set('CF_SAAS_TOKEN') },
  { label: 'Kunci enkripsi kredensial', ok: set('PLATFORM_CREDENTIAL_KEY') },
];
const time = (iso: string | null) => (iso ? formatWibDateTime(iso) : 'belum ada');
const panel = 'rounded-xl border border-slate-200 bg-white p-5';
---
<PlatformLayout title="Kesehatan" active="health">
  <h1 class="text-xl font-semibold text-slate-950">Kesehatan platform</h1>
  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    <section class={panel}><h2 class="text-base font-semibold">Toko per status</h2>
      <ul class="mt-2 space-y-1 text-sm">{health.statuses.length ? health.statuses.map((row) => <li class="flex justify-between"><span>{row.status}</span><strong class="tabular-nums">{row.n}</strong></li>) : <li>Belum ada toko.</li>}</ul></section>
    <section class={panel}><h2 class="text-base font-semibold">Domain sendiri</h2>
      <ul class="mt-2 space-y-1 text-sm">{health.customHostnames.length ? health.customHostnames.map((row) => <li class="flex justify-between"><span>{row.status}</span><strong class="tabular-nums">{row.n}</strong></li>) : <li>Belum ada.</li>}</ul></section>
    <section id="staleHeartbeats" class="rounded-xl border border-rose-200 bg-white p-5"><h2 class="text-base font-semibold text-rose-800">Heartbeat lebih dari 2 jam</h2>
      <ul class="mt-2 space-y-1 text-sm">{health.staleHeartbeats.length ? health.staleHeartbeats.map((row) => <li><a class="font-semibold text-blue-700 hover:underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a> · {time(row.heartbeat_at)}{row.last_error ? ` · ${row.last_error}` : ''}</li>) : <li>Semua toko aktif sehat.</li>}</ul></section>
    <section class={panel}><h2 class="text-base font-semibold">Recovery dan backlog</h2>
      <ul class="mt-2 space-y-1 text-sm">
        {health.recovery.map((row) => <li>recovery: <a class="font-semibold text-blue-700 hover:underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
        {health.backlog.map((row) => <li>backlog {row.outbox_backlog}: <a class="font-semibold text-blue-700 hover:underline" href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
        {health.unresolvedRecoveries.map((row) => <li class="text-rose-800">pemulihan owner tanpa hasil: <a class="font-semibold text-blue-700 hover:underline" href={`/platform/tenants/${row.tenant_id}`}>{row.slug ?? row.tenant_id}</a> · {time(row.at)}</li>)}
        {!health.recovery.length && !health.backlog.length && !health.unresolvedRecoveries.length && <li>Tidak ada.</li>}
      </ul></section>
    <section id="platformConfig" class={`${panel} md:col-span-2`}><h2 class="text-base font-semibold">Konfigurasi platform</h2>
      <p class="mt-1 text-xs text-slate-500">Hanya terpasang atau belum — nilainya tidak pernah ditampilkan.</p>
      <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
        {config.map((item) => <li class="flex justify-between gap-3"><span>{item.label}</span><span class={item.ok ? 'font-semibold text-emerald-700' : 'font-semibold text-amber-800'}>{item.ok ? 'Terpasang' : 'Belum'}</span></li>)}
      </ul></section>
  </div>
  <p class="mt-4 text-xs text-slate-500">Tingkat error Worker dan jumlah 404/503 gate: Workers Logs (baris <code>event: request</code> per permintaan) dan analitik dashboard Cloudflare. Diperiksa {time(health.checkedAt)} (WIB).</p>
</PlatformLayout>

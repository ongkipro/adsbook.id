---
import PlatformLayout from '../PlatformLayout.astro';
import AdminPageHeader from '../../admin/AdminPageHeader.astro';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../ui/card';
import { getRuntimeEnv } from '../../../lib/env';
import { platformHealth } from '../../../platform/admin/health';
import { formatWibDateTime } from '../../../platform/admin/metrics';

// OBS-3/OBS-4: what the control plane knows, plus which platform settings are configured (never a value).
const env = (getRuntimeEnv(Astro.locals) ?? {}) as Record<string, unknown>;
const platformDb = env.PLATFORM_DB as D1Database;
const health = await platformHealth(platformDb);
// Configured or not — never a value. Platform-host code only (the platform tag stays off seller hosts).
const set = (name: string) => typeof env[name] === 'string' && String(env[name]).trim().length > 0;
const config = [
  { label: 'Pembayaran langganan (AutoLaris platform)', ok: set('PLATFORM_AUTOLARIS_API_KEY') },
  { label: 'Webhook AutoLaris platform', ok: set('PLATFORM_AUTOLARIS_WEBHOOK_TOKEN') },
  { label: 'Notifikasi operator (alert webhook)', ok: set('PLATFORM_ALERT_WEBHOOK_URL') },
  { label: 'Turnstile pendaftaran', ok: set('TURNSTILE_SITE_KEY') && set('TURNSTILE_SECRET_KEY') },
  { label: 'Meta Pixel + CAPI platform', ok: set('PLATFORM_META_PIXEL_ID') && set('PLATFORM_META_CAPI_TOKEN') },
  { label: 'Cloudflare for SaaS (domain sendiri)', ok: set('CF_SAAS_TOKEN') },
  { label: 'Kunci enkripsi kredensial', ok: set('PLATFORM_CREDENTIAL_KEY') },
];
const time = (iso: string | null) => (iso ? formatWibDateTime(iso) : 'belum ada');
const STATUS_LABELS: Record<string, string> = { active: 'Aktif', suspended: 'Ditangguhkan', provisioning: 'Dibuat', recovery: 'Pemulihan', purging: 'Dihapus', purged: 'Terhapus', pending: 'Menunggu DNS', revoked: 'Dicabut' };
const link = 'font-semibold text-blue-700 hover:underline';
---
<PlatformLayout title="Kesehatan" description="Heartbeat, backlog, dan konfigurasi platform" active="health">
  <div class="space-y-4 md:space-y-5">
    <AdminPageHeader title="Kesehatan platform" description={`Diperiksa ${time(health.checkedAt)} WIB. Error rate Worker dan 404/503 gate ada di Workers Logs dan analitik Cloudflare.`} />
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3"><CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Toko per status</CardTitle></CardHeader>
        <CardContent>
          <ul class="space-y-1.5 text-sm">{health.statuses.length ? health.statuses.map((row) => <li class="flex justify-between"><span class="text-slate-700">{STATUS_LABELS[row.status] ?? row.status}</span><strong class="tabular-nums text-slate-950">{row.n}</strong></li>) : <li class="text-slate-500">Belum ada toko.</li>}</ul>
        </CardContent>
      </Card>
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3"><CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Domain sendiri</CardTitle></CardHeader>
        <CardContent>
          <ul class="space-y-1.5 text-sm">{health.customHostnames.length ? health.customHostnames.map((row) => <li class="flex justify-between"><span class="text-slate-700">{STATUS_LABELS[row.status] ?? row.status}</span><strong class="tabular-nums text-slate-950">{row.n}</strong></li>) : <li class="text-slate-500">Belum ada.</li>}</ul>
        </CardContent>
      </Card>
      <Card id="staleHeartbeats" className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Heartbeat lebih dari 2 jam</CardTitle>
          <CardDescription>Toko aktif yang alarm-nya tidak melapor.</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="space-y-1.5 text-sm">{health.staleHeartbeats.length ? health.staleHeartbeats.map((row) => <li><a class={link} href={`/platform/tenants/${row.id}`}>{row.slug}</a> <span class="text-slate-500">· {time(row.heartbeat_at)}{row.last_error ? ` · ${row.last_error}` : ''}</span></li>) : <li class="text-slate-500">Semua toko aktif sehat.</li>}</ul>
        </CardContent>
      </Card>
      <Card className="border-slate-200 shadow-none">
        <CardHeader className="border-b border-slate-100 pb-3"><CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Recovery dan backlog</CardTitle></CardHeader>
        <CardContent>
          <ul class="space-y-1.5 text-sm">
            {health.recovery.map((row) => <li>Pemulihan: <a class={link} href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
            {health.backlog.map((row) => <li>Backlog {row.outbox_backlog}: <a class={link} href={`/platform/tenants/${row.id}`}>{row.slug}</a></li>)}
            {health.unresolvedRecoveries.map((row) => <li class="text-rose-800">Pemulihan owner tanpa hasil: <a class={link} href={`/platform/tenants/${row.tenant_id}`}>{row.slug ?? row.tenant_id}</a> · {time(row.at)}</li>)}
            {!health.recovery.length && !health.backlog.length && !health.unresolvedRecoveries.length && <li class="text-slate-500">Tidak ada.</li>}
          </ul>
        </CardContent>
      </Card>
      <Card id="platformConfig" className="border-slate-200 shadow-none md:col-span-2">
        <CardHeader className="border-b border-slate-100 pb-3">
          <CardTitle as="h2" className="text-sm font-semibold text-slate-950 md:text-base">Konfigurasi platform</CardTitle>
          <CardDescription>Hanya terpasang atau belum — nilainya tidak pernah ditampilkan.</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="grid grid-cols-1 gap-x-8 gap-y-1.5 text-sm sm:grid-cols-2">
            {config.map((item) => <li class="flex justify-between gap-3"><span class="text-slate-700">{item.label}</span><span class={item.ok ? 'font-semibold text-emerald-700' : 'font-semibold text-amber-700'}>{item.ok ? 'Terpasang' : 'Belum'}</span></li>)}
          </ul>
        </CardContent>
      </Card>
    </div>
  </div>
</PlatformLayout>

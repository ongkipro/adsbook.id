---
/**
 * A platform legal document by version (T-39, PR-24): `?v=<version>` shows
 * that exact accepted text; without it, the current version. An unknown
 * version is a 404, never a different text. Placeholders the operator has
 * not filled yet stay visible (marked), because filling one is a new version.
 */
import '../../styles/admin.css';
import { legalText, legalVersions, renderLegalMarkdown, type LegalDocId } from '../../platform/legal.ts';

interface Props {
  doc: LegalDocId;
  title: string;
}

const { doc, title } = Astro.props;
const entry = legalText(doc, Astro.url.searchParams.get("v"));
if (!entry) Astro.response.status = 404;
const html = entry
  ? renderLegalMarkdown(entry.text.replace(/^# .+\n/, ''), { versi: entry.version, tanggal_berlaku: entry.date, slug: 'nama-toko' })
  : '';
const versions = legalVersions(doc);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - adsbook.id</title>
  </head>
  <body class="min-h-dvh bg-[#f6f7f9] text-slate-900 antialiased">
    <main class="mx-auto w-full max-w-2xl px-4 py-10 sm:py-14">
      <p class="text-sm font-semibold text-blue-700"><a href="/platform/signup">adsbook.id</a></p>
      <h1 class="mt-1 text-2xl font-semibold text-slate-950">{title}</h1>
      {entry ? (
        <>
          <p class="mt-2 text-sm text-slate-600">Versi {entry.version} · {entry.date}{versions.length > 1 && <> · versi lain: {versions.filter((v) => v !== entry.version).map((v) => <a class="underline" href={`?v=${v}`}>{v}</a>)}</>}</p>
          <article class="legal mt-6 rounded-xl border border-slate-200 bg-white p-5 text-sm leading-7 text-slate-700 shadow-sm sm:p-8" set:html={html} />
        </>
      ) : (
        <p class="mt-6 rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-700" role="status">Versi ini tidak ada. <a class="underline" href="?">Lihat versi terbaru</a>.</p>
      )}
    </main>
  </body>
</html>

<style>
  .legal :global(h2) { margin-top: 1.75rem; font-size: 1.05rem; font-weight: 600; color: #0f172a; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(h3) { margin-top: 1.25rem; font-weight: 600; color: #0f172a; }
  .legal :global(p), .legal :global(ul), .legal :global(ol), .legal :global(blockquote) { margin-top: 0.6rem; }
  .legal :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .legal :global(ol) { list-style: decimal; padding-left: 1.25rem; }
  .legal :global(li) { margin-top: 0.25rem; }
  .legal :global(blockquote) { border-left: 3px solid #cbd5e1; padding-left: 0.75rem; color: #64748b; }
  .legal :global(code) { font-size: 0.85em; }
  .legal :global(mark) { background: #fef3c7; color: inherit; border-radius: 0.2rem; padding: 0 0.15rem; }
</style>

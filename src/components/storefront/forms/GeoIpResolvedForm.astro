---
import { tenantDatabase } from '../../../lib/tenant-database.ts';
import FormHybridContent from './FormHybridContent.astro';
import FormMiddleContent from './FormMiddleContent.astro';
import FormDigitalContent from './FormDigitalContent.astro';
import { getStorefrontProduct } from '../../../lib/catalog';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
  type FormMode,
} from '../../../lib/form-mode';

interface Props {
  bannerImage?: string;
  mode?: FormMode;
  productSlug?: string;
  selectedVariantId?: string;
  province?: string;
  embedded?: boolean;
  /** The wide PDP's right column: the form spans the column, aligned left, from 1024px. */
  fill?: boolean;
}

const {
  mode = 'hybrid',
  province = '',
  productSlug = 'asahan-portable',
  embedded = false,
  fill = false,
  selectedVariantId,
  bannerImage,
} = Astro.props;
// DIGITAL-PRODUCTS-SPEC §5.1: a digital product takes the digital checkout, whatever the page asked for.
const digital = (await getStorefrontProduct(Astro.locals, productSlug))?.productType === 'digital';
const database = tenantDatabase(Astro.locals);
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);
const resolvedMode =
  formContext.resolvedMode === 'full'
    ? 'full'
    : mode === 'hybrid'
      ? formContext.resolvedMode
      : mode;
const resolvedProvince = province || formContext.province;
---

<div class:list={['mx-auto w-full max-w-[480px] bg-white', fill && 'sf-form-fill lg:mx-0 lg:max-w-none']} data-canonical-order-form data-resolved-mode={digital ? 'digital' : resolvedMode}>
  {
    digital ? (
      <FormDigitalContent productSlug={productSlug} selectedVariantId={selectedVariantId} embedded={embedded} />
    ) : resolvedMode === 'full' ? (
      <FormHybridContent
        productSlug={productSlug}
        selectedVariantId={selectedVariantId}
        province={resolvedProvince}
        embedded={embedded}
        bannerImage={bannerImage}
        codDisabledProvinceCodes={codDisabledProvinceCodes}
      />
    ) : (
      <FormMiddleContent
        productSlug={productSlug}
        selectedVariantId={selectedVariantId}
        province={resolvedProvince}
        embedded={embedded}
        bannerImage={bannerImage}
        codDisabledProvinceCodes={codDisabledProvinceCodes}
      />
    )
  }
</div>

---
/**
 * The digital checkout (DIGITAL-PRODUCTS-SPEC §5.1): package, name, WhatsApp,
 * optional email and a prepaid rail. No address, no courier, no COD; the
 * access link opens on /payment and /thanks once the payment is confirmed.
 * Rendered by GeoIpResolvedForm (product, landing, full/middle, embed) and
 * /hybrid-form whenever the product is digital.
 */
import { formatIdr } from '../../../lib/format-idr';
import { getStorefrontProduct } from '../../../lib/catalog';
import { cheapestVariant, resolveFormVariant } from '../../../lib/form-config';
import { jsonForScript } from '../../../lib/json-script';
import '../../../styles/form-hybrid.css';

interface Props {
  productSlug?: string;
  selectedVariantId?: string;
  embedded?: boolean;
}

const { productSlug = '', selectedVariantId, embedded = false } = Astro.props;
const product = await getStorefrontProduct(Astro.locals, productSlug);
if (!product) throw new Error(`Product ${productSlug} not found`);
const defaultVariant = resolveFormVariant(product, selectedVariantId) || cheapestVariant(product.variants)!;
const instanceId = `digital-${product.slug}-${embedded ? 'embedded' : 'standalone'}`;
const RootTag = embedded ? 'section' : 'main';
const uid = crypto.randomUUID().slice(0, 8);
---

<RootTag class="digital-checkout bg-white" data-digital-form-root data-instance-id={instanceId}>
  <form class="checkout-blocks grid grid-cols-1 px-4 pb-8 pt-4" data-digital-form novalidate>
    <div class="absolute left-[-10000px] top-auto size-px overflow-hidden" aria-hidden="true">
      <label>Jangan isi kolom ini <input type="text" name="contact_url_confirm" tabindex="-1" autocomplete="off" /></label>
    </div>

    <p class="digital-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>Produk digital · akses dikirim setelah lunas</p>

    {product.variants.length > 1 && (
      <section class="form-block form-block-first">
        <div class="form-block-head gap-1.5">
          <h2 class="section-title">Pilih paket</h2>
        </div>
        <div class="variant-group simple-variant-group">
          {product.variants.map((variant) => (
            <label class="variant-option simple-variant-option">
              <input type="radio" name="variant" value={variant.id} checked={variant.id === defaultVariant.id} data-label={variant.label} data-price={variant.price} />
              <div class="variant-copy simple-variant-copy">
                <div class="variant-radio" />
                <div class="variant-main simple-variant-main">
                  <p class="variant-label">{variant.label}</p>
                  <span class="variant-price">{formatIdr(variant.price)}</span>
                </div>
              </div>
            </label>
          ))}
        </div>
      </section>
    )}
    {product.variants.length === 1 && (
      <input type="radio" name="variant" value={defaultVariant.id} checked hidden data-label={defaultVariant.label} data-price={defaultVariant.price} />
    )}

    <section class="form-block">
      <div class="form-block-head gap-1.5">
        <h2 class="section-title">Data pembeli</h2>
        <p class="section-lead">Tanpa alamat. Link akses tampil di halaman pembayaran setelah lunas.</p>
      </div>
      <div class="field-grid">
        <div class="form-field form-field-full">
          <input id={`dig-name-${uid}`} name="customer_name" required autocomplete="name" placeholder=" " />
          <label for={`dig-name-${uid}`}>Nama lengkap</label>
        </div>
        <div class="form-field form-field-full">
          <input id={`dig-phone-${uid}`} name="customer_phone" required type="tel" inputmode="numeric" autocomplete="tel" placeholder=" " />
          <label for={`dig-phone-${uid}`}>Nomor WhatsApp aktif</label>
        </div>
        <div class="form-field form-field-full">
          <input id={`dig-email-${uid}`} name="customer_email" type="email" inputmode="email" autocomplete="email" maxlength="160" placeholder=" " />
          <label for={`dig-email-${uid}`}>Email (opsional)</label>
        </div>
      </div>
    </section>

    <section class="form-block" aria-labelledby={`dig-pay-${uid}`}>
      <div class="form-block-head gap-1.5">
        <h2 class="section-title" id={`dig-pay-${uid}`}>Metode pembayaran</h2>

      </div>
      <div class="digital-pay-list" data-digital-payments role="radiogroup" aria-labelledby={`dig-pay-${uid}`}>
        <p class="digital-pay-empty">Memuat metode pembayaran…</p>
      </div>
    </section>

    <section class="form-block summary-block">
      <div class="summary-card">
        <div class="summary-row summary-row-product">
          <strong class="summary-product-name">{product.productName}</strong>
          <span class="summary-variant" data-digital-variant>{defaultVariant.label}</span>
        </div>
        <div class="summary-row digital-summary-line"><span>Ongkos kirim</span><span>Gratis · akses digital</span></div>
        <div class="total-box">
          <div><p>Total pembayaran</p><small>Biaya layanan (jika ada) tampil di halaman bayar</small></div>
          <div class="total-box-side"><strong data-digital-total>{formatIdr(defaultVariant.price)}</strong></div>
        </div>
      </div>
      <div class="submit-panel">
        <button type="submit" class="submit-main" data-state="disabled" aria-disabled="true"><span class="submit-main-label" data-label>Bayar &amp; Dapatkan Akses</span></button>
        <p class="form-error" data-digital-error hidden role="alert"></p>
      </div>
    </section>
  </form>
  <script
    is:inline
    type="application/json"
    data-digital-form-config
    set:html={jsonForScript({ instanceId, productSlug: product.slug, productId: product.productId, productName: product.productName })}
  />
</RootTag>

<script>
  import { initDigitalOrderForms } from '../../../scripts/form-digital';
  initDigitalOrderForms();
</script>

<style is:global>
  /* Digital checkout on the COD forms' system (owner, 2026-11-23): the same
     accent tokens, 6px controls, 8px between rows, ink and #555 text. */
  .digital-checkout .digital-badge { display: inline-flex; align-items: center; gap: 0.5rem; justify-self: start; min-height: 2rem; padding: 0 0.75rem; border-radius: 0.375rem; background: var(--sf-accent-soft); color: var(--sf-accent-strong); font-size: 0.8125rem; font-weight: 600; }
  .digital-checkout .digital-badge svg { width: 1rem; height: 1rem; flex-shrink: 0; }
  .digital-checkout .digital-pay-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  .digital-checkout .digital-pay-option { display: flex; align-items: center; gap: 0.75rem; min-height: 3.5rem; padding: 0.75rem 0.875rem; border: 1px solid #E5E5E5; border-radius: 0.375rem; background: #fff; cursor: pointer; transition: border-color 0.18s ease, background-color 0.18s ease; }
  .digital-checkout .digital-pay-option:has(input:checked) { border-color: var(--sf-accent); background: var(--sf-accent-soft); }
  .digital-checkout .digital-pay-option:has(input:focus-visible) { outline: 2px solid var(--sf-accent); outline-offset: 2px; }
  .digital-checkout .digital-pay-option input { width: 1.125rem; height: 1.125rem; margin: 0; accent-color: var(--sf-accent); flex-shrink: 0; }
  .digital-checkout .digital-pay-text { display: grid; gap: 0.125rem; flex: 1; min-width: 0; }
  .digital-checkout .digital-pay-text strong { font-size: 0.9375rem; font-weight: 600; color: #111111; }
  .digital-checkout .digital-pay-text small { font-size: 0.8125rem; color: #555555; }
  .digital-checkout .digital-pay-option img { width: 42px; height: 28px; object-fit: contain; flex-shrink: 0; }
  .digital-checkout .digital-pay-empty { margin: 0; padding: 0.875rem; border-radius: 0.375rem; background: #F7F7F7; font-size: 0.875rem; color: #555555; }
  .digital-checkout .digital-summary-line { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.8125rem; color: #555555; }
</style>

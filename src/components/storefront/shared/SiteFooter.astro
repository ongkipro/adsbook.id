---

// The footer is the storefront's navigation (Paduka, 2026-11-01): the header
// carries the store name alone, so the catalogue and the landing pages are
// reached from here. Meta and Google both want a reachable contact, privacy
// policy, terms, and a shipping/returns policy before they will run a store's
// ads; those stay one tap away on every page. /tentang, /disclaimer,
// /testimoni and the others still render and sit in sitemap.xml.
//
// No per-visitor value and no database read: the footer is safe in the
// two-minute anonymous edge cache (ADR-029).
const groups = [
  {
    title: 'Belanja',
    links: [
      { label: 'Semua produk', href: '/produk' },
      { label: 'Halaman promo', href: '/landing-page' },
    ],
  },
  {
    title: 'Bantuan',
    links: [
      { label: 'Kontak', href: '/kontak' },
      { label: 'Pengiriman & Retur', href: '/pengiriman' },
      { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
      { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
    ],
  },
];

const path = Astro.url.pathname;
const linkClass =
  'inline-flex min-h-10 items-center text-sm text-[#444444] underline-offset-4 hover:text-[#111111] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] aria-[current=page]:font-semibold aria-[current=page]:text-[#111111]';
---

<!-- Compact footer (2026-11-23): the store's name and the two link
     groups on a quiet band, at the page's content width. The faint name
     watermark is gone: it sat on top of the group titles. -->
<footer class="mt-8 border-t border-[#EDEDEF] bg-[#FAFAFA] text-[#111111]">
  <div class="grid grid-cols-2 gap-x-4 gap-y-6 px-5 py-8">
    <div class="col-span-2 min-w-0">
      <p class="truncate text-[15px] font-bold uppercase tracking-[0.06em]">{Astro.locals.tenant.name}</p>
      {(Astro.locals.tenant.tagline || Astro.locals.tenant.description) && (
        <p class="mt-2 line-clamp-3 max-w-sm text-sm leading-6 text-[#555555]">{Astro.locals.tenant.tagline || Astro.locals.tenant.description}</p>
      )}
    </div>
    <nav aria-label="Tautan footer" class="contents">
      {
        groups.map((group) => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.08em] text-[#555555]">{group.title}</p>
            <ul class="mt-2">
              {group.links.map((item) => (
                <li>
                  <a href={item.href} class={linkClass} aria-current={path === item.href ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  {/* The store holds the copyright on its own site; the platform's only mark
      on a seller host is this small link (UI-1, plan pilot keeps it on;
      replaces the 2026-11-01 maker credit). */}
  <div class="border-t border-[#EDEDEF]">
    <p class="px-5 py-4 text-center text-xs text-[#767676]">
      © {new Date().getFullYear()} {Astro.locals.tenant.name} ·{' '}
      <a
        href="https://adsbook.id"
        target="_blank"
        rel="noopener"
        class="underline-offset-4 hover:text-[#111111] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111]"
      >Dibuat dengan adsbook.id</a>
    </p>
  </div>
</footer>

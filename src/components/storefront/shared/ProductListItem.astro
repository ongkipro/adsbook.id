---
import { cardImageSrc } from '../../../lib/image-derivative';

/** The card only counts these. Requiring the full variant shape made every
 *  caller carry fields the card never reads. */
interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
    /** Seller-published presentation (storefront_content), never invented. */
    ratingValue?: number;
    reviewCount?: number;
    soldCount?: number;
  };
  formatPrice: (value: number) => string;
  /** Above-the-fold cards only. On /produk the first row is the page's LCP
   *  element, and a lazy LCP image is the one thing lazy-loading must never
   *  touch — under Slow 4G it spent 726ms of a 919ms LCP merely waiting to
   *  be requested. The homepage grid sits below the hero and stays lazy. */
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
// "Mulai" only when the variants really differ in price; a card that says
// "from" over one price is hedging for nothing.
const hasRange = new Set(product.variants.map((variant) => variant.price).filter((price) => typeof price === 'number')).size > 1;
// The discount sits in the price row, never over the photo: supplier banners
// carry their headline in the top-left corner and a badge there hid it.
const discountPercentage = hasDiscount ? Math.round((1 - product.price / comparePrice) * 100) : 0;
// One quiet meta line, only from what the seller published: "★ 4.8 · 1,2rb terjual".
const rating = typeof product.ratingValue === 'number' && (product.reviewCount ?? 0) > 0 ? product.ratingValue.toFixed(1) : '';
const sold = product.soldCount && product.soldCount > 0
  ? product.soldCount >= 1000
    ? `${(product.soldCount / 1000).toFixed(1).replace('.0', '').replace('.', ',')}rb terjual`
    : `${product.soldCount} terjual`
  : '';
---

<!-- Compact card (2026-11-23): compact, square photo on a 6px radius,
     a hairline frame, tabular prices. Every line has a fixed height so a row
     of cards lines up whatever the data. -->
<article class="sf-card group h-full">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col overflow-hidden rounded-sf border border-sf-line bg-white transition-[border-color,box-shadow] hover:border-sf-line-strong hover:shadow-[0_2px_10px_rgba(17,17,17,0.06)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink"
  >
    <div class="relative aspect-square overflow-hidden bg-sf-surface">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    </div>

    {/* Four fixed lines, so every card in a row ends level: the title (two
        lines held, a short one keeps its space), the price, the compare price
        and discount, then one meta line. 13px body, tabular figures. */}
    <div class="flex flex-1 flex-col px-2 pb-2 pt-1.5">
      <h2 class="line-clamp-2 h-9 text-[13px] leading-[18px] text-sf-ink" title={product.productName}>{product.productName}</h2>
      <p class="sf-num mt-1 flex h-5 items-baseline gap-1 leading-5">
        {hasRange && <span class="text-xs text-sf-text">Mulai</span>}
        <span class="text-[15px] font-bold text-sf-ink">{formatPrice(product.price)}</span>
      </p>
      <p class="sf-num flex h-4 items-center gap-1.5 text-xs leading-4">
        {hasDiscount && <span class="text-sf-muted line-through">{formatPrice(comparePrice)}</span>}
        {discountPercentage > 0 && <span class="font-semibold text-sf-danger">{discountPercentage}%</span>}
      </p>
      <p class="sf-num mt-1 flex h-4 items-center gap-1 truncate text-xs leading-4 text-sf-text">
        {rating && (
          <>
            <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0" aria-hidden="true"><path fill="#111111" d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9Z"/></svg>
            <span class="text-sf-ink">{rating}</span>
          </>
        )}
        {rating && sold && <span aria-hidden="true" class="text-sf-line-strong">·</span>}
        {sold && <span>{sold}</span>}
        {!rating && !sold && product.variants.length > 1 && <span>{product.variants.length} pilihan</span>}
      </p>
    </div>
  </a>
</article>

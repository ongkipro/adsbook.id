---
import { storefrontImageSrc } from '../../../lib/image-derivative';

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
  /** One or two lines from the product's own description (`heroSummary`). */
  summary?: string;
  /** The product page, when the slide is a catalogue product. */
  href?: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<!-- Home hero (owner, 2026-11-23): full width of the 480px column, three to
     five catalogue products (or the store's own banner) that slide by
     themselves, each with its name and a line of its description. The first
     slide is the LCP image (preloaded by index.astro); the rest load lazily.
     The motion stops while a finger is on it, while the tab is hidden, and
     never starts under prefers-reduced-motion. -->
<section class="hero" aria-roledescription="carousel" aria-label="Produk unggulan" data-hero>
  <h1 class="sr-only">{Astro.locals.tenant.defaultTitle}</h1>
  <div id="hero-track" class="hero-track flex snap-x snap-mandatory overflow-x-auto bg-sf-surface" aria-live="off">
    {
      slides.map((slide, index) => {
        const body = (
          <>
            <img
              src={storefrontImageSrc(slide.image)}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              width="480"
              height="480"
              class="aspect-square w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
              draggable={false}
            />
            {(slide.badge || slide.text || slide.summary) && <div class="hero-caption">
              {slide.badge && (
                <p class="inline-block rounded-full bg-black/40 px-2.5 py-0.5 text-xs font-medium text-white/95 backdrop-blur-xs">
                  {slide.badge}
                </p>
              )}
              <p class="mt-1.5 line-clamp-2 text-xl font-bold leading-snug tracking-[-0.015em] text-white">{slide.text}</p>
              {slide.summary && <p class="mt-1 line-clamp-2 text-[13px] leading-[18px] text-white/85">{slide.summary}</p>}
            </div>}
          </>
        );
        return (
          <article data-hero-slide class="relative min-w-full snap-start" aria-roledescription="slide" aria-label={`${index + 1} dari ${slides.length}`}>
            {slide.href ? <a href={slide.href} class="block focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-white">{body}</a> : body}
          </article>
        );
      })
    }
  </div>
  {slides.length > 1 && (
    <div id="hero-dots" class="hero-dots" role="group" aria-label="Pilih slide">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            aria-current={index === 0 ? 'true' : undefined}
            class="hero-dot group flex h-10 w-6 items-center justify-center focus-visible:outline-2 focus-visible:outline-white"
          >
            <span class="block h-1.5 w-1.5 rounded-full bg-white/60 transition-all group-aria-[current=true]:w-4 group-aria-[current=true]:bg-white" />
          </button>
        ))
      }
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
  }
  .hero-track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
  /* The caption sits on the photo's lower edge over a scrim dark enough for
     white text on any image (4.5:1 against the scrim's darkest stop). Extra
     bottom padding keeps the summary clear of the pager dots below. */
  .hero-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 4.5rem 1rem 2.75rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.48) 58%, transparent);
  }
  .hero-dots {
    position: absolute;
    left: 50%;
    bottom: 0.25rem;
    transform: translateX(-50%);
    display: flex;
  }
</style>

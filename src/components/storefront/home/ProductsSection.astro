---
// One card for the whole storefront. The home grid grew its own with a
// rating, a sold count and a CTA while /produk had a cleaner one; two cards
// meant two answers to the same question. The wrapper below keeps the search
// hooks the filter script reads - the card has no business knowing them.
import ProductListItem from '../shared/ProductListItem.astro';
import Icon from '../shared/Icon.astro';
import { CATALOG_PAGE_SIZE } from '../../../lib/catalog-page-size';

interface Product {
  slug: string;
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants?: Array<{ label: string; price: number }>;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  products: Product[];
  heading: Heading;
  /** /produk: the heading is the page's h1, there is no "Lihat semua", and the header's `?q=` filters the grid. */
  asPage?: boolean;
  /** The first row is the LCP element on /produk. */
  eager?: boolean;
}

const { products, heading, asPage = false, eager = false } = Astro.props;
// Chips only when they narrow something: one category is the whole list.
const categories = [...new Set(products.map((product) => product.category).filter(Boolean))];
const showChips = categories.length > 1;
const chipClass =
  'catalog-chip inline-flex min-h-10 shrink-0 items-center rounded-sf border border-sf-line bg-white px-3 text-sm text-sf-text transition-colors hover:border-sf-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink aria-pressed:border-sf-accent aria-pressed:bg-sf-accent-soft aria-pressed:font-semibold aria-pressed:text-sf-accent-strong';

const formatPrice = (val: number) => `Rp${val.toLocaleString('id-ID')}`;
---

<section id="produk" class:list={["px-4 pb-8", asPage ? "pt-1" : "pt-6"]}>
  <div class="mb-3">
    <div class="flex items-baseline justify-between gap-4">
      {asPage
        ? <h1 class="text-xl font-bold tracking-[-0.01em] text-sf-ink">{heading.title}</h1>
        : <h2 class="text-lg font-bold tracking-[-0.01em] text-sf-ink">{heading.title}</h2>}
      {!asPage && <a href="/produk" class="-my-2.5 inline-flex min-h-10 shrink-0 items-center text-sm font-semibold text-sf-accent underline-offset-4 hover:underline">Lihat semua</a>}
    </div>
    {heading.description && <p class="mt-0.5 text-sm leading-5 text-sf-text">{heading.description}</p>}
  </div>

  <div class="mb-4 flex flex-col gap-3" hidden={products.length === 0}>
    <form action="/produk" method="get" role="search" class="relative w-full" onsubmit="return false">
      <label for="catalog-search" class="sr-only">Cari produk di {Astro.locals.tenant.name}</label>
      <input
        type="search"
        id="catalog-search"
        name="q"
        maxlength="80"
        autocomplete="off"
        enterkeyhint="search"
        placeholder="Cari produk"
        class="h-10 w-full rounded-sf border border-sf-line bg-sf-surface pl-9 pr-3 text-base text-sf-ink placeholder:text-sf-muted focus:border-sf-ink focus:bg-white focus:outline-none"
      />
      <Icon name="lucide:search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-sf-muted" aria-hidden="true" />
    </form>
    {showChips && (
      <div role="group" aria-label="Kategori" class="catalog-chips -mx-4 flex gap-2 overflow-x-auto px-4 pb-1">
        <button type="button" class={chipClass} data-category="" aria-pressed="true">Semua</button>
        {categories.map((category) => (
          <button type="button" class={chipClass} data-category={category} aria-pressed="false">{category}</button>
        ))}
      </div>
    )}
  </div>

  {
    products.length === 0 && (
      <div class="rounded-sf bg-sf-surface px-5 py-10 text-center">
        <p class="text-sm font-semibold text-sf-ink">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-1 max-w-[26rem] text-sm leading-6 text-sf-text">
          Produk akan tampil di sini setelah diterbitkan.
        </p>
      </div>
    )
  }

  <div id="catalog-empty" class="hidden rounded-sf bg-sf-surface px-5 py-8 text-center" role="status">
    <p class="text-sm font-semibold text-sf-ink">Produk tidak ditemukan</p>
    <p class="mt-1 text-sm text-sf-text">Coba kata lain, atau lihat semua produk.</p>
    <button type="button" id="catalog-reset" class="mt-4 inline-flex min-h-10 items-center rounded-sf border border-sf-line bg-white px-4 text-sm font-semibold text-sf-ink hover:border-sf-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink">Hapus pencarian</button>
  </div>

  <div id="product-grid" class="grid grid-cols-2 gap-2" hidden={products.length === 0}>
    {
      products.map((product, idx) => (
        <div
          class:list={['product-card', idx >= CATALOG_PAGE_SIZE && 'hidden']}
          data-category={product.category}
          data-search={`${product.name} ${product.category} ${product.description}`.toLowerCase()}
          data-index={idx}
        >
          <ProductListItem
            product={{
              slug: product.slug,
              productName: product.name,
              heroImage: product.image,
              category: product.category,
              price: product.price,
              comparePrice: product.comparePrice,
              variants: product.variants ?? [],
              ratingValue: product.ratingValue,
              reviewCount: product.reviewCount,
              soldCount: product.soldCount,
            }}
            formatPrice={formatPrice}
            eager={eager && idx < 4}
          />
        </div>
      ))
    }
  </div>

  <div
    id="load-more-container"
    class="mt-6 flex flex-col items-center gap-3"
    hidden={products.length === 0}
  >
    <p id="catalog-status" class="text-xs text-sf-text" aria-live="polite">
      Menampilkan <span id="product-visible-count">{Math.min(CATALOG_PAGE_SIZE, products.length)}</span> dari <span id="product-total-count">{products.length}</span> produk
    </p>
    {
      products.length > CATALOG_PAGE_SIZE && (
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-sf border border-sf-line bg-white px-6 text-sm font-semibold text-sf-ink transition-colors hover:border-sf-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sf-ink"
        >
          <span>Lihat produk lainnya</span>
          <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
        </button>
      )
    }
  </div>
</section>

<script>
  import { autoLoadMore } from '../../../lib/auto-load-more';
  import { CATALOG_PAGE_SIZE } from '../../../lib/catalog-page-size';

  function initProductCatalog() {
    // Typing filters this grid live; a `?q=` link arrives here already filtered.
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('product-visible-count');
    const totalCountEl = document.getElementById('product-total-count');

    const emptyEl = document.getElementById('catalog-empty');
    const statusEl = document.getElementById('catalog-status');
    const chips = document.querySelectorAll<HTMLButtonElement>('.catalog-chip');
    let currentSearch = (new URLSearchParams(window.location.search).get('q') ?? '').trim().toLowerCase().slice(0, 80);
    if (searchInput && currentSearch && !searchInput.value) searchInput.value = currentSearch;
    let currentCategory = '';
    let visibleLimit = CATALOG_PAGE_SIZE;

    function filterAndRender() {
      let matchedCount = 0;
      let currentlyShown = 0;

      cards.forEach((card) => {
        const searchData = card.getAttribute('data-search') || '';
        const matchesSearch =
          (!currentSearch || searchData.includes(currentSearch)) &&
          (!currentCategory || card.getAttribute('data-category') === currentCategory);
        if (matchesSearch) matchedCount++;

        // Toggle a class rather than writing `style.display`. Showing a card
        // with `display: flex` turned the wrapper into a flex container, which
        // sizes its `<article>` to max-content instead of the grid cell — so a
        // product with a short title rendered a narrower card, and the square
        // image box shrank its height to match.
        const show = matchesSearch && currentlyShown < visibleLimit;
        if (show) currentlyShown++;
        card.classList.toggle('hidden', !show);
      });

      emptyEl?.classList.toggle('hidden', cards.length === 0 || matchedCount > 0);
      // "Menampilkan 0 dari 0" beside the empty message says nothing more.
      statusEl?.toggleAttribute('hidden', matchedCount === 0);
      if (visibleCountEl) visibleCountEl.textContent = String(currentlyShown);
      if (totalCountEl) totalCountEl.textContent = String(matchedCount);

      if (loadMoreBtn) {
        if (currentlyShown >= matchedCount) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'inline-flex';
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      visibleLimit = CATALOG_PAGE_SIZE;
      filterAndRender();
    });

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        currentCategory = chip.dataset.category ?? '';
        chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
        visibleLimit = CATALOG_PAGE_SIZE;
        filterAndRender();
      }),
    );

    document.getElementById('catalog-reset')?.addEventListener('click', () => {
      currentSearch = '';
      currentCategory = '';
      if (searchInput) searchInput.value = '';
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(!chip.dataset.category)));
      visibleLimit = CATALOG_PAGE_SIZE;
      if (window.location.search) history.replaceState(null, '', window.location.pathname);
      filterAndRender();
      searchInput?.focus();
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += CATALOG_PAGE_SIZE;
      filterAndRender();
    });

    filterAndRender();
    // The next page loads as the button nears the screen; the button stays as the
    // keyboard and no-script path.
    autoLoadMore(loadMoreBtn);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCatalog);
  } else {
    initProductCatalog();
  }
</script>

<style>
  .catalog-chips {
    scrollbar-width: none;
  }
  .catalog-chips::-webkit-scrollbar {
    display: none;
  }
</style>

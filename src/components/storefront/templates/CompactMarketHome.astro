---
import AnnouncementBar from '../home/AnnouncementBar.astro';
import FeaturedProducts from '../home/FeaturedProducts.astro';
import HeroSection from '../home/HeroSection.astro';
import HowToOrder from '../home/HowToOrder.astro';
import ProductsSection from '../home/ProductsSection.astro';
import TrustStrip from '../shared/TrustStrip.astro';
import type { TenantHomeContent } from '../../../lib/tenant-content';
import type { HomeSectionId } from '../../../lib/storefront-theme';

interface ProductCard {
  slug: string;
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants: Array<{ label: string; price: number }>;
}

interface Props {
  content: TenantHomeContent;
  products: ProductCard[];
  /** Resolved by the page, not here: index.astro preloads the first slide's
   *  image as the LCP element, so the page and the hero must read the same
   *  list. The daily-rotation fallback lives with that preload now. */
  heroSlides: Array<{ image: string; alt: string; badge: string; text: string; summary?: string; href?: string }>;
  sections: {
    hero: boolean;
    catalog: true;
    // `proofs` is still accepted so a template saved before this change keeps
    // parsing; the third slot lists landing pages now.
    proofs?: boolean;
    landingPages?: boolean;
  };
  /** True claims from the store's checkout settings (`storefrontTrustSignals`). */
  trustSignals?: Array<{ icon: string; label: string; short: string }>;
  /** admin › Tema's catalogue heading; the published home content's otherwise. */
  catalogHeading?: { eyebrow: string; title: string; description: string };
  /** Admin › Tema › Atur beranda: the seller's section order and the parts each needs. Absent = the theme's own order. */
  layout?: {
    order: readonly HomeSectionId[];
    announcement: { text: string; href: string } | null;
    featured: { title: string; products: ProductCard[] } | null;
    howToOrder: Array<{ title: string; text: string }> | null;
    categories: boolean;
  };
}

const { content, products, heroSlides, sections, trustSignals = [], catalogHeading, layout } = Astro.props;
const order: readonly HomeSectionId[] = layout?.order ?? ['hero', 'trust', 'catalog'];
---

<main id="konten-utama" class="overflow-x-hidden bg-white font-sans text-sf-ink antialiased">
  <div id="home" class="flex w-full flex-col">
    {order.map((id) => {
      if (id === 'announcement') return layout?.announcement && <AnnouncementBar text={layout.announcement.text} href={layout.announcement.href} />;
      if (id === 'hero') return sections.hero && heroSlides.length > 0 && <HeroSection slides={heroSlides} highlights={content.heroHighlights} content={content.hero} />;
      if (id === 'trust') return trustSignals.length > 0 && <div class="px-4 pt-3"><TrustStrip signals={trustSignals} /></div>;
      if (id === 'featured') return layout?.featured && <FeaturedProducts title={layout.featured.title} products={layout.featured.products} />;
      if (id === 'catalog') return sections.catalog && <ProductsSection products={products} heading={catalogHeading ?? content.catalog} categories={layout?.categories ?? true} />;
      if (id === 'howToOrder') return layout?.howToOrder && <HowToOrder steps={layout.howToOrder} />;
      return null;
    })}
    {/* Landing pages are not listed on the home page (Paduka, 2026-11-01):
        they live on /landing-page, reached from the header and footer
        "Halaman" link. `sections.landingPages` still parses for saved
        templates and no longer renders anything. */}
  </div>
</main>

<script>
  // Native scroll-snap carries the swipe; this keeps the dots in step, lets a
  // dot jump to its slide, and advances the hero by itself (owner, 2026-11-23:
  // a continuous auto slider). The first slide is the LCP image and is painted
  // before the timer's first tick (5 s), so autoplay does not move the LCP.
  // It pauses while a finger or pointer is on the hero, while the tab is
  // hidden, and never runs under prefers-reduced-motion.
  const heroTrack = document.getElementById('hero-track');
  const heroDots = document.getElementById('hero-dots');
  if (heroTrack && heroDots) {
    const dots = [...heroDots.children];
    const count = dots.length;
    const current = () => Math.round(heroTrack.scrollLeft / Math.max(1, heroTrack.clientWidth));
    const mark = (index: number) =>
      dots.forEach((dot, itemIndex) => {
        if (itemIndex === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    const go = (index: number) => heroTrack.scrollTo({ left: index * heroTrack.clientWidth, behavior: 'smooth' });
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    heroTrack.addEventListener('scroll', () => mark(current()), { passive: true });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let held = false;
    const hold = (on: boolean) => () => { held = on; };
    const hero = heroTrack.closest('[data-hero]') ?? heroTrack;
    hero.addEventListener('pointerenter', hold(true));
    hero.addEventListener('pointerleave', hold(false));
    hero.addEventListener('touchstart', hold(true), { passive: true });
    hero.addEventListener('touchend', () => window.setTimeout(() => { held = false; }, 4000), { passive: true });
    hero.addEventListener('focusin', hold(true));
    hero.addEventListener('focusout', hold(false));
    window.setInterval(() => {
      if (held || document.hidden || reduce.matches || count < 2) return;
      go((current() + 1) % count);
    }, 5000);
  }
</script>

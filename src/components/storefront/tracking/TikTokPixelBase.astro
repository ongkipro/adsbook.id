---
/**
 * TikTok Pixel for one store (tracking chapter 11 §2.1–§2.3).
 *
 * Renders nothing unless the store's pixel code matches
 * `TIKTOK_PIXEL_ID_PATTERN`, so a store without TikTok ships zero bytes and
 * makes no request to TikTok. The ad-signal pause (ADR-041) arrives through
 * `getStoreAdsConfig`, which is empty for a store in Preview Mode.
 *
 * Like `MetaPixelBase`: the first-party `_ttp` cookie is minted before the
 * deferred `events.js` loads (the SDK adopts an existing one), the library
 * downloads on the first interaction or after 2.5 s, and a conversion pulls it
 * forward through `__PS_LOAD_TIKTOK_PIXEL__`. Client-side only, so the HTML
 * stays cacheable (ADR-029).
 *
 * `__PS_TIKTOK_TRACK__(event, properties, eventId, identity?)` is the one way
 * other files reach TikTok: it sends the browser event and, for the three
 * funnel events, its server twin to `/api/tiktok-event` with the same
 * `event_id`. `CompletePayment` is browser-only here: its server leg is
 * enqueued from the order itself (`tiktok-outbox.ts`), never from a browser.
 */
import { getStoreAdsConfig, TIKTOK_PIXEL_ID_PATTERN } from '../../../lib/store-ads';

interface Props {
  pixelId?: string;
}

let pixelId = Astro.props.pixelId;
if (pixelId === undefined) pixelId = (await getStoreAdsConfig(Astro.locals)).tiktokPixelId;
const shouldRender = TIKTOK_PIXEL_ID_PATTERN.test(String(pixelId || '').trim());
---

{shouldRender && (
  <>
    <link rel="preconnect" href="https://analytics.tiktok.com" crossorigin />
    <script is:inline define:vars={{ pixelId }}>
      (() => {
        if (typeof window === 'undefined' || window.__PS_TIKTOK_TRACK__) return;

        const readCookie = (name) =>
          document.cookie.split('; ').find((row) => row.startsWith(`${name}=`))?.split('=')[1] || '';
        const cookieSecurity = window.location.protocol === 'https:' ? 'SameSite=None; Secure' : 'SameSite=Lax';

        // First-party `_ttp`, minted before events.js so the server twin of a
        // top-of-funnel event already carries it. 27 alphanumerics, one year.
        if (!/^[A-Za-z0-9._-]{10,128}$/.test(readCookie('_ttp'))) {
          try {
            const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
            const bytes = crypto.getRandomValues(new Uint8Array(27));
            const ttp = Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join('');
            document.cookie = `_ttp=${ttp}; Path=/; Max-Age=31536000; ${cookieSecurity}`;
          } catch {
            // Without Web Crypto the SDK mints it when it loads.
          }
        }

        // TikTok's own stub: every ttq call queues until events.js arrives.
        const ttq = (window.ttq = window.ttq || []);
        window.TiktokAnalyticsObject = 'ttq';
        ttq.methods = ['page', 'track', 'identify', 'instances', 'debug', 'on', 'off', 'once', 'ready', 'alias', 'group', 'enableCookie', 'disableCookie', 'holdConsent', 'revokeConsent', 'grantConsent'];
        ttq.setAndDefer = (target, method) => {
          target[method] = function () {
            target.push([method].concat(Array.prototype.slice.call(arguments, 0)));
          };
        };
        for (const method of ttq.methods) ttq.setAndDefer(ttq, method);
        ttq.instance = (id) => {
          const instance = ttq._i[id] || [];
          for (const method of ttq.methods) ttq.setAndDefer(instance, method);
          return instance;
        };
        const library = 'https://analytics.tiktok.com/i18n/pixel/events.js';
        ttq._i = ttq._i || {};
        ttq._i[pixelId] = [];
        ttq._i[pixelId]._u = library;
        ttq._t = ttq._t || {};
        ttq._t[pixelId] = Date.now();
        ttq._o = ttq._o || {};
        ttq._o[pixelId] = {};

        let requested = false;
        const loadPixel = () => {
          if (requested) return;
          requested = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = `${library}?sdkid=${encodeURIComponent(pixelId)}&lib=ttq`;
          document.head.appendChild(script);
        };
        window.__PS_LOAD_TIKTOK_PIXEL__ = loadPixel;
        for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
          window.addEventListener(type, loadPixel, { once: true, passive: true });
        }
        window.setTimeout(loadPixel, 2500);
        ttq.page();

        const sha256 = async (value) => {
          const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value));
          return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('');
        };
        // `toE164Digits` (meta-identity.ts) plus TikTok's leading `+`.
        const tiktokPhone = (value) => {
          let digits = String(value || '').replace(/\D/g, '');
          if (!digits) return '';
          if (digits.startsWith('00')) digits = digits.slice(2);
          if (digits.startsWith('620')) digits = `62${digits.slice(3)}`;
          else if (digits.startsWith('0')) digits = `62${digits.slice(1)}`;
          else if (digits.startsWith('8')) digits = `62${digits}`;
          return digits.length >= 8 && digits.length <= 15 ? `+${digits}` : '';
        };
        let identified = '';
        const identify = async (identity) => {
          const phone = tiktokPhone(identity?.phone);
          if (!phone || identified === phone) return;
          identified = phone;
          try {
            ttq.identify({ phone_number: await sha256(phone) });
          } catch {
            // The server twin still carries the phone.
          }
        };

        const SERVER_EVENTS = new Set(['ViewContent', 'AddToCart', 'InitiateCheckout']);
        window.__PS_TIKTOK_TRACK__ = (eventName, properties, eventId, identity) => {
          void (async () => {
            if (identity) await identify(identity);
            try {
              ttq.track(eventName, properties, { event_id: eventId });
            } catch (error) {
              console.error('tiktok-pixel-track', error);
            }
            if (eventName === 'CompletePayment') loadPixel();
          })();
          if (!SERVER_EVENTS.has(eventName)) return;
          fetch('/api/tiktok-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              event: eventName,
              event_id: eventId,
              url: window.location.href,
              properties,
              phone: identity?.phone || undefined,
            }),
          }).catch(() => undefined);
        };
      })();
    </script>
  </>
)}

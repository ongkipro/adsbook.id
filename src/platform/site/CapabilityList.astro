---
/** Everything else a store runs on: a quiet three-column list, no cards. */
import { CAPABILITIES } from './content.ts';
---

<dl class="caps">
  {CAPABILITIES.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
</dl>

<style>
  .caps { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 3rem; }
  .caps div { display: grid; gap: 0.3rem; align-content: start; padding: 1.4rem 0; border-top: 1px solid var(--line); }
  .caps dt { font-weight: 700; color: var(--ink); }
  .caps dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 900px) { .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .caps { grid-template-columns: 1fr; } }
</style>

---
/** The six pillars in full (/fitur, /coba): a real screen, or the published numbers. */
import ShotFrame from './ShotFrame.astro';
import { PILLARS } from './content.ts';

interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<div class="rows">
  {PILLARS.map((pillar, index) => (
    <article class={`row ${index % 2 ? 'row-flip' : ''}`} id={pillar.id} aria-labelledby={`${pillar.id}-title`}>
      <div class="row-text">
        <p class="pillar-label"><span class="pillar-no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{pillar.label}</p>
        <Heading class="row-title" id={`${pillar.id}-title`}>{pillar.title}</Heading>
        <ul>{pillar.points.map((point) => <li>{point}</li>)}</ul>
      </div>
      {pillar.shot ? <ShotFrame shot={pillar.shot} /> : (
        <dl class="spec" aria-label={pillar.title}>
          {pillar.specs?.map((spec) => <div><dt>{spec.value}</dt><dd>{spec.label}</dd></div>)}
        </dl>
      )}
    </article>
  ))}
</div>

<style>
  .rows { display: grid; gap: 5.5rem; }
  .row { display: grid; grid-template-columns: 5fr 7fr; gap: 3.5rem; align-items: center; scroll-margin-top: 1.5rem; }
  .row-flip .row-text { order: 2; }
  .row-text { display: grid; gap: 0.9rem; }
  .pillar-label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; font-weight: 700; color: var(--accent); }
  .pillar-no { font-family: var(--display); font-variant-numeric: tabular-nums; color: var(--ink-muted); }
  .row-title { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.015em; }
  .row-text ul { margin: 0.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.7rem; color: var(--ink-muted); }
  .row-text li { display: grid; grid-template-columns: 10px 1fr; gap: 0.85rem; }
  .row-text li::before { content: ""; width: 7px; height: 7px; margin-top: 0.62em; background: var(--accent); }
  .spec { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .spec div { background: var(--surface); padding: 1.6rem; display: grid; gap: 0.35rem; align-content: start; }
  .spec dt { font-family: var(--display); font-weight: 800; font-size: clamp(1.7rem, 1.2rem + 1.5vw, 2.4rem); letter-spacing: -0.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .spec dd { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }
  @media (max-width: 760px) {
    .rows { gap: 3.5rem; }
    .row { grid-template-columns: 1fr; gap: 1.5rem; }
    .row-flip .row-text { order: 0; }
    .spec div { padding: 1.2rem; }
  }
</style>

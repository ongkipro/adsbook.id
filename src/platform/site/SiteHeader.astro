---
/**
 * The marketing site's one header (Paduka, 2026-11-18): the same wordmark,
 * nav, account button and Daftar / Masuk dialog on every platform page.
 * - `variant="hero"`: transparent, inside the home's 100dvh stage (KineticHero3D).
 * - `variant="page"`: on the canvas at the top of SiteLayout (inner pages).
 * - `quiet`: the wordmark only (/daftar, which is the signup itself).
 * Up to 900px the nav folds into [account] [menu]: the menu button morphs
 * into × and opens a screen-aligned panel with a short line per page.
 * Every action is a real link first (/masuk, /daftar); scripts add the dialog.
 */
import { SIGNUP_LABEL, SIGNUP_PATH, SITE_PAGES } from './site.ts';

interface Props {
  currentPath?: string;
  /** Seller zone for the Masuk finder (`adsbook.my.id`, or `localhost` in local development). */
  suffix?: string;
  variant?: 'hero' | 'page';
  quiet?: boolean;
}
const { currentPath, suffix = 'adsbook.my.id', variant = 'page', quiet = false } = Astro.props;
const nav = Object.values(SITE_PAGES).filter((entry) => entry.nav);
/** One line per page in the phone menu: what the visitor finds there. */
const NAV_HINTS: Record<string, string> = {
  '/fitur': 'Server tracking 1:1, Hybrid Form, dan kontrol RTS',
  '/cara-kerja': 'Alur dari ad click sampai konversi tercatat',
  '/harga': 'Mulai Rp149.000/bulan · 0% biaya per transaksi',
  '/faq': 'Seputar tracking, pembayaran, dan domain',
  '/kontak': 'Hubungi tim dukungan adsbook.id',
};
const current = (path: string) => (path === currentPath ? 'page' : undefined);
---

<header class={`site-header sh-${variant}`} data-site-header data-suffix={suffix}>
  <div class="sh-row">
    <a class="sh-wordmark" href="/" aria-label="adsbook.id, beranda"><img src="/platform/brand/adsbook-id-wordmark.svg" alt="adsbook.id" width="151" height="24" loading="eager" decoding="async" /></a>
    {!quiet && (
      <nav class="sh-nav" aria-label="Utama">
        {nav.map((entry) => <a href={entry.path} aria-current={current(entry.path)}>{entry.nav}</a>)}
      </nav>
    )}
    {!quiet && (
      <div class="sh-tools">
        <a id="btn-user-auth" class="sh-round" href="/masuk" aria-label="Masuk atau Daftar" aria-haspopup="dialog" title="Daftar / Masuk">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="6.6" r="3.1" stroke="currentColor" stroke-width="1.65"/>
            <path d="M4.4 16.4C5.1 13.7 7.25 12.1 10 12.1C12.75 12.1 14.9 13.7 15.6 16.4" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
          </svg>
        </a>
        <button type="button" id="btn-mobile-menu" class="sh-round sh-burger" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="mobile-nav-dropdown">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path class="bar bar-top" d="M4 7H16" stroke="currentColor" stroke-width="1.7" stroke-linecap="square"/>
            <path class="bar bar-bottom" d="M4 13H16" stroke="currentColor" stroke-width="1.7" stroke-linecap="square"/>
          </svg>
        </button>
      </div>
    )}
  </div>
</header>

{!quiet && (
  <>
    <div id="mobile-nav-backdrop" class="sh-backdrop" aria-hidden="true"></div>
    <nav id="mobile-nav-dropdown" class="sh-dropdown" aria-label="Menu navigasi" inert>
      <ul>
        {nav.map((entry, index) => (
          <li>
            <a href={entry.path} aria-current={current(entry.path)}>
              <span class="row-idx" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="row-text"><span class="row-label">{entry.nav}</span><span class="row-hint">{NAV_HINTS[entry.path] ?? ''}</span></span>
              <span class="row-mark" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="sh-dropdown-foot">
        <a class="sh-pill" href={SIGNUP_PATH}>{SIGNUP_LABEL} →</a>
        <a class="sh-secondary" href="/masuk" data-auth-open="masuk">Sudah punya toko? <b>Masuk ke admin</b></a>
      </div>
    </nav>

    <dialog id="auth-dialog" class="auth-dialog" aria-labelledby="auth-title" aria-describedby="auth-desc">
      <div class="auth-head">
        <img src="/platform/brand/adsbook-id-wordmark.svg" alt="adsbook.id" width="126" height="20" loading="lazy" decoding="async" />
        <form method="dialog"><button class="auth-close" aria-label="Tutup">
          <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 3.5L10.5 10.5M10.5 3.5L3.5 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
        </button></form>
      </div>
      <div class="auth-tabs" role="tablist" aria-label="Daftar atau masuk">
        <button type="button" role="tab" id="tab-daftar" aria-selected="true" aria-controls="panel-daftar">Daftar</button>
        <button type="button" role="tab" id="tab-masuk" aria-selected="false" aria-controls="panel-masuk" tabindex="-1">Masuk</button>
      </div>
      <h2 id="auth-title" class="auth-title">Mulai toko konversi 1:1</h2>
      <p id="auth-desc" class="auth-desc">Kunci sinyal TikTok Ads, Meta Ads, dan Google Ads di satu ID pesanan.</p>

      <form id="panel-daftar" role="tabpanel" aria-labelledby="tab-daftar" class="auth-form" action={SIGNUP_PATH} method="get" novalidate>
        <label for="hero-email">Email</label>
        <input id="hero-email" type="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="email@brandkamu.id" aria-describedby="hero-email-error" data-msg-missing="Masukkan alamat email Anda terlebih dahulu." data-msg-invalid="Format email belum benar (contoh: nama@toko.id)." />
        <p id="hero-email-error" class="auth-error" hidden></p>
        <button type="submit" class="sh-pill">Lanjutkan gratis →</button>
      </form>

      <form id="panel-masuk" role="tabpanel" aria-labelledby="tab-masuk" class="auth-form" action={SIGNUP_PATH} method="get" hidden novalidate>
        <input type="hidden" name="masuk" value="1" />
        <label for="hero-store">Alamat atau slug toko</label>
        <input id="hero-store" type="text" required autocomplete="url" autocapitalize="none" spellcheck="false" placeholder="namatoko atau tokoanda.com" aria-describedby="hero-store-error" />
        <p id="hero-store-error" class="auth-error" hidden></p>
        <button type="submit" class="sh-pill">Masuk ke toko →</button>
      </form>
    </dialog>
  </>
)}

<script>
  import { HERO_EMAIL_KEY, storeLoginUrl } from '../store-finder.ts';
  import { bindInlineValidation, setFieldError, validateInline } from '../../lib/form-validation-id.ts';

  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuButton = document.getElementById('btn-mobile-menu') as HTMLButtonElement | null;
  const dropdown = document.getElementById('mobile-nav-dropdown');
  const backdrop = document.getElementById('mobile-nav-backdrop');
  const dialog = document.getElementById('auth-dialog') as HTMLDialogElement | null;

  // --- The phone menu: [account] [menu ⇄ ×], a panel aligned to the screen edges.
  // Paduka (2026-11-18): the header and its × stay sharp and clickable while the menu is
  // open, and the page behind it does not scroll. The header sits above the scrim
  // (z-index 65 over 59/60, one stacking context on every page), the scrim starts at the
  // header's bottom edge (--sh-bottom), and the page is locked until any close path runs.
  const desktop = window.matchMedia('(min-width: 901px)');
  const lockScroll = (locked: boolean) => {
    document.documentElement.style.overflow = locked ? 'hidden' : '';
    document.body.style.overflow = locked ? 'hidden' : '';
  };
  const setMenu = (open: boolean, returnFocus = false) => {
    if (!menuButton || !dropdown || !backdrop || !header) return;
    if (open) {
      const bottom = Math.max(0, Math.round(header.getBoundingClientRect().bottom));
      document.documentElement.style.setProperty('--sh-bottom', `${bottom}px`);
    }
    header.toggleAttribute('data-menu-open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    dropdown.toggleAttribute('inert', !open);
    dropdown.classList.toggle('is-open', open);
    backdrop.classList.toggle('is-open', open);
    lockScroll(open);
    if (open) dropdown.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (returnFocus) menuButton.focus();
  };
  const isOpen = () => menuButton?.getAttribute('aria-expanded') === 'true';
  menuButton?.addEventListener('click', () => setMenu(!isOpen()));
  backdrop?.addEventListener('click', () => setMenu(false));
  // A swipe on the scrim must not scroll the page under it (iOS ignores overflow alone).
  backdrop?.addEventListener('touchmove', (event) => event.preventDefault(), { passive: false });
  // Leaving through a menu link closes it first, so a page restored from the back-forward
  // cache never comes back locked; pageshow covers any other way out.
  dropdown?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });
  window.addEventListener('pageshow', () => { if (isOpen()) setMenu(false); });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) setMenu(false, true);
  });
  desktop.addEventListener('change', (event) => { if (event.matches) setMenu(false); });

  // --- The account dialog: a real /masuk link; Daftar / Masuk when the browser has <dialog>.
  if (dialog && typeof dialog.showModal === 'function') {
    const tabs = { daftar: document.getElementById('tab-daftar')!, masuk: document.getElementById('tab-masuk')! };
    const panels = { daftar: document.getElementById('panel-daftar') as HTMLFormElement, masuk: document.getElementById('panel-masuk') as HTMLFormElement };
    const title = document.getElementById('auth-title')!;
    const desc = document.getElementById('auth-desc')!;
    const copy = {
      daftar: ['Mulai toko konversi 1:1', 'Kunci sinyal TikTok Ads, Meta Ads, dan Google Ads di satu ID pesanan.'],
      masuk: ['Masuk ke toko Anda', 'Ketik alamat toko Anda; halaman masuk toko terbuka di alamatnya sendiri.'],
    } as const;
    const show = (mode: 'daftar' | 'masuk', focus = false) => {
      for (const key of ['daftar', 'masuk'] as const) {
        const on = key === mode;
        tabs[key].setAttribute('aria-selected', String(on));
        tabs[key].tabIndex = on ? 0 : -1;
        panels[key].hidden = !on;
      }
      [title.textContent, desc.textContent] = copy[mode];
      if (focus) panels[mode].querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();
    };
    const open = (mode: 'daftar' | 'masuk') => {
      setMenu(false);
      show(mode);
      dialog.showModal();
      panels[mode].querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();
    };
    tabs.daftar.addEventListener('click', () => show('daftar', true));
    tabs.masuk.addEventListener('click', () => show('masuk', true));
    for (const tab of Object.values(tabs)) {
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        const next = tab === tabs.daftar ? 'masuk' : 'daftar';
        show(next);
        tabs[next].focus();
      });
    }
    // A modified click (new tab, new window) keeps the plain /masuk link.
    const plainClick = (event: MouseEvent) => !(event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0);
    for (const trigger of [document.getElementById('btn-user-auth'), ...document.querySelectorAll<HTMLElement>('[data-auth-open]')]) {
      trigger?.addEventListener('click', (event) => {
        if (!plainClick(event)) return;
        event.preventDefault();
        open('masuk');
      });
    }
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

    bindInlineValidation(panels.daftar);
    bindInlineValidation(panels.masuk);
    panels.daftar.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!validateInline(panels.daftar)) return;
      const email = (document.getElementById('hero-email') as HTMLInputElement).value.trim();
      try { if (email) sessionStorage.setItem(HERO_EMAIL_KEY, email); } catch { /* the seller types it again on /daftar */ }
      window.location.assign(panels.daftar.action);
    });
    panels.masuk.addEventListener('submit', (event) => {
      event.preventDefault();
      const input = document.getElementById('hero-store') as HTMLInputElement;
      const login = storeLoginUrl(input.value, header?.dataset.suffix || 'adsbook.my.id', window.location);
      if ('error' in login) {
        setFieldError(input, login.error);
        input.focus();
        return;
      }
      window.location.assign(login.url);
    });
  }
</script>

<style>
  /* Above the menu's scrim (59) and panel (60): the wordmark and × stay sharp and clickable.
     On the home the header, scrim and panel share .layer-ui's stacking context; elsewhere, the root. */
  .site-header { --sh-ease: cubic-bezier(0.22, 1, 0.36, 1); position: relative; z-index: 65; color: var(--ink); }
  /* Open: a solid white bar that also takes its own taps (the home's hero header is click-through). */
  .site-header[data-menu-open] { background: #fff; pointer-events: auto; }
  /* One header, one look (Paduka, 2026-11-18): the inner pages get the home's clean header,
     transparent on the page's own surface, no rule under it, no second action. */
  .sh-row { width: min(1120px, 100% - 2rem); margin-inline: auto; min-height: 56px; display: flex; align-items: center; gap: 1rem; }
  .sh-hero, .sh-page { flex-shrink: 0; padding: 0.75rem 0 0.25rem; }
  .sh-hero { pointer-events: none; }
  .sh-hero .sh-wordmark, .sh-hero .sh-nav, .sh-hero .sh-tools { pointer-events: auto; }

  /* The logo is outlines (logo/make-logo.mjs in the content folder): a one-module square dot. */
  .sh-wordmark { display: inline-flex; align-items: center; min-height: 44px; margin-right: auto; border-radius: 6px; }
  .sh-wordmark img { height: 21px; width: auto; }
  .sh-nav { display: none; gap: 1.75rem; }
  .sh-nav a { position: relative; color: #475569; text-decoration: none; font-weight: 600; font-size: 0.93rem; letter-spacing: -0.005em; }
  .sh-nav a:hover { color: var(--accent); }
  .sh-nav a[aria-current="page"] { color: var(--accent); }
  .sh-nav a[aria-current="page"]::after { content: ""; position: absolute; left: 50%; bottom: -0.55rem; width: 5px; height: 5px; margin-left: -2.5px; background: var(--accent); }
  .sh-tools { display: flex; align-items: center; gap: 0.5rem; }

  .sh-round {
    width: 40px; height: 40px; padding: 0; border-radius: 999px; display: flex; align-items: center; justify-content: center; cursor: pointer;
    background: #fff; border: 1px solid rgb(15 23 42 / 0.08); color: var(--ink); transition: border-color 0.2s var(--sh-ease), color 0.2s var(--sh-ease), background-color 0.2s var(--sh-ease), transform 0.2s var(--sh-ease), box-shadow 0.2s var(--sh-ease);
  }
  .sh-round:hover { border-color: var(--accent); color: var(--accent); background: #eff6ff; transform: translateY(-1px); box-shadow: 0 8px 20px -6px rgb(37 99 235 / 0.22); }
  .sh-round svg { width: 18px; height: 18px; overflow: visible; }
  /* = → ×: the two bars meet in the middle and turn. */
  .sh-burger .bar { transform-box: view-box; transform-origin: 10px 10px; transition: transform 0.2s var(--sh-ease); }
  /* Open: the × reads unmistakably — cobalt on a soft cobalt tile. */
  .sh-burger[aria-expanded="true"] { border-color: var(--accent); color: var(--accent); background: #eff6ff; box-shadow: 0 0 0 3px rgb(37 99 235 / 0.12); }
  .sh-burger[aria-expanded="true"] .bar-top { transform: translateY(3px) rotate(45deg); }
  .sh-burger[aria-expanded="true"] .bar-bottom { transform: translateY(-3px) rotate(-45deg); }

  /* The scrim starts under the header bar, so it can never blur the header or its ×. */
  .sh-backdrop { position: fixed; top: var(--sh-bottom, 64px); right: 0; bottom: 0; left: 0; z-index: 59; pointer-events: none; background: rgb(15 23 42 / 0.12); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); opacity: 0; transition: opacity 0.18s ease-out; }
  .sh-backdrop.is-open { opacity: 1; pointer-events: auto; }
  /* Borderless gallery v2: a white card, a faint edge, the float shadow, no accent stripe. */
  .sh-dropdown {
    position: fixed; top: calc(var(--sh-bottom, 64px) + 6px); left: 1rem; right: 1rem; max-width: 440px; margin-inline: auto; z-index: 60; pointer-events: auto;
    max-height: calc(100dvh - var(--sh-bottom, 64px) - 1rem); overflow-y: auto; overscroll-behavior: contain;
    padding: 0.625rem; border-radius: 22px; background: #fff;
    border: 1px solid rgb(15 23 42 / 0.06); box-shadow: 0 24px 56px -12px rgb(15 23 42 / 0.14), 0 2px 8px -2px rgb(15 23 42 / 0.05);
    opacity: 0; visibility: hidden; transform: translateY(-8px) scale(0.985); transform-origin: top center;
    transition: opacity 0.19s var(--sh-ease), transform 0.19s var(--sh-ease), visibility 0s linear 0.19s;
  }
  .sh-dropdown.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity 0.19s var(--sh-ease), transform 0.19s var(--sh-ease), visibility 0s; }
  .sh-dropdown ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sh-dropdown li a { display: flex; align-items: center; gap: 0.75rem; min-height: 54px; padding: 0.7rem 0.875rem; border-radius: 14px; color: var(--ink); text-decoration: none; transition: background-color 0.15s ease-out; }
  .sh-dropdown li a:hover, .sh-dropdown li a:focus-visible { background: var(--tile); }
  .row-idx { align-self: flex-start; margin-top: 0.2rem; font: 600 0.72rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.06em; color: var(--slate-soft); font-variant-numeric: tabular-nums; }
  .row-text { flex: 1; display: grid; gap: 0.15rem; min-width: 0; }
  /* The display face's word space is narrow: the site's +0.06em keeps "Cara kerja" two words. */
  .row-label { font: 800 0.975rem/1.25 var(--display); letter-spacing: -0.01em; word-spacing: 0.06em; color: var(--ink); }
  .row-hint { font-size: 0.8rem; line-height: 1.4; color: var(--slate); }
  .row-mark { flex-shrink: 0; width: 7px; height: 7px; border-top: 2px solid var(--slate-soft); border-right: 2px solid var(--slate-soft); transform: rotate(45deg); margin-right: 0.25rem; transition: transform 0.15s ease-out; }
  .sh-dropdown li a:hover .row-mark, .sh-dropdown li a:focus-visible .row-mark { transform: translateX(2px) rotate(45deg); }
  /* The current page: a porcelain row, cobalt label, the brand's square dot. */
  .sh-dropdown li a[aria-current="page"] { background: var(--tile); }
  .sh-dropdown li a[aria-current="page"] .row-label { color: var(--accent); }
  .sh-dropdown li a[aria-current="page"] .row-idx { color: var(--accent); }
  .sh-dropdown li a[aria-current="page"] .row-mark { border: 0; transform: none; width: 6px; height: 6px; background: var(--accent); }
  .sh-dropdown-foot { display: grid; gap: 0.5rem; margin-top: 0.625rem; padding: 0.75rem 0.375rem 0.375rem; border-top: var(--hairline); }
  .sh-secondary { display: flex; align-items: center; justify-content: center; gap: 0.3rem; min-height: 46px; padding: 0 1rem; border-radius: 999px; background: var(--tile); color: var(--ink); font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: background-color 0.15s ease-out; }
  .sh-secondary b { color: var(--accent); font-weight: 700; }
  .sh-secondary:hover { background: #eef1f6; color: var(--ink); }

  .sh-pill {
    display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 0 1.25rem; border: 0; border-radius: 999px; cursor: pointer;
    font: 700 0.875rem/1 var(--display); letter-spacing: -0.01em; word-spacing: 0.06em; color: #fff; text-decoration: none; background: var(--accent);
    box-shadow: 0 8px 20px -10px rgb(37 99 235 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.2); transition: background-color 0.2s ease;
  }
  .sh-pill:hover { color: #fff; background: var(--accent-hover); }

  .auth-dialog { width: min(360px, 100% - 2rem); padding: 1.5rem; pointer-events: auto; border: 1px solid rgb(15 23 42 / 0.08); border-radius: 22px; background: #fff; color: var(--ink); box-shadow: 0 24px 56px -12px rgb(15 23 42 / 0.16), 0 2px 8px -2px rgb(15 23 42 / 0.05); }
  .auth-dialog::backdrop { background: rgb(15 23 42 / 0.14); backdrop-filter: blur(4px); }
  .auth-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .auth-head img { height: 20px; width: auto; }
  .auth-close { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 999px; border: 0; background: var(--tile); color: #64748b; cursor: pointer; }
  .auth-close:hover { background: #eff6ff; color: var(--accent); }
  .auth-close svg { width: 14px; height: 14px; }
  .auth-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; padding: 0.25rem; margin-bottom: 1rem; border-radius: 999px; background: var(--tile); }
  .auth-tabs button { min-height: 36px; border: 0; border-radius: 999px; background: transparent; color: #64748b; font: 700 0.8125rem/1 var(--display); cursor: pointer; }
  .auth-tabs button:hover { color: var(--ink); }
  /* The chosen tab: a white chip on the porcelain track, cobalt text. */
  .auth-tabs button[aria-selected="true"] { background: #fff; color: var(--accent); box-shadow: 0 1px 2px rgb(15 23 42 / 0.06), 0 4px 10px -4px rgb(15 23 42 / 0.12); }
  .auth-title { font-size: 1rem; letter-spacing: -0.02em; }
  .auth-desc { margin-top: 0.25rem; font-size: 0.8125rem; line-height: 1.5; color: #64748b; }
  .auth-form { margin-top: 1rem; display: grid; gap: 0.5rem; }
  .auth-form[hidden] { display: none; }
  .auth-form label { font-size: 0.8125rem; font-weight: 600; color: #475569; }
  .auth-form input { width: 100%; min-height: 44px; padding: 0 0.875rem; border-radius: 12px; border: 1px solid rgb(15 23 42 / 0.1); background: #f8fafc; color: var(--ink); font: inherit; font-size: 1rem; }
  .auth-form input:focus { outline: none; border-color: var(--accent); background: #fff; box-shadow: 0 0 0 3px rgb(37 99 235 / 0.15); }
  .auth-form input[aria-invalid="true"] { border-color: #e11d48; background: #fff; box-shadow: 0 0 0 3px rgb(225 29 72 / 0.14); }
  .auth-form .sh-pill { width: 100%; margin-top: 0.25rem; }
  .auth-error { display: flex; align-items: flex-start; gap: 0.375rem; font-size: 0.8125rem; font-weight: 500; line-height: 1.4; color: #be123c; }
  .auth-error::before { content: ""; width: 6px; height: 6px; margin-top: 0.35em; flex-shrink: 0; background: #e11d48; }
  .auth-error[hidden] { display: none; }

  @media (min-width: 640px) {
    .sh-hero, .sh-page { padding: 1.1rem 0 0.25rem; }
    .sh-wordmark img { height: 24px; }
  }
  @media (min-width: 901px) {

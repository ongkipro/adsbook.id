---
/**
 * A page's own 2.5D banner (PLATFORM-SEO-AND-VISUAL-BANNERS-SPEC §4): real
 * copy on one side, the page's illustration (public/visual/*.webp,
 * `npm run platform-visuals`) on the other, on one porcelain tile — no border,
 * no eyebrow pill. `wide` puts the copy above a full-width illustration.
 * The illustration is drawn at 2×; `width`/`height` are its CSS box.
 */
interface Props {
  id: string;
  title: string;
  text: string;
  image: { src: string; width: number; height: number; alt: string };
  link?: { href: string; label: string };
  points?: string[];
  wide?: boolean;
  /** The likely first paint of the page (right under its head). */
  eager?: boolean;
}
const { id, title, text, image, link, points, wide = false, eager = false } = Astro.props;
---

<section class="section visual-banner-section" aria-labelledby={id}>
  <div class:list={['wrap', 'visual-banner', { wide }]} data-visual-banner>
    <div class="vb-copy">
      <h2 id={id}>{title}</h2>
      <p class="lead">{text}</p>
      {points && <ul class="vb-points">{points.map((point) => <li>{point}</li>)}</ul>}
      {link && <a class="text-link" href={link.href}>{link.label}</a>}
    </div>
    <div class="vb-figure">
      <img src={image.src} width={image.width} height={image.height} alt={image.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
    </div>
  </div>
</section>

<style>
  .visual-banner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 2.5rem; align-items: center; padding: 2.5rem; border-radius: 28px; background: var(--tile); }
  .visual-banner.wide { grid-template-columns: 1fr; gap: 1.5rem; }
  .vb-copy { display: grid; gap: 1rem; align-content: center; }
  .vb-copy h2 { font-size: clamp(1.6rem, 1.25rem + 1.5vw, 2.25rem); max-width: 22ch; }
  .wide .vb-copy { max-width: 64ch; }
  .vb-points { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
  .vb-points li { display: grid; grid-template-columns: 8px 1fr; gap: 0.75rem; align-items: baseline; color: var(--ink); font-weight: 600; }
  .vb-points li::before { content: ""; width: 8px; height: 8px; background: var(--accent); transform: translateY(-1px); }
  .vb-figure img { width: 100%; height: auto; border-radius: 20px; }
  @media (max-width: 860px) {
    .visual-banner { grid-template-columns: 1fr; padding: 1.5rem; gap: 1.5rem; border-radius: 22px; }
  }
  /* Under an inner page's head the head already gives the air above it. */
  :global(.page-head) + .visual-banner-section { padding-top: 0; }
</style>

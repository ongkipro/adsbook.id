---
import type { Faq } from './content.ts';

interface Props { items: Faq[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p class="muted">{item.a}</p>
    </details>
  ))}
</div>

<style>
  /* Hairline rows, no boxes (HOMEPAGE-DESIGN-SYSTEM v2 §6): one rule under each question; the
     marker is a "+" that turns into "×" when the answer opens. */
  .faq { display: grid; max-width: 820px; border-top: var(--hairline); }
  details { border-bottom: var(--hairline); }
  summary { cursor: pointer; font-family: var(--display); font-weight: 700; font-size: 1.05rem; color: var(--ink); padding: 1.35rem 3rem 1.35rem 0; min-height: 44px; list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; position: absolute; right: 0.25rem; top: 50%; transform: translateY(-50%); font: 400 1.6rem/1 var(--body); color: var(--accent); transition: transform 200ms ease-out; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  summary:hover { color: var(--accent); }
  details p { padding: 0 3rem 1.4rem 0; line-height: 1.65; }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>

---
/** The six pillars, short: numbered, hairline-separated, each linking to its full row on /fitur. */
import { PILLARS } from './content.ts';
---

<ol class="pillars" aria-label="Enam hal yang membuat adsbook.id presisi">
  {PILLARS.map((pillar, index) => (
    <li>
      <p class="pillar-label"><span class="pillar-no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{pillar.label}</p>
      <h3>{pillar.title}</h3>
      <p class="muted">{pillar.summary}</p>
      <a class="text-link" href={`/fitur#${pillar.id}`} aria-label={`Selengkapnya: ${pillar.title}`}>Selengkapnya</a>
    </li>
  ))}
</ol>

<style>
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 3rem; }
  .pillars li { display: grid; gap: 0.7rem; align-content: start; justify-items: start; padding: 2rem 0; border-top: 1px solid var(--line); }
  .pillar-label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; font-weight: 700; color: var(--accent); }
  .pillar-no { font-family: var(--display); font-variant-numeric: tabular-nums; color: var(--ink-muted); font-weight: 700; }
  .pillars h3 { font-size: 1.3rem; }
  @media (max-width: 960px) { .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .pillars { grid-template-columns: 1fr; } .pillars li { padding: 1.5rem 0; } }
</style>

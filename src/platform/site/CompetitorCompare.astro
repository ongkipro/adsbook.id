---
/**
 * Head-to-head comparison against a typical form builder and an add-on tracking app, without
 * naming any brand (Paduka, 2026-11-18). An open editorial table (HOMEPAGE-DESIGN-SYSTEM v2 §5.3):
 * horizontal hairlines only, no outer box, no dark header; the adsbook.id column is one porcelain
 * wash rounded at its ends.
 */
const ROWS = [
  {
    feature: 'Potongan transaksi QRIS & VA',
    typical: 'Persentase dipotong per transaksi',
    tracker: 'Biaya langganan aplikasi kedua',
    ours: '0% biaya per transaksi, dana cair langsung',
  },
  {
    feature: 'Kuota order dan jumlah produk',
    typical: 'Sering dibatasi per paket',
    tracker: 'Biaya bisa naik mengikuti volume event',
    ours: 'Tanpa kuota order dan produk',
  },
  {
    feature: 'Metode bayar per provinsi',
    typical: 'COD terbuka untuk semua wilayah',
    tracker: 'Tidak mengatur metode bayar',
    ours: 'Hybrid Form per provinsi, COD dikunci di server',
  },
  {
    feature: 'Server tracking 1:1 dan 8 hash SHA-256',
    typical: 'Pixel browser, atau server GTM terpisah',
    tracker: 'Terpisah dari form dan status COD',
    ours: 'Bawaan toko, satu event_id per pesanan',
  },
  {
    feature: 'Database toko',
    typical: 'Tergantung arsitektur penyedia',
    tracker: 'Menambah script di halaman',
    ours: 'Database 10 GB khusus per toko',
  },
] as const;
---

<div class="compare" role="region" aria-label="Perbandingan fitur dan biaya platform">
  <div class="compare-table" role="table">
    <div class="c-row c-head" role="row">
      <span role="columnheader">Kebutuhan pengiklan</span>
      <span role="columnheader" class="c-other-head">Form atau toko biasa</span>
      <span role="columnheader" class="c-other-head">+ aplikasi tracker</span>
      <span role="columnheader" class="c-ours c-ours-head"><i class="sq" aria-hidden="true"></i>adsbook.id</span>
    </div>

    {ROWS.map((row) => (
      <div class="c-row" role="row">
        <span role="cell" class="c-feat">{row.feature}</span>
        <span role="cell" class="c-other" data-col="Form atau toko biasa">{row.typical}</span>
        <span role="cell" class="c-other" data-col="+ aplikasi tracker">{row.tracker}</span>
        <span role="cell" class="c-ours" data-col="adsbook.id">{row.ours}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .compare-table { display: grid; }
  .c-row { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr); align-items: stretch; }
  .c-row > span { display: flex; align-items: center; padding: 1.05rem 1.15rem; font-size: 0.92rem; line-height: 1.45; border-bottom: var(--hairline); }
  .c-row:last-child > span { border-bottom: 0; }
  .c-head > span { padding-block: 1.25rem 0.9rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--slate); }
  .c-feat { font-weight: 700; color: var(--ink); padding-left: 0 !important; }
  .c-head > span:first-child { padding-left: 0; }
  .c-other { color: var(--ink-muted); }
  /* One porcelain column, rounded where it starts and ends. */
  .c-ours { gap: 0.55rem; background: var(--tile); color: var(--ink); font-weight: 700; }
  .c-head .c-ours-head { border-radius: 16px 16px 0 0; color: var(--ink); font: 800 0.95rem/1.2 var(--display); letter-spacing: -0.01em; text-transform: none; }
  .c-row:last-child .c-ours { border-radius: 0 0 16px 16px; }
  .sq { width: 8px; height: 8px; background: var(--accent); flex-shrink: 0; }

  @media (max-width: 860px) {
    .c-head { display: none; }
    .c-row { grid-template-columns: 1fr; gap: 0.45rem; padding: 1.25rem 0; border-bottom: var(--hairline); }
    .c-row:last-child { border-bottom: 0; }
    .c-row > span { padding: 0; border-bottom: 0; display: grid; grid-template-columns: 118px 1fr; align-items: baseline; gap: 0.5rem; }
    .c-row > span.c-feat { display: block; font-family: var(--display); font-weight: 800; font-size: 1rem; margin-bottom: 0.2rem; }
    .c-other::before, .c-ours::before { content: attr(data-col) ":"; font-weight: 700; font-size: 0.8rem; color: var(--slate); }
    .c-ours, .c-row:last-child .c-ours { margin-top: 0.2rem; padding: 0.6rem 0.8rem !important; border-radius: 12px; }
    .c-ours::before { color: var(--accent); }
  }
</style>

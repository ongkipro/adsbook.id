---
import { PLANS, PLAN_POINTS, PREVIEW } from './content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH } from './site.ts';

// T-51 (ADR-041): Option A, one store and one own domain per subscription.
// `compact` (home) shows the cards and the preview promise; the full version
// (/harga) adds what every plan holds and what happens around payment.
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="pricing">
  <p class="preview"><strong>{PREVIEW.title}.</strong> {PREVIEW.text}</p>
  <ul class="plans" aria-label="Paket langganan per toko">
    {PLANS.map((plan) => (
      <li class:list={['plan', { best: 'best' in plan && plan.best }]}>
        <p class="plan-name">{plan.label}{'best' in plan && plan.best && <span class="tag">Paling hemat</span>}</p>
        <p class="plan-price">{plan.price}</p>
        <p class="plan-note">{plan.period} · {plan.note}</p>
        <a class="plan-pick" href={`${SIGNUP_PATH}?paket=${plan.code}`}>Pilih {plan.label} →</a>
      </li>
    ))}
  </ul>
  <div class="after">
    <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
    <p class="muted">Harga per toko. 1 langganan = 1 toko dan 1 domain sendiri. 0% potongan per transaksi.</p>
  </div>
  {!compact && (
    <div class="details">
      <div>
        <h3>Semua paket berisi</h3>
        <ul class="points">{PLAN_POINTS.map((point) => <li>{point}</li>)}</ul>
      </div>
      <div class="notes">
        <p>{PREVIEW.payment}</p>
        <p>{PREVIEW.grace}</p>
        <p class="muted">{PREVIEW.fees}</p>
      </div>
    </div>
  )}
</div>

<style>
  .pricing { display: grid; gap: 1.75rem; }
  .preview { max-width: 64ch; }
  .plans { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .plan { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 1.5rem; display: grid; gap: 0.4rem; align-content: start; }
  .plan.best { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .plan-name { font-weight: 700; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .tag { font-size: 0.8125rem; font-weight: 700; color: var(--accent); background: var(--accent-tint); border-radius: 999px; padding: 0.15rem 0.6rem; }
  .plan-price { font-family: var(--display); font-weight: 800; font-size: 1.9rem; color: var(--ink); letter-spacing: -0.02em; }
  .plan-note { font-size: 0.95rem; color: var(--ink-muted); }
  .plan-pick { margin-top: 0.5rem; font-size: 0.92rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; min-height: 36px; }
  .plan-pick:hover { text-decoration: underline; }
  .after { display: grid; gap: 0.75rem; justify-items: start; }
  .details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; padding-top: 0.5rem; }
  .details h3 { margin-bottom: 0.75rem; }
  .points { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .notes { display: grid; gap: 1rem; }
  @media (max-width: 960px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .details { grid-template-columns: 1fr; gap: 1.5rem; } }
  @media (max-width: 520px) { .plans { grid-template-columns: 1fr; } .plan { padding: 1.25rem; } }
</style>

---
/** The closing band: the three steps left after signup, then the one action. */
import ShotFrame from './ShotFrame.astro';
import { SETUP_DONE, SETUP_STEPS, SHOTS } from './content.ts';
import { SIGNUP_LABEL, SIGNUP_PATH } from './site.ts';

interface Props { withShot?: boolean; tone?: 'canvas' | 'white' }
const { withShot = true, tone = 'canvas' } = Astro.props;
---

<section class={`section closing ${tone === 'white' ? 'section-white' : ''}`} aria-labelledby="closing-title">
  <div class={`wrap closing-grid ${withShot ? '' : 'closing-single'}`}>
    <div class="closing-text">
      <h2 id="closing-title">Toko aktif hari ini, siap jualan setelah tiga langkah lagi</h2>
      <p class="muted">{SETUP_DONE}</p>
      <ol>{SETUP_STEPS.map((step) => <li>{step}</li>)}</ol>
      <a class="btn" href={SIGNUP_PATH}>{SIGNUP_LABEL}</a>
    </div>
    {withShot && <ShotFrame shot={SHOTS.setup} />}
  </div>
</section>

<style>
  .closing-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3.5rem; align-items: center; }
  .closing-single { grid-template-columns: minmax(0, 720px); }
  .closing-text { display: grid; gap: 1.1rem; justify-items: start; }
  .closing-text ol { margin: 0; padding-left: 1.3rem; display: grid; gap: 0.4rem; font-weight: 600; }
  @media (max-width: 760px) { .closing-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>

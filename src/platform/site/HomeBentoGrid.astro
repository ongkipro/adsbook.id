---
/**
 * The six pillars on the home as borderless porcelain tiles (HOMEPAGE-DESIGN-SYSTEM v2 §3.4):
 * each tile holds one floating white widget, then a quiet mono index, the pillar's title and its
 * one-line summary. No per-tile "Detail" link: the header already leads to /fitur. Every tile
 * maps 1:1 to PILLARS in content.ts; the widgets show mechanisms the code has, no result figures.
 */
import { PILLARS } from './content.ts';

const SPAN: Record<string, string> = { sinyal: 'span-7', form: 'span-5', kirim: 'span-4', uang: 'span-4', mulai: 'span-4', infra: 'span-12' };
---

<div class="bento-grid" data-home-bento>
  {PILLARS.map((pillar, index) => (
    <article class={`tile bento-${pillar.id} ${SPAN[pillar.id] ?? 'span-4'}`} id={`bento-${pillar.id}`}>
      {pillar.id !== 'infra' && (
        <div class="widget" aria-hidden="true">
          {pillar.id === 'sinyal' && (
            <ul class="w-sync">
              <li><span class="w-pf">Meta Ads</span><span class="w-how">Pixel + Conversions API</span><b>1:1</b></li>
              <li><span class="w-pf">Google Ads</span><span class="w-how">Tag + offline conversion</span><b>1:1</b></li>
              <li><span class="w-pf">TikTok Ads</span><span class="w-how">Pixel + Events API</span><b>1:1</b></li>
            </ul>
          )}
          {pillar.id === 'form' && (
            <div class="w-form">
              <div class="w-input"><span>Sukajadi, Bandung</span><i class="w-caret"></i></div>
              <ul class="w-results">
                <li class="is-pick">Sukajadi, Kota Bandung, Jawa Barat</li>
                <li>Sukajadi, Kota Pekanbaru, Riau</li>
              </ul>
              <p class="w-lead">Form tidak selesai → <b>Pesanan Tertinggal</b> · rotator 10 WA CS</p>
            </div>
          )}
          {pillar.id === 'kirim' && (
            <div class="w-rts">
              <div class="w-row"><b>#INV-8421</b><span>Menunggu rilis</span></div>
              <div class="w-meter"><span></span></div>
              <div class="w-row"><span>Risiko RTS penerima</span><b class="w-accent">Rendah</b></div>
            </div>
          )}
          {pillar.id === 'uang' && (
            <dl class="w-money">
              <div><dt>Potongan adsbook.id</dt><dd class="w-accent">0%</dd></div>
              <div><dt>COD</dt><dd>Akun Mengantar Anda</dd></div>
              <div><dt>QRIS dan VA</dt><dd>Akun AutoLaris Anda</dd></div>
            </dl>
          )}
          {pillar.id === 'mulai' && (
            <div class="w-start">
              <p class="w-mode">Mode Review Pemilik</p>
              <ul class="w-steps">
                <li class="is-done">Produk pertama</li>
                <li class="is-done">Gudang pickup</li>
                <li>API key kurir</li>
              </ul>
            </div>
          )}
        </div>
      )}

      <div class="tile-body">
        <span class="idx">{String(index + 1).padStart(2, '0')}</span>
        <h3>{pillar.title}</h3>
        <p>{pillar.summary}</p>
      </div>

      {pillar.id === 'infra' && pillar.specs && (
        <dl class="metrics">
          {pillar.specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
        </dl>
      )}
    </article>
  ))}
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-home-bento]'));
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) (entry.target as HTMLElement).classList.toggle('is-playing', entry.isIntersecting);
    }, { threshold: 0.2 });
    grids.forEach((grid) => io.observe(grid));
  }
</script>

<style>
  .bento-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.25rem; }
  .tile { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding: 2rem; border-radius: 24px; background: var(--tile); }
  .span-7 { grid-column: span 7; }
  .span-5 { grid-column: span 5; }
  .span-4 { grid-column: span 4; }
  .span-12 { grid-column: span 12; flex-direction: row; align-items: center; }

  /* The one floating artifact of each tile. */
  .widget { display: grid; gap: 0.6rem; padding: 1.1rem 1.2rem; border-radius: 14px; background: #fff; box-shadow: var(--shadow-float); font-size: 0.8rem; color: var(--ink-muted); }
  .w-accent { color: var(--accent); }

  .w-sync { list-style: none; margin: 0; padding: 0; display: grid; }
  .w-sync li { display: grid; grid-template-columns: 5.75rem minmax(0, 1fr) auto; gap: 0.6rem; align-items: center; padding: 0.55rem 0; border-bottom: var(--hairline); }
  .w-sync li:last-child { border-bottom: 0; }
  .w-pf { font-weight: 700; color: var(--ink); }
  .w-how { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--slate); }
  .w-sync b { padding: 0.1rem 0.45rem; border-radius: 999px; background: #eff6ff; color: var(--accent); font-size: 0.7rem; }

  .w-form { display: grid; gap: 0.55rem; }
  .w-input { display: flex; align-items: center; gap: 0.15rem; padding: 0.55rem 0.7rem; border-radius: 10px; background: #f8fafc; box-shadow: inset 0 0 0 1.5px var(--accent); font-weight: 700; color: var(--ink); }
  .w-caret { width: 1.5px; height: 1em; background: var(--accent); }
  .w-results { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
  .w-results li { padding: 0.35rem 0.7rem; border-radius: 8px; }
  .w-results .is-pick { background: #eff6ff; color: var(--ink); font-weight: 600; }
  .w-lead { padding-top: 0.5rem; border-top: var(--hairline); font-size: 0.76rem; }
  .w-lead b { color: var(--ink); }

  .w-rts { display: grid; gap: 0.6rem; }
  .w-row { display: flex; justify-content: space-between; gap: 0.5rem; }
  .w-row b { color: var(--ink); }
  .w-meter { height: 6px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
  .w-meter span { display: block; width: 22%; height: 100%; border-radius: 999px; background: var(--accent); }

  .w-money { margin: 0; display: grid; }
  .w-money div { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.45rem 0; border-bottom: var(--hairline); }
  .w-money div:last-child { border-bottom: 0; }
  .w-money dt { color: var(--slate); }
  .w-money dd { margin: 0; font-weight: 700; color: var(--ink); text-align: right; }
  .w-money dd.w-accent { font: 800 1.05rem/1 var(--display); color: var(--accent); }

  .w-start { display: grid; gap: 0.6rem; }
  .w-mode { justify-self: start; padding: 0.15rem 0.55rem; border-radius: 6px; background: var(--ink); color: #fff; font-size: 0.72rem; font-weight: 700; }
  .w-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .w-steps li { display: flex; align-items: center; gap: 0.5rem; }
  .w-steps li::before { content: ""; width: 14px; height: 14px; border-radius: 4px; box-shadow: inset 0 0 0 1.5px #cbd5e1; }
  .w-steps .is-done { color: var(--ink); }
  .w-steps .is-done::before { background: var(--accent); box-shadow: none; }

  .tile-body { display: grid; gap: 0.5rem; align-content: end; }
  .idx { font: 600 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.08em; color: var(--slate-soft); }
  .tile-body h3 { font-size: 1.15rem; line-height: 1.28; }
  .tile-body p { font-size: 0.93rem; line-height: 1.55; color: var(--ink-muted); }
  .span-12 .tile-body { flex: 1; max-width: 46ch; }

  /* The infra tile: numbers set as type, no boxes around them. */
  .metrics { flex: 1.2; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .metrics div { display: grid; gap: 0.25rem; align-content: start; }
  .metrics dd { order: -1; margin: 0; font: 800 clamp(1.4rem, 1.1rem + 1vw, 1.9rem)/1.1 var(--display); color: var(--ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .metrics dt { font-size: 0.8rem; line-height: 1.4; color: var(--slate); }

  .bento-grid.is-playing .widget { animation: float-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes float-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  @media (max-width: 960px) {
    .span-7, .span-5, .span-4 { grid-column: span 6; }
    .span-12 { flex-direction: column; align-items: stretch; }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .span-7, .span-5, .span-4, .span-12 { grid-column: span 12; }
    .tile { padding: 1.4rem; border-radius: 20px; gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento-grid.is-playing .widget { animation: none; }
  }
</style>

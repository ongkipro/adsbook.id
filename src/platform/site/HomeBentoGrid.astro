---
/**
 * Scannable 6-card visual Bento Grid for Homepage (Paduka, 2026-11-18:
 * minimal text, simulation/visual-first, zero external animation libraries).
 * Every card maps 1:1 to PILLARS in content.ts and links to /fitur#<id>.
 */
import { PILLARS } from './content.ts';
---

<div class="bento-grid" data-home-bento>
  {PILLARS.map((pillar, index) => (
    <article class={`bento-card bento-${pillar.id} ${index < 2 ? 'bento-wide' : ''}`}>
      <div class="bento-visual" aria-hidden="true">
        {pillar.id === 'sinyal' && (
          <div class="vis-hub">
            <div class="hub-sources">
              <span>Meta Ads</span>
              <span>Google Ads</span>
              <span>TikTok UTM</span>
            </div>
            <div class="hub-rails">
              <i class="rail r1"></i>
              <i class="rail r2"></i>
              <i class="rail r3"></i>
            </div>
            <div class="hub-core"><span>a<i></i></span><small>1:1</small></div>
            <div class="hub-dest">Dashboard Iklan</div>
          </div>
        )}

        {pillar.id === 'form' && (
          <div class="vis-form">
            <div class="vf-search">
              <span class="vf-typed">Sukajadi, Bandung</span>
              <b class="vf-ms">0 ms</b>
            </div>
            <div class="vf-lead">
              <span class="sq-blue"></span>
              <span>Batal isi → <b>Pesanan Tertinggal</b> (Rotator 10 WA CS)</span>
            </div>
          </div>
        )}

        {pillar.id === 'kirim' && (
          <div class="vis-rts">
            <div class="rts-row">
              <span class="rts-order">#INV-8421 · Menunggu</span>
              <span class="rts-safe">Skor RTS Aman</span>
            </div>
            <div class="rts-bar"><span></span></div>
            <p class="rts-meta">Pilih otomatis dari 10 titik gudang terdekat</p>
          </div>
        )}

        {pillar.id === 'uang' && (
          <div class="vis-money">
            <div class="vm-compare">
              <span class="vm-strike">Potongan 1% – 5%</span>
              <strong class="vm-zero">0% Komisi Platform</strong>
            </div>
            <p class="vm-flow">Mengantar COD &amp; AutoLaris QRIS/VA → Langsung ke Akun Anda</p>
          </div>
        )}

        {pillar.id === 'mulai' && (
          <div class="vis-start">
            <div class="vs-pills">
              <span class="vs-on">Mode Review Pemilik</span>
              <span class="vs-shield">+48 Jam Masa Tenggang</span>
            </div>
            <div class="vs-steps">
              <i class="done"></i><i class="done"></i><i class="done"></i>
              <span>3 langkah siap buka</span>
            </div>
          </div>
        )}

        {pillar.id === 'infra' && (
          <div class="vis-infra">
            <div><strong>348</strong><small>Kota Edge</small></div>
            <div><strong>50 ms</strong><small>Respons</small></div>
            <div><strong>10 GB</strong><small>DB Mandiri</small></div>
            <div><strong>1.000/dtk</strong><small>Kapasitas</small></div>
          </div>
        )}
      </div>

      <div class="bento-body">
        <p class="bento-kicker">
          <span class="bento-num">{String(index + 1).padStart(2, '0')}</span>
          <span>{pillar.label}</span>
        </p>
        <h3>{pillar.title}</h3>
        <p class="bento-copy">{pillar.summary}</p>
        <a class="text-link bento-link" href={`/fitur#${pillar.id}`} aria-label={`Detail ${pillar.label}`}>Detail</a>
      </div>
    </article>
  ))}
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const grids = Array.from(document.querySelectorAll<HTMLElement>('[data-home-bento]'));
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) (entry.target as HTMLElement).classList.toggle('is-playing', entry.isIntersecting);
    }, { threshold: 0.2 });
    grids.forEach((g) => io.observe(g));
  }
</script>

<style>
  .bento-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.25rem; }
  .bento-card { grid-column: span 4; background: #ffffff; border: 1px solid var(--line); border-radius: 18px; padding: 1.35rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.15rem; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .bento-card:hover { border-color: #93c5fd; box-shadow: 0 16px 34px -16px rgb(15 23 42 / 0.1); }
  .bento-wide { grid-column: span 6; }

  .bento-visual { min-height: 108px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.95rem 1rem; display: flex; flex-direction: column; justify-content: center; }

  /* 1. Sinyal Hub */
  .vis-hub { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 0.6rem; }
  .hub-sources { display: grid; gap: 0.3rem; }
  .hub-sources span { font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; background: #ffffff; border: 1px solid #cbd5e1; color: var(--ink); white-space: nowrap; }
  .hub-rails { display: grid; gap: 0.55rem; }
  .rail { display: block; height: 2px; background: #dbeafe; position: relative; overflow: hidden; }
  .rail::after { content: ""; position: absolute; top: 0; left: -30%; width: 30%; height: 100%; background: var(--accent); }
  .bento-grid.is-playing .rail::after { animation: rail-move 2.2s linear infinite; }
  .bento-grid.is-playing .r2::after { animation-delay: 0.4s; }
  .bento-grid.is-playing .r3::after { animation-delay: 0.8s; }
  @keyframes rail-move { to { left: 110%; } }
  .hub-core { width: 44px; height: 44px; border-radius: 11px; background: var(--ink); color: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; }
  .hub-core span { font-family: var(--display); font-weight: 800; font-size: 0.95rem; display: inline-flex; align-items: baseline; }
  .hub-core span i { width: 4px; height: 4px; background: #60a5fa; margin-left: 1px; display: inline-block; }
  .hub-core small { font-size: 0.62rem; color: #93c5fd; font-weight: 700; margin-top: 2px; }
  .hub-dest { font-size: 0.74rem; font-weight: 800; padding: 0.38rem 0.65rem; border-radius: 8px; background: #eff6ff; border: 1px solid #bfdbfe; color: var(--accent); white-space: nowrap; }

  /* 2. Instant Form + Rescued Lead */
  .vis-form { display: grid; gap: 0.55rem; }
  .vf-search { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.45rem 0.7rem; border-radius: 8px; background: #ffffff; border: 1px solid #bfdbfe; font-size: 0.8rem; }
  .vf-typed { font-weight: 700; color: var(--ink); }
  .vf-ms { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; padding: 0.12rem 0.42rem; border-radius: 5px; background: #eff6ff; color: var(--accent); }
  .vf-lead { display: flex; align-items: center; gap: 0.45rem; font-size: 0.76rem; color: var(--ink-muted); }
  .vf-lead b { color: var(--ink); }
  .sq-blue { width: 6px; height: 6px; background: var(--accent); flex-shrink: 0; }

  /* 3. RTS Guard */
  .vis-rts { display: grid; gap: 0.45rem; }
  .rts-row { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; font-size: 0.76rem; }
  .rts-order { font-weight: 700; color: var(--ink); }
  .rts-safe { font-size: 0.7rem; font-weight: 700; padding: 0.14rem 0.46rem; border-radius: 5px; background: #dcfce7; color: #166534; }
  .rts-bar { height: 6px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
  .rts-bar span { display: block; width: 88%; height: 100%; background: var(--accent); }
  .rts-meta { font-size: 0.74rem; color: var(--ink-muted); }

  /* 4. Zero Fee */
  .vis-money { display: grid; gap: 0.45rem; }
  .vm-compare { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .vm-strike { font-size: 0.75rem; color: #94a3b8; text-decoration: line-through; }
  .vm-zero { font-family: var(--display); font-weight: 800; font-size: 0.95rem; color: var(--accent); }
  .vm-flow { font-size: 0.74rem; color: var(--ink-muted); line-height: 1.4; }

  /* 5. Start Free + 48h Shield */
  .vis-start { display: grid; gap: 0.55rem; }
  .vs-pills { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .vs-on { font-size: 0.71rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; background: var(--ink); color: #ffffff; }
  .vs-shield { font-size: 0.71rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 6px; background: #eff6ff; color: var(--accent); border: 1px solid #bfdbfe; }
  .vs-steps { display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 600; color: var(--ink-muted); }
  .vs-steps i.done { width: 14px; height: 5px; background: var(--accent); display: inline-block; }

  /* 6. Infra Metrics */
  .vis-infra { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 0.75rem; }
  .vis-infra strong { display: block; font-family: var(--display); font-weight: 800; font-size: 0.95rem; color: var(--ink); line-height: 1.1; }
  .vis-infra small { font-size: 0.71rem; color: var(--ink-muted); }

  /* Body */
  .bento-body { display: grid; gap: 0.45rem; align-content: start; }
  .bento-kicker { display: flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; font-weight: 700; color: var(--accent); }
  .bento-num { font-family: var(--display); color: #94a3b8; font-variant-numeric: tabular-nums; }
  .bento-body h3 { font-size: 1.14rem; line-height: 1.25; }
  .bento-copy { font-size: 0.9rem; line-height: 1.5; color: var(--ink-muted); }
  .bento-link { font-size: 0.88rem; margin-top: 0.2rem; }

  @media (max-width: 960px) {
    .bento-card, .bento-wide { grid-column: span 6; }
  }
  @media (max-width: 640px) {
    .bento-card, .bento-wide { grid-column: span 12; }
    .vis-hub { grid-template-columns: 1fr auto 1fr; }
    .hub-dest { grid-column: 1 / -1; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail::after, .bento-card { animation: none !important; transition: none !important; }
  }
</style>

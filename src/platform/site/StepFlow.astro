---
/**
 * The five steps of one order: a strip (C2), then one row per step (C3).
 * `detail` (cara-kerja) adds what the buyer and the seller do at each step.
 */
import ShotFrame from './ShotFrame.astro';
import { STEPS } from './content.ts';

interface Props { headingLevel?: 'h2' | 'h3'; detail?: boolean }
const { headingLevel = 'h3', detail = false } = Astro.props;
const Heading = headingLevel;
---

<ol class="strip" aria-label="Alur satu pesanan">
  {STEPS.map((step, index) => (
    <li><a href={`#${step.id}`}><span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="label">{step.label}</span></a></li>
  ))}
</ol>

<div class="rows">
  {STEPS.map((step, index) => (
    <article class={`row ${index % 2 ? 'row-flip' : ''}`} id={step.id} aria-labelledby={`${step.id}-title`}>
      <div class="row-text">
        <p class="step-no"><span class="step-idx">{String(index + 1).padStart(2, '0')}</span>{step.label}</p>
        <Heading class="step-title" id={`${step.id}-title`}>{step.title}</Heading>
        {step.text.map((paragraph) => <p class="muted">{paragraph}</p>)}
        {detail && (
          <dl class="roles">
            <div><dt>Pembeli</dt><dd>{step.buyer}</dd></div>
            <div><dt>Anda</dt><dd>{step.seller}</dd></div>
          </dl>
        )}
      </div>
      <div class="row-shot"><ShotFrame shot={step.shot} /></div>
    </article>
  ))}
</div>

<style>
  /* One porcelain strip (HOMEPAGE-DESIGN-SYSTEM v2 §5.2): mono pills, no circles, no line. */
  .strip { list-style: none; margin: 0; padding: 0.5rem; display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.35rem; border-radius: 16px; background: var(--tile); }
  .strip a { display: flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 48px; padding: 0.5rem 0.75rem; border-radius: 12px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background-color 150ms ease-out, box-shadow 150ms ease-out; }
  .strip a:hover { background: #fff; box-shadow: var(--shadow-float); }
  .num { padding: 0.15rem 0.45rem; border-radius: 6px; background: #fff; color: var(--accent); font: 600 0.75rem/1.2 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .rows { display: grid; gap: 5rem; margin-top: 4.5rem; }
  .row { display: grid; grid-template-columns: 5fr 7fr; gap: 3.5rem; align-items: center; scroll-margin-top: 1.5rem; }
  .row-flip .row-text { order: 2; }
  .row-text { display: grid; gap: 0.9rem; }
  /* One size for step titles whatever their level: a narrow column, not a page heading. */
  .row-text .step-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
  .step-no { display: flex; align-items: center; gap: 0.7rem; color: var(--slate); font-weight: 600; font-size: 0.92rem; }
  .step-idx { font: 600 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.08em; color: var(--slate-soft); }
  .roles { margin: 0.4rem 0 0; display: grid; gap: 0.75rem; padding-top: 1rem; border-top: var(--hairline); }
  .roles div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; }
  .roles dt { font-weight: 700; }
  .roles dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 760px) {
    .strip { grid-template-columns: 1fr; gap: 0.15rem; }
    .strip a { justify-content: flex-start; }
    .rows { gap: 3.5rem; margin-top: 3rem; }
    .row { grid-template-columns: 1fr; gap: 1.5rem; }
    .row-flip .row-text { order: 0; }
    .roles div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
  @media (prefers-reduced-motion: reduce) { .strip a { transition: none; } }
</style>

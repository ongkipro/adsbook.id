---
/**
 * The five steps of one order: a strip (C2), then one row per step (C3).
 * `detail` (cara-kerja) adds what the buyer and the seller do at each step.
 */
import ShotFrame from './ShotFrame.astro';
import { STEPS } from './content.ts';

interface Props { headingLevel?: 'h2' | 'h3'; detail?: boolean }
const { headingLevel = 'h3', detail = false } = Astro.props;
const Heading = headingLevel;
---

<ol class="strip" aria-label="Alur satu pesanan">
  {STEPS.map((step, index) => (
    <li><a href={`#${step.id}`}><span class="num" aria-hidden="true">{index + 1}</span><span class="label">{step.label}</span></a></li>
  ))}
</ol>

<div class="rows">
  {STEPS.map((step, index) => (
    <article class={`row ${index % 2 ? 'row-flip' : ''}`} id={step.id} aria-labelledby={`${step.id}-title`}>
      <div class="row-text">
        <p class="step-no">Langkah {index + 1} · {step.label}</p>
        <Heading class="step-title" id={`${step.id}-title`}>{step.title}</Heading>
        {step.text.map((paragraph) => <p class="muted">{paragraph}</p>)}
        {detail && (
          <dl class="roles">
            <div><dt>Pembeli</dt><dd>{step.buyer}</dd></div>
            <div><dt>Anda</dt><dd>{step.seller}</dd></div>
          </dl>
        )}
      </div>
      <div class="row-shot"><ShotFrame shot={step.shot} /></div>
    </article>
  ))}
</div>

<style>
  .strip { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  /* The connecting line reads on white and on canvas (DESIGN.md C2). */
  .strip::before { content: ""; position: absolute; left: 10%; right: 10%; top: 21px; height: 2px; background: var(--accent); opacity: 0.45; }
  .strip li { position: relative; text-align: center; }
  .strip a { display: grid; justify-items: center; gap: 0.5rem; color: var(--ink); text-decoration: none; font-weight: 600; padding: 0 0.25rem; min-height: 44px; }
  .strip .label { text-decoration: underline; text-decoration-color: var(--line); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .strip a:hover .label { color: var(--accent); text-decoration-color: currentColor; }
  .num { width: 44px; height: 44px; border-radius: 999px; background: var(--accent); color: #fff; display: grid; place-items: center; font-family: var(--display); font-weight: 800; position: relative; }
  .rows { display: grid; gap: 5rem; margin-top: 4.5rem; }
  .row { display: grid; grid-template-columns: 5fr 7fr; gap: 3.5rem; align-items: center; scroll-margin-top: 1.5rem; }
  .row-flip .row-text { order: 2; }
  .row-text { display: grid; gap: 0.9rem; }
  /* One size for step titles whatever their level: a narrow column, not a page heading. */
  .row-text .step-title { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
  .step-no { color: var(--accent); font-weight: 700; font-size: 0.95rem; }
  .roles { margin: 0.4rem 0 0; display: grid; gap: 0.75rem; }
  .roles div { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0.75rem; }
  .roles dt { font-weight: 700; }
  .roles dd { margin: 0; color: var(--ink-muted); }
  @media (max-width: 760px) {
    .strip { grid-template-columns: 1fr; gap: 0.5rem; }
    .strip::before { left: 21px; right: auto; top: 22px; bottom: 22px; width: 2px; height: auto; }
    .strip a { grid-template-columns: 44px 1fr; justify-items: start; align-items: center; text-align: left; gap: 0.9rem; }
    .rows { gap: 3.5rem; margin-top: 3rem; }
    .row { grid-template-columns: 1fr; gap: 1.5rem; }
    .row-flip .row-text { order: 0; }
    .roles div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>

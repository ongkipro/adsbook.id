---
/**
 * Campaign analytics showcase (Paduka, 2026-11-18, white gallery): copy on the
 * left, a layered product-UI composition on the right — a dashboard surface
 * fading into the page behind a "Top campaigns" card. No connector lines.
 *
 * Only what the product reports is shown: orders and revenue per platform and
 * campaign (Analitik, UTM campaigns in src/lib/insights.ts), Purchase sent 1:1
 * (ADR-036), the 8 hashed match keys (src/lib/meta-identity.ts), the 90-day
 * click window (src/lib/click-ids.ts). There is no spend or ROAS here: the
 * product has no ad spend, so the caption sends ROAS to the seller's Ads Manager.
 */
interface Props { id?: string; tone?: 'white' | 'canvas' }
const { id = 'campaigns-title', tone = 'white' } = Astro.props;

const ROWS = [
  { platform: 'meta', name: 'Video edukasi produk, angle A', meta: 'Meta Ads · Prospecting', orders: 48, revenue: 'Rp7.152.000', note: 'Layak tambah budget', state: 'win' },
  { platform: 'tiktok', name: 'Creator review, hook v2', meta: 'TikTok Ads · UTM', orders: 31, revenue: 'Rp4.619.000', note: 'Stabil', state: 'ok' },
  { platform: 'google', name: 'Broad keyword generic', meta: 'Google Ads · Search', orders: 0, revenue: 'Rp0', note: 'Cek di Ads Manager', state: 'cut' },
] as const;
---

<section class={`section campaigns ${tone === 'white' ? 'section-white' : ''}`} aria-labelledby={id} data-campaigns>
  <div class="wrap camp-grid">
    <div class="camp-copy">
      <p class="pill-eyebrow"><span class="sq" aria-hidden="true"></span>Campaign &amp; creative analytics</p>
      <h2 id={id}>Lihat jelas campaign mana yang benar-benar menghasilkan pesanan</h2>
      <p class="lead">Setiap pesanan tercatat kembali ke ad platform dan campaign asalnya, dari transaksi toko, bukan estimasi. Anda tahu ad set mana yang layak ditambah budget-nya, dan campaign mana yang belum menghasilkan satu pesanan pun.</p>
      <ul class="checks">
        <li>Meta Ads, Google Ads, TikTok Ads, dan UTM platform lain</li>
        <li>Deduplikasi 1:1 browser + server untuk Meta dan Google</li>
        <li>Setup dalam hitungan menit, tanpa coding</li>
      </ul>
    </div>

    <figure class="camp-visual">
      <div class="layer-back" aria-hidden="true">
        <div class="toolbar">
          <span class="chip">Periode: 30 hari <i>▾</i></span>
          <span class="chip">Platform: semua <i>▾</i></span>
          <span class="chip chip-soft">Atribusi klik 90 hari</span>
        </div>
        <div class="tiles">
          <div class="tile"><span class="t-label">Orders</span><b>412</b></div>
          <div class="tile"><span class="t-label">Revenue</span><b>Rp68,3 jt</b><span class="t-pill">dari transaksi toko</span></div>
          <div class="tile"><span class="t-label">Purchase ke Meta &amp; Google</span><b>1:1</b><span class="t-sub">satu event per pesanan</span></div>
          <div class="tile"><span class="t-label">Match keys</span><b>8</b><span class="t-sub">SHA-256</span></div>
        </div>
        <div class="spark"><span style="--h:38%"></span><span style="--h:52%"></span><span style="--h:46%"></span><span style="--h:61%"></span><span style="--h:57%"></span><span style="--h:72%"></span><span style="--h:68%"></span><span style="--h:84%"></span><span style="--h:79%"></span><span style="--h:93%"></span></div>
      </div>

      <div class="layer-front" role="table" aria-label="Contoh laporan top campaigns">
        <div class="front-head" role="row">
          <span role="columnheader" class="fh-title">Top campaigns</span>
          <span role="columnheader" class="num">Orders</span>
          <span role="columnheader" class="num">Revenue</span>
        </div>
        {ROWS.map((row) => (
          <div class={`front-row is-${row.state}`} role="row">
            <span role="cell" class="fr-name">
              <span class={`pf pf-${row.platform}`} aria-hidden="true">
                {row.platform === 'meta' && (
                  <svg viewBox="0 0 24 24" fill="none"><path d="M6.6 7.6C4.0 7.6 2.2 10.1 2.2 13.1C2.2 15.6 3.7 17.3 5.9 17.3C8.2 17.3 9.9 15.4 12.0 12.2C14.1 9.0 15.8 7.6 17.8 7.6C20.1 7.6 21.8 9.6 21.8 12.6C21.8 15.4 20.1 17.3 17.8 17.3C15.6 17.3 13.9 15.5 12.0 12.2C10.1 8.9 8.6 7.6 6.6 7.6Z" stroke="#0081FB" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                )}
                {row.platform === 'tiktok' && (
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z" fill="#25F4EE" transform="translate(-0.9,-0.7)"/>
                    <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z" fill="#FE2C55" transform="translate(0.9,0.7)"/>
                    <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z" fill="#0F172A"/>
                  </svg>
                )}
                {row.platform === 'google' && (
                  <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="6.3" y2="17.4" stroke="#FBBC04" stroke-width="4.6" stroke-linecap="round"/><line x1="12" y1="5" x2="17.7" y2="17.4" stroke="#4285F4" stroke-width="4.6" stroke-linecap="round"/><circle cx="6.3" cy="17.4" r="2.3" fill="#34A853"/></svg>
                )}
              </span>
              <span class="fr-text"><span class="fr-title">{row.name}</span><span class="fr-meta">{row.meta}</span></span>
            </span>
            <span role="cell" class="num fr-orders">{row.orders}</span>
            <span role="cell" class="num fr-rev">{row.revenue}<span class={`fr-note note-${row.state}`}>{row.note}</span></span>
          </div>
        ))}
      </div>
      <figcaption class="camp-caption">Ilustrasi laporan Analitik per campaign dari transaksi toko. ROAS Anda hitung bersama spend di Ads Manager.</figcaption>
    </figure>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-campaigns]'));
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) (entry.target as HTMLElement).classList.toggle('is-playing', entry.isIntersecting);
    }, { threshold: 0.25 });
    blocks.forEach((block) => io.observe(block));
  }
</script>

<style>
  .camp-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3.5rem; align-items: center; }
  .camp-copy { display: grid; gap: 1.1rem; justify-items: start; }
  .pill-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.8rem; border-radius: 999px; background: #eff6ff; border: 1px solid #dbeafe; font: 600 0.72rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .sq { width: 6px; height: 6px; background: var(--accent); flex-shrink: 0; }
  .checks { list-style: none; margin: 0.25rem 0 0; padding: 0; display: grid; gap: 0.55rem; font-weight: 600; font-size: 0.97rem; }
  .checks li { position: relative; padding-left: 1.75rem; }
  .checks li::before { content: ""; position: absolute; left: 0; top: 0.2rem; width: 18px; height: 18px; border-radius: 6px; background: #eff6ff; }
  .checks li::after { content: ""; position: absolute; left: 6px; top: calc(0.2rem + 4px); width: 5px; height: 9px; border: solid var(--accent); border-width: 0 2px 2px 0; transform: rotate(45deg); }

  .camp-visual { position: relative; margin: 0; padding: 1rem 0 0; min-height: 430px; }
  /* The back layer: a dashboard surface that fades into the page on the right and at the bottom. */
  .layer-back {
    position: absolute; top: 0; left: 14%; right: 0; display: grid; gap: 1rem; padding: 1.25rem; border-radius: 18px;
    background: var(--canvas); border: 1px solid #e2e8f0; box-shadow: 0 24px 60px -15px rgb(15 23 42 / 0.08);
    mask-image: linear-gradient(to right, #000 55%, transparent 100%), linear-gradient(to bottom, #000 60%, transparent 100%);
    mask-composite: intersect; -webkit-mask-image: linear-gradient(to right, #000 55%, transparent 100%), linear-gradient(to bottom, #000 60%, transparent 100%); -webkit-mask-composite: source-in;
  }
  .toolbar { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.6rem; border-radius: 8px; background: #fff; border: 1px solid #e2e8f0; font-size: 0.75rem; font-weight: 600; color: #475569; }
  .chip i { font-style: normal; color: #94a3b8; }
  .chip-soft { background: #eff6ff; border-color: #dbeafe; color: var(--accent); }
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .tile { display: grid; gap: 0.2rem; align-content: start; padding: 0.75rem; border-radius: 12px; background: #fff; border: 1px solid #e2e8f0; }
  .t-label { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #64748b; }
  .tile b { font: 800 1.05rem/1.2 var(--display); color: var(--ink); font-variant-numeric: tabular-nums; }
  .t-pill { justify-self: start; padding: 0.05rem 0.4rem; border-radius: 999px; background: #ecfdf5; color: #047857; font-size: 0.66rem; font-weight: 700; }
  .t-sub { font-size: 0.7rem; color: #64748b; }
  .spark { display: flex; align-items: flex-end; gap: 0.4rem; height: 96px; padding: 0.5rem 0.25rem 0; }
  .spark span { flex: 1; height: var(--h); border-radius: 6px 6px 2px 2px; background: linear-gradient(#93c5fd, #dbeafe); }

  /* The front layer: the card people read. */
  .layer-front {
    position: relative; z-index: 1; margin-top: 7.5rem; width: min(100%, 470px); display: grid; border-radius: 18px; background: #fff; border: 1px solid #e2e8f0;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 12px 24px -10px rgb(15 23 42 / 0.12), 0 32px 64px -24px rgb(15 23 42 / 0.18);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .front-head, .front-row { display: grid; grid-template-columns: minmax(0, 1fr) 3.5rem 7.5rem; gap: 0.75rem; align-items: center; padding: 0.75rem 1rem; }
  .front-head { border-bottom: 1px solid #f1f5f9; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; }
  .fh-title { color: var(--ink); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .front-row { border-bottom: 1px solid #f1f5f9; }
  .front-row:last-child { border-bottom: 0; }
  .front-row.is-win { background: #eff6ff; box-shadow: inset 3px 0 0 var(--accent); }
  .front-row.is-cut { opacity: 0.72; }
  .fr-name { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
  .pf { flex-shrink: 0; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 10px; background: #fff; border: 1px solid #e2e8f0; }
  .pf svg { width: 18px; height: 18px; }
  .fr-text { display: grid; min-width: 0; }
  .fr-title { font-weight: 700; font-size: 0.86rem; line-height: 1.3; color: var(--ink); }
  .fr-meta { font-size: 0.72rem; color: #64748b; }
  .fr-orders { font: 800 0.95rem/1 var(--display); color: var(--ink); }
  .fr-rev { display: grid; justify-items: end; gap: 0.2rem; font-weight: 700; font-size: 0.85rem; color: var(--ink); }
  .fr-note { max-width: 100%; font-size: 0.66rem; font-weight: 700; line-height: 1.35; padding: 0.05rem 0.4rem; border-radius: 999px; text-align: right; }
  .note-win { background: #ecfdf5; color: #047857; }
  .note-ok { background: #f1f5f9; color: #475569; }
  .note-cut { background: #fff1f2; color: #be123c; }
  .camp-caption { position: relative; z-index: 1; margin-top: 1rem; max-width: 470px; font-size: 0.8rem; line-height: 1.5; color: #64748b; }
  .campaigns.is-playing .layer-front { transform: translateY(-6px); }

  @media (max-width: 900px) {
    .camp-grid { grid-template-columns: 1fr; gap: 2rem; }
    .camp-visual { min-height: 0; }
    .layer-back { position: relative; left: 0; }
    .layer-front { margin-top: -5rem; margin-left: auto; margin-right: auto; }
    .camp-caption { margin-inline: auto; }
  }
  @media (max-width: 520px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .front-head, .front-row { grid-template-columns: minmax(0, 1fr) 2.75rem 6.25rem; gap: 0.5rem; padding-inline: 0.75rem; }
    .pf { width: 30px; height: 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .layer-front { transition: none; }
    .campaigns.is-playing .layer-front { transform: none; }
  }
</style>

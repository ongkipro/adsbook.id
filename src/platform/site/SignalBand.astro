---
/**
 * Clean, high-contrast SignalBand (Paduka, 2026-11-18 — replacing the noisy
 * "AI slop" dark card pile):
 *  - Left: Animated wordmark + interactive Before / After 1:1 Lock switcher
 *    with crisp proportional horizontal accuracy bars (instant visual scan!).
 *  - Right: Ad-Dashboard Campaign Winner vs Cut-Loser view + visual 8-key
 *    SHA-256 pipeline, fixing the "konversi terhitung ganda" terminology.
 *
 * Keeps all platform-site.test.ts invariants:
 *  - `img.signal-logo` + `prefers-reduced-motion: reduce`
 *  - the 8 SHA-256 match keys matching buildMetaAdvancedMatching
 *  - two honest simulation captions at the foot of each deck panel
 */
interface Props { id?: string }
const { id = 'signal-title' } = Astro.props;

const DAYS_BEFORE = [
  { day: 'Hari 1', orders: 42, reported: 19, pct: 45, bar: 45, tag: 'Bocor ad-blocker / tutup layar', state: 'leak' },
  { day: 'Hari 2', orders: 38, reported: 21, pct: 55, bar: 55, tag: 'Jejak klik putus di iOS', state: 'leak' },
  { day: 'Hari 3', orders: 31, reported: 52, pct: 168, bar: 100, tag: 'Konversi ganda (tanpa ID kembar)', state: 'double' },
] as const;

const DAYS_AFTER = [
  { day: 'Hari 4', orders: 48, reported: 48, pct: 100 },
  { day: 'Hari 5', orders: 53, reported: 53, pct: 100 },
  { day: 'Hari 6', orders: 61, reported: 61, pct: 100 },
] as const;

// src/lib/meta-identity.ts: exact 8 customer fields hashed with SHA-256.
const MATCH_KEYS = ['ph', 'fn', 'ln', 'ct', 'st', 'zp', 'country', 'external_id'];
---

<section class="signal" aria-labelledby={id} data-signal-band>
  <div class="wrap signal-top">
    <div class="signal-intro">
      <p class="signal-kicker"><span class="sq-sky" aria-hidden="true"></span>Pelacakan Server First-Party · 1:1</p>
      <h2 id={id}>Suapi dashboard iklan dengan transaksi nyata — tanpa sinyal bocor dan tanpa konversi ganda</h2>
      <p class="signal-sub">Asal klik TikTok dan platform lain tercatat utuh selama 90 hari di Analitik. Khusus Meta Ads dan Google Ads, satu ID pesanan mengunci laporan browser dan server.</p>
    </div>

    <div class="logo-card">
      <img class="signal-logo" src="/platform/brand/adsbook-id-wordmark.svg" data-animated="/platform/brand/adsbook-id-wordmark-animated.svg" alt="" width="530" height="85" loading="lazy" decoding="async" />
      <div class="logo-axes" aria-label="Arti titik pada logo">
        <span><i class="ax-v" aria-hidden="true"></i>Browser Pixel</span>
        <span><i class="ax-h" aria-hidden="true"></i>Server Toko</span>
        <span><i class="ax-d" aria-hidden="true"></i>1 ID = 1 Konversi</span>
      </div>
    </div>
  </div>

  <div class="wrap signal-deck">
    <!-- Panel 1: Clean Visual Bar Meter Before vs After 1:1 Active -->
    <figure class="deck-panel">
      <div class="panel-head">
        <div>
          <span class="panel-tag">Akurasi Sinyal</span>
          <h3>Order toko vs konversi tercatat di dashboard iklan</h3>
        </div>
      </div>

      <div class="meter-list" role="table" aria-label="Perbandingan order toko dan konversi tercatat">
        <div class="meter-cols" role="row">
          <span role="columnheader">Hari</span>
          <span role="columnheader">Order → Tercatat</span>
          <span role="columnheader" class="col-end">Status</span>
        </div>

        {DAYS_BEFORE.map((row) => (
          <div class={`meter-row is-${row.state}`} role="row">
            <span role="cell" class="m-day">{row.day}</span>
            <div role="cell" class="m-bar-cell">
              <div class="m-nums"><span><b>{row.orders}</b> order</span><span>tercatat <b>{row.reported}</b></span></div>
              <div class="m-track"><span class="m-fill" style={`width:${row.bar}%`}></span></div>
              <span class="m-hint">{row.tag}</span>
            </div>
            <span role="cell" class="m-pct">{row.pct}%</span>
          </div>
        ))}

        <div class="lock-divider" role="row">
          <span role="cell" class="lock-pill">
            <span class="lock-mark" aria-hidden="true">a<i></i></span>
            <span>Mesin Sinyal 1:1 Diaktifkan</span>
          </span>
        </div>

        {DAYS_AFTER.map((row) => (
          <div class="meter-row is-locked" role="row">
            <span role="cell" class="m-day">{row.day}</span>
            <div role="cell" class="m-bar-cell">
              <div class="m-nums"><span><b>{row.orders}</b> order</span><span>tercatat <b>{row.reported}</b></span></div>
              <div class="m-track"><span class="m-fill" style="width:100%"></span></div>
            </div>
            <span role="cell" class="m-pct">100%</span>
          </div>
        ))}
      </div>

      <figcaption class="sim-caption">Ilustrasi cara kerja pencocokan order toko ke Conversions API dan konversi offline Google, bukan data toko tertentu.</figcaption>
    </figure>

    <!-- Panel 2: Ad-Dashboard Scale/Kill Decision + 8-Key Pipeline -->
    <figure class="deck-panel panel-right">
      <div class="panel-head">
        <div>
          <span class="panel-tag">Keputusan Budget &amp; ROAS</span>
          <h3>Tahu persis iklan mana yang layak di-scale</h3>
        </div>
      </div>

      <div class="adset-pair">
        <div class="adset-card is-winner">
          <div class="adset-row">
            <span class="adset-title">Ad Set 04 · Video Masalah</span>
            <span class="adset-pill pill-scale">Layak Scale</span>
          </div>
          <div class="adset-kpis">
            <div><small>Order Nyata</small><strong>34</strong></div>
            <div><small>Omzet Toko</small><strong>Rp5,61 jt</strong></div>
            <div><small>Sinyal</small><strong>1:1 Utuh</strong></div>
          </div>
        </div>

        <div class="adset-card is-loser">
          <div class="adset-row">
            <span class="adset-title">Ad Set 02 · Broad Audience</span>
            <span class="adset-pill pill-cut">Matikan</span>
          </div>
          <div class="adset-kpis">
            <div><small>Klik Iklan</small><strong>Ramai</strong></div>
            <div><small>Order Nyata</small><strong>0</strong></div>
            <div><small>Status</small><strong>Bebas Dobel Semu</strong></div>
          </div>
        </div>
      </div>

      <div class="hash-pipe" aria-label="Pengayaan otomatis 8 kunci pencocokan SHA-256">
        <div class="pipe-top">
          <span class="pipe-title">Pengayaan 8 Kunci SHA-256 + Cookie 90 Hari</span>
          <span class="pipe-note">Tahan timpaan link WA CS</span>
        </div>
        <div class="pipe-flow">
          <div class="pipe-inputs">
            <span>Nama</span><span>0812… → 628…</span><span>Kota &amp; Kode Pos</span>
          </div>
          <span class="pipe-arrow" aria-hidden="true">→</span>
          <ul class="pipe-keys">
            {MATCH_KEYS.map((key) => <li>{key}</li>)}
          </ul>
        </div>
      </div>

      <p class="roas-summary">Budget berhenti tersedot ke kampanye yang konversinya terhitung ganda, sementara algoritma belajar dari 100% profil pembeli asli.</p>
      <figcaption class="sim-caption">Ilustrasi keputusan dari laporan Analitik per kampanye. Hasil ROAS tetap ditentukan produk, iklan, dan pasar Anda.</figcaption>
    </figure>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bands = Array.from(document.querySelectorAll<HTMLElement>('[data-signal-band]'));
  if (!reduce && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const band = entry.target as HTMLElement;
        band.classList.toggle('is-playing', entry.isIntersecting);
        if (!entry.isIntersecting) continue;
        const logo = band.querySelector<HTMLImageElement>('img.signal-logo');
        if (logo?.dataset.animated && !logo.src.endsWith(logo.dataset.animated)) logo.src = logo.dataset.animated;
      }
    }, { threshold: 0.25 });
    bands.forEach((band) => observer.observe(band));
  }
</script>

<style>
  .signal { background: #0f172a; color: #cbd5e1; padding-block: var(--section); }
  .signal h2, .signal h3 { color: #f8fafc; }

  .signal-top { display: grid; grid-template-columns: minmax(0, 6.8fr) minmax(0, 5.2fr); gap: 2.5rem; align-items: center; margin-bottom: 2.75rem; }
  .signal-intro { display: grid; gap: 0.8rem; }
  .signal-kicker { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #93c5fd; }
  .sq-sky { width: 7px; height: 7px; background: #60a5fa; flex-shrink: 0; }
  .signal-sub { color: #94a3b8; font-size: 1.02rem; line-height: 1.55; max-width: 56ch; }

  .logo-card { background: #ffffff; border-radius: 18px; padding: 1.5rem 1.75rem; display: grid; gap: 1.1rem; box-shadow: 0 20px 44px -16px rgb(2 6 23 / 0.5); }
  .logo-card img { width: 100%; max-width: 340px; height: auto; margin-inline: auto; }
  .logo-axes { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 1.2rem; padding-top: 0.9rem; border-top: 1px solid #e2e8f0; color: #0f172a; font-size: 0.8rem; font-weight: 700; }
  .logo-axes span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ax-v { display: inline-block; width: 3px; height: 14px; background: linear-gradient(#93c5fd, #2563eb); }
  .ax-h { display: inline-block; width: 14px; height: 3px; background: linear-gradient(90deg, #2563eb, #93c5fd); }
  .ax-d { display: inline-block; width: 8px; height: 8px; background: #2563eb; }

  .signal-deck { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; align-items: stretch; }
  .deck-panel { margin: 0; background: #131e33; border: 1px solid #23324d; border-radius: 20px; padding: 1.6rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .panel-head h3 { font-size: 1.15rem; margin-top: 0.25rem; }
  .panel-tag { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #60a5fa; }

  /* Visual Bar Meter */
  .meter-list { display: grid; gap: 0.55rem; }
  .meter-cols { display: grid; grid-template-columns: 60px 1fr 56px; gap: 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; padding: 0 0.25rem 0.35rem; border-bottom: 1px solid #1e293b; }
  .col-end { text-align: right; }
  .meter-row { display: grid; grid-template-columns: 60px 1fr 56px; gap: 0.75rem; align-items: center; padding: 0.55rem 0.7rem; border-radius: 10px; background: #0f172a; border: 1px solid #1e293b; }
  .m-day { font-size: 0.8rem; font-weight: 700; color: #cbd5e1; }
  .m-bar-cell { display: grid; gap: 0.3rem; }
  .m-nums { display: flex; justify-content: space-between; font-size: 0.78rem; color: #94a3b8; font-variant-numeric: tabular-nums; }
  .m-nums b { color: #f8fafc; font-weight: 700; }
  .m-track { height: 6px; border-radius: 999px; background: #1e293b; overflow: hidden; }
  .m-fill { display: block; height: 100%; border-radius: 999px; transition: width 0.5s ease; }
  .m-hint { font-size: 0.73rem; color: #94a3b8; }
  .m-pct { text-align: right; font-family: var(--display); font-weight: 800; font-size: 0.84rem; font-variant-numeric: tabular-nums; }

  .is-leak .m-fill { background: #f43f5e; }
  .is-leak .m-pct { color: #fda4af; }
  .is-double .m-fill { background: repeating-linear-gradient(90deg, #f59e0b 0 8px, #b45309 8px 12px); }
  .is-double .m-pct { color: #fcd34d; }
  .is-locked { border-color: rgb(37 99 235 / 0.38); background: rgb(37 99 235 / 0.08); }
  .is-locked .m-fill { background: linear-gradient(90deg, #2563eb, #60a5fa); }
  .is-locked .m-pct { color: #60a5fa; }

  .lock-divider { position: relative; display: flex; justify-content: center; margin: 0.35rem 0; }
  .lock-divider::before { content: ""; position: absolute; inset-inline: 0; top: 50%; height: 1px; background: linear-gradient(90deg, transparent, #2563eb, transparent); }
  .lock-pill { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.32rem 0.85rem; border-radius: 999px; background: #2563eb; color: #ffffff; font-size: 0.76rem; font-weight: 700; box-shadow: 0 6px 20px -4px rgb(37 99 235 / 0.65); }
  .lock-mark { display: inline-flex; align-items: baseline; padding: 0.08rem 0.32rem; border-radius: 5px; background: #ffffff; color: #0f172a; font-family: var(--display); font-weight: 800; font-size: 0.78rem; line-height: 1; }
  .lock-mark i { display: inline-block; width: 3px; height: 3px; background: #2563eb; margin-left: 1px; }

  /* Right Panel: Campaign Cards + Hash Pipeline */
  .adset-pair { display: grid; gap: 0.75rem; }
  .adset-card { border-radius: 14px; padding: 0.95rem 1.05rem; display: grid; gap: 0.7rem; }
  .adset-card.is-winner { background: linear-gradient(180deg, rgb(37 99 235 / 0.18), rgb(15 23 42 / 0.9)); border: 1.5px solid #3b82f6; box-shadow: 0 12px 28px -12px rgb(37 99 235 / 0.45); }
  .adset-card.is-loser { background: #0f172a; border: 1px solid #1e293b; opacity: 0.78; }
  .adset-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .adset-title { font-weight: 700; color: #f8fafc; font-size: 0.9rem; }
  .adset-pill { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; padding: 0.2rem 0.55rem; border-radius: 6px; }
  .pill-scale { background: #2563eb; color: #ffffff; }
  .pill-cut { background: #1e293b; color: #fda4af; border: 1px solid rgb(244 63 94 / 0.35); }
  .adset-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; padding-top: 0.55rem; border-top: 1px solid rgb(148 163 184 / 0.14); }
  .adset-kpis small { display: block; font-size: 0.7rem; color: #94a3b8; }
  .adset-kpis strong { font-family: var(--display); font-weight: 800; font-size: 0.94rem; color: #f8fafc; font-variant-numeric: tabular-nums; }

  .hash-pipe { background: #0f172a; border: 1px solid #1e293b; border-radius: 14px; padding: 0.95rem 1.05rem; display: grid; gap: 0.65rem; }
  .pipe-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .pipe-title { font-size: 0.76rem; font-weight: 700; color: #e2e8f0; }
  .pipe-note { font-size: 0.72rem; color: #60a5fa; font-weight: 600; }
  .pipe-flow { display: grid; grid-template-columns: auto auto 1fr; gap: 0.65rem; align-items: center; }
  .pipe-inputs { display: grid; gap: 0.3rem; }
  .pipe-inputs span { font-size: 0.74rem; font-weight: 600; padding: 0.22rem 0.5rem; border-radius: 6px; background: #1e293b; color: #f8fafc; white-space: nowrap; }
  .pipe-arrow { color: #60a5fa; font-weight: 800; }
  .pipe-keys { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.32rem; }
  .pipe-keys li { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.46rem; border-radius: 5px; background: rgb(37 99 235 / 0.16); border: 1px solid rgb(96 165 250 / 0.35); color: #bfdbfe; }

  .roas-summary { font-size: 0.86rem; line-height: 1.5; color: #cbd5e1; margin-top: auto; }
  .sim-caption { font-size: 0.75rem; line-height: 1.45; color: #64748b; padding-top: 0.65rem; border-top: 1px solid #1e293b; }

  @media (max-width: 960px) {
    .signal-top, .signal-deck { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .deck-panel { padding: 1.2rem; }
    .pipe-flow { grid-template-columns: 1fr; }
    .pipe-inputs { display: flex; flex-wrap: wrap; }
    .pipe-arrow { display: none; }
    .adset-kpis { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .m-fill { transition: none !important; }
  }
</style>

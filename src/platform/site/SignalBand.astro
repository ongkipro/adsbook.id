---
/**
 * The tracking proof in the borderless gallery (HOMEPAGE-DESIGN-SYSTEM v2): two porcelain
 * surfaces, each one floating white artifact (Paduka, 2026-11-18: white, never a
 * dark band; layered product-UI cards, no connector lines).
 *  - Left card: store orders against the Purchase an ad platform records, per
 *    day, before and after the 1:1 engine (leaked, duplicated, then exact).
 *  - Right card: one buyer's order enriched into the 8 match keys the store
 *    hashes with SHA-256, plus the first-party click id it keeps for 90 days.
 * Both are captioned illustrations. Every mechanism is in the code: the keys
 * (src/lib/meta-identity.ts, pinned by test), the 90-day click id that a
 * WhatsApp follow-up link does not erase (src/lib/click-ids.ts), one event id
 * for browser and server (ADR-036). Motion only on screen, none under
 * reduced motion; the animated logo is swapped in the same way.
 */
interface Props { id?: string }
const { id = 'signal-title' } = Astro.props;

const DAYS_BEFORE = [
  { day: 'Hari 1', orders: 42, reported: 19, pct: 45, bar: 45, tag: 'Event bocor: ad blocker, halaman ditutup cepat', state: 'leak' },
  { day: 'Hari 2', orders: 38, reported: 21, pct: 55, bar: 55, tag: 'Click ID terputus di iOS', state: 'leak' },
  { day: 'Hari 3', orders: 31, reported: 52, pct: 168, bar: 100, tag: 'Konversi ganda: browser dan server tanpa event_id sama', state: 'double' },
] as const;

const DAYS_AFTER = [
  { day: 'Hari 4', orders: 48, reported: 48, pct: 100 },
  { day: 'Hari 5', orders: 53, reported: 53, pct: 100 },
  { day: 'Hari 6', orders: 61, reported: 61, pct: 100 },
] as const;

// src/lib/meta-identity.ts: exact 8 customer fields hashed with SHA-256.
const MATCH_KEYS = ['ph', 'fn', 'ln', 'ct', 'st', 'zp', 'country', 'external_id'];
const KEY_SOURCE: Record<string, string> = {
  ph: 'WhatsApp, 628…',
  fn: 'Nama depan',
  ln: 'Nama belakang',
  ct: 'Kota',
  st: 'Provinsi',
  zp: 'Kode pos',
  country: 'Negara',
  external_id: 'ID pengunjung',
};
---

<section class="section signal" aria-labelledby={id} data-signal-band>
  <div class="wrap signal-head">
    <h2 id={id}>Kirim data konversi yang utuh ke Ads Manager</h2>
    <p class="lead">Satu ID pesanan mengunci event browser dan server untuk Meta Ads, Google Ads, dan TikTok Ads. Asal klik dari platform lain tetap tercatat 90 hari di Analitik.</p>
  </div>

  <div class="wrap surfaces">
    <div class="surface">
      <div class="surface-copy">
        <span class="idx">01</span>
        <h3>Dari event terpotong ke akurasi 1:1</h3>
        <p>Ad blocker, batas cookie iOS, dan tab yang ditutup cepat tidak lagi memotong laporan konversi. Browser dan server mengirim satu pesanan dengan satu event_id.</p>
        <div class="signature">
          <img class="signal-logo" src="/platform/brand/adsbook-id-wordmark.svg" data-animated="/platform/brand/adsbook-id-wordmark-animated.svg" alt="" width="530" height="85" loading="lazy" decoding="async" />
          <div class="logo-axes" aria-label="Arti titik pada logo">
            <span><i class="ax-v" aria-hidden="true"></i>Browser</span>
            <span><i class="ax-h" aria-hidden="true"></i>Server</span>
            <span><i class="ax-d" aria-hidden="true"></i>1 ID = 1 konversi</span>
          </div>
        </div>
      </div>
      <figure class="artifact chart">
        <div class="chart-head"><span>Purchase tercatat dibanding order toko</span><span class="chart-key"><i></i>1:1 aktif</span></div>
        <ol class="bars" aria-label="Akurasi Purchase tercatat per hari">
          {DAYS_BEFORE.map((row, index) => (
            <li class={`bar is-${row.state}`} style={`--h:${Math.min(row.bar, 100)}%; --i:${index}`} aria-label={`${row.day}: ${row.orders} order, ${row.reported} tercatat, ${row.pct}%`}>
              <span class="b-pct" aria-hidden="true">{row.pct}%</span>
              <span class="b-col" aria-hidden="true"><span class="b-fill"></span></span>
              <span class="b-day" aria-hidden="true">{row.day}</span>
              <span class="b-nums" aria-hidden="true">{row.orders}/{row.reported}</span>
            </li>
          ))}
          <li class="lock" aria-label="Mesin sinyal 1:1 aktif"><span class="lock-line" aria-hidden="true"></span><span class="lock-tag" aria-hidden="true"><span class="mini-a">a<i></i></span><span class="lock-text">1:1</span></span></li>
          {DAYS_AFTER.map((row, index) => (
            <li class="bar is-locked" style={`--h:100%; --i:${index + 4}`} aria-label={`${row.day}: ${row.orders} order, ${row.reported} tercatat, ${row.pct}%`}>
              <span class="b-pct" aria-hidden="true">{row.pct}%</span>
              <span class="b-col" aria-hidden="true"><span class="b-fill"></span></span>
              <span class="b-day" aria-hidden="true">{row.day}</span>
              <span class="b-nums" aria-hidden="true">{row.orders}/{row.reported}</span>
            </li>
          ))}
        </ol>
        <ul class="reasons">
          {DAYS_BEFORE.map((row) => <li><b>{row.day}</b>{row.tag}</li>)}
        </ul>
        <figcaption class="sim-caption">Ilustrasi pencocokan order toko ke Conversions API, konversi offline Google, dan TikTok Events API, bukan data toko tertentu. Atribusi ke campaign tetap mengikuti attribution window platform iklan.</figcaption>
      </figure>
    </div>

    <div class="surface is-flip">
      <div class="surface-copy">
        <span class="idx">02</span>
        <h3>Satu pesanan, delapan kunci pencocokan</h3>
        <p>Event Match Quality dinilai dari kelengkapan data pembeli. Setiap Purchase membawa delapan kunci ini, bukan hanya IP dan user agent.</p>
        <p class="click-id"><b>First-party click ID, 90 hari.</b> Klik dari Meta, Google, dan TikTok tetap tersimpan walau pembeli membuka link follow-up WhatsApp dari CS.</p>
      </div>
      <figure class="artifact order">
        <div class="profile">
          <span class="avatar" aria-hidden="true">RL</span>
          <div class="profile-text">
            <p class="p-name">Rina Lestari</p>
            <p class="p-meta">Bandung, Jawa Barat · 2 produk · COD</p>
          </div>
          <span class="p-badge">#8421</span>
        </div>
        <p class="enrich-label">Di-hash SHA-256 sebelum dikirim</p>
        <ul class="keys">
          {MATCH_KEYS.map((key, index) => (
            <li style={`--k:${index}`}><code>{key}</code><span>{KEY_SOURCE[key]}</span></li>
          ))}
        </ul>
        <figcaption class="sim-caption">Ilustrasi data satu pesanan contoh. Nilai asli tidak pernah dikirim: hanya hash SHA-256.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bands = Array.from(document.querySelectorAll<HTMLElement>('[data-signal-band]'));
  if (!reduce && 'IntersectionObserver' in window) {
    // The cards play only while the band is on screen.
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const band = entry.target as HTMLElement;
        band.classList.toggle('is-playing', entry.isIntersecting);
        if (!entry.isIntersecting) continue;
        band.classList.add('has-played');
        const logo = band.querySelector<HTMLImageElement>('img.signal-logo');
        if (logo?.dataset.animated && !logo.src.endsWith(logo.dataset.animated)) logo.src = logo.dataset.animated;
      }
    }, { threshold: 0.2 });
    bands.forEach((band) => observer.observe(band));
  } else {
    bands.forEach((band) => band.classList.add('has-played', 'is-still'));
  }
</script>

<style>
  .signal-head { display: grid; gap: 1rem; justify-items: center; text-align: center; margin-bottom: 3rem; }
  .signal-head h2 { max-width: 22ch; }
  .signal-head .lead { max-width: 58ch; }
  .surfaces { display: grid; gap: 1.5rem; }
  /* A borderless porcelain surface holding one floating white artifact. */
  .surface { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 3rem; align-items: center; padding: 2.25rem; border-radius: 24px; background: var(--tile); }
  .surface.is-flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .surface.is-flip .surface-copy { order: 2; }
  .surface-copy { display: grid; gap: 0.9rem; align-content: center; justify-items: start; }
  .surface-copy p { color: var(--ink-muted); font-size: 1rem; line-height: 1.6; max-width: 46ch; }
  .idx { font: 600 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.08em; color: var(--slate-soft); }
  .surface-copy h3 { font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); font-weight: 800; letter-spacing: -0.02em; }
  .signature { display: grid; gap: 0.7rem; margin-top: 0.5rem; width: min(100%, 260px); }
  .signature img { width: 100%; height: auto; }
  .logo-axes { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; font-size: 0.78rem; font-weight: 600; color: var(--slate); }
  .logo-axes span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ax-v { width: 3px; height: 12px; background: var(--accent); }
  .ax-h { width: 12px; height: 3px; background: var(--accent); }
  .ax-d { width: 7px; height: 7px; background: var(--accent); }
  .click-id b { color: var(--ink); }

  .artifact { margin: 0; display: grid; gap: 1.1rem; padding: 1.5rem; border-radius: 18px; background: #fff; box-shadow: var(--shadow-float); }
  .sim-caption { font-size: 0.78rem; line-height: 1.5; color: var(--slate); }

  /* 01: six columns read in one glance — slate before, cobalt after the lock. */
  .chart-head { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.78rem; font-weight: 600; color: var(--slate); }
  .chart-key { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--accent); }
  .chart-key i { width: 8px; height: 8px; background: var(--accent); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) 2.25rem repeat(3, minmax(0, 1fr)); gap: 0.6rem; align-items: end; }
  .bar { display: grid; justify-items: center; gap: 0.35rem; }
  .b-pct { font: 800 0.88rem/1 var(--display); font-variant-numeric: tabular-nums; color: var(--slate-soft); }
  .b-col { position: relative; width: 100%; max-width: 44px; height: 150px; display: flex; align-items: flex-end; border-radius: 8px; background: #f1f5f9; overflow: hidden; }
  .b-fill { width: 100%; height: var(--h); border-radius: 8px 8px 0 0; background: #cbd5e1; }
  .is-double .b-fill { background: repeating-linear-gradient(135deg, #cbd5e1 0 6px, #94a3b8 6px 9px); }
  .is-locked .b-pct { color: var(--accent); }
  .is-locked .b-fill { background: var(--accent); }
  .b-day { font-size: 0.74rem; font-weight: 700; color: var(--ink); white-space: nowrap; }
  .b-nums { font-size: 0.7rem; color: var(--slate); font-variant-numeric: tabular-nums; }
  /* The lock: a cobalt rule through the chart, its tag at the middle of the columns. */
  .lock { position: relative; align-self: stretch; display: flex; align-items: center; justify-content: center; padding-bottom: 2.4rem; }
  .lock-line { position: absolute; top: 0; bottom: 2.4rem; width: 2px; background: var(--accent); }
  .lock-tag { position: relative; display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.2rem 0.3rem; border-radius: 8px; background: #fff; color: var(--accent); font: 800 0.72rem/1 var(--display); box-shadow: 0 0 0 4px rgb(37 99 235 / 0.1); }
  .mini-a { display: inline-flex; align-items: flex-end; gap: 2px; padding: 0 0.25rem; height: 1.1rem; border-radius: 5px; background: var(--ink); color: #fff; font: 800 0.78rem/1.1rem var(--display); }
  .mini-a i { width: 3px; height: 3px; margin-bottom: 3px; background: #60a5fa; }
  .reasons { list-style: none; margin: 0; padding: 0.9rem 0 0; display: grid; gap: 0.35rem; border-top: var(--hairline); font-size: 0.8rem; color: var(--slate); }
  .reasons b { display: inline-block; min-width: 3.75rem; color: var(--ink); font-weight: 700; }

  /* 02: the order and its eight keys. */
  .profile { display: flex; align-items: center; gap: 0.75rem; }
  .avatar { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--ink); color: #fff; font: 800 0.85rem/1 var(--display); }
  .profile-text { flex: 1; min-width: 0; }
  .p-name { font-weight: 700; color: var(--ink); }
  .p-meta { font-size: 0.8rem; color: var(--slate); }
  .p-badge { flex-shrink: 0; padding: 0.15rem 0.55rem; border-radius: 999px; background: var(--tile); font: 600 0.72rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: var(--ink-muted); }
  .enrich-label { padding-top: 0.9rem; border-top: var(--hairline); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--slate); }
  .keys { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem; }
  .keys li { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.45rem 0.65rem; border-radius: 10px; background: #f8fafc; }
  .keys code { font: 700 0.76rem/1.3 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: var(--accent); }
  .keys span { font-size: 0.72rem; color: var(--ink-muted); text-align: right; }

  /* Motion: bars rise and keys settle in once; the lock breathes while on screen. */
  .signal.has-played:not(.is-still) .b-fill { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 0.1s); transform-origin: bottom; }
  .signal.has-played:not(.is-still) .keys li { animation: key-in 0.45s ease-out both; animation-delay: calc(0.3s + var(--k) * 0.07s); }
  .signal.is-playing .lock-tag { animation: lock 2.8s ease-in-out infinite; }
  @keyframes rise { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes key-in { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes lock { 0%, 100% { box-shadow: 0 0 0 4px rgb(37 99 235 / 0.1); } 50% { box-shadow: 0 0 0 7px rgb(37 99 235 / 0.16); } }
  @media (prefers-reduced-motion: reduce) {
    .signal *, .signal *::before { animation: none !important; transition: none !important; }
  }

  @media (max-width: 900px) {
    .surface, .surface.is-flip { grid-template-columns: 1fr; gap: 2rem; }
    .surface.is-flip .surface-copy { order: 0; }
  }
  @media (max-width: 520px) {
    .surface { padding: 1.25rem; border-radius: 20px; }
    .artifact { padding: 1.1rem; }
    .bars { gap: 0.3rem; grid-template-columns: repeat(3, minmax(0, 1fr)) 1.6rem repeat(3, minmax(0, 1fr)); }
    .b-col { height: 120px; }
    .b-pct { font-size: 0.72rem; }
    .b-day { font-size: 0.66rem; }
    .b-nums { font-size: 0.62rem; }
    .lock-text { display: none; }
    .keys { grid-template-columns: 1fr; }
  }
</style>

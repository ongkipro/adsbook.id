---
/**
 * The tracking proof in the white gallery (Paduka, 2026-11-18: white, never a
 * dark band; layered product-UI cards, no connector lines).
 *  - Left card: store orders against the Purchase an ad platform records, per
 *    day, before and after the 1:1 engine (leaked, duplicated, then exact).
 *  - Right card: one buyer's order enriched into the 8 match keys the store
 *    hashes with SHA-256, plus the first-party click id it keeps for 90 days.
 * Both are captioned illustrations. Every mechanism is in the code: the keys
 * (src/lib/meta-identity.ts, pinned by test), the 90-day click id that a
 * WhatsApp follow-up link does not erase (src/lib/click-ids.ts), one event id
 * for browser and server (ADR-036). Motion only on screen, none under
 * reduced motion; the animated logo is swapped in the same way.
 */
interface Props { id?: string }
const { id = 'signal-title' } = Astro.props;

const DAYS_BEFORE = [
  { day: 'Hari 1', orders: 42, reported: 19, pct: 45, bar: 45, tag: 'Event bocor: ad blocker, halaman ditutup cepat', state: 'leak' },
  { day: 'Hari 2', orders: 38, reported: 21, pct: 55, bar: 55, tag: 'Click ID terputus di iOS', state: 'leak' },
  { day: 'Hari 3', orders: 31, reported: 52, pct: 168, bar: 100, tag: 'Konversi ganda: browser dan server tanpa event_id sama', state: 'double' },
] as const;

const DAYS_AFTER = [
  { day: 'Hari 4', orders: 48, reported: 48, pct: 100 },
  { day: 'Hari 5', orders: 53, reported: 53, pct: 100 },
  { day: 'Hari 6', orders: 61, reported: 61, pct: 100 },
] as const;

// src/lib/meta-identity.ts: exact 8 customer fields hashed with SHA-256.
const MATCH_KEYS = ['ph', 'fn', 'ln', 'ct', 'st', 'zp', 'country', 'external_id'];
const KEY_SOURCE: Record<string, string> = {
  ph: 'WhatsApp, 628…',
  fn: 'Nama depan',
  ln: 'Nama belakang',
  ct: 'Kota',
  st: 'Provinsi',
  zp: 'Kode pos',
  country: 'Negara',
  external_id: 'ID pengunjung',
};
---

<section class="section signal" aria-labelledby={id} data-signal-band>
  <div class="wrap signal-top">
    <div class="signal-intro">
      <p class="pill-eyebrow"><span class="sq" aria-hidden="true"></span>First-party tracking · 1:1</p>
      <h2 id={id}>Kirim data konversi yang akurat ke Ads Manager, tanpa event bocor dan tanpa konversi ganda</h2>
      <p class="lead">Asal klik dari Meta, Google, TikTok, dan platform lain tercatat 90 hari di Analitik. Untuk Meta Ads dan Google Ads, satu ID pesanan mengunci event dari browser dan dari jalur server.</p>
    </div>
    <div class="logo-card">
      <img class="signal-logo" src="/platform/brand/adsbook-id-wordmark.svg" data-animated="/platform/brand/adsbook-id-wordmark-animated.svg" alt="" width="530" height="85" loading="lazy" decoding="async" />
      <div class="logo-axes" aria-label="Arti titik pada logo">
        <span><i class="ax-v" aria-hidden="true"></i>Browser pixel</span>
        <span><i class="ax-h" aria-hidden="true"></i>Server toko</span>
        <span><i class="ax-d" aria-hidden="true"></i>1 ID = 1 konversi</span>
      </div>
    </div>
  </div>

  <div class="wrap deck">
    <figure class="card">
      <div class="card-head">
        <span class="card-tag">Akurasi event</span>
        <h3>Dari event bocor ke akurasi 1:1</h3>
      </div>
      <div class="meter" role="table" aria-label="Order toko dibanding Purchase tercatat, per hari">
        <div class="m-cols" role="row">
          <span role="columnheader">Hari</span>
          <span role="columnheader">Order toko → Purchase tercatat</span>
          <span role="columnheader" class="m-end">Akurasi</span>
        </div>
        {DAYS_BEFORE.map((row, index) => (
          <div class={`m-row is-${row.state}`} role="row" style={`--i:${index}`}>
            <span role="cell" class="m-day">{row.day}</span>
            <div role="cell" class="m-cell">
              <div class="m-nums"><span><b>{row.orders}</b> order</span><span><b>{row.reported}</b> tercatat</span></div>
              <div class="m-track"><span class="m-fill" style={`width:${row.bar}%`}></span></div>
              <span class="m-hint">{row.tag}</span>
            </div>
            <span role="cell" class="m-pct">{row.pct}%</span>
          </div>
        ))}
        <div class="m-divider" role="row">
          <span role="cell" class="m-divider-pill"><span class="mini-a" aria-hidden="true">a<i></i></span>Mesin sinyal 1:1 aktif</span>
        </div>
        {DAYS_AFTER.map((row, index) => (
          <div class="m-row is-locked" role="row" style={`--i:${index + 4}`}>
            <span role="cell" class="m-day">{row.day}</span>
            <div role="cell" class="m-cell">
              <div class="m-nums"><span><b>{row.orders}</b> order</span><span><b>{row.reported}</b> tercatat</span></div>
              <div class="m-track"><span class="m-fill" style="width:100%"></span></div>
              <span class="m-hint">Satu pesanan, satu Purchase</span>
            </div>
            <span role="cell" class="m-pct">{row.pct}%</span>
          </div>
        ))}
      </div>
      <figcaption class="sim-caption">Ilustrasi pencocokan order toko ke Conversions API dan konversi offline Google, bukan data toko tertentu. Atribusi ke campaign tetap mengikuti attribution window platform iklan.</figcaption>
    </figure>

    <figure class="card">
      <div class="card-head">
        <span class="card-tag">360° customer data enrichment</span>
        <h3>Satu pesanan, delapan kunci pencocokan</h3>
      </div>
      <div class="profile">
        <span class="avatar" aria-hidden="true">RL</span>
        <div class="profile-text">
          <p class="p-name">Rina Lestari</p>
          <p class="p-meta">Bandung, Jawa Barat · 2 produk · COD</p>
        </div>
        <span class="p-badge">Order #8421</span>
      </div>
      <p class="enrich-label">Di-hash SHA-256 sebelum dikirim</p>
      <ul class="keys">
        {MATCH_KEYS.map((key, index) => (
          <li style={`--k:${index}`}><code>{key}</code><span>{KEY_SOURCE[key]}</span></li>
        ))}
      </ul>
      <p class="click-id"><span class="sq" aria-hidden="true"></span><span><b>First-party click ID, 90 hari.</b> Tetap tersimpan walau pembeli membuka link follow-up WhatsApp dari CS.</span></p>
      <p class="why">Event Match Quality dinilai dari kelengkapan data pembeli. Setiap Purchase membawa delapan kunci ini, bukan hanya IP dan user agent.</p>
      <figcaption class="sim-caption">Ilustrasi data satu pesanan contoh. Nilai asli tidak pernah dikirim: hanya hash SHA-256.</figcaption>
    </figure>
  </div>
  <div class="wrap signal-more"><a class="text-link" href="/fitur#sinyal">Detail server tracking semua platform iklan</a></div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bands = Array.from(document.querySelectorAll<HTMLElement>('[data-signal-band]'));
  if (!reduce && 'IntersectionObserver' in window) {
    // The cards play only while the band is on screen.
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        const band = entry.target as HTMLElement;
        band.classList.toggle('is-playing', entry.isIntersecting);
        if (!entry.isIntersecting) continue;
        band.classList.add('has-played');
        const logo = band.querySelector<HTMLImageElement>('img.signal-logo');
        if (logo?.dataset.animated && !logo.src.endsWith(logo.dataset.animated)) logo.src = logo.dataset.animated;
      }
    }, { threshold: 0.2 });
    bands.forEach((band) => observer.observe(band));
  } else {
    bands.forEach((band) => band.classList.add('has-played', 'is-still'));
  }
</script>

<style>
  .signal { --rose: #e11d48; --amber: #d97706; --emerald: #047857; background: var(--canvas); }
  .pill-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.8rem; border-radius: 999px; background: #fff; border: 1px solid #dbeafe; font: 600 0.72rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .sq { display: inline-block; width: 6px; height: 6px; background: var(--accent); flex-shrink: 0; }

  .signal-top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: center; }
  .signal-intro { display: grid; gap: 1rem; justify-items: start; }
  .logo-card { display: grid; gap: 1.1rem; padding: 1.6rem; border-radius: 18px; background: #fff; border: 1px solid #e2e8f0; box-shadow: 0 24px 60px -15px rgb(15 23 42 / 0.08); }
  .logo-card img { width: 100%; height: auto; }
  .logo-axes { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; font-size: 0.82rem; font-weight: 600; color: #475569; }
  .logo-axes span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .ax-v { width: 3px; height: 14px; background: linear-gradient(var(--accent-tint), var(--accent)); }
  .ax-h { width: 14px; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent-tint)); }
  .ax-d { width: 8px; height: 8px; background: var(--accent); }

  .deck { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 1.5rem; margin-top: 3rem; align-items: start; }
  .card { margin: 0; display: grid; gap: 1.1rem; padding: 1.5rem; border-radius: 18px; background: #fff; border: 1px solid #e2e8f0; box-shadow: 0 24px 60px -15px rgb(15 23 42 / 0.08); }
  .card-head { display: grid; gap: 0.3rem; }
  .card-tag { font: 600 0.7rem/1.3 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .card h3 { font-size: 1.12rem; }
  .sim-caption { font-size: 0.8rem; line-height: 1.5; color: #64748b; border-top: 1px solid #f1f5f9; padding-top: 0.85rem; }

  /* Left card: proportional bars, read in one glance. */
  .meter { display: grid; gap: 0.45rem; }
  .m-cols, .m-row { display: grid; grid-template-columns: 4rem minmax(0, 1fr) 3.75rem; gap: 0.85rem; align-items: center; }
  .m-cols { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #64748b; padding: 0 0.75rem; }
  .m-end { text-align: right; }
  .m-row { padding: 0.6rem 0.75rem; border-radius: 12px; background: var(--canvas); border: 1px solid #f1f5f9; }
  .m-day { font-weight: 700; font-size: 0.86rem; color: var(--ink); }
  .m-cell { display: grid; gap: 0.3rem; min-width: 0; }
  .m-nums { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.78rem; color: #64748b; font-variant-numeric: tabular-nums; }
  .m-nums b { color: var(--ink); }
  .m-track { height: 6px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
  .m-fill { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
  .is-leak .m-fill { background: var(--rose); }
  .is-double .m-fill { background: var(--amber); }
  .m-hint { font-size: 0.74rem; color: #64748b; }
  .m-pct { text-align: right; font: 800 0.95rem/1 var(--display); font-variant-numeric: tabular-nums; }
  .is-leak .m-pct { color: var(--rose); }
  .is-double .m-pct { color: var(--amber); }
  .is-locked { background: #eff6ff; border-color: #dbeafe; }
  .is-locked .m-pct { color: var(--accent); }
  .m-divider { position: relative; display: flex; justify-content: center; margin: 0.35rem 0; }
  .m-divider::before { content: ""; position: absolute; left: 8%; right: 8%; top: 50%; height: 2px; transform: translateY(-50%); background: linear-gradient(90deg, transparent, var(--accent), transparent); }
  .m-divider-pill { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.85rem 0.3rem 0.4rem; border-radius: 999px; background: #fff; border: 1px solid var(--accent); color: var(--ink); font-weight: 700; font-size: 0.82rem; box-shadow: 0 0 0 4px rgb(37 99 235 / 0.1); }
  .mini-a { display: inline-flex; align-items: flex-end; gap: 2px; padding: 0 0.3rem; height: 1.3rem; border-radius: 6px; background: var(--ink); color: #fff; font: 800 0.9rem/1.3rem var(--display); }
  .mini-a i { width: 4px; height: 4px; margin-bottom: 4px; background: #60a5fa; }

  /* Right card: the order and its keys. */
  .profile { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem; border-radius: 14px; background: var(--canvas); border: 1px solid #f1f5f9; }
  .avatar { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 12px; background: var(--accent); color: #fff; font: 800 0.85rem/1 var(--display); }
  .profile-text { flex: 1; min-width: 0; }
  .p-name { font-weight: 700; color: var(--ink); }
  .p-meta { font-size: 0.8rem; color: #64748b; }
  .p-badge { flex-shrink: 0; padding: 0.15rem 0.5rem; border-radius: 999px; background: #fff; border: 1px solid #e2e8f0; font-size: 0.7rem; font-weight: 700; color: #475569; }
  .enrich-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #64748b; }
  .keys { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem; }
  .keys li { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.4rem 0.6rem; border-radius: 10px; background: #eff6ff; border: 1px solid #dbeafe; }
  .keys code { font: 700 0.76rem/1.3 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: var(--accent); }
  .keys span { font-size: 0.72rem; color: #475569; text-align: right; }
  .click-id { display: flex; align-items: flex-start; gap: 0.55rem; font-size: 0.82rem; line-height: 1.5; color: #475569; }
  .click-id .sq { margin-top: 0.45rem; }
  .click-id b { color: var(--ink); }
  .why { font-size: 0.88rem; line-height: 1.55; color: var(--ink); }
  .signal-more { margin-top: 2rem; }

  /* Motion: rows and keys settle in once; the divider breathes while on screen. */
  .signal.has-played:not(.is-still) .m-row { animation: row-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 0.12s); }
  .signal.has-played:not(.is-still) .keys li { animation: key-in 0.45s ease-out both; animation-delay: calc(0.4s + var(--k) * 0.08s); }
  .signal.is-playing .m-divider-pill { animation: lock 2.8s ease-in-out infinite; }
  @keyframes row-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes key-in { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes lock { 0%, 100% { box-shadow: 0 0 0 4px rgb(37 99 235 / 0.1); } 50% { box-shadow: 0 0 0 7px rgb(37 99 235 / 0.16); } }
  @media (prefers-reduced-motion: reduce) {
    .signal *, .signal *::before { animation: none !important; transition: none !important; }
  }

  @media (max-width: 900px) {
    .signal-top, .deck { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .card { padding: 1.1rem; }
    .m-cols, .m-row { grid-template-columns: 3.4rem minmax(0, 1fr) 3.2rem; gap: 0.55rem; padding-inline: 0.6rem; }
    .keys { grid-template-columns: 1fr; }
  }
</style>

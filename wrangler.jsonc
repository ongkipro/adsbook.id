{
  // adsbook.id — platform Worker template.
  //
  // This file is a TEMPLATE, not a deployment. One Worker serves every tenant
  // (ADR-039): a tenant is a row in PLATFORM_DB and a TenantStore Durable
  // Object, created at signup, never a deploy. Nothing in this repository
  // deploys (ADR-012); the platform runbook comes with T-30.
  //
  // The all-zero ids are the one thing that must never deploy, and the deploy
  // preflight refuses them (src/lib/deploy-preflight.ts).
  //
  // Binding NAMES are fixed — PLATFORM_DB, TENANT_STORE, SESSION,
  // ASSET_BUCKET, AI, ASSETS — because the application resolves them by name.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // ARCH-2. Never an AdsBookCMS install's Worker name: a deploy under that
  // name would replace a live store of the old fleet (ADR-038).
  "name": "adsbook-platform",
  "main": "./src/worker.ts",


  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Run the Worker beside its D1, not beside the visitor (ADR-030, ADR-034).
  // Cloudflare serves part of Indonesian traffic (and all of PageSpeed
  // Insights) from US colos, where each D1 read crossed the Pacific. Smart
  // Placement declined some of them (cf-placement: local-LAX, 2-3 s to first
  // byte against 0.3 s from SIN), so the Worker is pinned to Singapore, beside
  // an APAC D1. A store whose D1 is not in APAC sets its own region or "mode":
  // "smart" instead. Static assets still serve from the nearest colo.
  "placement": {
    "region": "aws:ap-southeast-1"
  },

  // No required secret (T-21). Each tenant's session key is generated into its
  // own store at signup (`install_secrets`, ADR-026); there is no installer and
  // no INSTALL_TOKEN. Provider keys are saved per tenant from /admin.
  // Optional platform secrets, set with `wrangler secret put` on the platform
  // account (T-30/T-31), never here: PLATFORM_AUTH_SECRET (platform admin),
  // PLATFORM_ALERT_WEBHOOK_URL (operator notices, T-44), PLATFORM_META_CAPI_TOKEN
  // (the marketing site's Conversions API, T-40). PLATFORM_CREDENTIAL_KEY is
  // required before any seller saves a provider key (ADR-040, T-48): without it
  // credentials are neither stored nor read.

  // The workers.dev copy answers `X-Robots-Tag: noindex`; the gate refuses any
  // host that is not a platform host or a tenant row.
  "workers_dev": true,
  // One Worker for every seller host on the SaaS zone (ADR-039). The zone does
  // not exist yet (PRD Q-1); nothing in this repository deploys (ADR-012).
  "routes": [
    { "pattern": "*/*", "zone_name": "belanja.cc" }
  ],
  // Hourly evaluation catches a stalled conversion outbox even when no operator
  // opens the dashboard. Alert transitions are deduplicated in the install's KV.
  "triggers": {
    "crons": ["7 * * * *"]
  },


  "assets": {
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      // The control plane (TD-2): tenants, hosts, plans, audit. Its own chain.
      "binding": "PLATFORM_DB",
      "database_name": "adsbook-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/platform/migrations"
    }
  ],
  // One SQLite-backed Durable Object per tenant (ADR-039, TD-3): the store is
  // created on first use, by tenant id, with the APAC hint (DATA-1).
  "durable_objects": {
    "bindings": [{ "name": "TENANT_STORE", "class_name": "TenantStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantStore"] }],
  // A bucket of its own, never an AdsBookCMS install's (ADR-038): every key is
  // `t/<tenantId>/…` (TEN-3, src/platform/keys.ts), so it starts empty and no
  // unprefixed object ever exists in it.
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "adsbook-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },

  // Without this, Workers Logs are off and the ~76 labelled console.error
  // calls in src/ are unqueryable — a failing install cannot be diagnosed
  // after the fact. See OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // OBS-1: invocation logs record the full request URL (webhook tokens are
    // path segments). The middleware writes one structured line instead.
    "logs": {
      "invocation_logs": false
    }
  },
  // No per-store `vars` (T-21): store identity — name, URL, logo, locale,
  // template — is a row in each tenant's own store, never a Worker-wide value.
}
